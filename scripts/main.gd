		_card_timing_look(tb, i)
		v.add_child(tb)
		if not easy_on:   # the timing panel (move, hold) is Expert's (Easy continued above)
			var pp := PanelContainer.new()   # not a popup Window (12 of them per rebuild): a panel that floats over the strip
			pp.name = "time_edit"
			pp.top_level = true
			pp.visible = false
