func _wp_toggle() -> void:
	if wp.is_empty():
		_say("no skin to paint: Weight paint works on a body with a skin: pick the mannequin")
		return
	wp_on = not wp_on
	if wp_brush_btn != null:
		wp_brush_btn.visible = wp_on
		if not wp_on:
			wp_pop.hide()
	_wp_show()
	_say("weight paint on: pick a bone in Bone, then drag on the body. The colour shows that bone's weight: dark = none, orange = all" if wp_on else "weight paint off")


## the body's colours follow the picked bone while the mode is on; off = the body as it was
func _wp_show() -> void:
	if not wp.is_empty():
		SkinPaint.apply(wp, wp_bind if wp_on else -1)
		if not wp_on:
			_skp_build()   # the painted weights decide the pick and the light from now on


## a left press on the body starts a stroke (and one undo step); a press off the body is the view's. True = taken
func _wp_input(ev: InputEvent) -> bool:
	if ev is InputEventMouseButton and (ev as InputEventMouseButton).button_index == MOUSE_BUTTON_LEFT:
		var mb := ev as InputEventMouseButton
		if mb.pressed:
			if wp_bind < 0:
				_say("pick a bone first: choose one in the Bone list, then press on the body")
				return true
			SkinPaint.refresh(wp)   # the stroke lands on the shape the body has when it starts
			var hit = SkinPaint.pick(wp, mb.position, cam)
			if hit == null:
				return false
			_push_undo()
			wp_stroke = true
			wp_centres = []
			_wp_dab(hit)
			return true
		if wp_stroke:
			wp_stroke = false
			var saved := SkinPaint.save(wp, wp_key)
			_say(("weight stroke done (%d dabs), the weights are saved" % wp_centres.size()) if saved else "weight stroke done, but the weights could not be saved (the disk is full or read-only): free some space, then paint again")
			return true
		return false
	if ev is InputEventMouseMotion and wp_stroke:
		var hit = SkinPaint.pick(wp, (ev as InputEventMouseMotion).position, cam)
		if hit != null:
			_wp_dab(hit)
		return true
	return false


## one brush dab at c: every surface's weights move for the picked bone, then the meshes are redrawn
func _wp_dab(c: Vector3) -> void:
	wp_centres.append(c)
	for s in wp["surfs"]:
		SkinPaint.paint(s, s["pos"], c, wp_radius, wp_bind, wp_strength, wp_mode)
	SkinPaint.apply(wp, wp_bind if wp_on else -1)


## a test's own library folder goes with it (never the user's)
static func _rm_tree(dir: String) -> void:
	var da := DirAccess.open(dir)
	if da == null:
		return
	for f in da.get_files():
		DirAccess.remove_absolute(dir.path_join(f))
	for sub in da.get_directories():
		_rm_tree(dir.path_join(sub))
	DirAccess.remove_absolute(dir)


func _unsaved() -> bool:
	var H := _hero_scene()   # TC3: the file is the hero's scene, whoever is active
	# a drawn house (or a part with steps) is work too; a blank part (no steps: the BUILDING card's start, Nick 2026-10-28) is not
	return (not H.cards.is_empty() or not H.props.is_empty() or not S.building.is_empty() or not (S.part.get("features", []) as Array).is_empty()) and _doc_key() != _clean


## what "saved" compares: the cards, and the set when there is one (no props: the same string as before round 37); with
## a second actor (TC3) each actor's name, place and cards too (one actor: the same string as before)
func _doc_key() -> String:
	var H := _hero_scene()
	var k := JSON.stringify(H.cards) + ("" if H.props.is_empty() else JSON.stringify(H.props.map(func(p): return Props.to_dict(p))))
	if not S.building.is_empty():
		k += "|building" + JSON.stringify(Building.to_file(S.building))   # BUILD: a drawn room is an unsaved change
	if not S.part.is_empty():
		k += "|part" + JSON.stringify(Part.to_file(S.part))   # PART: a sketched feature is an unsaved change
	if not H.shots.is_empty():
		k += "|shots" + var_to_str(H.shots)   # the shots and their cameras: an unsaved change too (ROADMAP 75)
	for a in H.actors:
		k += "|" + JSON.stringify([a["name"], a["xf"], (a["scene"] as Scene).cards])
	# the fighter's applied body and armour plates are the scene's too (an edit to them is unsaved, so the autosave holds it)
	k += "|body%d|plates%d" % [BaseBody.gen(self), ArmourFromBody.parts(self).size()]
	return k


func _load_scene(path0: String, work := false) -> void:   # work: a copy the app wrote into scenes/_wip (a card build, a mirror, a restore), not a file the user saved or opened
	var path := path0
	if not FileAccess.file_exists(path) and FileAccess.file_exists(UserPaths.w(path)):
		path = UserPaths.w(path)   # written as res://... in an exported build: it is in the user's folder
	var probe: Variant = JSON.parse_string(FileAccess.get_file_as_string(path)) if FileAccess.file_exists(path) else null
	if not (probe is Dictionary):   # a missing, empty or non-JSON file is refused with a message, not a crash
		_say_plain("NOT NOW: %s is not a scene file (missing, empty or not JSON)" % path.get_file())
		return
	_open_scene_dict(path, probe, work, false)


## A CARD BUILD (Easy home): the clip is opened from the dictionary in memory, not from a file written and read back.
## The values are the ones the file would hold (a JSON round trip), and the _wip file is written after the frame
## (_write_later) with the same text. Same scene as _load_scene(path, true) on the written file.
func _load_scene_built(path0: String, d: Dictionary) -> void:
	var rt: Variant = d   # no deep copy of a 37-card clip: the caller (easy_home._build) never touches d again, the scene's cards copy their poses (Scene._finite) and the file is written from d after the frame
	_after_first_frame(_write.bind(path0, d))
	if not (rt is Dictionary):
		_say_plain("NOT NOW: %s is not a scene file (missing, empty or not JSON)" % path0.get_file())
		return
	_open_scene_dict(path0, rt, true, true)


func _open_scene_dict(path: String, d: Dictionary, work: bool, built := false) -> void:   # built: a card build (_load_scene_built): its recents line and the dot follow the frame
	_actors_home()   # TC3: the opened file's hero goes on the hero's body; its actors are built from it
	if not vdiff.is_empty():   # COMPARE WITH: a comparison belongs to the scene it was made in
		_vdiff_clear()
	swap_scenes = []
	scene_path = path
	layer_on = -1   # NA1: edits go to the first layer of a newly opened scene
	check_ran = false
	S = Scene.new()
	if d.has("cards"):
		S.from_dict(d)
		if not S.props_skipped.is_empty():
			_say.call_deferred("this scene's set names models your library does not have (%s): they were left out" % ", ".join(S.props_skipped))
		BodyFile.from_scene(self, d)   # G07: the body the scene was saved with back on the fighter
		ArmourFromBody.from_scene(self, d)   # B23: the armour plates the scene was saved with (none when the file has none)
		CharImportApp.from_scene(self, d)   # L9: the imported character the scene was saved with (none: the Kine body)
		KMeshTPaintFile.from_scene(self, d, path)   # L55: the painted texture the scene was saved with (its PNG beside the file), held for Texture mode
		camx.from_scene(d)   # C01: the cube's Top the scene was saved with
	else:   # an old move file: its keys become cards
		var prev := 0.0
		for k in d.get("keys", []):
			S.add("key %.2fs" % k["t"], k["pose"])
			S.cards[-1]["move"] = maxf(0.05, k["t"] - prev) if S.cards.size() > 1 else -1.0
			S.cards[-1]["hold"] = 0.0
			prev = k["t"]
		S.name = d.get("name", "move")
	if ui_scene_name != null:
		ui_scene_name.text = S.name
	if built:
		_after_first_frame(_recent_note.bind(path))   # the settings file's recent list: written after the clip's first moving frame (the card's pictures do not wait for it)
	else:
		_recent_note(path)
	_show_open_scene()
	if ui_natural != null:
		ui_natural.set_pressed_no_signal(S.natural)   # the boxes show THIS scene's settings (10-14: they kept the last ones)
		ui_spline.set_pressed_no_signal(S.spline)
		ui_loop.set_pressed_no_signal(S.loop)
	ov.mark_dirty()
	wt.mark_dirty()
	_dummy_hits()
	sel_card = -1
	playhead = 0.0
	if not work:   # the user's file (opened, or saved by Save) is the clean state; a work copy is unsaved work until the user saves it (ROADMAP 50)
		_clean = _doc_key()
	if not _recovering and not work:
		_autosave_drop()   # opened a scene: what was unsaved was given up (it asks first, V3)
		if journal_on:
			journal.trim()   # ... and its journal goes with it
	_props_show()   # the opened scene's set is drawn now (a load used to leave the props out of the view until the next edit)
	UiWire.register(self)   # L95: the stage's lights / floor / skin are AnyKey targets for the scene just opened
	if not S.anykeys.is_empty() or uiw != null:
		_uiw().after_open()
	S.apply(B, 0.0)
	_home_refit()   # C62: a scene opened under the untouched home view is framed for ITS body
	_home_refit.call_deferred()   # ... and again once its first pose has settled
	_bld_scene_changed(true, built)


# ---------------------------------------------------------------- THE SHOT CAMERA (docs/GAP_ANALYSIS.md row 21; GATES SC)
## scripts/shot_camera.gd holds the keys' maths; here: the commands, look-through and the playblast's use of it. The keys
## are the HERO's scene's (the file's top level), in the hero's world; with another fighter active the stage moves, and
## the camera with it (_stage_xf). Look-through is a VIEW: never saved, never an undo step.
var shot_through := false   # looking through the shot camera
var ui_shot: ShotFrame      # the 16:9 frame and passepartout (scripts/shot_frame.gd)
var _shot_fov := 40.0       # the viewport camera's own fov, put back when look-through ends
var _shot_dof: CameraAttributesPractical   # the rack focus's depth of field (ROADMAP 76; _shot_dof_set)


## ---- LIGHTING PRESETS (ROADMAP R1; scripts/light_rig.gd): the shot's "light" is one of LightRig.IDS or "" (the stage's
## own two lights). It is part of the shot: saved with the scene, undone like a camera key. _light_apply puts the lights
## where the shot's camera (at the playhead) says; it is a view of the data, so it never makes an undo step itself.
func _light_id() -> String:
	var i := shot_now_index()
	return "" if i < 0 else String(_shot_shots()[i].get("light", ""))


func _light_apply() -> void:
	if light_key == null or _hero_scene() == null:
		return
	var id := _light_id()
	var ks := _shot_keys()
	var k := {} if (id == "" or ks.is_empty()) else ShotCam.sample(ks, playhead)
	var sig := "" if k.is_empty() else "%s|%s|%s" % [id, k["pos"], k["aim"]]
	if sig == _light_sig:
		return
	_light_sig = sig
	if k.is_empty():   # the stage's own lights (as _world builds them)
		Shading.stage_default(self)
		_body_outline_show(true)
		world_env.adjustment_enabled = false
		world_env.adjustment_brightness = 1.0
		world_env.adjustment_contrast = 1.0
		shading.apply_lights(self)   # K02: back to the studio lights the view had chosen (none: the default above)
		_lr_view_apply()
		return
	_body_outline_show(false)
	var r := LightRig.rig(id, k["pos"], k["aim"])
	for pair in [[light_key, "key"], [light_fill, "fill"], [light_rim, "rim"]]:
		var L: DirectionalLight3D = pair[0]
		var d: Dictionary = r[pair[1]]
		L.basis = Basis.looking_at(d["dir"], Vector3.UP)
		L.light_energy = d["energy"]
		L.light_color = d["color"]
	world_env.ambient_light_energy = r["ambient"]["energy"]
	world_env.ambient_light_color = r["ambient"]["color"]
	world_env.adjustment_enabled = true
	world_env.adjustment_brightness = r["adjust"]["brightness"]
	world_env.adjustment_contrast = r["adjust"]["contrast"]
	_lr_view_apply()


## L25: the view-side half of the light rig: the link masks on the three lights and the sky map on the world environment
func _lr_view_apply() -> void:
	for pair in [[light_key, "key"], [light_fill, "fill"], [light_rim, "rim"]]:
		LightRig.set_link(pair[0], bool(lr_link[pair[1]]))
	if lr_hdri_id != "":
		LightRig.apply_hdri(world_env, lr_hdri_id, lr_rot, lr_int)
		_lr_sky_on = true
	elif _lr_sky_on:
		_lr_sky_on = false
		LightRig.apply_hdri(world_env, "", 0.0, 1.0)
		shading.apply_sky(self)   # the flat colour (or the View menu's sky / picture) as before
	if lr_ui != null:
		lr_ui.sync()


## L25: a look from the panel or the palette. With no shot camera yet the view is keyed as one (the same step), because the rig is
## placed relative to the shot camera. One undo step.
func lr_preset(id: String) -> bool:
	if not LightRig.PRESETS.has(id) or _hero_scene() == null:
		return false
	if _hero_scene().cards.is_empty():
		_say("the lights follow the shot camera: add a pose card first (or open a scene), then pick a look")
		return false
	var had := not _shot_keys().is_empty()
	if had and _light_id() == id:
		_say("this shot already has %s" % LightRig.PANEL_NAMES.get(id, id))
		return true
	var t := clampf(playhead, 0.0, S.length())
	var key := {} if had else _shot_view_key(t)
	if not had:
		key["t"] = t
	_do(func():
		if not had:
			_shot_ensure()
			ShotCam.put(_shot_keys(), key)
		_shot_shots()[shot_now_index()]["light"] = id)
	_light_apply()
	_say("%s: %s%s (Ctrl+Z takes it back)" % [LightRig.PANEL_NAMES.get(id, id), LightRig.tip(id), "" if had else "; the view was keyed as the shot camera"])
	return true


func lr_hdri(id: String) -> void:
	lr_hdri_id = id if LightRig.SKIES.has(id) else ""
	_lr_view_apply()
	_say("sky map: %s" % (LightRig.SKY_NAMES[lr_hdri_id] if lr_hdri_id != "" else "none (the flat world colour)"))


func lr_hdri_rot(deg: float) -> void:
	lr_rot = fposmod(deg, 360.0)
	_lr_view_apply()


func lr_hdri_int(x: float) -> void:
	lr_int = clampf(x, 0.0, 4.0)
	_lr_view_apply()


func lr_set_link(role: String, on: bool) -> void:
	if not lr_link.has(role):
		return
	lr_link[role] = on
	_lr_view_apply()
	_say("%s light: %s" % [role, "lights the character only" if on else "lights everything"])


func _light_preset(id: String) -> void:
	var ks := _shot_keys()
	if ks.is_empty():
		_say("the lights follow the shot camera: key it first with 'Camera: key the shot camera from the view', then pick a lighting preset")
		return
	if _light_id() == id:
		_say("this shot already has %s: pick another preset, or 'Light: back to the default lights'" % ("the default lights" if id == "" else LightRig.NAMES[id]))
		return
	var si := shot_now_index()
	_do(func():
		if id == "":
			_shot_shots()[si].erase("light")
		else:
			_shot_shots()[si]["light"] = id)
	_light_apply()
	_say("%s on %s: %s (Ctrl+Z takes it back)" % ["default lights" if id == "" else LightRig.NAMES[id], _shot_shots()[si]["name"], "the stage's two lights" if id == "" else LightRig.tip(id)])


func _shot_commands(add: Callable) -> void:
