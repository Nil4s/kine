## BODY: SMOOTH (BODY tab "Body: smooth", Easy's "Smooth body"): the figure is drawn by a smooth human mesh on the same
## skeleton (assets/body_smooth.glb, Quaternius UBC, CC0) instead of the mannequin; the mannequin is the default.
## One undo step (the choice is view state, undone like His colour). Saved bodies stay the mannequin's: a body mesh
## applied with Model > Apply, and the painted weights, belong to the mannequin's vertices (weights: their own sidecar).
func _body_smooth_toggle() -> void:
	if body_skin == null:
		_say("body: the body is not there yet")
		return
	if wp_on:
		_say("Body: smooth cannot change while Weight paint is on: leave it first")
		return
	if _body_edited():
		_say("Body: this body's mesh was changed with Model > Apply: it belongs to the mannequin. Undo the change first (Ctrl+Z) to switch")
		return
	_step_hint = "Body: smooth" if not Overlays.smooth else "Body: mannequin"
	_push_undo()
	_body_smooth_set(not Overlays.smooth)
	_doc_line()
	if easy.on:
		_say_plain("The body is %s now. Press again to switch; Undo gives the old one back." % ("smooth" if Overlays.smooth else "the mannequin"))
	else:
		_say("body: %s (Ctrl+Z gives the old one back)" % ("smooth" if Overlays.smooth else "the mannequin"))


## true when Model > Apply wrote a mesh onto the fighter (BaseBody keeps generations; 0 = the shipped one)
func _body_edited() -> bool:
	return has_meta(BaseBody.META_GENS) and BaseBody.gen(self) != 0


## the figure rebuilt on the chosen mesh (the same lines as _body: the pieces, the weights, the corrective, DQ skinning,
## the pick). No undo step: _body_smooth_toggle and _restore make it.
func _body_smooth_set(on: bool) -> void:
	if body_skin == null or man_root == null or on == Overlays.smooth:
		return
	Overlays.smooth = on
	var shown := man_root.visible
	man_root.get_parent().remove_child(man_root)
	man_root.free()
	var mq := Overlays.mannequin(self, body_skin)
	man_root = mq[0]
	skel = mq[1]
	bone_idx = mq[2]
	man_root.visible = shown
	pieces = Overlays.split_parts(mq[0], skel, bone_idx)
	face_geo = {}   # the face's anchors are read again from the new head piece
	_outline_off.clear()
	wp_key = "body_smooth" if on else "mannequin"   # the painted weights are the mesh's own: a sidecar per body
	wp_bind = -1
	_wp_setup()
	corr.attach(pieces.values(), skel)
	stretch_skin.attach(pieces.values(), skel, bone_idx, corr)
	dq_skin_pass.skin = null   # (DqSkin keeps the first skin it saw)
	dq_skin_pass.attach(pieces.values(), skel)
	_skp_build()
	if shading.mode != "solid":
		shading.set_mode(self, shading.mode)
	photomat.sync_body()
	_refresh()


## the outline's colour is a token (the light palette has a deeper one); _retheme calls this
func _body_look_tint() -> void:
	if _body_outline != null:
		_body_outline.set_shader_parameter("colour", Tok.c("body_outline"))


## a part wearing a pick / hover / limit tint has no outline: the tint is the line there, and its hull never covers it
func _body_outline_parts(looks: Dictionary) -> void:
	for j in pieces:
		var off: bool = looks.has(j)
		if off != _outline_off.has(j):
			(pieces[j] as MeshInstance3D).set_instance_shader_parameter("outline_on", 0.0 if off else 1.0)
			if off:
				_outline_off[j] = true
			else:
				_outline_off.erase(j)


## the body look is the editor view's: a shot with a lighting preset is lit as a picture, so its body wears no sky line
func _body_outline_show(on: bool) -> void:
	if body_skin == null:
		return
	body_skin.next_pass = _body_outline if on else null
	light_key.shadow_enabled = not on   # the soft look has none (acne on the skinned mesh); a rig's key casts its own
	body_skin.rim_enabled = on   # nor its soft rim, nor SSAO and the soft penumbra: the rig's own lights are the picture
	_body_look_on = on
	body_skin.roughness = 0.92 if on else 0.55   # and the skin it had before look D (the clay's brighter albedo flattens a rim light's edge)
	body_skin.metallic_specular = 0.25 if on else 0.5
	_body_colour_show()
	world_env.ssao_enabled = on
	for L in [light_key, light_rim, light_fill]:
		L.light_angular_distance = 4.0 if (on and L == light_key) else 0.0


func _body_colour_show() -> void:
	if body_skin != null:
		body_skin.albedo_color = BODY_SKIN_PRE_D if (body_colour == 0 and not _body_look_on) else BODY_COLOURS[body_colour][1]


## Copies in a row (M3): ROW_N copies of the picked prop beside it, along its own x axis, on the floor; one undo step. Still
## copies of a kind are drawn as one shape (scripts/prop_instances.gd); a moving prop is refused (its copies would not move)
func _prop_copies_row() -> void:
	if sel_prop < 0 or sel_prop >= S.props.size():
		_say_plain("pick a prop first: click it in the view (or Add prop), then Copies in a row")
		return
	if Props.animated(S.props[sel_prop]) or Props.hinged(S.props[sel_prop]):
		_say_plain("a moving prop (keys or a hinge) is not copied in a row: its copies would not move with it")
		return
	_push_undo()
	var copies := PropInstances.row(S.props, sel_prop)
	S.props.append_array(copies)
	_props_show()
	_doc_line()
	_say_plain("%d copies of the %s in a row beside it, on the floor; Ctrl+Z takes them back" % [copies.size(), _prop_name(sel_prop)])


func _prop_del() -> void:
	if sel_prop < 0 or sel_prop >= S.props.size():
		return
	if _outl_locked_say(sel_prop):
		return
	_push_undo()
	var nm := _prop_name(sel_prop)
	S.props.remove_at(sel_prop)
	Outliner.prop_removed(S, sel_prop)   # L36: the parents / hide / lock follow the new numbers
	for c in S.cards:   # UU2: the cards' take / drop marks follow the props' new numbers
		if c.has("take"):
			if int(c["take"]["prop"]) == sel_prop:
				c.erase("take")
			elif int(c["take"]["prop"]) > sel_prop:
				c["take"]["prop"] = int(c["take"]["prop"]) - 1
		if c.has("drop"):
			if int(c["drop"]) == sel_prop:
				c.erase("drop")
			elif int(c["drop"]) > sel_prop:
				c["drop"] = int(c["drop"]) - 1
	sel_prop = -1
	_props_show()
	_doc_line()
	_say("deleted the %s: Ctrl+Z puts it back" % nm)


## APROP: EASY PICK UP. The picked Part (a cup you built) leaves the scene and goes into his right hand, as Give to a character
## does: one undo step. Only a Part is picked up for now (a built-in prop has no hand shape); a full hand is said, not dropped
func _prop_pick_up() -> void:
	if sel_prop < 0 or sel_prop >= S.props.size():   # nothing picked: the first built part in the scene is the one
		for k in S.props.size():
			if PartWeapon.is_part(String(S.props[k]["kind"])):
				sel_prop = k
				break
	if sel_prop < 0 or sel_prop >= S.props.size():
		_say("nothing to pick up: build a part and Give it, or Use in a scene first")
		return
	var kind := String(S.props[sel_prop]["kind"])
	if not PartWeapon.is_part(kind):
		_say("Pick up works on a part you built (a cup, a sword...) for now: the %s stays where it is" % _prop_name(sel_prop))
		return
	if B.wep_on:
		_say("his hand is full: Drop it first, then Pick up")
		return
	_push_undo()
	var nm := _prop_name(sel_prop)
	var i := sel_prop
	S.props.remove_at(i)
	for c in S.cards:   # the cards' take / drop marks follow the props' new numbers (as Delete does)
		if c.has("take"):
			if int(c["take"]["prop"]) == i:
				c.erase("take")
			elif int(c["take"]["prop"]) > i:
				c["take"]["prop"] = int(c["take"]["prop"]) - 1
		if c.has("drop"):
			if int(c["drop"]) == i:
				c.erase("drop")
			elif int(c["drop"]) > i:
				c["drop"] = int(c["drop"]) - 1
	B.wep2_on = false
	B.set_kind(kind)
	B.weapon_to_hand("hand_r")
	sel = "bat_handle"
	sel_prop = -1
	_after_edit()
	_props_show()
	_doc_line()
	_say("picked up the %s: it is in his right hand. Ctrl+Z puts it back in the scene" % nm)


## SIT HERE (TT3, #205): a new card after the picked one: the body faces away from the seat's back (the prop's +Z),
## its hips just behind the seat's middle, thighs level and shins down; grounding on the set lifts the thighs onto the
## seat; a foot left hanging is planted on the floor. One undo step; a pose that still goes into the seat is said
func _prop_sit() -> void:
	if sel_prop < 0 or not String(S.props[sel_prop]["kind"]) in SIT_ON:
		return
	_push_undo()
	var p: Dictionary = S.props[sel_prop]
	var xf: Transform3D = p["xf"]
	var fwd: Vector3 = (xf.basis * Vector3(0, 0, 1)).normalized()
	var sup: Dictionary = Props.supports(p)[0]
	var seat: Vector3 = (sup["xf"] as Transform3D) * Vector3((sup["c"] as Vector2).x, 0.0, (sup["c"] as Vector2).y)
	var at := seat - fwd * 0.05
	var a: Dictionary = B.state()
	B.set_ang("pelvis", Vector3(0, 0, rad_to_deg(atan2(fwd.x, fwd.z))))
	for sd in ["_l", "_r"]:
		B.set_ang("thigh" + sd, Vector3(90, 0, 0))
		B.set_ang("calf" + sd, Vector3(90, 0, 0))
	B.offset = Vector3(at.x - (B.p0["pelvis"] as Vector3).x, B.offset.y, at.z - (B.p0["pelvis"] as Vector3).z)
	B.fk()
	B.props = S.props
	B.ground()
	for sd in ["_l", "_r"]:   # a foot hanging (a high stool): onto the floor
		var fs := B.foot_state(sd)
		if not fs[2]:
			var ball: Vector3 = fs[0]
			B.plant(sd, Vector3(ball.x, (B.p0["ball" + sd] as Vector3).y, ball.z), fs[1], true)
	_use_card("sit on the %s" % _prop_name(sel_prop), a)


## ---- SIT DOWN / STAND UP / GET UP FROM THE FLOOR (ROADMAP 94; the keys are made in scripts/rise.gd)
## each adds a run of cards after the picked one as ONE undo step; a refusal says what to pick
func _rise_prop_ok(verb: String) -> bool:
	if actor_on != 0:
		_say("%s works on the hero's scene: press Actor: switch to the next fighter until the hero is on screen" % verb)
		return false
	if sel_prop < 0 or sel_prop >= S.props.size() or not String(S.props[sel_prop]["kind"]) in SIT_ON:
		_say("%s needs a chair, a stool or a bench: pick one in the view (Add prop puts one in the set), then %s again" % [verb, verb])
		return false
	return true


func _rise_add(r: Dictionary, flags: Dictionary) -> void:
	var at := sel_card + 1 if sel_card >= 0 else S.cards.size()
	var first := at
	_do(func():
		var i := at
		for c in r["cards"]:
			S.add(c["name"], c["pose"], i)
			var cd: Dictionary = S.cards[mini(i, S.cards.size() - 1)]
			cd["move"] = c["move"] if i > at else 0.5   # the way in to the run is a short half second
			cd["hold"] = 0.0
			if not (c["plant"] as Array).is_empty():
				cd["plant"] = c["plant"]
			if c.has("ease"):
				cd["ease"] = c["ease"]
			i += 1
		for k in flags:
			S.set(k, flags[k])
		sel_card = first
		playhead = S.times()[sel_card][1]
		_rebuild_cards()
		S.apply(B, playhead))


## WALK TO A CHAIR AND SIT (easy_home's walk_to_sit): the walk's cards then the sit run, appended after the last card as ONE undo
## step. Each card keeps its own move (a card with none, -1, takes a half second: the way in from the clip's end)
func _walk_sit_add(cards: Array) -> void:
	var at := S.cards.size()
	_do(func():
		var i := at
		for c in cards:
			S.add(c["name"], c["pose"], i)
			var cd: Dictionary = S.cards[i]
			cd["move"] = c["move"] if (i > at and float(c["move"]) >= 0.0) else 0.5
			cd["hold"] = c["hold"]
			for k in ["plant", "ease", "steps", "lift", "walk"]:
				if c.has(k):
					cd[k] = c[k]
			i += 1
		sel_card = S.cards.size() - 1
		playhead = S.times()[sel_card][1]
		_rebuild_cards()
		S.apply(B, playhead))


func _rise_sit_down() -> void:
	if not _rise_prop_ok("Sit down"):
		return
	var keep: Dictionary = B.state()
	var r := Rise.sit_down(B, S.props[sel_prop])
	B.set_state(keep)
	var n: int = (r["cards"] as Array).size()
	_rise_add(r, {})
	_say("added %d cards: the body sits down on the %s in %.1f s, feet planted. Ctrl+Z takes the whole run back" % [n, _prop_name(sel_prop), Rise.DUR])


func _rise_stand_up() -> void:
	if not _rise_prop_ok("Stand up"):
		return
	var keep: Dictionary = B.state()
	var r := Rise.stand_up(B, S.props[sel_prop])
	B.set_state(keep)
	var n: int = (r["cards"] as Array).size()
	_rise_add(r, {})
	_say("added %d cards: the body stands up from the %s in %.1f s (trunk %.0f deg forward at seat-off, feet planted). Ctrl+Z takes the whole run back" % [n, _prop_name(sel_prop), Rise.DUR, Rise.TRUNK_PEAK])


func _rise_get_up() -> void:
	if actor_on != 0:
		_say("Get up works on the hero's scene: press Actor: switch to the next fighter until the hero is on screen")
		return
	var keep: Dictionary = B.state()
	var p: Vector3 = B.P["pelvis"]
	var r := Rise.get_up(B, Vector2(p.x, p.z))
	B.set_state(keep)
	var n: int = (r["cards"] as Array).size()
	_rise_add(r, r["report"]["scene"])
	_say("added %d cards: lying on the back, rolled to the side, hands and knees, half-kneel, stand (%.0f s). This scene now plays with natural and floor grounding off (the lifts are in the cards). Ctrl+Z takes it all back" % [n, Rise.FLOOR_DUR])


## STEP UP (TT3, #205): a new card: the foot nearer the picked box / step / stairs stands on its lowest top, 12 cm in
## from the edge nearest the body; the other stays. A top out of the leg's reach is refused in words, nothing changed
func _prop_step() -> void:
	if sel_prop < 0 or not String(S.props[sel_prop]["kind"]) in STEP_ON:
		return
	var p: Dictionary = S.props[sel_prop]
	var hips: Vector3 = B.P["pelvis"]
	var best := {}
	for s in Props.supports(p):   # the lowest top (the stairs: the first step)
		if best.is_empty() or float(s["y"]) < float(best["y"]):
			best = s
	var sx: Transform3D = best["xf"]
	var c: Vector2 = best["c"]
	var h: Vector2 = best["half"]
	var lh := sx.affine_inverse() * hips
	var inset := Vector2(minf(0.12, h.x), minf(0.12, h.y))
	var lp := Vector2(clampf(lh.x, c.x - h.x + inset.x, c.x + h.x - inset.x), clampf(lh.z, c.y - h.y + inset.y, c.y + h.y - inset.y))
	var top: float = best["y"]
	var sd := "_l" if (B.P["ball_l"] as Vector3).distance_to(sx * Vector3(lp.x, top, lp.y)) < (B.P["ball_r"] as Vector3).distance_to(sx * Vector3(lp.x, top, lp.y)) else "_r"
	var target := sx * Vector3(lp.x, 0.0, lp.y)
	target.y = top + (B.p0["ball" + sd] as Vector3).y
	_push_undo()
	var a: Dictionary = B.state()
	var miss := B.plant(sd, target, B.foot_state(sd)[1], true)
	if miss > 0.02:
		B.set_state(a)
		undo.pop_back()
		_history_rows()
		_refresh()
		_say("the %s's top is out of the foot's reach (it misses by %.0f cm): move it closer to the feet, then Step up again" % [_prop_name(sel_prop), miss * 100.0])
		return
	_use_card("step up on the %s" % _prop_name(sel_prop), a)


## PICK UP (UU2, #206): on the selected card, the hand(s) within REACH of the picked prop hold it from that card's
## arrival on (a box or a crate in both hands when both are near). Out of reach: said with the distance, nothing
## changed. One undo step. The grip is where the prop is in the hand(s) on this card: nothing else is stored
func _prop_take() -> void:
	if sel_prop < 0 or sel_prop >= S.props.size() or sel_card < 0:
		return
	var p: Dictionary = S.props[sel_prop]
	_ps().apply(B, S.times()[sel_card][1])
	if PartScene.pick_up_card(self, sel_prop):   # F146: a built part out of his hands: a card where his right hand goes to its grip
		return
	var gap := {}
	for sd in ["_l", "_r"]:
		var c := B.cap("hand" + sd)
		var best := INF
		for pt in Props._samples(c[0], c[1]):
			for sw in Props.solids(p):
				best = minf(best, Props._sd(sw, pt))
		gap[sd] = best - float(B.rad["hand" + sd])
	var near: Array = ["_l", "_r"].filter(func(sd): return float(gap[sd]) <= REACH)
	if near.is_empty():
		_say("the hands are %.0f cm from the %s on card %d (a hand must be within %.0f cm): pose a hand next to it on this card, then Pick up" % [
			minf(gap["_l"], gap["_r"]) * 100.0, _prop_name(sel_prop), sel_card + 1, REACH * 100.0])
		return
	if near.size() == 2 and not String(p["kind"]) in TWO_HANDS:
		near = ["_l"] if float(gap["_l"]) < float(gap["_r"]) else ["_r"]
	_push_undo()
	S.cards[sel_card]["take"] = {"prop": sel_prop, "hands": near}
	_rebuild_cards()
	_props_show()
	_refresh()
	_doc_line()
	_say("card %d: %s the %s from here on; Put down on a later card lets it go. Ctrl+Z takes it back" % [sel_card + 1,
		"both hands hold" if near.size() == 2 else ("the left hand holds" if near[0] == "_l" else "the right hand holds"), _prop_name(sel_prop)])


## the carry going on at card k's arrival (taken on an earlier card, not yet let go): {} = none
func _held_at(k: int) -> Dictionary:
	if k < 0:
		return {}
	for c in S.carries():
		if int(c["a"]) < k and (int(c["b"]) < 0 or int(c["b"]) >= k):
			return c
	return {}


## PUT DOWN (UU3): the hands let the held prop go at the selected card; it falls onto what is under it
func _prop_put() -> void:
	var c := _held_at(sel_card)
	if c.is_empty():
		return
	_push_undo()
	var pi: int = c["prop"]
	for k in range(int(c["a"]) + 1, S.cards.size()):   # one drop per carry: an earlier or later one moves here
		if int(S.cards[k].get("drop", -1)) == pi:
			S.cards[k].erase("drop")
			S.cards[k].erase("drop_rig")
	S.cards[sel_card]["drop"] = pi
	S.bake_drop(B, sel_card)   # ROADMAP 85: a sword let go over the floor falls as a rigid body, baked on this card
	_rebuild_cards()
	_props_show()
	_refresh()
	_doc_line()
	var d: Dictionary = {}
	var cs := S.carries()
	for k in cs.size():
		if int(cs[k]["a"]) == int(c["a"]):
			d = S._carry_data(B)[k]
	if d.has("rig"):   # ROADMAP 85: a rod falls as a rigid body; its baked fall ends where it lies
		var n := int((d["rig"]["poses"] as PackedFloat64Array).size() / 7)
		_say("card %d: the hands let the %s go; it falls as a rigid body and lies on the floor after %s. Ctrl+Z takes it back" % [
			sel_card + 1, _prop_name(pi), Units.time(float(n - 1) * RigidDrop.DT, S.fps)])
		return
	var h := float(d.get("drop", Transform3D()).origin.y) - float(d.get("land", 0.0)) if d.has("drop") else 0.0
	_say("card %d: the hands let the %s go; it falls %.0f cm in %s onto %s. Ctrl+Z takes it back" % [sel_card + 1, _prop_name(pi),
		h * 100.0, Units.time(float(d.get("tf", 0.0)), S.fps), "the floor" if float(d.get("land", 0.0)) < 0.001 else "what is under it"])


## the set as it is at the playhead: carried props in the hands, dropped ones falling (every frame while any card
## carries; the stored props are their homes)
func _props_pose() -> void:
	if ui_props_root == null or (S.carries().is_empty() and not Props.any_animated(S.props)):
		return
	var pa := _ps().props_at(playhead, B) if _ps() == S else S.props_at(playhead, B)
