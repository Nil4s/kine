## the frame data of the scene as it is now (a fresh body: the live one is not moved). Made again only when the cards,
## the dummy or the frame rate change
func _fd_key() -> String:
	return "%d|%s|%s|%s|%s" % [fd_fps, str(S.cards.hash()), var_to_str(T.xf) if dummy_on else "-", var_to_str(S.boxes), "" if dummy_on else FrameAdvantage.app_key(self)]


## _fd_data() for the redraw (checkslice): the cached data at once; when the scene changed, a worker thread makes the new one on a clone
## and a body of its own (the strip shows the old data meanwhile, then redraws); the dummy / two-fighter cases make it in one go as before
var _fd_job := ""
var _fd_gen := 0

func _fd_data_bg() -> Dictionary:
	var key := _fd_key()
	if String(fd_cache.get("key", "")) == key:
		return fd_cache["fd"]
	if actors_rt.size() >= 2:
		return _fd_data()
	if _fd_job != key:
		_fd_job = key
		_fd_start(key)
	return fd_cache.get("fd", {})


func _fd_start(key: String) -> void:
	_fd_gen += 1
	var gen := _fd_gen
	var C: Scene = S.clone()
	var fps := fd_fps
	var dm := {"dist": T.dist, "yaw": T.yaw, "xf": T.xf, "st": T.D.state()} if dummy_on else {}   # the dummy it stands by, copied for the thread
	var box := []
	var thr := Thread.new()
	thr.start(func():
		var Bc := EventQuery._new_body()
		Bc.from_dict(JSON.parse_string(FileAccess.get_file_as_string("res://poses/stand.json")))
		Bc.ground()
		var Dm: Dummy = null
		if not dm.is_empty():
			Dm = Dummy.new()
			Dm.place(dm["dist"], dm["yaw"])
			Dm.xf = dm["xf"]
			Dm.D.set_state(dm["st"])
		var fdw := FrameData.analyze(C, Bc, fps, Dm)
		CancelWindows.attach(fdw, C, Bc)   # N081: the cancel windows ride with the frame data
		box.append(fdw))
	_bg_live.append(thr)   # waited for if the app quits first
	while thr.is_alive():
		await get_tree().process_frame
	thr.wait_to_finish()
	_bg_live.erase(thr)
	if gen != _fd_gen or box.is_empty() or _fd_key() != key:
		if gen == _fd_gen:
			_fd_job = ""
		return
	fd_cache = {"key": key, "fd": box[0]}
	_fd_job = ""
	_refresh()


func _fd_data() -> Dictionary:
	var key := _fd_key()
	if String(fd_cache.get("key", "")) != key:
		if _force_body == null:   # I16b: the skeleton is read once, not at every score
			_force_body = Body.new()
			_force_body.load_files("res://data/skeleton.json", "res://data/body_limits.json")
		var Bc: Body = _force_body
		Bc.from_dict(JSON.parse_string(FileAccess.get_file_as_string("res://poses/stand.json")))
		Bc.ground()
		var fdx := {} if dummy_on else FrameAdvantage.app_fd(self, Bc, fd_fps)   # N080: two fighters: hitstun / advantage as well
		fd_cache = {"key": key, "fd": fdx if not fdx.is_empty() else FrameData.analyze(S, Bc, fd_fps, T if dummy_on else null)}
		CancelWindows.attach(fd_cache["fd"], S, Bc)   # N081
	return fd_cache["fd"]


## ROADMAP 99: while a scene plays, redraw the whole timeline only when something on it besides the playhead moved
## (the key below: the edit counter, the cards and their times, the selection, the size and zoom, the palette ...);
## otherwise only the playhead overlay (Timeline.playhead_redraw). Not playing: always the whole timeline, as before.
var _tl_key := []


func _tl_play_redraw() -> void:
	if not playing:
		_tl_key = []
		ui_timeline.queue_redraw()
		return
	var key := [_dm_gen, S, S.cards.size(), S.times(), sel_card, S.length(), ui_timeline.size, ui_timeline.pps(), ui_timeline.x_of(0.0), auto_key,
		Tok.c("tl_bg"), Tok.c("ink"), fd_cache.get("key", null), ui_timeline.fd.size(), ui_timeline.bx.size(), ui_timeline.sp.size(), ui_timeline.ph.size(), ui_timeline.bf.size(), ui_timeline.bf_grid.size(), ui_timeline.dk.size(), ui_timeline.rd.size(), ui_timeline.sh.size(), ui_timeline.bk.size(), ui_timeline.rh.size(), ui_timeline.ph_sel, fd_on,
		vdiff.size(), pv_in, pv_out, S.markers.size(), S.audio_tracks.size(), ui_timeline.clip_px(), _tl_under_ruler(),
		shot_now_index(), S.clips.hash(), clips_ui.sel if clips_ui != null else -1, findings_live(), findings.size(), audio_pick, audio_envs.size()]   # what the strip draws that is not the playhead's line: the lit shot, the clips, the pick, the marks
	if key == _tl_key:
		ui_timeline.playhead_redraw()
		return
	_tl_key = key
	ui_timeline.queue_redraw()


## the strip and the boxes for this refresh (both off: nothing is analysed)
func _fd_refresh() -> void:
	if ui_timeline != null:
		var before := _tl_under_ruler()
		ui_timeline.fd = _fd_data_bg() if fd_on and not S.cards.is_empty() else {}
		ui_timeline.sp = LimbIK.space_lane(S.ik, S.length()) if not S.ik.is_empty() else []   # ROADMAP 63: the space segments
		ui_timeline.bx = HitBoxes.lanes(S.boxes, float(fd_fps)) if not S.boxes.is_empty() and not S.cards.is_empty() else []   # ROADMAP 36: the boxes lane
		if before != _tl_under_ruler() or not is_equal_approx(_iq_seen, ui_timeline.iq_px()):
			_iq_seen = ui_timeline.iq_px()
			_tl_height()
			_layout_bottom()   # the panel makes room for the frame strip and the lane, or gives it back
		if not PerfStub.skip("timeline"):
			_tl_play_redraw()
	if not fd_boxes or S.cards.is_empty():
		if fd_node != null:
			fd_node.visible = false
		return
	var fd := _fd_data_bg()
	if fd.is_empty():   # still being made: the boxes come with the redraw that ends the job
		if fd_node != null:
			fd_node.visible = false
		return
	var fr: Dictionary = FrameData.frame_at(fd, playhead)
	var groups := [[fr["hurtboxes"], Color(0.6, 0.7, 0.85)]]
	var auto_hits := []   # the auto-detected hitboxes (active frames) and the user's own hit boxes (any frame, ROADMAP 36)
	var own_hits := []
	for c in fr["hitboxes"]:
		(own_hits if c.has("src") else auto_hits).append(c)
	if fr["active"]:
		groups.append([auto_hits, Color(1.0, 0.3, 0.25)])
	if not own_hits.is_empty():
		groups.append([own_hits, Color(1.0, 0.75, 0.2)])
	if fd_node == null:
		fd_node = MeshInstance3D.new()
		var m := StandardMaterial3D.new()
		m.vertex_color_use_as_albedo = true
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.no_depth_test = true
		fd_node.material_override = m
		add_child(fd_node)
	fd_node.mesh = FrameData.wire(groups)
	fd_node.visible = true


