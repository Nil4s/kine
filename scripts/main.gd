const EXAMPLES := [["walk", "res://scenes/walk_bat.json"], ["swing", "res://scenes/swing_fore.json"], ["dodge", "res://scenes/dodge_side.json"]]


func _open_example(path: String) -> void:
	_load_scene(path)
	scene_path = ""
	S.name = path.get_file().get_basename() + "_mine"
	if ui_scene_name != null:
		ui_scene_name.text = S.name
	_show_open_scene()
	_rebuild_cards()
	_refresh()
	_say("example '%s' opened as a copy: press Play to watch it, change any card, Save scene keeps yours as '%s'" % [path.get_file().get_basename(), S.name])


var _cards_shown_empty := true   # what the panel was last built as: the beginner's "No clips yet" (true) or the cards
var _in_rebuild := false


func _rebuild_cards() -> void:
	_in_rebuild = true
	_cards_shown_empty = S.cards.is_empty()
	_doc_line(true)   # RR1: a load or a new scene changes the strip's name
	_in_rebuild = false
	if sel_prop >= S.props.size():
		sel_prop = -1
	_props_show()   # SS5: the scene's set
	if ui_cards == null:
		return
	_dummy_hits()   # the cards changed: the landed scene and its hits too
	ov.mark_dirty()
	wt.mark_dirty()
	if ui_browser != null:
		ui_browser.refresh()
	for c in ui_cards.get_children() + (ui_add_slot.get_children() if ui_add_slot != null else []):
		c.get_parent().remove_child(c)   # detach now: a freed card_3 would still hold its name for a frame
		c.queue_free()
	_ease_bias_armed = false   # a rebuild (pick, undo, any edit) ends the slider's drag: its next move gets its own undo step
	_sg_strip = null   # R27: the strip was emptied just above
	_layout_bottom()
	if S.cards.is_empty() and easy != null and easy.on:
		ui_cards.add_child(easy.strip_button())   # + Add pose: an empty scene's strip shows it with its tip (Easy home holds the other ways in)
		ui_cards.add_child(_label("Drag his arms and legs, then press + Add pose", 16, "text:0.55"))
	elif S.cards.is_empty():
		# THREE WAYS IN (round 26, GATES GG1, UPGRADES #47): clip the body as it is, open a scene, or an example (a copy)
		ui_cards.add_child(_label("No clips yet.  Start here:", 16, "text:0.55"))
		for st in [["Clip this pose  (Enter)", _card_add, "the body as it is now becomes clip 1; pose the next moment and clip again, then Play"],
				["Open a scene", _open_scene_popup, "pick one of your scenes from the list"]]:
			var sb := _button(st[0], st[1], st[2])
			sb.name = "start_" + ("clip" if st[0].begins_with("Clip") else "open")
			sb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			sb.add_theme_font_size_override("font_size", 13)   # fits the collapsed row (26 px)
			ui_cards.add_child(sb)
		ui_cards.add_child(_label("   or try one:", 16, "text:0.55"))
		for ex in EXAMPLES:
			var eb := _button("Example: " + ex[0], _open_example.bind(ex[1]), "open '%s' as a copy to look at and change; Save makes a new file, the example stays as it is" % ex[1].get_file().get_basename())
			eb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			eb.add_theme_font_size_override("font_size", 13)   # fits the collapsed row (26 px): the empty panel keeps its height
			ui_cards.add_child(eb)
	var ts := S.times()
	_pl_card = _play_card_idx()
	msel = msel.filter(func(k): return k >= 0 and k < S.cards.size())   # R19: an undo or a load may have shortened the strip
	var pic_rank := _pic_ranks()
	for i in S.cards.size():
		var c: Dictionary = S.cards[i]
		var pc := PanelContainer.new()
		pc.name = "card_%d" % (i + 1)   # a named scope: card_3/.../b_update (U2)
		pc.add_theme_stylebox_override("panel", _card_style(i))
		pc.custom_minimum_size = Vector2(CARD_W, 0)
		pc.set_drag_forwarding(Callable(), _card_can_drop.bind(i, pc), _card_drop.bind(i, pc))
		var v := VBoxContainer.new()   # the card's nodes are put together first and enter the tree once (ui_cards.add_child(pc) below): 37 cards entered the tree piece by piece took 12 ms
		v.add_theme_constant_override("separation", 0)
		pc.add_child(v)
		# the picture IS the pick button: the pose on the body, the number and name under it
		var easy_on: bool = easy != null and easy.on   # Easy: a picture and one plain word (the name); no number, no seconds
		var nb := _button(_easy_card_name(c["name"], i) if easy_on else "%d %s" % [i + 1, c["name"]], _card_pick_click.bind(i), "")
		nb.name = "b_pick"   # not from its text: the card's name changes
		nb.tooltip_text = ("%s  (%s).  Click shows it, double-click renames, drag moves it, right-click for more" % [_easy_card_name(c["name"], i), c["name"]]) if easy_on else "%d  %s  (at %.2f s).  Click shows it, double-click renames, drag moves it, right-click for more" % [i + 1, c["name"], ts[i][1]]
		nb.gui_input.connect(_card_title_input.bind(i, nb))   # V3: a card's name, in place
		nb.flat = true
		nb.clip_text = true
		nb.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		nb.add_theme_font_size_override("font_size", 11)
		if easy_on and c.has("from") and nb.get_combined_minimum_size().x > CARD_W:   # a plain name too wide for its card: smaller type first, then "<Move> <n>"
			var fs := 11
			while fs > 8 and nb.get_combined_minimum_size().x > CARD_W:
				fs -= 1
				nb.add_theme_font_size_override("font_size", fs)
			if nb.get_combined_minimum_size().x > CARD_W:
				nb.remove_theme_font_size_override("font_size")
				nb.text = _easy_move_label(i)
		nb.add_theme_constant_override("icon_max_width", CARD_W - 8)
		nb.add_theme_constant_override("h_separation", 0)
		nb.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
		nb.vertical_icon_alignment = VERTICAL_ALIGNMENT_TOP
		nb.expand_icon = true
		nb.custom_minimum_size = Vector2(CARD_W - 8, CARD_PIC_H + 16)
		_card_flat(nb)
		nb.set_drag_forwarding(Callable(), _card_can_drop.bind(i, nb), _card_drop.bind(i, nb))   # R18: the drag itself is _card_drag_input (6 px, a gold line); R8: a library pose can drop here
		var pkey: String = thumbs.pose_key(c["pose"])   # made once for the request and the picture
		nb.set_meta("pkey", thumbs.request_key(pkey, c["pose"], pic_rank[i]))
		var tex := thumbs.picture_of_key(pkey)
		if tex != null:
			nb.icon = tex
		# hover tools: Update and Delete (reorder is a drag, or the right-click menu)
		var tools := HBoxContainer.new()
		tools.name = "hover_tools"
		tools.visible = false
		tools.add_theme_constant_override("separation", 1)
