## checked, copied into the library (the original never changed), registered as a prop and put in the set. A
## refusal: the reason on the status line, nothing changed. Returns the importer's answer
func _import_file(path: String) -> Dictionary:
	var r: Dictionary = Importer.inspect(path)
	if not r["ok"]:
		_say("could not import %s: %s Try another .glb, or open it in Blender and export it as .glb again" % [path.get_file(), r["why"]])
		return r
	if r["kind"] == "rigged":
		CharScale.offer(self, path, r)   # C21: a character under 0.3 m or over 5 m tall: one click scales it to 1.75 m
	if r["kind"] == "rigged" and AnimImport.load_source(path)["ok"]:   # a skeleton WITH an animation: the animation import
		var o := _import_anim(path)
		return {"ok": o != "", "path": o, "why": "" if o != "" else "refused (the reason is on the status line)"}
	if r["kind"] == "rigged":   # L9: a skeleton with a skinned mesh and no animation is a CHARACTER
		var cr := CharImportApp.open(self, path, {}, true)
		if cr["ok"]:
			return {"ok": true, "path": path, "why": ""}
	if r["kind"] == "rigged":
		var aa: Dictionary = Importer.accept(path, "animation", library)
		_say(("%s has a skeleton: importing animations comes later (UPGRADES #209); it was kept in your library. To use a model as a prop, drop one without a skeleton" % path.get_file()) if aa["ok"] else "could not import %s: %s Try another .glb, or open it in Blender and export it as .glb again" % [path.get_file(), aa["why"]])
		return aa
	var a: Dictionary = Importer.accept(path, "prop", library)
	if not a["ok"]:
		_say("could not import %s: %s Try another .glb, or open it in Blender and export it as .glb again" % [path.get_file(), a["why"]])
		return a
	var kind := "my " + String(a["path"]).get_file().get_basename()
	Props.register(kind, r["aabb"], a["path"], r["scale_factor"])
	_prop_add(kind)
	_say("imported %s as a prop: it is in the set and in Add prop%s" % [path.get_file(), "" if String(r["scale_note"]) == "" else ". " + String(r["scale_note"])])
	return a


## ---- OBJ (ROADMAP_400 N01; scripts/obj_io.gd). Export: the visible body pieces SKINNED at the current pose (SkinPick's world
## positions, the ones the pick uses) plus the held weapon's solids, each as a group; written under user://exports only.
func _obj_posed_meshes() -> Array:
	var out := []
	var binds := _obj_binds()
	for j in Body.ORDER:
		if not pieces.has(j):
			continue
		var mi := pieces[j] as MeshInstance3D
		if mi == null or mi.mesh == null or not mi.visible:
			continue
		var col := _obj_color(mi)
		for si in mi.mesh.get_surface_count():
			var arr: Array = mi.mesh.surface_get_arrays(si)
			var rest: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
			var pos := _obj_skinned(mi, arr, binds)   # this piece's own vertices (a corrective shape gives it a mesh of its own), skinned as drawn
			var ix = arr[Mesh.ARRAY_INDEX]
			var idx: PackedInt32Array = ix if ix != null else PackedInt32Array(range(rest.size()))
			var uv0 = arr[Mesh.ARRAY_TEX_UV]
			var remap := {}   # a piece shares the whole body's vertex array: keep only the vertices its triangles use
			var cp := PackedVector3Array()
			var cu := PackedVector2Array()
			var ci := PackedInt32Array()
			for i in idx:
				if not remap.has(i):
					remap[i] = cp.size()
					cp.append(pos[i])
					if uv0 != null:
						cu.append((uv0 as PackedVector2Array)[i])
				ci.append(remap[i])
			var ar := []
			ar.resize(Mesh.ARRAY_MAX)
			ar[Mesh.ARRAY_VERTEX] = cp
			ar[Mesh.ARRAY_NORMAL] = ObjIO.compute_normals(cp, ci)
			if uv0 != null:
				ar[Mesh.ARRAY_TEX_UV] = cu
			ar[Mesh.ARRAY_INDEX] = ci
			var am := ArrayMesh.new()
			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, ar)
			out.append({"name": String(j) + ("" if mi.mesh.get_surface_count() == 1 else "_%d" % si), "mesh": am, "xf": Transform3D.IDENTITY, "color": col})
	var ws := []
	if B.wep_on:
		ws += [["weapon", wep_model]]
	if B.wep2_on:
		ws += [["weapon2", wep2_model]]
	for w in ws:
		for wm in (w[1] as Node3D).find_children("*", "MeshInstance3D", true, false):
			var mi := wm as MeshInstance3D
			if mi.visible and mi.mesh != null:
				out.append({"name": "%s_%s" % [w[0], mi.name], "mesh": mi.mesh, "xf": mi.global_transform if mi.is_inside_tree() else mi.transform, "color": _obj_color(mi)})
	return out


## each skin bind's matrix: the skeleton's world transform * its bone's pose in the skeleton * the bind pose
func _obj_binds() -> Array:
	var out := []
	if skp.skin == null:
		return out
	for k in skp.skin.get_bind_count():
		out.append(skel.global_transform * skel.get_bone_global_pose(skp.bind_bone[k]) * skp.skin.get_bind_pose(k))
	return out


## the vertices of a mesh surface (arrays) in world space as the skin draws them; unskinned: where the node stands
func _obj_skinned(mi: MeshInstance3D, arr: Array, binds: Array) -> PackedVector3Array:
	var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
	var out := PackedVector3Array()
	out.resize(v.size())
	var bo = arr[Mesh.ARRAY_BONES]
	var w = arr[Mesh.ARRAY_WEIGHTS]
	if binds.is_empty() or bo == null or w == null:
		var gx := mi.global_transform if mi.is_inside_tree() else mi.transform
		for i in v.size():
			out[i] = gx * v[i]
		return out
	var per: int = (bo as PackedInt32Array).size() / maxi(v.size(), 1)
	for i in v.size():
		var p := Vector3.ZERO
		for q in per:
			var x: float = (w as PackedFloat32Array)[i * per + q]
			if x > 0.0:
				p += ((binds[(bo as PackedInt32Array)[i * per + q]] as Transform3D) * v[i]) * x
		out[i] = p
	return out


func _obj_color(mi: MeshInstance3D) -> Color:
	var m: Material = mi.material_override if mi.material_override != null else (mi.get_active_material(0) if mi.mesh != null and mi.mesh.get_surface_count() > 0 else null)
	if m is StandardMaterial3D:
		var c: Color = (m as StandardMaterial3D).albedo_color
		return Color(c.r, c.g, c.b)
	return ObjIO.DEFAULT_COLOR


func _export_obj(dir := "user://exports", budget := 0) -> String:
	var ms := ExportBudget.apply_list(_obj_posed_meshes(), budget)
	var nm := safe_file(S.name if S.name != "" else "scene")
	var path := "%s/%s.obj" % [dir, nm]
	var r := ObjIO.export(ms, path)
	if not r["ok"]:
		_say_plain("NOT DONE: the .obj could not be written (%s). Check that the folder is writable, then run Deliver again" % r["why"])
		return ""
	_say_plain("exported %s.obj: %d triangles in %d groups at the playhead (metres, Y up)%s. A static mesh: for the animation use Export animation%s" % [nm, r["tris"], ms.size(), ", the held weapon included" if B.wep_on else "", ExportBudget.words() if budget > 0 else ""])
	return path


## OBJ of ONE object (DELIVER, the export dialog's OBJ with "Only the selected object"; or one entry per object): the picked
## set piece (the chair) or the body, each as its own group at its place (metres, Y up). Same objects as the .glb choice
func _export_obj_objects(dir := "res://exports", only_selected := false, budget := 0, quality := {}) -> String:
