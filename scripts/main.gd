## the take is kept first when one is running, then the tracker stops and the socket closes
func _live_end(why: String) -> void:
	if live.recording and not live_layer.is_empty():
		_live_layer_stop()
	if live.recording:
		_live_record()
	var f := live.fps()
	var lat := live.latency_ms()
	live.stop()
	_say("live: %s (posed %d frames at %.0f fps; camera to pose %.0f ms mean, %.0f ms worst)" % [why, live.frames_posed, f, lat[0], lat[1]])


## LIVE LAYER (scripts/live_layer.gd): while it records, the clip plays from where it started and only the picked joints follow
## the webcam; stop writes them as part keys on the open scene (one undo step), never a new scene
var live_layer := []        # the joints being layered; empty = an ordinary take
var _layer_grp := ""
var _layer_t0 := 0.0        # the clip time the take starts at
var _layer_ms0 := 0         # engine msec when it started


func _live_layer(grp: String) -> void:
	if not live.running:
		_say("live: start the webcam puppet first (run Live: start the webcam puppet), then layer the %s" % grp)
		return
	if live.recording and not live_layer.is_empty():
		_live_layer_stop()
		return
	if live.recording:
		_say("live: a whole-body take is recording: stop it first (Live: record / stop)")
		return
	if S.cards.size() < 2:
		_say("live: layering needs a clip to play: open or make one with at least two cards")
		return
	live_layer = (LiveLayer.GROUPS[grp] as Array).duplicate()
	_layer_grp = grp
	_layer_t0 = clampf(playhead, 0.0, S.length())
	_layer_ms0 = Time.get_ticks_msec()
	live.record_start()
	_say("live: layering the %s from %.2f s: the clip plays, act the %s. Run Live: layer %s onto this clip again to keep it" % [grp, _layer_t0, grp, grp])


func _live_layer_stop() -> Dictionary:
	live.recording = false
	var keys := LiveLayer.keys_from_take(live._take, live_layer, _layer_t0, S.length())
	live._take = []
	var grp := _layer_grp
	live_layer = []
	if keys.is_empty():
		_say("live: the %s layer was too short to keep (record at least two frames, inside the clip)" % grp)
		return {}
	_step_hint = "Live layer"
	_push_undo()
	var n := LiveLayer.apply(S, keys)
	var regripped := LiveLayer.bake_grip(S, B, keys) if PartKeys.moves_arm(keys) else 0
	_rebuild_cards()
	_ps().apply(B, playhead)
	_refresh()
	var j0: String = keys.keys()[0]
	var grip_note := ""
	if PartKeys.moves_arm(keys):
		var gr := LiveLayer.grip_report(S, B)
		_ps().apply(B, playhead)
		if int(gr["off"]) > 0:
			grip_note = "; the second hand cannot reach the weapon at %d of %d moments (up to %.0f cm off): the acted arm takes it out of the other's reach there" % [gr["off"], gr["n"], float(gr["worst"]) * 100.0]
		elif int(gr["n"]) > 0:
			grip_note = "; the second hand stays on the weapon"
	_say("live: the %s layer is kept: %d part keys on %d joints from %.2f s to %.2f s; the cards are untouched%s. Ctrl+Z undoes it" % [grp, n, keys.size(), float(keys[j0][0]["t"]), float(keys[j0][-1]["t"]), grip_note])
	return keys


func _live_record() -> void:
	if not live_layer.is_empty():
		_live_layer_stop()
		return
	if not live.running:
		_say("live: start the webcam puppet first (run Live: start the webcam puppet)")
		return
	if not live.recording:
		live.record_start()
		_say("live: recording. Press Live: record / stop again to keep the take as a new scene")
		return
	var r := live.record_stop(B)
	if not r["ok"]:
		_say("live: the take was not kept: %s (try recording again)" % r["why"])
		return
	_load_scene(r["path"], true)
	_rebuild_cards()
	_refresh()
	_say("live: the take is the new scene scenes/_wip/%s: %d frames at %.0f fps in %d cards. Check it, then move its cards like any others" % [String(r["path"]).get_file(), r["frames"], r["fps"], r["cards"]])


func _live_poll(_dt: float) -> void:
	if not live.running:
		return
	var got := live.poll(B)
	if not got.is_empty() and not live_layer.is_empty():
		# the clip plays under the take: pose it at the clip's clock, then the layered joints take the webcam's angles
		var mine := {}
		for j in live_layer:
			mine[j] = B.ang[j]
		playhead = minf(_layer_t0 + (Time.get_ticks_msec() - _layer_ms0) / 1000.0, S.length())
		_ps().apply(B, playhead)
		for j in mine:
			B.ang[j] = mine[j]
		B.fk()
		S.regrip_layered(B, playhead)   # a two-handed weapon: the second hand stays on it as the clip holds it while you act
		if playhead >= S.length():
			_live_layer_stop()
	if not got.is_empty():
		if not _live_said:
			_live_said = true
			_say("live: the body follows you")
		_refresh()
	if live.ended:
		_live_end(live.error if live.error != "" else "the tracker stopped")


## BVH IMPORT (round 41, GATES WW7): a dropped .bvh (a Poser export) becomes a NEW scene in scenes/_wip, opened. The
## work is in scripts/bvh_import.gd; a refusal puts its reason on the status line and changes nothing.
func _import_bvh(path: String) -> void:
	var bv := BvhImport.load_file(path)
	var r := BvhImport.to_scene(bv, B, 1, 1.0, safe_file(path.get_file().get_basename())) if bv["ok"] else bv
	if not r["ok"]:
		_say("could not import %s: %s. Try another .bvh, or export it again from Blender" % [path.get_file(), r["why"]])
		return
	var d: Dictionary = (r["scene"] as Scene).to_dict(B)
	d["plan"] = "BVH import of %s: %s" % [path.get_file(), r["text"]]
	var base := safe_file(String(d["scene"]))
	var out := UserPaths.w("res://scenes/_wip/%s.json" % base)
	var n := 2
	while FileAccess.file_exists(out):   # never over an earlier import: walk_2, walk_3 ...
		out = UserPaths.w("res://scenes/_wip/%s_%d.json" % [base, n])
		n += 1
	_write(out, d)
	_load_scene(out, true)
	_rebuild_cards()
	_refresh()
	_say("imported %s as scenes/_wip/%s: %s" % [path.get_file(), out.get_file(), r["text"]])


