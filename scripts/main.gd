## a clip dropped on the view at mouse position mp: the fighter under it (its skin, else the nearest body centre on screen)
func _reaction_drop(path: String, mp: Vector2) -> bool:
	_actors_sync()
	if actors_rt.size() < 2:
		_say("a reaction needs two fighters to land on: 'Actor: add a second fighter' first, then drag it onto the one who is hit")
		return false
	var k := -1
	var pa := _pick_actor(mp)
	if int(pa[0]) >= 0:
		k = int(pa[0])
	else:
		var best := 170.0
		for i in actors_rt.size():
			var W: Vector3 = _stage_xf() * (actors_rt[i]["xf"] as Transform3D) * ((actors_rt[i]["B"] as Body).P["pelvis"] as Vector3)
			if cam.is_position_behind(W):
				continue
			var d := cam.unproject_position(W).distance_to(mp)
			if d < best:
				best = d
				k = i
	if k < 0:
		_say("drop the reaction ON a fighter in the view (the one who is hit), not on empty floor: drag it again and let go over one")
		return false
	return _reaction_apply(path, k)


## the clip's cards onto fighter k at the contact time. One undo step (the struck fighter's own, as 'Hits: make the struck fighter react')
func _reaction_apply(path: String, k: int) -> bool:
	_actors_sync()
	if actors_rt.size() < 2 or k < 0 or k >= actors_rt.size():
		_say("a reaction needs two fighters to land on: 'Actor: add a second fighter' first")
		return false
	if not FileAccess.file_exists(path):
		_say("that reaction file is gone: open the picker again to list what is there")
		return false
	var clip := ReactionPicker.load_clip(path)
	var c := ReactionPicker.contact(self, k)
	var t: float = snappedf(float(c["t"]), 1.0 / float(maxi(1, (actors_rt[k]["S"] as Scene).fps)))
	_actor_go(k)
	_push_undo()
	var r := ReactionPicker.insert(S, clip, t)
	playhead = t
	_ps().apply(B, playhead)
	_rebuild_cards()
	ov.mark_dirty()
	wt.mark_dirty()
	_refresh()
	_say("%s: %d reaction cards from %s start at %s%s; Ctrl+Z takes them off" % [actors_rt[k]["name"] if k > 0 else "the hero", int(r["n"]), path.get_file().get_basename(),
		Units.time(t, S.fps), " (the contact)" if c["found"] else " (no contact in the report: the playhead)"])
	return true


## I11 FIGHT PHRASE BUILDER (scripts/fight_phrase.gd): the active fighter attacks, the other one answers. "Build" works the plan out and
## shows the defender as it would be (a blue ghost at the playhead; the cards are untouched); "Accept" writes it as ONE undo step on the
## defender (its cards from the first reaction on, and a timeline label per beat). The attacker is never touched
var fp_prev := {}   # {"scene": the defender's clone with the plan on it, "xf": its place, "k": defender, "plan"}


func _fight_pair() -> Array:
	_actors_sync()
	if actors_rt.size() != 2:
		_say("the fight phrase needs exactly two fighters: 'Actor: add a second fighter' first (the active one attacks, the other answers)")
		return []
	return [actor_on, 1 - actor_on]


func _fight_plan(a: int, d: int) -> Dictionary:
	var rel: Transform3D = (actors_rt[a]["xf"] as Transform3D).affine_inverse() * (actors_rt[d]["xf"] as Transform3D)
	return FightPhrase.plan((actors_rt[a]["S"] as Scene).clone(), (actors_rt[d]["S"] as Scene).clone(), rel)


func _fight_build() -> Dictionary:
	var pr := _fight_pair()
	if pr.is_empty():
		return {}
	var a: int = pr[0]
	var d: int = pr[1]
	var pl := _fight_plan(a, d)
	if not pl["ok"]:
		fp_prev = {}
		_say(String(pl["why"]) + ". Pick the fighter who strikes, or move the fighters closer, then try again")
		return pl
	var ds: Scene = (actors_rt[d]["S"] as Scene).clone()
	FightPhrase.apply_plan(ds, pl)
	fp_prev = {"scene": ds, "xf": actors_rt[d]["xf"], "k": d, "plan": pl}
	var first := -1.0
	for r in pl["beats"]:
		if not r["flag"]:
			first = float(r["t"])
			break
	if first >= 0.0:
		playhead = first
		_ps().apply(B, playhead)
	_refresh()
	_say("PREVIEW (blue ghost): %s.  'Fight phrase: accept the preview' writes it (Ctrl+Z undoes); change nothing to drop it" % String(pl["text"]).replace("
", "; "))
	return pl


func _fight_accept() -> bool:
	var pr := _fight_pair()
	if pr.is_empty():
		return false
	if fp_prev.is_empty():
		_say("nothing to accept: run 'Fight phrase: build the defender's answer' first and look at the ghost")
		return false
	var a: int = pr[0]
	var d: int = pr[1]
	var pl := _fight_plan(a, d)   # worked out again: whatever changed since the preview is in it
	fp_prev = {}
	if not pl["ok"]:
		_refresh()
		_say(String(pl["why"]) + ". Pick the fighter who strikes, or move the fighters closer, then try again")
		return false
	_actor_go(d)
	_push_undo()
	FightPhrase.apply_plan(S, pl)
	for r in pl["beats"]:
		if not r["flag"]:
			playhead = float(r["t"])
			break
	_ps().apply(B, playhead)
	_rebuild_cards()
	ov.mark_dirty()
	wt.mark_dirty()
	_refresh()
	_say("%s's answer is written: %s.  Ctrl+Z takes it off" % [actors_rt[d]["name"], String(pl["text"]).replace("
", "; ")])
	return true


## I14 REHEARSE AGAINST YOURSELF (scripts/rehearse.gd): "Compare with a video of me..." tracks a phone video (the R13 path: the tracker, then
## the fit on the worker), aligns the fitted take to the open clip with DTW on joint angles, and shows a panel card by card: how much
## faster / slower the move into the card was and the biggest joint differences, with the take as an orange ghost that follows the
## playhead. Nothing is written to the scene: "Use my timing" (every move retimed) and "Use my pose" (one card) are one undo step each.
## The fitted take is kept under user://rehearse/ (never scenes/).
var reh := {}                # {"take": Scene, "R": Rehearse.compare's result, "name"}
var _video_reh := false      # the tracked video is a take for the comparison, not a new scene
var ui_reh: PanelContainer = null


func _rehearse_ask() -> void:
	var fd := FileDialog.new()
	fd.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	fd.access = FileDialog.ACCESS_FILESYSTEM
	fd.filters = PackedStringArray(["*.mp4, *.mov, *.avi, *.webm, *.mkv, *.m4v ; videos"])
	fd.use_native_dialog = true
	fd.title = "A video of you doing this move"
	fd.file_selected.connect(func(p): _video_reh = true; _import_video(p); fd.queue_free())
	fd.canceled.connect(fd.queue_free)
	add_child(fd)
	fd.popup_centered(Vector2i(800, 500))


## the tracker's pose file -> the take, fitted and compared on the worker; lands in _rehearse_land
func _rehearse_from_pose(path: String, from: String) -> void:
	var P := VideoImport.load_file(path)
	if not P["ok"]:
		_say("could not compare with %s: %s; pick a video with one person, whole body in view" % [from, P["why"]])
		return
	var keep := B.state()
	var Bw := _imp_body(keep)
	var clip := S.clone()
	var base_name := safe_file(from.get_basename())
	var rt := _retarget_on()
	_imp_begin("comparing with %s" % from, func():
		var R := VideoIQ.process(Bw, P, "", base_name, rt)
		if R.is_empty():
			Bw.set_state(keep)
			return {}
		var V: Scene = R["scene"]
		var out := {"take": V, "cmp": Rehearse.compare(clip, V), "dict": V.to_dict(Bw)}
		Bw.set_state(keep)
		return out,
		func(res): _rehearse_land(res, from))


func _rehearse_land(res: Dictionary, from: String) -> void:
	if res.is_empty():
		return
	DirAccess.make_dir_recursive_absolute(OS.get_user_data_dir().path_join("rehearse"))
	var f := FileAccess.open("user://rehearse/%s.json" % safe_file(from.get_basename()), FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(res["dict"]))
		f.close()
	_rehearse_set(res["take"], res["cmp"], from)


## show a comparison (the app's path and the test's): T = the take as a Scene
func _rehearse_compare(T: Scene, from := "your take") -> Dictionary:
	if S.cards.size() < 2:
		_say("nothing to compare yet: add cards until the clip has at least two, then compare it with your video")
		return {}
	var R := Rehearse.compare(S, T)
	_rehearse_set(T, R, from)
	return R


func _rehearse_set(T: Scene, R: Dictionary, from: String) -> void:
	reh = {"take": T, "R": R, "name": from}
	_rehearse_panel()
	_refresh()
	_say("compared with %s: the orange ghost is you, the card list says where you were faster or slower and which joints differed. 'Use my timing' retimes the clip to you (one undo step)" % from)


func _rehearse_close() -> void:
	reh = {}
	if ui_reh != null:
		ui_reh.visible = false
	if ov != null:
		ov.take_ghost(null, 0.0)


## the clip changed (an edit, an undo): the same take compared again
func _rehearse_again() -> void:
	if reh.is_empty():
		return
	reh["R"] = Rehearse.compare(S, reh["take"])
	_rehearse_panel()


func _rehearse_timing() -> bool:
	if reh.is_empty():
		_say("no comparison open: run 'Compare with a video of me...' first")
		return false
	_push_undo()
	var n := Rehearse.use_timing(S, reh["R"])
	_rebuild_cards()
	ov.mark_dirty()
	wt.mark_dirty()
	_rehearse_again()
	_refresh()
	_say("the clip now keeps your timing: %d moves changed. Ctrl+Z puts the old timing back" % n)
	return true


func _rehearse_pose(i: int) -> bool:
	if reh.is_empty() or i < 0 or i >= S.cards.size():
		_say("pick a card in the comparison first, then 'Use my pose'")
		return false
	_push_undo()
	var Bw := _imp_body(B.state())
	Rehearse.use_pose(S, reh["take"], reh["R"], i, Bw)
	_rebuild_cards()
	ov.mark_dirty()
	wt.mark_dirty()
	_rehearse_again()
	_refresh()
	_say("card %d now has your pose (the 36 joint angles compared). Ctrl+Z takes it back" % (i + 1))
	return true


func _rehearse_go(i: int) -> void:
