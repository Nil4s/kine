var _rigx_root: Node3D
var _rigx_mat: StandardMaterial3D
var _rigx_dot_mat: StandardMaterial3D


## the rig drawn on the body: a capsule per bone (Tok s_hips), a dot per joint (Tok focus), at the pose now. The nodes are
## kept and reused (one capsule + one dot per bone); the ones past the count hide
func _rigx_draw() -> void:
	if _rigx_root == null:
		_rigx_root = Node3D.new()
		_rigx_root.name = "rigx"
		add_child(_rigx_root)
		_rigx_mat = StandardMaterial3D.new()
		_rigx_mat.roughness = 0.6
		_rigx_dot_mat = StandardMaterial3D.new()
		_rigx_dot_mat.roughness = 0.4
	var show := S != null and not S.rigx.is_empty() and not clean
	_rigx_root.visible = show
	if not show:
		return
	_rigx_mat.albedo_color = Tok.c("s_hips")
	_rigx_dot_mat.albedo_color = Tok.c("focus")
	var k := 0
	for c in S.rigx:
		if not B.G.has(c["parent"]):
			continue
		var pts := RigWords.points(B, c)
		var nb := (c["bones"] as Array).size()
		for i in nb:
			var f := float(i) / float(maxi(nb - 1, 1))
			var r := lerpf(float(c["r0"]), float(c["r1"]), f)
			var a := pts[i]
			var b := pts[i + 1]
			var L := a.distance_to(b)
			var cap_n := _rigx_node(k * 2, true)
			var dot_n := _rigx_node(k * 2 + 1, false)
			cap_n.visible = true
			dot_n.visible = true
			var cm := cap_n.mesh as CapsuleMesh
			var h := maxf(L, r * 2.0 + 0.001)
			if not is_equal_approx(cm.radius, r * 0.8) or not is_equal_approx(cm.height, h):
				cm.radius = r * 0.8
				cm.height = h
			var dir := (b - a).normalized()
			var q := Quaternion(Vector3.UP, dir) if dir.dot(Vector3.UP) > -0.9999 else Quaternion(Vector3.RIGHT, PI)
			cap_n.transform = Transform3D(Basis(q), (a + b) * 0.5)
			var sm := dot_n.mesh as SphereMesh
			if not is_equal_approx(sm.radius, r * 1.15):
				sm.radius = r * 1.15
				sm.height = r * 2.3
			dot_n.position = a
			k += 1
	for i in range(k * 2, _rigx_root.get_child_count()):
		(_rigx_root.get_child(i) as Node3D).visible = false


func _rigx_node(i: int, capsule: bool) -> MeshInstance3D:
	while _rigx_root.get_child_count() <= i:
		var n := MeshInstance3D.new()
		var idx := _rigx_root.get_child_count()
		if idx % 2 == 0:
			n.mesh = CapsuleMesh.new()
			n.material_override = _rigx_mat
			n.name = "bone_%d" % (idx / 2)
		else:
			n.mesh = SphereMesh.new()
			n.material_override = _rigx_dot_mat
			n.name = "joint_%d" % (idx / 2)
		_rigx_root.add_child(n)
	return _rigx_root.get_child(i) as MeshInstance3D


func _after_edit() -> void:
	part_weapon_changed(S.part)   # a Part the fighter holds takes its edit (PartWeapon)
	if not vdiff.is_empty():   # COMPARE WITH: the marks follow the open scene's edits
		_vdiff_update()
	if shoulder_follow and _arm_edit != "":   # YY5: only a hand edit of an upper arm; never a load, paste or play
		B.shoulder_follow(_arm_edit.right(2))
	_arm_edit = ""
	if symmetry:
		_mirror_changed()
	B.apply_grip()
	simc.edited()
	_refresh()


## SYMMETRY MODE (round 22, GATES CC1, UPGRADES #65): while on, an edit on one side moves its twin, reflected the way
## Copy side does (bend, side, -twist). Only the joints the edit CHANGED since the last refresh are copied, so dragging
## an arm leaves the legs as they were, and the middle (its own twin) is never touched. Runs inside the edit's own undo
## step: one Ctrl+Z takes back both sides
var symmetry := false
var shoulder_follow := true   # YY5: raising an upper arm by hand brings its collarbone (Body.shoulder_follow)
var _arm_edit := ""           # the upper arm the current slider / drag edit turned ("" = none): what follows it
var _sym_prev := {}   # the angles at the last refresh: what an edit is measured against


func _mirror_changed() -> void:
	var moved := false
	for j in Body.ORDER:
		var t := Body.twin(j)
		if t == j or not _sym_prev.has(j) or (B.ang[j] as Vector3).is_equal_approx(_sym_prev[j]):
			continue
		if not (B.ang[t] as Vector3).is_equal_approx(_sym_prev[t]):
			continue   # both sides changed (Copy side, Mirror pose, a pasted pose): the edit already set them
		var v: Vector3 = B.ang[j]
		B.ang[t] = B.clamp_ang(t, Vector3(v.x, v.y, -v.z))
		moved = true
	if moved:
		B.fk()


func _toggle_symmetry() -> void:
	symmetry = not symmetry
	_refresh()
	_say("symmetry ON: drag a part on one side and its twin on the other side follows, reflected" if symmetry else "symmetry off: each side moves on its own")


## AUTO-KEY (ROADMAP 42): while on, a pose change made at the playhead keys a card there. A card whose arrival or hold
## holds the playhead takes the body as its pose; otherwise a new card goes into the sequence at the playhead. A view
## setting: not saved, and it is not an undo step of its own (the change it keys is one step with it)
var auto_key := false
var ui_akey: Control   # the red frame round the 3D view while auto-key is on (the view's edges, Tok "autokey")


func _toggle_autokey() -> void:
	auto_key = not auto_key
	if ui_akey != null:
		ui_akey.visible = auto_key
		ui_akey.queue_redraw()
	_refresh()
	_say("Auto-key ON: changes make keys" if auto_key else "Auto-key off: changes stay in the body until you key them")


## the frame sits on the 3D view: between the side panels, under the top bar, above the status line and the timeline
func _build_akey_frame() -> void:
	ui_akey = Control.new()
	ui_akey.name = "autokey_frame"
	ui_akey.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ui_akey.visible = auto_key
	ui_akey.draw.connect(func(): ui_akey.draw_rect(Rect2(Vector2(2, 2), ui_akey.size - Vector2(4, 4)), Tok.c("autokey"), false, 4.0))   # inset: the 4 px band lies inside the view
	ui_root.add_child(ui_akey)
	ui_root.move_child(ui_akey, -1)   # drawn over the panels that touch the view's edges
	_place_akey_frame()


func _place_akey_frame() -> void:
	if ui_akey == null:
		return
	var vs := get_viewport().get_visible_rect().size
	ui_akey.offset_left = lw()
	ui_akey.offset_right = vs.x - rw()
	ui_akey.offset_top = TOP_H
	ui_akey.offset_bottom = vs.y - bottom_h - LINE_H - 6
	ui_akey.queue_redraw()


## L11: with auto-key on and a KEYING SET active (part_sets.gd), the change keys only that set's parts at the playhead, as
## part keys (no card). Returns true when it did (or the set has nothing to key); false = no active set, the old card key.
func _autokey_set() -> bool:
	var ps := PartSets.of(self)
	var nm := ps.active()
	if nm == "":
		return false
	var parts := PartSets.keyable(ps.parts_of("keying", nm))
	if S.cards.is_empty() or parts.is_empty():
		return true
	var t := clampf(playhead, 0.0, S.length())
	for j in parts:
		PartKeys.put(S.part_keys, j, t, B.ang[j])
	_say("Auto-key: keying set '%s' keyed %d parts at %s" % [nm, parts.size(), Units.time(t, S.fps)])
	return true


## L10 RETIME KEY (scripts/anim_tools.gd): card i's arrival moved by df frames, later keys rippling along or not. One undo step.
func _retime_key(i: int, df: int, ripple: bool) -> Dictionary:
	var why := AnimTools.retime_refuse(S, i, df, ripple)
	if why != "":
		_say("retime: %s" % why)
		return {"ok": false, "why": why, "frames": 0}
	_step_hint = "Retime key"
	_retime_begin()
	var r := AnimTools.retime_apply(S, i, df, ripple)
	_retime_step(true)
	_say("retime: key %d moved %+d frames%s" % [i + 1, df, " with ripple (the later keys follow)" if ripple else ", the other keys stay"])
	return r


## a change to the body at the playhead, once it is made (the undo step is already pushed: it covers the card too)
func _autokey_card() -> void:
	if not auto_key or undo.is_empty():
		return
	if undo.back().get("body") == B.state():
		return   # nothing moved: no card
	if _autokey_set():
		return   # L11: an active keying set takes the keys, as part keys on its parts only
	var ci := LimbIK.card_at(S, playhead)
	if ci >= 0:
		S.cards[ci]["pose"] = B.to_dict()
		_rebuild_cards()
		_say("Auto-key: card %d takes the body at %s" % [ci + 1, Units.time(playhead, S.fps)])
		return
	var at := S.cards.size()
	var ts := S.times()
	for i in ts.size():
		if playhead < float(ts[i][1]) - 0.001:
			at = i
			break
	var prev_end := float(ts[at - 1][2]) if at > 0 else 0.0
	S.add("auto key %d" % (S.cards.size() + 1), B.to_dict(), at)
	if at > 0:
		S.cards[at]["move"] = snappedf(maxf(0.04, playhead - prev_end), 0.001)   # the card arrives at the playhead
	sel_card = at
	_rebuild_cards()
	_refresh()
	_say("Auto-key: card %d keyed at %s" % [at + 1, Units.time(playhead, S.fps)])


func _big_view() -> void:
	big_view = not big_view
	_sides_apply()
	_say("big view: the side panels are hidden (Tab brings them back)" if big_view else "panels back")


## an undo step = the body AND the open scene's cards (10-14: a Fix or "+ tween" changes cards, so Ctrl+Z must bring
## them back). The cards come back only into the scene they were taken from: opening another scene makes them stale.
func _snapshot() -> Dictionary:
	_actors_sync()
	var H := _hero_scene()
	# TC3: tagged with the actor it was taken on, and the actors as they are (the same Body / Scene objects: an add or a
	# remove is undone by putting the list back), so _restore never puts one actor's body onto another
	return {"actor": actor_on, "hero": H, "spath": scene_path, "hero_actors": H.actors.duplicate(), "rt": actors_rt.map(func(a): return (a as Dictionary).duplicate()),
		"body": B.state(), "playhead": playhead, "pbody": S.body.duplicate(true), "scene": S,"cards": S.cards.duplicate(true), "sel": sel_card, "holds": S.moving_holds, "sway": S.sway, "sway_seed": S.sway_seed, "scurves": S.strength_curves, "fps": S.fps, "bcol": body_colour, "bsm": Overlays.smooth,
		"props": S.props.map(func(p): return Props.to_dict(p)), "pxf": S.props.map(func(p): return p["xf"]), "outl": S.outl.duplicate(true), "building": _bld_file(), "part": _part_file(), "vehicle": _vehicle_file(), "bmats": body_mats.duplicate(), "pk": S.part_keys.duplicate(true),
		"markers": S.markers.duplicate(true), "refimgs": S.refimgs.duplicate(true), "crowd": S.crowd.duplicate(true), "fitness": S.fitness, "floor_mat": S.floor_mat, "injury": S.injury.duplicate(true), "breath": S.breath, "layer": S.layer.duplicate(), "layer_w": S.layer_w,
		"layers": S.layers.duplicate(true), "ik": S.ik.duplicate(true),   # IK keys (limb_ik.gd), undone like a card
		"secondary": S.secondary.duplicate(true),   # SECONDARY MOTION (ROADMAP 26), undone like a card
		"soft": S.soft.duplicate(true),   # L22: the soft-body regions, undone like a card
		"simc": simc.meta.duplicate(true),   # L35: the sim point caches (their files follow), undone like a card
		"cape": S.cape.duplicate(true),   # the cape (ROADMAP 86), undone like a card
		"rigx": S.rigx.duplicate(true),   # the words-made rig (rig_words.gd), undone like a card
		"own_rig": S.own_rig.duplicate(true),   # OWN RIG (L73), undone like a card
		"bones": S.bones.duplicate(true),   # J01: the user's extra bones (bone_editor.gd), undone like a card
		"spline": S.spline_chains.duplicate(true),   # L28: their spline-IK chains (spline_chain.gd), undone like a card
		"hair": S.hair.duplicate(true),   # the hair strands' parameters (ROADMAP 87): undone like a card, the frames baked again
		"skin_w": SkinPaint.snapshot(wp),   # WEIGHT PAINT (ROADMAP 72): every stroke is one step, undone with the weights
		"body_gen": BaseBody.gen(self),   # G01: the body mesh applied from the model preview (scripts/base_body.gd)
		"armour": load("res://scripts/armour_from_body.gd").snap(self),   # B23: the armour parts on the fighter (scripts/armour_from_body.gd)
		"plants": S.plants.duplicate(true),   # foot plants (foot_plant.gd), undone like a card
		"drivers": S.drivers.duplicate(true),   # user drivers (drivers.gd), undone like a card
		"anykeys": S.anykeys.duplicate(true),   # L13/L15 any-property keys, undone like a card
		"audio_tracks": S.audio_tracks.duplicate(true),   # the sounds on the timeline (AudioTrack, ROADMAP 77), undone like a card
		"lip": S.lip.duplicate(true),   # the lip-sync channel (lip_sync.gd), undone like a card
		"face": S.face.duplicate(true),   # THE FACE keys (face.gd), undone like a card
		"iq": S.iq.duplicate(true),   # VIDEO IQ (video_iq.gd): the import's lane and contacts, undone with the cards
		"attrs": S.attrs.duplicate(true),   # CUSTOM ATTRIBUTES (custom_attr.gd, ROADMAP 82), undone like a card
		"beats_audio": S.beats_audio.duplicate(true),   # ROADMAP 32: the music beats, undone like a card
		"cons": S.cons.duplicate(true),   # constraints (round 51, constraints.gd), undone like a card
		"shots": H.shots.duplicate(true),   # THE SHOTS (ROADMAP 75; shot_camera.gd), the hero's, undone like a card
		"beats": H.beats.duplicate(true),   # ROADMAP 13: the exchange's beats (the hero's), undone like a card
		"notes": S.notes.duplicate(true),   # ROADMAP 29: the review notes, undone like a marker
		"sets": S.sets.duplicate(true),   # selection / keying sets (part_sets.gd), undone like a card
		"clips": S.clips.duplicate(true),   # CLIPS (clips.gd), undone like a card
		"boxes": S.boxes.duplicate(true),   # HIT / HURT BOXES (hit_boxes.gd), undone like a card
		"others": actors_rt.map(func(a): return {"S": a["S"], "cards": (a["S"] as Scene).cards.duplicate(true), "pk": (a["S"] as Scene).part_keys.duplicate(true), "attrs": (a["S"] as Scene).attrs.duplicate(true), "ik": (a["S"] as Scene).ik.duplicate(true)}),   # (I13: and their part keys and attributes: a hit-stop shifts them)
		   # ROADMAP 53: every fighter's cards (a copy writes the other one's)
		"flags": BAKE_FLAGS.map(func(f): return S.get(f))}   # DD4: the playback switches a bake turns off


const BAKE_FLAGS := ["on_floor", "pin", "spline", "stepped", "natural", "floor_body"]


## the Scene objects a step may put back whole: Walk along a path makes a new scene and registers the old and the new one
## here. Any other step belongs to the scene it was taken on and never pastes into another one (fix_window: "undo after
## opening thrust leaves thrust's cards alone"); opening / making a scene empties the list.
var swap_scenes: Array = []


## another scene is open (opened, or a new one): BUILD shows its house and the tabs of its kind; a building project opens on BUILD,
## and a scene of another kind is not left on BUILD
func _bld_scene_changed(opened: bool, caller_follows := false) -> void:   # caller_follows: a card build, whose own rebuild of the cards lays the bottom out (7 ms) and whose own refresh (2 ms) come right after
	if bld == null:
		return
	bld.sync()
	if opened and S.kind == "building" and cur_page != "BUILD":
		_page_set("BUILD")
	elif cur_page == "BUILD" and S.kind != "building":
		_page_set("POSE")
	else:
		_sides_apply()   # the kind of scene decides what the page hides (PAGE_KIND_HIDES)
		if not caller_follows:
			_layout_bottom()
		_chrome_sync()
		if tag != null and not caller_follows:
			_refresh()


## the open scene's BUILD record as the file holds it ({} = none): the undo snapshot's "building"
func _bld_file() -> Dictionary:
	return {} if S.building.is_empty() else Building.to_file(S.building)


## the open scene's PART record as the file holds it ({} = none): the undo snapshot's "part"
func _part_file() -> Dictionary:
	return {} if S.part.is_empty() else Part.to_file(S.part)


## VEHICLE (B3): the wheel's record, as an undo snapshot holds it ({} when there is no car)
func _vehicle_file() -> Dictionary:
	return Vehicle.to_file(S.vehicle)   # the wheel and the package (carpkg), as the file keeps them


func _restore(u: Dictionary) -> void:
	UndoBudget.unpack(u)   # Friday 175: an old step is stored packed
	_bake_drop(u["scene"] if u.get("scene") is Scene else null)
	if mm_ui != null:
		mm_ui.halt()   # a motion matching preview ends with the step taken back: it would play over the restored pose
	if bm_ui != null:
		bm_ui.halt()
	if sd_ui != null:
		sd_ui.halt()
	if wt_ui != null:
		wt_ui.halt()
	if pr_ui != null:
		pr_ui.halt()
	if tc_ui != null:
		tc_ui.halt()
	if tcat_ui != null:
		tcat_ui.halt()
	if if_ui != null:
		if_ui.halt()
	if bf_ui != null:
		bf_ui.halt()
	if cg_ui != null:
		cg_ui.halt()
	if style_ui != null:
		style_ui.halt()
	if bt_ui != null:
		bt_ui.halt()
	if se_ui != null:
		se_ui.halt()
	if dk_ui != null:
		dk_ui.halt()
	if rd_ui != null:
		rd_ui.halt()
	if sh_ui != null:
		sh_ui.halt()
	if gz_ui != null:
		gz_ui.halt()
	if el_ui != null:
		el_ui.halt()
	if bk_ui != null:
		bk_ui.halt()
	if rc_ui != null:
		rc_ui.halt()
	if rh_ui != null:
		rh_ui.halt()
	if pc_ui != null:
		pc_ui.halt()
	if ao_ui != null:
		ao_ui.halt()
	if fa_ui != null:
		fa_ui.halt()
	if ml_ui != null:
		ml_ui.halt()
	if sp_ui != null:
		sp_ui.halt()
	if cm_ui != null:
		cm_ui.halt()
	if feint_ui != null:
		feint_ui.pv = null
	if _actors_restore(u) or not actors_rt.is_empty():   # TC3: onto the actor the step was taken on first (its own body and scene)
		ov.mark_dirty()
		wt.mark_dirty()
		_rebuild_cards()
	if (u.get("swap", false) or swap_scenes.has(u["scene"])) and u["scene"] != S and actors_rt.is_empty() and u["scene"] is Scene:
		# a step that swapped the whole scene (Walk along a path makes a NEW scene: it marks its step "swap" and registers both scenes in
		# swap_scenes): undo/redo put that scene object back. Any other step never pastes into another scene (tests/fix_window_test.gd)
		S = u["scene"]
		scene_path = String(u.get("spath", ""))
		sel_card = -1
		if ui_scene_name != null:
			ui_scene_name.text = S.name
		ov.mark_dirty()
		wt.mark_dirty()
		_rebuild_cards()
		_show_open_scene()
	if u["scene"] == S and u.has("fps"):
		S.fps = int(u["fps"])   # WW4: the frame rate is a scene setting, undone like a card
	if u["scene"] == S and u.has("pbody") and u["pbody"] != S.body:
		S.body = u["pbody"].duplicate(true)   # PR1: the proportions, undone like a card (the body's come back in its state)
		ov.mark_dirty()
		wt.mark_dirty()
		if bld != null:
			bld.sync()   # C2: a Part dimension bound to the body follows it back
	B.set_state(u["body"])   # lossless (round 8): from_dict re-solved from the file's rounded numbers
	if u["scene"] == S and (u.get("sway", S.sway) != S.sway or u.get("sway_seed", S.sway_seed) != S.sway_seed or u.get("scurves", S.strength_curves) != S.strength_curves):
		S.sway = u.get("sway", S.sway)   # N037 / N039 scene settings, undone like a card
		S.sway_seed = u.get("sway_seed", S.sway_seed)
		S.strength_curves = u.get("scurves", S.strength_curves)
		_rebuild_cards()
	if u["scene"] == S and u.get("holds", S.moving_holds) != S.moving_holds:   # a scene setting, undone like a card
		S.moving_holds = u["holds"]
		_rebuild_cards()
	if u["scene"] == S and u.has("markers") and JSON.stringify(u["markers"]) != JSON.stringify(S.markers):
		S.markers = u["markers"].duplicate(true)   # WW5: the markers, undone like a card
		if ui_timeline != null:
			ui_timeline.queue_redraw()
	if u["scene"] == S and u.has("refimgs") and JSON.stringify(u["refimgs"]) != JSON.stringify(S.refimgs):
		S.refimgs = u["refimgs"].duplicate(true)   # the reference pictures, undone like a marker
		_refimg_sync()
	if u["scene"] == S and u.has("crowd") and var_to_str(u["crowd"]) != var_to_str(S.crowd):
		S.crowd = (u["crowd"] as Dictionary).duplicate(true)   # ROADMAP 95: the crowd, undone like a marker
	if u["scene"] == S and u.has("notes") and JSON.stringify(u["notes"]) != JSON.stringify(S.notes):
		S.notes = u["notes"].duplicate(true)   # ROADMAP 29: the review notes, undone like a marker
		if ui_timeline != null:
			ui_timeline.queue_redraw()
	if u.has("beats") and u.get("hero") == _hero_scene() and var_to_str(u["beats"]) != var_to_str(_hero_scene().beats):
		_hero_scene().beats = u["beats"].duplicate(true)   # ROADMAP 13: the beats, undone like a card
		if ui_choreo != null and is_instance_valid(ui_choreo.win):
			ui_choreo.refresh()
	if u["scene"] == S and u.has("outl") and var_to_str(u["outl"]) != var_to_str(S.outl):
		S.outl = u["outl"].duplicate(true)   # L36: parents, hide and lock, undone like a card
		_props_show()
		if ui_browser != null:
			ui_browser.refresh()
	var _cur_props: Array = S.props.map(func(p): return Props.to_dict(p)) if u["scene"] == S and u.has("props") else []
	if u["scene"] == S and u.has("props") and u["props"] != _cur_props:   # L58: a native deep compare (was two JSON.stringify of the whole set)
		var old_props: Array = S.props
		var ups: Array = u["props"]
		var np: Array = []
		for k in ups.size():   # the set, undone like a card (SS5); a prop that did not change keeps its record (and so its drawn node)
			if k < old_props.size() and k < _cur_props.size() and ups[k] == _cur_props[k]:
				np.append(old_props[k])
			else:
				np.append(Props.from_dict(ups[k]))
		S.props = np
		var exact := false
		if u.has("pxf") and (u["pxf"] as Array).size() == S.props.size():
			for k in S.props.size():
				S.props[k]["xf"] = u["pxf"][k]   # L36: the exact places (the file form keeps 1e-4), so a parent's children undo exactly
			exact = true
		if sel_prop >= S.props.size():
			sel_prop = -1
		_props_show(not exact)   # L58: the saved places are already at rest: nothing is settled again
	if u["scene"] == S and u.has("building") and JSON.stringify(u["building"]) != JSON.stringify(_bld_file()):
		S.building = Building.from_file(u["building"])   # BUILD: the house, undone like a card
		if bld != null:
			bld.sync()
	if u["scene"] == S and u.has("part") and JSON.stringify(u["part"]) != JSON.stringify(_part_file()):
		S.part = Part.from_file(u["part"])   # PART: the feature timeline, undone like a card
		if bld != null:
			bld.sync()
	if u["scene"] == S and u.has("vehicle") and JSON.stringify(u["vehicle"]) != JSON.stringify(_vehicle_file()):
		S.vehicle = Vehicle.from_file(u["vehicle"])   # VEHICLE: the wheel, undone like a card
	if u.has("bcol") and int(u["bcol"]) != body_colour:
		body_colour = int(u["bcol"])   # His colour, undone like the photo materials
		_body_colour_show()
	if u.has("bsm") and bool(u["bsm"]) != Overlays.smooth:
		_body_smooth_set(bool(u["bsm"]))   # Body: smooth, undone like His colour
	if u.has("bmats") and var_to_str(u["bmats"]) != var_to_str(body_mats):
		body_mats = u["bmats"].duplicate()   # the photo materials on body parts, undone like a card (E15)
		photomat.sync_body()
	if u["scene"] == S and u.has("pk"):
		S.part_keys = u["pk"].duplicate(true)   # PART KEYS (WW1), undone like a card
	if u["scene"] == S and u.has("iq") and var_to_str(u["iq"]) != var_to_str(S.iq):
		S.iq = u["iq"].duplicate(true)   # VIDEO IQ, undone like a card
	if u["scene"] == S and u.has("attrs") and var_to_str(u["attrs"]) != var_to_str(S.attrs):
		S.attrs = u["attrs"].duplicate(true)   # CUSTOM ATTRIBUTES (ROADMAP 82), undone like a card
		_attr_sig = ""
		_attr_refresh()   # the rows of an undone add go, and come back on redo, without waiting for the next refresh
	if u["scene"] == S and u.has("secondary") and var_to_str(u["secondary"]) != var_to_str(S.secondary):
		S.secondary = u["secondary"].duplicate(true)   # SECONDARY MOTION (ROADMAP 26), undone like a card
	if u["scene"] == S and u.has("soft") and var_to_str(u["soft"]) != var_to_str(S.soft):
		S.soft = u["soft"].duplicate(true)   # L22: the soft-body regions, undone like a card
	if u["scene"] == S and u.has("simc") and var_to_str(u["simc"]) != var_to_str(simc.meta):
		simc.apply_meta(u["simc"])   # L35: the sim point caches, undone like a card
	if u["scene"] == S and u.has("cape") and var_to_str(u["cape"]) != var_to_str(S.cape):
		S.cape = u["cape"].duplicate(true)   # the cape (ROADMAP 86), undone like a card
	if u["scene"] == S and u.has("rigx") and var_to_str(u["rigx"]) != var_to_str(S.rigx):
		S.rigx = u["rigx"].duplicate(true)   # RIG FROM WORDS (J24), undone like a card
		ov.mark_dirty()
	if u["scene"] == S and u.has("own_rig") and var_to_str(u["own_rig"]) != var_to_str(S.own_rig):
		S.own_rig = u["own_rig"].duplicate(true)   # OWN RIG (L73), undone like a card
		if rig_ui != null:
			rig_ui._scene_ref = null
	if u["scene"] == S and u.has("bones") and var_to_str(u["bones"]) != var_to_str(S.bones):
		S.bones = u["bones"].duplicate(true)   # BONE EDITOR (J01), undone like a card
	if u["scene"] == S and u.has("spline") and var_to_str(u["spline"]) != var_to_str(S.spline_chains):
		S.spline_chains = u["spline"].duplicate(true)   # SPLINE IK on bone chains (L28), undone like a card
	if u["scene"] == S and u.has("hair") and var_to_str(u["hair"]) != var_to_str(S.hair):
		S.hair = u["hair"].duplicate(true)   # HAIR STRANDS (ROADMAP 87), undone like a card: the strands are baked again
		_hair_bake()
		ov.mark_dirty()
	if u["scene"] == S and u.has("ik") and var_to_str(u["ik"]) != var_to_str(S.ik):
		S.ik = u["ik"].duplicate(true)   # IK keys (limb_ik.gd), undone like a card
		_dummy_hits()
	if u["scene"] == S and u.has("sets") and var_to_str(u["sets"]) != var_to_str(S.sets):
		S.sets = u["sets"].duplicate(true)   # selection / keying sets (part_sets.gd), undone like a card
		if ui_browser != null:
			ui_browser.refresh()
	if u["scene"] == S and u.has("anykeys") and var_to_str(u["anykeys"]) != var_to_str(S.anykeys):
		S.anykeys = u["anykeys"].duplicate(true)   # L13/L15
	if u["scene"] == S and u.has("drivers") and var_to_str(u["drivers"]) != var_to_str(S.drivers):
		S.drivers = u["drivers"].duplicate(true)   # user drivers (GAP row 15), undone like a card
	if u.has("body_gen"):
		BaseBody.restore_gen(self, int(u["body_gen"]))   # G01: before the weights, which are sized by its vertices
	if u.has("armour"):
		load("res://scripts/armour_from_body.gd").restore(self, u["armour"])   # B23: the armour parts as they were
	if u.has("skin_w") and not wp.is_empty():
		if SkinPaint.restore(wp, u["skin_w"]):
			_skp_build()
	if u["scene"] == S and u.has("plants") and var_to_str(u["plants"]) != var_to_str(S.plants):
		S.plants = u["plants"].duplicate(true)   # foot plants (ROADMAP 8), undone like a card
	if u["scene"] == S and u.has("cons") and var_to_str(u["cons"]) != var_to_str(S.cons):
		S.cons = u["cons"].duplicate(true)   # constraints (round 51), undone like a card
		_dummy_hits()
	if u.has("shots") and var_to_str(u["shots"]) != var_to_str((u.get("hero", S) as Scene).shots):
		(u.get("hero", S) as Scene).shots = u["shots"].duplicate(true)   # the shots and their cameras, undone like a card (ROADMAP 75)
		if ui_timeline != null:
			ui_timeline.queue_redraw()
	if u["scene"] == S and u.has("clips") and var_to_str(u["clips"]) != var_to_str(S.clips):
		S.clips = u["clips"].duplicate(true)   # CLIPS, undone like a card
