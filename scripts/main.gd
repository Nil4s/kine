## a test's own settings file goes with it (ribbon_test clicks VIEW > Light like any button: one file per run piled up)
func _exit_tree() -> void:
	SlicerSend.shutdown()   # C79: the start-up slicer lookup (a `reg query` on a worker) must not hold the quit
	if nb_ui != null:
		nb_ui.finish()   # I44: the fatigue worker ends before the scenes it reads go
	for sc in _bake_scenes():
		if (sc as Scene).baker != null:
			(sc as Scene).baker.stop()   # ROADMAP 99: the bake tasks end before the scenes they read go
	PoseBake.stop_all()   # ... and those of scenes already swapped out (a baker outlives its scene's turn on stage)
	_imp_stop()   # R13: a video import's worker ends (and is waited for) before the scene it was given goes
	if _simc_clean.is_valid():
		_simc_clean.call()   # L42: a half-written Bake sim leaves no file behind
	for jb in _throw_jobs:
		WorkerThreadPool.wait_for_task_completion(jb["task"])   # L42: the throw judge's worker ends before the scenes go
	Children.kill_all()   # the separate programs (video tracker, AI video maker, Save video's ffmpeg, webcam and multicam readers...) end with the app
	if not _pv_job.is_empty():   # a fix preview still being worked out on a worker thread
		WorkerThreadPool.wait_for_task_completion(_pv_job["task"])
	if not _dm_job.is_empty():   # the dummy's measurement, the same
		WorkerThreadPool.wait_for_task_completion(_dm_job["task"])
	for th in _bg_live + _bg_orphans + _polish_orphans:   # CHECK's worker threads (bg_run, Polish), running or cancelled: waited for, not freed mid-run
		if (th as Thread).is_started():
			(th as Thread).wait_to_finish()
	_bg_live.clear()
	_bg_orphans.clear()
	_polish_orphans.clear()
	if _sg_task >= 0:   # I10: the next-pose strip's MotionMatch.build worker reads scenes/Body statics; it ends before they go (else an access violation at exit)
		WorkerThreadPool.wait_for_task_completion(_sg_task)
	if settings != SETTINGS:
		DirAccess.remove_absolute(ProjectSettings.globalize_path(settings))
	if library != LIBRARY:
		_rm_tree(library)   # SS6: a test's own library
	if Houses.dir == "user://zz_houses_%d" % OS.get_process_id():
		_rm_tree(Houses.dir)
	if journal_on:
		if not _unsaved() or _discarding:
			journal.trim()   # nothing unsaved (or Don't save was chosen): the journal has nothing to give back
		if quit_clean:
			journal.set_session(true)   # a clean quit: the next start offers nothing
		journal.close()
	# quitting with nothing unsaved: no autosave to offer next time. A test's own per-process file always goes
	if not _unsaved() or _discarding or (autosave != AUTOSAVE and OS.get_environment("POSER_AUTOSAVE") == ""):
		_autosave_drop()
	if autosave != AUTOSAVE and OS.get_environment("POSER_AUTOSAVE") == "" and FileAccess.file_exists(_later_path()):
		DirAccess.remove_absolute(_later_path())


func _process(dt: float) -> void:
	var _pt := Time.get_ticks_usec() if PerfDoc.probe else 0
	_process_body(dt)
	if PerfDoc.probe:
		PerfDoc.proc_us += Time.get_ticks_usec() - _pt
		PerfDoc.proc_n += 1


func _process_body(dt: float) -> void:
	var _pre := PerfDoc.t()
	_mesh_hint_sync()
	PerfDoc.add("p_hint", _pre)
	if soft_live.busy() and soft_live.poll(self):
		_soft_draw()   # L22: the bake landed while nothing else redrew
	var _p0 := PerfDoc.t()
	_hands_dock_tick()   # C66
	PerfDoc.add("p_dock", _p0)
	if _drop_line != null and _drop_line.visible:
		var hov := get_viewport().gui_get_hovered_control()
		if not get_viewport().gui_is_dragging() or hov == null or not (hov == ui_card_row or ui_card_row.is_ancestor_of(hov)):
			_drop_line.visible = false   # R8: the drag ended or left the strip
	PoseBake.serving = playing   # the baked pose table serves playback only (pose_bake.gd)
	var _pm := PerfDoc.t()
	if ui_mouse != null:
		ui_mouse.tick(dt)   # P05: at most every 50 ms
	PerfDoc.add("p_mouse", _pm)
	_co_tick()   # ROADMAP 30: the session's socket, the owned fighter's playhead
	var _p1 := PerfDoc.t()
	_doc_line()   # RR1: the strip catches up (throttled) after edits that do not refresh
	PerfDoc.add("p_docline", _p1)
	_p1 = PerfDoc.t()
	_mark_play_card()   # the card at the playhead wears the gold frame; the strip follows it while playing
	PerfDoc.add("p_markcard", _p1)
	_p1 = PerfDoc.t()
	_keys_camera(dt)
	PerfDoc.add("p_keycam", _p1)
	if campiv != null:
		campiv.tick(dt)   # C07
	if vx != null:
		vx.tick(dt)   # K13-K16
	if shot_through:
		_shot_apply()   # THE SHOT CAMERA follows the playhead (play, scrub, an edit)
	_p0 = PerfDoc.t()
	_tour_poll()
	_step_hint = ""   # a press that pushed no step must not name a later one
	_pv_poll()
	_video_poll(dt)
	_gen_poll(dt)
	_multicam_poll(dt)
	refimg.poll(dt)
	_imp_poll()
	PerfDoc.add("p_polls0", _p0)
	var _pp := PerfDoc.t()
	_live_poll(dt)
	PerfDoc.add("live", _pp)
	_sg_poll()
	_p0 = PerfDoc.t()
	if mm_ui != null:
		mm_ui.tick(dt)   # MOTION MATCHING PREVIEW: steers and plays the matched frames while it is on (nothing otherwise)
	if bm_ui != null:
		bm_ui.tick(dt)   # BLEND MATRIX preview (N084): plays the clicked blend
	if mp_ui != null:
		mp_ui.tick(dt)
	if ds_ui != null:
		ds_ui.tick(dt)   # H17: one slice of the deformation grading while it runs (nothing otherwise)
	if clash_ui != null:
		clash_ui.tick(dt)   # B24: one slice of the armour clash check while it runs (nothing otherwise)
	if sd_ui != null:
		sd_ui.tick(dt)   # STYLE DIAL: forgets its base when anything else changed the scene
	if tcat_ui != null:
		tcat_ui.tick(dt)   # THROW AND CATCH preview (nothing otherwise)
	if if_ui != null:
		if_ui.tick(dt)   # IMPACT FRAMES preview (nothing otherwise)
	if ic_ui != null:
		ic_ui.sync()   # plan 137: the flash follows the playhead every frame (a rebuilt prop node loses it otherwise)
	if bf_ui != null:
		bf_ui.tick(dt)
	if cg_ui != null:
		cg_ui.tick(dt)
	if style_ui != null:
		style_ui.tick(dt)
	if bt_ui != null:
