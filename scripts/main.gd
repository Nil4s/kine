const CARD_W := 91     # a card: the picture, "3 CONTACT", "0.4 s + hold 0.05": 17 fit a 1600 window (the old cards: 8)
const CARD_PIC_H := 55
var _pl_card := -1     # the card at the playhead (marked on the strip)


## Easy's card line: the card's name with a capital and the rest as typed ("CROSS" -> "Cross", "guard" -> "Guard")
func _easy_card_name(n: String, i := -1) -> String:
	var t := String(n).strip_edges()
	if i >= 0 and i < S.cards.size() and S.cards[i].has("from") and easy_is_jargon(t):   # a move's jargon name ("Anticipation: load"): "<Move> <n>" by its place in the move's run
		return _easy_move_label(i)
	if i >= 0 and t.begins_with("v") and t.substr(1).is_valid_int():   # a card copied from a video is named v<frame> (video_import): Easy names it "Video <n>", n its place in the copy
		return "Video %d" % _copy_place(i)
	if t.to_lower().begins_with("pivot ") and t.substr(6).contains("."):   # a path walk's turn card ("pivot 1.2": the feet turn before a step): "Turn" in plain words (walk-through 10, B)
		return "Turn"
	if i >= 0 and t.to_lower().begins_with("pose ") and t.substr(5).strip_edges().is_valid_int():   # "pose 3" (a new card's name): its place in the strip, so a card added between two reads right
		return "Pose %d" % (i + 1)
	if EASY_CARD_NAME.has(t.to_lower()):   # the template's own jargon (load, CROSS, recover) in plain words; the stored name is not changed
		return EASY_CARD_NAME[t.to_lower()]
	if i >= 0 and EASY_CODE_NAME.search(t.to_lower()) != null:   # a template's own codes ("mid r0", "off l1", "air 0", "step r", "stop: feet together"): "<Move> <n>"
		return "%s %d" % [easy_move_word(S.name), i + 1]
	return t.substr(0, 1).to_upper() + t.substr(1).to_lower() if t != "" else "Card"


## EASY: the card codes the templates use, at the start of a name (matched on the lower case name)
static var EASY_CODE_NAME := RegEx.create_from_string("^(mid|off|air|land|swing|half step|step|stop)\\b")


## EASY: a card's own name is animator jargon when it has a ":" or starts with a phase word (the template's and TextBlocking's)
static func easy_is_jargon(n: String) -> bool:
	var t := n.strip_edges().to_lower()
	if t.find(":") >= 0:
		return true
	for w in ["ready", "anticipation", "strike", "follow-through", "recovery", "contact", "settle"]:
		if t.begins_with(w):
			return true
	return false


## EASY: the place of a copied-video card in its run of copied cards (the v<frame> cards in a row), 1 for the run's first
func _copy_place(i: int) -> int:   # the copied cards up to and including card i: unique even when a pose or a cut sits between them
	var k := 0
	for j in range(0, i + 1):
		if _is_copy_name(String(S.cards[j]["name"])):
			k += 1
	return maxi(k, 1)


static func _is_copy_name(n: String) -> bool:
	return n.begins_with("v") and n.substr(1).is_valid_int()


## EASY: "<Move> <n>" for a card of a move: n is its place in the move's run (consecutive cards with the same tag)
func _easy_move_label(i: int) -> String:
	var tag := String(S.cards[i]["from"])
	var k := 1
	var j := i - 1
	while j >= 0 and S.cards[j].get("from", "") == tag:
		k += 1
		j -= 1
	return "%s %d" % [easy_from_word(tag), k]


## EASY: the word for a card's move tag ("punch|<serial>", "roundhouse|<serial>", "jab|<serial>"): the move in plain words
static func easy_from_word(tag: String) -> String:
	var t := tag.split("|")[0].strip_edges().to_lower().replace(" ", "_")
	return EASY_MOVE_WORD.get(t, t.substr(0, 1).to_upper() + t.substr(1))


## EASY: the move a scene is named for, in plain words: its name without the copy number ("run 68", "run_2" -> "Run");
## "Move" when the name is not a move's (a scene the user named)
static func easy_move_word(scene_name: String) -> String:
	var base := RegEx.create_from_string("[ _]\\d+$").sub(scene_name.strip_edges().to_lower(), "")
	return EASY_MOVE_WORD.get(base.replace(" ", "_"), "Move")


const EASY_MOVE_WORD := {"walk": "Walk", "run": "Run", "jump": "Jump", "punch": "Punch", "sword_swing": "Sword",
	"sit_down": "Sit down", "wave": "Wave", "fall": "Fall", "roundhouse": "Kick"}
const EASY_CARD_NAME := {"load": "Wind up", "cross": "Punch", "recover": "Back to guard"}
const EASY_WEAPON := {"sword": "a sword", "longsword": "a longsword", "katana": "a katana", "metal_bat": "a bat", "staff": "a staff",
	"long_hammer": "a hammer", "long_axe": "an axe", "spear": "a spear", "dagger": "a dagger", "two_daggers": "two daggers"}


## the word on a drag that put the second hand on the weapon (GripMagnet.drag's r): the hand that KEEPS the weapon is named
## (the one it is in), a let-go names the hand that let go. Easy says "his left / right hand" in plain words
func _grip_said(r: String, sel_h: String) -> String:
	if easy != null and easy.on:
		var keep := "left" if B.wep_hand == "hand_l" else "right"
		if r == "let go":
			var let := "left" if sel_h == "hand_l" else "right"
			return "His %s hand let go. His %s hand still holds the sword." % [let, keep]
		return "His %s hand holds the sword." % keep
	var holder := sel_h if r == "let go" else B.wep_hand
	return "the %s %s the %s" % [nice(holder), {"snap": "holds", "held": "holds", "let go": "let go of"}[r], B.wep_kind.replace("_", " ")]


## Easy's line for a weapon put in his hand: no weight, no length, no key names
static func easy_holds(key: String) -> String:
	return "He holds %s now. Undo takes it away." % EASY_WEAPON.get(key, "it")


## "0.4 s + hold 0.05": the time to get here (a ~ when it is automatic) and the hold; the first card has only a hold
func _card_timing(i: int) -> String:
	var c: Dictionary = S.cards[i]
	var hold := "no hold"
	if float(c["hold"]) > 0.0:
		hold = "hold %s" % String.num(float(c["hold"]), 2)
	if i == 0:
		return hold
	var mv: float = c["move"]
	if _card_is_usual(c):
		return "your usual %s s" % String.num(mv, 2)   # I10: the timing came from Nick's own habits and has not been touched since
	return "%s%s s + %s" % ["" if mv > 0.0 else "~", String.num(mv if mv > 0.0 else S.move_time(i), 2), hold]


## I10: the card carries "your usual" timing (a tag set when it was pre-timed) and its move and hold are still exactly that
func _card_is_usual(c: Dictionary) -> bool:
	var u: Variant = c.get("usual")
	return u is Dictionary and is_equal_approx(float(c["move"]), float(u["mv"])) and is_equal_approx(float(c["hold"]), float(u["hd"]))


## the timing button's colour: its own hue while the timing is "your usual", the plain one once touched
func _card_timing_look(tb: Button, i: int) -> void:
	if i >= S.cards.size():
		return
	var us := _card_is_usual(S.cards[i])
	for k in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
		if us:
			tb.add_theme_color_override(k, Tok.c("card_usual"))
		else:
			tb.remove_theme_color_override(k)
	tb.tooltip_text = ("your usual timing, learned from the scenes you saved (move %s s, hold %s s); it stays this colour until you change it.  U puts it on the picked cards" % [
		String.num(float(S.cards[i]["move"]), 2), String.num(float(S.cards[i]["hold"]), 2)]) if us else "seconds to get here from the card before + seconds the body then holds still.  Click to type them"


## the card's look: picked = blue, pass-by = brown, else plain; the card at the playhead has a gold frame and a lighter ground
func _card_style(i: int) -> StyleBoxFlat:
	var c: Dictionary = S.cards[i]
	var st := StyleBoxFlat.new()
	var here := i == _pl_card
	st.bg_color = Tok.c("card_sel") if i in card_range() else (Tok.c("card_passby") if c["name"] == "pass-by" else (Tok.c("card_play_bg") if here else Tok.c("card")))
	st.set_corner_radius_all(5)
	st.set_content_margin_all(3)
	st.set_border_width_all(2)
	st.border_color = Tok.c("card_play") if here else Color(0, 0, 0, 0)
	if i in msel:   # R19: a card in the multi-selection: a thicker outline in its own amber, apart from the playhead's gold frame
		st.set_border_width_all(3)
		st.border_color = Tok.c("card_multi")
	return st


## the card whose pose the playhead has reached (-1: none)
func _play_card_idx() -> int:
	var ts := S.times()
	var at := -1
	for i in ts.size():
		if float(ts[i][1]) <= playhead + 1e-4:
			at = i
	return at


var _pl_seen := -1.0


## the playhead moved: the gold frame goes to its card; while playing the strip scrolls so the card stays in view
func _mark_play_card() -> void:
	if ui_cards == null or S.cards.is_empty() or playhead == _pl_seen:
		return
	_pl_seen = playhead
	var now := _play_card_idx()
	if now != _pl_card:
		var old := _pl_card
		_pl_card = now
		for k in [old, now]:
			var pc := ui_cards.get_node_or_null("card_%d" % (k + 1)) as PanelContainer
			if pc != null and k < S.cards.size():
				pc.add_theme_stylebox_override("panel", _card_style(k))
	var pc_now := ui_cards.get_node_or_null("card_%d" % (now + 1)) as Control   # by name: the next-pose strip (R27) sits between cards
	if playing and now >= 0 and pc_now != null:
		var sc := ui_card_row
		var pc := pc_now
		if pc.position.x < sc.scroll_horizontal or pc.position.x + pc.size.x > sc.scroll_horizontal + sc.size.x:
			sc.scroll_horizontal = int(maxf(0.0, pc.position.x - 16.0))


## the order the strip's pictures are drawn in (SceneThumbs.request_pose's rank): the cards in view come first, from the
## selected card on (view order, round from it), then the rest in order. The view is the scroll position and the row's width
func _pic_ranks() -> Array:
	var n := S.cards.size()
	var ranks: Array = []
	ranks.resize(n)
	if n == 0 or ui_card_row == null:
		return ranks
	var step := float(CARD_W + 2)   # a card and the strip's gap (ui_cards separation)
	var w := ui_card_row.size.x if ui_card_row.size.x > 0.0 else 1000.0
	var a := clampi(int(floor(ui_card_row.scroll_horizontal / step)), 0, n - 1)
	var b := clampi(a + int(ceil(w / step)), a, n - 1)
	var vis: Array = range(a, b + 1)
	var start := sel_card if vis.has(sel_card) else a
	var order: Array = []
	var k := vis.find(start)
	for j in vis.size():
		order.append(vis[(k + j) % vis.size()])
	for i in n:
		if not vis.has(i):
			order.append(i)
	for j in order.size():
		ranks[order[j]] = j
	return ranks


## a pose picture is ready: every card showing that pose gets it
