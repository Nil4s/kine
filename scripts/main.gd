## ROOT MOTION EDITOR (ROADMAP 91; scripts/root_path.gd). View toggle "Root path on the floor": the played path as a curve on the
## floor, a yellow handle at each card's root and a red arrow for its facing. A press on a root handle and a drag moves that
## card's root on the floor; a press on an arrow turns its facing. One undo step per drag (pushed at the press, dropped when the
## mouse never moved). The planted feet re-solve at play time (Scene._planted), so the card poses are all that is written.
var root_path_on := false
var _rp_line: MeshInstance3D
var _rp_drag := {}          # the drag: {card, kind ("root" | "head"), start (the card's pose at the press), xz0, head0, hit0, moved}
var _rp_cache := {"poses": [], "len": -1.0, "path": []}   # the played path: rebuilt when a card's pose or the length changes
var ui_rp_dlg: ConfirmationDialog
var ui_rp_slider: HSlider
var ui_rp_val: Label


## the root handles of the scene as it stands (one per card)
func _rp_handles() -> Array:
	return RootPath.handles(RootPath.roots(S))


## the played path, sampled through the scene; cached until a card's pose (by identity) or the length changes
func _rp_path() -> Array:
	var ps: Array = _rp_cache["poses"]
	var same := ps.size() == S.cards.size() and is_equal_approx(float(_rp_cache["len"]), S.length())
	if same:
		for i in S.cards.size():
			if not is_same(ps[i], S.cards[i]["pose"]):
				same = false
				break
	if not same:
		var poses := []
		for c in S.cards:
			poses.append(c["pose"])
		_rp_cache = {"poses": poses, "len": S.length(), "path": RootPath.played(S)}
	return _rp_cache["path"]


func _rp_draw() -> void:
	if _rp_line == null:
		_rp_line = MeshInstance3D.new()
		_rp_line.name = "root_path"
		_rp_line.mesh = ImmediateMesh.new()
		add_child(_rp_line)
	var im := _rp_line.mesh as ImmediateMesh
	im.clear_surfaces()
	if not root_path_on or clean or S == null or S.cards.is_empty():
		return
	var act := {}
	if not _rp_drag.is_empty():
		act = {"card": _rp_drag["card"], "kind": _rp_drag["kind"], "warn": _rp_drag.get("warn", false)}
	RootPath.draw(im, _rp_path(), _rp_handles(), act, cam)


func _rp_toggle() -> void:
	root_path_on = not root_path_on
	_refresh()
	if root_path_on:
		_say("root path on: drag a yellow handle to move a card's root on the floor, a red arrow to turn its facing (one undo step each)")
	else:
		_say("root path off")


## a press on a root handle (move) or a heading arrow (turn) of the path: one undo step, dropped if the mouse never moves
func _rp_press(mp: Vector2) -> bool:
	if not root_path_on or clean or S == null or S.cards.is_empty():
		return false
	var h := RootPath.hit(cam, mp, _rp_handles())
	if h.is_empty():
		return false
	var hit0 = RootPath.floor_hit(cam, mp)
	if hit0 == null:
		return false
	var i := int(h["card"])
	var r := RootPath.root_of(RootPath.work(), S.cards[i]["pose"])
	_step_hint = "Move card %d's root" % (i + 1) if h["kind"] == "root" else "Turn card %d's facing" % (i + 1)
	_push_undo()
	_rp_drag = {"card": i, "kind": h["kind"], "start": S.cards[i]["pose"].duplicate(true), "xz0": r["xz"], "head0": r["heading"], "hit0": hit0, "moved": false}
	playing = false
	dragging = "root_path"
	_refresh()
	_say("%s: drag the mouse on the floor; release keeps it (Ctrl+Z takes it back)" % _step_hint)
	return true


func _rp_move(mp: Vector2) -> void:
	if _rp_drag.is_empty():
		return
	var p = RootPath.floor_hit(cam, mp)
	if p == null:
		return
	var i := int(_rp_drag["card"])
	var W := RootPath.work()
	var xz0: Vector2 = _rp_drag["xz0"]
	var pose: Dictionary
	var txt := ""
	if _rp_drag["kind"] == "root":
		var h0: Vector3 = _rp_drag["hit0"]
		var xz := xz0 + Vector2(p.x - h0.x, p.z - h0.z)
		pose = RootPath.posed(W, _rp_drag["start"], xz, float(_rp_drag["head0"]))
		txt = "card %d's root moved %.0f cm on the floor" % [i + 1, (xz - xz0).length() * 100.0]
	else:
		var bearing := rad_to_deg(atan2(p.x - xz0.x, p.z - xz0.y))
		pose = RootPath.posed(W, _rp_drag["start"], xz0, bearing)
		txt = "card %d now faces %.0f deg" % [i + 1, bearing]
	S.cards[i]["pose"] = pose
	_rp_drag["moved"] = true
	# REACH, live: a planted foot that cannot hold its spot is said in the status line, and the handle turns the warning colour
	var rep := RootPath.reach(S, i)
	_rp_drag["warn"] = not rep.is_empty()
	_retimed(false)
	if rep.is_empty():
		_say("%s   (release keeps it)" % txt)
	else:
		_say(RootPath.reach_message(rep))


func _rp_release() -> void:
	var d := _rp_drag
	_rp_drag = {}
	if d.is_empty():
		return
	if not d["moved"]:
		_drop_undo()
		_refresh()
		return
	_retimed()
	_say("root path: card %d %s   (Ctrl+Z takes it back in one step)" % [int(d["card"]) + 1, "moved" if d["kind"] == "root" else "turned"])


## one root-path command as one undo step; n = how many cards it moved (0 = nothing to do, nothing kept)
func _rp_edit(what: String, fn: Callable, none: String) -> void:
	if S == null or S.cards.size() < 2:
		_say("the root path needs two cards or more: make a pose and add it as a card first")
		return
	_step_hint = what
	_push_undo()
	var n: int = fn.call()
	if n == 0:
		_drop_undo()
		_refresh()
		_say(none)
		return
	_retimed()
	_say("%s: %d card(s) moved   (Ctrl+Z takes it back in one step)" % [what, n])


func _rp_straighten() -> void:
	_rp_edit("Straighten root path", func(): return RootPath.straighten(S),
		"the root path is already straight, or its first and last cards stand on one spot: drag a card's yellow handle off the line first")


func _rp_scale(k: float) -> void:
	_rp_edit("Scale root path length to %d %%" % roundi(k * 100.0), func(): return RootPath.scale_length(S, k),
		"the root path length is as it is: move the slider off 100 % and press OK")


## SCALE LENGTH: a slider (25 to 300 %) about the first card's root; the path keeps its headings and its card times
func _rp_scale_dialog() -> void:
	if S == null or S.cards.size() < 2:
		_say("the root path needs two cards or more: make a pose and add it as a card first")
		return
	if ui_rp_dlg == null:
		ui_rp_dlg = ConfirmationDialog.new()
		ui_rp_dlg.name = "root_path_scale_dialog"
		ui_rp_dlg.title = "Root path: scale its length"
		ui_rp_dlg.min_size = Vector2i(420, 0)
		var box := VBoxContainer.new()
		var lab := Label.new()
		lab.text = "Every card's root moves about the first card's root by this factor. The headings and the card times stay."
		lab.autowrap_mode = TextServer.AUTOWRAP_WORD
		box.add_child(lab)
		var h := HBoxContainer.new()
		var l := Label.new()
		l.text = "length"
		h.add_child(l)
		ui_rp_slider = HSlider.new()
		ui_rp_slider.name = "slider_root_path_scale"
		ui_rp_slider.min_value = RootPath.SCALE_MIN * 100.0
		ui_rp_slider.max_value = RootPath.SCALE_MAX * 100.0
		ui_rp_slider.step = 5.0
		ui_rp_slider.custom_minimum_size = Vector2(200, 26)
		ui_rp_val = Label.new()
		ui_rp_slider.value_changed.connect(func(v): ui_rp_val.text = "%d %%" % roundi(v))
		h.add_child(ui_rp_slider)
		h.add_child(ui_rp_val)
		box.add_child(h)
		ui_rp_dlg.add_child(box)
		ui_rp_dlg.confirmed.connect(func(): _rp_scale(ui_rp_slider.value / 100.0))
		add_child(ui_rp_dlg)
	ui_rp_slider.value = 100.0
	ui_rp_val.text = "100 %"
	ui_rp_dlg.popup_centered()


## USER CONSTRAINTS (round 51, GATES CN; scripts/constraints.gd): Child Of, Track To (look at), Floor, on the scene's
## stack, played after IK. The TARGET is picked first ("Constraint: use the picked part as the target", a view setting,
## not undone), then the owner is the picked part. With no target picked: the other hand (Child Of), the other fighter's
## head or else the weapon (look at). Every edit is one undo step
var cons_target := {}


## CONSTRAINTS ON SCREEN (Blender draws a dashed relationship line from a constrained bone to its target): for each
## constraint on at the playhead, a line from its owner to its target in the owner's side colour, faded by the
## influence; Child Of solid, look-at (Track To) dashed from between the eyes; Floor a cross on the floor under the foot.
## A view only: nothing saved, no undo
var _cons_line: MeshInstance3D


func _cons_draw() -> void:
	if _cons_line == null:
		_cons_line = MeshInstance3D.new()
		_cons_line.name = "constraint_lines"
		_cons_line.mesh = ImmediateMesh.new()
		add_child(_cons_line)
	var im := _cons_line.mesh as ImmediateMesh
	im.clear_surfaces()
	if clean or S == null or S.cons.is_empty():
		return
	var t := clampf(playhead, 0.0, S.length())
	for c in S.cons:
		var w := Constraints.weight(c, t)
		if w <= 0.0 or c.get("mute", false):
			continue
		var owner := String(c["owner"])
		var col := Color(side_col(owner) if owner.ends_with("_l") or owner.ends_with("_r") else Color(1.0, 0.85, 0.3), 0.35 + 0.65 * w)
		var ty := String(c["type"])
		var a: Vector3 = LookAt.eye_point(B) if ty == "track_to" else B.P[owner]
		im.surface_begin(Mesh.PRIMITIVE_LINES, Overlays._mat())
		im.surface_set_color(col)
		if ty == "floor":
			var y := float(c.get("height", 0.0))
			var f := Vector3(a.x, y, a.z)
			for d in [Vector3(0.06, 0, 0), Vector3(0, 0, 0.06)]:
				im.surface_add_vertex(f - d)
				im.surface_add_vertex(f + d)
			im.surface_add_vertex(a)
			im.surface_add_vertex(f)
		else:
			var x = Constraints.target_xf(S, B, c.get("target", {}), t)
			if x == null:
				im.surface_end()
				continue
			var b: Vector3 = (x as Transform3D).origin
			var n := 1 if ty == "child_of" else maxi(2, int(ceil(a.distance_to(b) / 0.03)))
			for k in range(0, n, 1 if n == 1 else 2):   # look-at dashed: 3 cm on, 3 cm off
				im.surface_add_vertex(a.lerp(b, float(k) / n))
				im.surface_add_vertex(a.lerp(b, minf(1.0, float(k + 1) / n)))
		im.surface_end()


func _cons_words(owner: String) -> String:
	if owner == "pelvis":
		return "hips"
	if owner == "head":
		return "head"
	return _ik_words(owner)


func _cons_tg_words(tg: Dictionary) -> String:
	match String(tg.get("kind", "")):
		"part":
			return nice(String(tg["part"]))
		"weapon":
			return "the weapon"
		"actor":
			return "fighter %d's %s" % [int(tg["actor"]) + 1, nice(String(tg.get("part", "head")))]
		"point":
			return "a spot in the world"
		"prop":
			return "prop %d" % (int(tg["prop"]) + 1)
	return "?"


## the picked part's owner for an existing constraint (fade / release / remove): its limb's hand / foot, the hips, the head
func _cons_owner_picked() -> String:
	for ty in ["child_of", "copy_location", "copy_rotation", "damped_track", "limit_location", "track_to"]:
		var o := Constraints.owner_of(ty, sel)
		if o != "" and Constraints.last_on(S, o) >= 0:
			return o
	return ""


func _cons_pick_target() -> void:
	if sel in Body.WEAPON:
		cons_target = {"kind": "weapon"}
	elif B.lim.has(sel):
		cons_target = {"kind": "part", "part": sel}
	else:
		_say("click a body part or the weapon first, then use the picked part as the target")
		return
	_say("constraint target: %s (now pick the part that follows it, or the head to look at it)" % _cons_tg_words(cons_target))


func _cons_target_fighter() -> void:
	_actors_sync()
	if actors_rt.size() < 2:
		_say("there is no other fighter: add one with 'Actor: add a second fighter' first")
		return
	cons_target = {"kind": "actor", "actor": 1 if actor_on == 0 else 0, "part": "head"}
	_say("constraint target: %s" % _cons_tg_words(cons_target))


func _cons_child_of() -> void:
	var owner := Constraints.owner_of("child_of", sel)
	if owner == "":
		_say("Child Of moves a hand, a foot or the hips: click one of them (or a part of that arm or leg) first")
		return
	if S.cards.is_empty():
		_say("constraints live in a scene: open a scene, or press Enter to add the body as a card first")
		return
	var tg := cons_target
	if tg.is_empty() or Constraints.bad_target(B, owner, tg) != "":
		tg = {"kind": "part", "part": Body.twin(owner)} if owner.begins_with("hand") else {"kind": "point", "at": B.P[owner]}
	var why := Constraints.bad_target(B, owner, tg)
	if why != "":
		_say("the %s cannot follow %s (%s): pick another target with 'Constraint: use the picked part as the target'" % [_cons_words(owner), _cons_tg_words(tg), why])
		return
	var t := clampf(playhead, 0.0, S.length())
	if Constraints.target_xf(S, B, tg, t) == null:
		_say("%s is not there now: pick another target with 'Constraint: use the picked part as the target'" % _cons_tg_words(tg))
		return
	_do(func(): Constraints.add_child_of(S, B, owner, tg, t))
	_dummy_hits()
	_say("the %s now follows %s from %s, keeping where it is from it (fade it out to let go; Ctrl+Z takes it back)" % [_cons_words(owner), _cons_tg_words(tg), Units.time(t, S.fps)])


## Copy location / Copy rotation / Damped track / Limit location: the same shape as Child Of (the target the user picked,
## else the other hand, else the spot the owner is at); Limit keeps the owner in a box round where it stands
func _cons_add_kind(type: String) -> void:
	var owner := Constraints.owner_of(type, sel)
	if owner == "":
		_say("%s works on a hand, a foot or the hips: click one of them (or a part of that arm or leg) first" % _cons_kind_words(type))
		return
	if S.cards.is_empty():
		_say("constraints live in a scene: open a scene, or press Enter to add the body as a card first")
		return
	var t := clampf(playhead, 0.0, S.length())
	if type == "limit_location":
		_do(func(): Constraints.add_limit(S, B, owner, t))
		_dummy_hits()
		_say("the %s now stays in a box %d cm each side of where it is, from %s (fade it out to let go; Ctrl+Z takes it back)" % [_cons_words(owner), roundi(Constraints.LIMIT_HALF * 100.0), Units.time(t, S.fps)])
		return
	var tg := cons_target
	if tg.is_empty() or Constraints.bad_target(B, owner, tg) != "":
		tg = {"kind": "part", "part": Body.twin(owner)} if owner.begins_with("hand") or owner.begins_with("foot") else {"kind": "point", "at": B.P[owner]}
	var why := Constraints.bad_target(B, owner, tg)
	if why != "":
		_say("the %s cannot use %s (%s): pick another target with 'Constraint: use the picked part as the target'" % [_cons_words(owner), _cons_tg_words(tg), why])
		return
	if Constraints.target_xf(S, B, tg, t) == null:
		_say("%s is not there now: pick another target with 'Constraint: use the picked part as the target'" % _cons_tg_words(tg))
		return
	_do(func(): Constraints.add_copy(S, B, type, owner, tg, t))
	_dummy_hits()
	_say("the %s now %s from %s (fade it out to let go; Ctrl+Z takes it back)" % [_cons_words(owner), _cons_kind_done(type, tg), Units.time(t, S.fps)])


func _cons_kind_words(type: String) -> String:
	return {"copy_location": "Copy location", "copy_rotation": "Copy rotation", "damped_track": "Damped track", "limit_location": "Limit location"}.get(type, type)


func _cons_kind_done(type: String, tg: Dictionary) -> String:
	match type:
		"copy_location":
			return "moves to %s's place, keeping its own turn" % _cons_tg_words(tg)
		"copy_rotation":
			return "turns with %s, keeping the turn it has against it, and its place" % _cons_tg_words(tg)
	return "points at %s, keeping its place" % _cons_tg_words(tg)


func _cons_look() -> void:
	if S.cards.is_empty():
		_say("constraints live in a scene: open a scene, or press Enter to add the body as a card first")
		return
	_actors_sync()
	var tg := cons_target
	if tg.is_empty() or Constraints.bad_target(B, "head", tg) != "":
		if actors_rt.size() >= 2:
			tg = {"kind": "actor", "actor": 1 if actor_on == 0 else 0, "part": "head"}
		elif B.wep_on:
			tg = {"kind": "weapon"}
		else:
			tg = {"kind": "point", "at": LookAt.eye_point(B) + LookAt.head_forward(B) * 2.0}
	var t := clampf(playhead, 0.0, S.length())
	if Constraints.bad_target(B, "head", tg) != "" or Constraints.target_xf(S, B, tg, t) == null:
		_say("the head cannot look at %s now: pick another target with 'Constraint: use the picked part as the target'" % _cons_tg_words(tg))
		return
	_do(func(): Constraints.add_track_to(S, B, tg, t))
	_dummy_hits()
	_say("the head looks at %s from %s (turning in over %d frames), never past the neck's limits" % [_cons_tg_words(tg), Units.time(t, S.fps), Constraints.FADE_FRAMES])


func _cons_floor() -> void:
	var owner := Constraints.owner_of("floor", sel)
	if owner == "":
		_say("the floor keeps a foot up: click a foot or a part of that leg first")
		return
	if S.cards.is_empty():
		_say("constraints live in a scene: open a scene, or press Enter to add the body as a card first")
		return
	_do(func(): Constraints.add_floor(S, owner))
	_dummy_hits()
	_say("the %s never goes below the floor now (Ctrl+Z takes it back)" % _cons_words(owner))


func _cons_fade(to: float) -> void:
	var owner := _cons_owner_picked()
	if owner == "":
		_say("no constraint on the picked part: click a part that has one, or add one with 'Constraint: child of the target'")
		return
	var i := Constraints.last_on(S, owner)
	var t := clampf(playhead, 0.0, S.length())
	_do(func(): Constraints.fade(S, i, t, to))
	_dummy_hits()
	_say("the %s's constraint fades %s over %d frames from %s" % [_cons_words(owner), "in" if to > 0.0 else "out", Constraints.FADE_FRAMES, Units.time(t, S.fps)])


func _cons_release() -> void:
	var owner := _cons_owner_picked()
	if owner == "" or not owner in LimbIK.LIMBS:
		_say("release keeping the pose works on a held hand or foot: click one that has a Child Of, or fade the constraint out instead")
		return
	var i := Constraints.last_on(S, owner)
	var t := clampf(playhead, 0.0, S.length())
	if Constraints.weight(S.cons[i], t) <= 0.0:
		_say("the %s's constraint is off here: move the playhead to where it holds, then release" % _cons_words(owner))
		return
	if LimbIK.card_at(S, t) < 0:
		_say("release writes the pose into a card: click a card (the playhead goes onto it), or press Enter to add one here, then release")
		return
	var r := {}
	_do(func(): r.merge(Constraints.release_keep(S, B, i, t)))
	_dummy_hits()
	_say("released the %s at %s: card %d now holds the pose the constraint gave it (off by %.2f°), so nothing jumps" % [_cons_words(owner), Units.time(t, S.fps), int(r.get("card", 0)) + 1, float(r.get("residual", 0.0))])


func _cons_remove() -> void:
	var owner := _cons_owner_picked()
	if owner == "":
		_say("no constraint on the picked part: click a part that has one (a held hand or foot, the hips, the head)")
		return
	var i := Constraints.last_on(S, owner)
	_do(func(): S.cons.remove_at(i))
	_dummy_hits()
	_say("removed the %s's constraint (Ctrl+Z puts it back)" % _cons_words(owner))


## USER DRIVERS (GAP_ANALYSIS row 15; scripts/drivers.gd): the picked part's bend follows another part's bend, every frame
## (driven = source * factor + offset). The SOURCE is picked first ("Driver: use the picked part as the source", a view
## choice, not undone), then the follower is the picked part. Every edit is one undo step
var drv_source := ""


func _drv_pick_source() -> void:
	if not B.lim.has(sel):
		_say("click a body part first, then use it as the driver's source")
		return
	drv_source = sel
	_say("driver source: %s (now pick the part that follows it, then 'Driver: the picked part follows the source')" % nice(sel))


func _drv_follow() -> void:
	if not B.lim.has(sel):
		_say("click the part that follows first, then 'Driver: the picked part follows the source'")
		return
	if drv_source == "" or not B.lim.has(drv_source):
		_say("no driver source yet: click the part that drives, then 'Driver: use the picked part as the source'")
		return
	if drv_source == sel:
		_say("a part cannot drive itself: pick another source")
		return
	var d := {"driven": sel, "axis": 0, "source": drv_source, "src_axis": 0, "factor": 1.0, "offset": 0.0}
	_do(func(): Drivers.put(S.drivers, d))
	_dummy_hits()
	_say("%s now follows %s at factor 1.0 (bend on bend, every frame; the factor presets change it; Ctrl+Z takes it back)" % [nice(sel), nice(drv_source)])


func _drv_factor(f: float) -> void:
	var i := Drivers.on(S.drivers, sel)
	if i < 0:
		_say("no driver on the picked part: click the part that follows, then 'Driver: the picked part follows the source'")
		return
	_do(func(): S.drivers[i]["factor"] = f)
	_dummy_hits()
	_say("%s follows %s x %s now (Ctrl+Z takes it back)" % [nice(sel), nice(String(S.drivers[i]["source"])), str(f)])


func _drv_remove() -> void:
	if Drivers.on(S.drivers, sel) < 0:
		_say("no driver on the picked part: nothing to take off. Pick the driven part first")
		return
	_do(func(): Drivers.remove_on(S.drivers, sel))
	_dummy_hits()
	_say("removed the driver on %s (Ctrl+Z puts it back)" % nice(sel))


## SECONDARY MOTION (ROADMAP item 26; scripts/secondary_motion.gd). A ponytail, a cloth strip or an oak bo hangs from a
## joint and follows it with lag and overshoot. "Secondary: add ..." adds the item AND bakes it in one undo step: the sim
## runs over the scene's frames and the keys are written to the scene (S.secondary). The view draws the baked chain at the
## playhead; before a bake the chain shows at rest. Bake again after the animation changes.
var _sec_line: MeshInstance3D


func _sec_attach_now(item: Dictionary) -> Vector3:
	return SecondaryMotion.attach_point(B, item)


func _sec_add(key: String) -> void:
	var item := SecondaryMotion.preset(key)
	item["name"] = SecondaryMotion.free_name(S.secondary, String(item["name"]))
	var sec := SecondaryMotion.with_item(S.secondary, item)
	sec = SecondaryMotion.bake_scene(S, B, sec)
	_do(func(): S.secondary = sec)
	_dummy_hits()
	_say("added the %s and baked it: %d frames of keys (Ctrl+Z takes it back)" % [String(item["name"]), S.length() * S.fps + 1])


func _sec_bake() -> void:
	if (S.secondary.get("items", []) as Array).is_empty():
		_say("no secondary motion yet: 'Secondary: add a ponytail' (or a cloth strip, or a weapon flex) first")
		return
	var sec := SecondaryMotion.bake_scene(S, B, S.secondary)
	_do(func(): S.secondary = sec)
	_dummy_hits()
	_say("baked %d secondary item(s) to keys (Ctrl+Z takes it back)" % (S.secondary.get("items", []) as Array).size())


func _sec_clear() -> void:
	if (S.secondary.get("items", []) as Array).is_empty():
		_say("no secondary motion to clear: run Secondary: add a ponytail to add one")
		return
	_do(func(): S.secondary = {})
	_dummy_hits()
	_say("took the secondary motion off the scene (Ctrl+Z puts it back)")


## CAPE (ROADMAP item 86; scripts/cloth.gd). An optional cape on the back, pinned at the shoulders and simulated as a cloth
## grid (12 x 16) that collides with the body's capsules. "Cape: add to the back" bakes it over the scene's frames in one
## undo step (S.cape); the view draws the baked frame at the playhead. Bake again after the animation changes. Taking it
## off and exporting are one step / no step.
var _cape_mi: MeshInstance3D
var _cape_mat: StandardMaterial3D


## THE BAKE RUNS IN THE BACKGROUND (round 86b, cloth_job.gd): sampling in 8 ms slices on this thread, the simulation on a
## worker task. A 60 Hz timer polls it; the result is applied here, in one undo step, when it is done. The scene keeps its
## last cape until then.
var _cape_job: ClothJob = null
var _cape_timer: Timer = null


func _cape_add() -> void:
	if _cape_job != null:
		_say("the cape is already baking (%d%%): click 'Cape: cancel the bake' to stop it" % int(_cape_job.progress() * 100.0))
		return
	_cape_job = ClothJob.start(S)
	if _cape_timer == null:
		_cape_timer = Timer.new()
		_cape_timer.wait_time = 1.0 / 60.0
		_cape_timer.timeout.connect(_cape_tick)
		add_child(_cape_timer)
	_cape_timer.start()
	_say("baking the cape over %.1f s in the background (0%%): the scene keeps its last cape until it is done" % S.length())


func _cape_tick() -> void:
	var job := _cape_job
	if job == null:
		_cape_timer.stop()
		return
	if job.stage == 0:
		if job.cancelled():
			_cape_drop("the cape bake was cancelled: the scene keeps its last cape (click 'Cape: add to the back' to bake a new one)")
			return
		if job.sample_for(8000):   # 8 ms of sampling a tick: the UI keeps its frames
			job.start_sim()
	if job.poll() == 2:
		_cape_timer.stop()
		_cape_job = null
		var cape := job.take_result()
		if cape.is_empty():
			_say("the cape bake was cancelled: the scene keeps its last cape (click 'Cape: add to the back' to bake a new one)")
			return
		if job.owner != S:
			_say("the scene changed during the bake, so the cape was not applied: click 'Cape: add to the back' to bake it again on this scene")
			return
		_do(func(): S.cape = cape)
		_dummy_hits()
		_say("the cape is on the back: %d frames of cloth at %d fps (Ctrl+Z takes it back).  %s" % [(cape["frames"] as Array).size(), S.fps, ClothStretch.words(ClothStretch.report(cape))])
		return
	if Engine.get_process_frames() % 15 == 0:   # the progress line, about four times a second
		_say("baking the cape: %d%%  (Cape: cancel the bake stops it; the scene keeps its last cape)" % int(job.progress() * 100.0))


func _cape_drop(msg: String) -> void:
	_cape_job = null
	_cape_timer.stop()
	_say(msg)


func _cape_cancel() -> void:
	if _cape_job == null:
		_say("no cape bake is running: 'Cape: add to the back' starts one")
		return
	_cape_job.cancel()
	_say("cancelling the cape bake: the scene keeps its last cape")


func _cape_fold_toggle() -> void:
	Cloth.self_collide = not Cloth.self_collide
	if Cloth.self_collide:
		_say("Cape: folds onto itself - ON (slower, about 0.5 s a frame to bake)")
	else:
		_say("Cape: folds onto itself - OFF")


func _cape_clear() -> void:
	if S.cape.is_empty():
		_say("no cape to take off: 'Cape: add to the back' first")
		return
	_do(func(): S.cape = {})
	_say("took the cape off (Ctrl+Z puts it back)")


func _cape_export() -> void:
	if S.cape.is_empty():
		_say("no cape to export: 'Cape: add to the back' first")
		return
	var p := Cloth.save_json(S.cape, "cape.json")
	if p == "":
		_say("could not write the cape file under the user folder: free up disk space there, then try again")
		return
	_say("exported the cape's vertices for every frame to %s (one list of 192 points per frame)" % p)


## L35 SIM CACHE (scripts/sim_cache.gd, sim_cache_live.gd): Bake sim writes the cape's and the soft regions' vertex positions for every
## frame to a file each; the timeline then scrubs the file. One undo step. Any edit marks it stale; Free bake removes it.
func _simc_bake() -> Dictionary:
	var r := SimCacheLive.compute(S)
	var objs: Dictionary = r["objs"]
	if objs.is_empty():
		_say("nothing to bake: 'Cape: add to the back' or a soft-body region on the BODY page first")
		return {"objects": []}
	var done := []
	_do(func():
		done.append_array(simc.commit(S, objs))
		if not (r["cape"] as Dictionary).is_empty():
			S.cape = r["cape"])
	var fr := 0
	for n in done:
		fr = maxi(fr, int(simc.meta[n]["frames"]))
	_say("baked %s to a point cache: %d frames each, the timeline scrubs the file (Ctrl+Z takes it back; an edit makes it stale; 'Bake sim: free' removes it)" % [", ".join(done), fr])
	_simc_badge_sync()
	return {"objects": done, "frames": fr}


## POL1106b: the timeline's "cache: fresh / stale / none" badge (SimCacheLive.badge)
func _simc_badge_sync() -> void:
	if ui_timeline == null:
		return
	if ui_simc_badge == null:
		ui_simc_badge = Label.new()
		ui_simc_badge.name = "sim_cache_badge"
		ui_simc_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ui_simc_badge.add_theme_font_size_override("font_size", 10)
		ui_timeline.add_child(ui_simc_badge)
	ui_simc_badge.text = simc.badge(S)
	ui_simc_badge.reset_size()
	ui_simc_badge.position = Vector2(maxf(2.0, ui_timeline.size.x - ui_simc_badge.size.x - 6.0), 2.0)
var ui_simc_badge: Label


var _simc_clean := Callable()   # removes the pending files of the bake in flight


## L42: Bake sim in the BACKGROUND (the menu action): the sims and the file writes run on a worker (progress bar and Cancel of the import panel);
## the files are written as <file>.pending and renamed into place on the main thread when the bake completed AND the scene is still the one it read
## (the keys are hashed again at landing), inside ONE undo step. Cancel, a scene edited meanwhile or a failed write leave no file and no undo step.
func _simc_bake_bg() -> Dictionary:
	if _imp_busy():
		_say("still working on %s: one background job at a time; press Cancel on the bar, or wait for it" % _imp["label"])
		return {"objects": []}
	var names: Array = []
	if not S.cape.is_empty():
		names.append("cape")
	for n in SoftBody.regions_of(S):
		names.append("soft:" + String(n))
	if names.is_empty():
		_say("nothing to bake: 'Cape: add to the back' or a soft-body region on the BODY page first")
		return {"objects": []}
	var keys := {}
	for n in names:
		keys[n] = SimCacheLive.key_for(S, n)
	var src := S
	var sc := S.clone()   # on this thread; the worker never reads the open scene
	var d: String = simc.dir
	var sname: String = S.name
	_simc_clean = func(): SimCacheLive.clear_pending(d, sname, names)
	var work := func() -> Dictionary:
		var r := SimCacheLive.compute(sc, true)
		if r.is_empty():
			return {}
		var pend := SimCacheLive.write_pending(d, sname, r["objs"], keys)
		if pend.is_empty():
			return {}
		return {"pend": pend, "cape": r["cape"]}
	var land := func(out: Dictionary) -> void:
		_simc_clean = Callable()
		var same := S == src
		if same:
			for n in names:
				same = same and SimCacheLive.key_for(S, n) == String(keys[n])
		if not same:
			SimCacheLive.clear_pending(d, sname, names)
			_say("the scene changed while the sim baked: that result was dropped (no file written); run Bake sim again")
			return
		var done := []
		_do(func():
			done.append_array(simc.commit_pending(S, out["pend"]))
			if not (out["cape"] as Dictionary).is_empty():
				S.cape = out["cape"])
		var fr := 0
		for n in done:
			fr = maxi(fr, int(simc.meta[n]["frames"]))
		_say("baked %s to a point cache: %d frames each, the timeline scrubs the file (Ctrl+Z takes it back; an edit makes it stale; 'Bake sim: free' removes it)" % [", ".join(done), fr])
	var fail := func() -> void:
		_simc_clean = Callable()
		SimCacheLive.clear_pending(d, sname, names)
	_imp_begin("Bake sim", work, land, fail)
	return {"objects": names, "background": true}


func _simc_free() -> void:
	if simc.meta.is_empty():
		_say("no baked sim to free: 'Bake sim (cache cloth and soft body)' first")
		return
	_do(func(): simc.free_all())
	_say("freed the baked sim: the cape and the flesh simulate live again (Ctrl+Z brings the bake back)")
	_simc_badge_sync()


func _cape_draw() -> void:
	if _cape_mi == null:
		_cape_mat = StandardMaterial3D.new()
		_cape_mat.cull_mode = BaseMaterial3D.CULL_DISABLED   # the cloth is seen from both sides
		_cape_mat.albedo_color = Color(0.42, 0.1, 0.16)
		_cape_mat.roughness = 0.9
		_cape_mi = MeshInstance3D.new()
		_cape_mi.name = "cape"
		_cape_mi.mesh = ImmediateMesh.new()
		add_child(_cape_mi)
	var im := _cape_mi.mesh as ImmediateMesh
	im.clear_surfaces()
	if S == null or S.cape.is_empty():
		_cape_mi.visible = false
		return
	_cape_mi.visible = true
	var v := PackedVector3Array()
	if not simc.meta.is_empty():
		v = simc.frame_at(S, "cape", clampf(playhead, 0.0, S.length()))   # L35: a fresh point cache answers; the sim is not read
	if v.is_empty():
		v = Cloth.verts_at(S.cape, clampf(playhead, 0.0, S.length()))
	var f := Cloth.faces()
	im.surface_begin(Mesh.PRIMITIVE_TRIANGLES, _cape_mat)
	for k in f.size():
		im.surface_add_vertex(v[f[k]])
	im.surface_end()


## the overlay: each item's chain at the playhead, from its baked keys (at rest when not baked yet)
## L22 SOFT-WIRE (scripts/soft_live.gd): the BODY page's flesh toggles and strength slider. Default OFF: nothing below runs.
func soft_set(group: String, on: bool) -> void:
	if not SoftBody.GROUPS.has(group):
		return
	var cur: Array = S.soft.get("regions", []).duplicate()
	var gset: Array = SoftBody.GROUPS[group]
	var ns := []
	for n in SoftBody.REGIONS.keys():
		if (cur.has(n) and not gset.has(n)) or (on and gset.has(n)):
			ns.append(n)
	if ns == cur:
		return
	var strength := SoftBody.strength_of(S)
	_do(func():
		var d := {}
		if not ns.is_empty():
			d["regions"] = ns
		if absf(strength - 1.0) > 1e-9:
			d["strength"] = strength
		S.soft = d)


## the strength slider (1 = as simulated, up to SoftBody.STRENGTH_MAX): drawn at once, no undo step, no new bake
func soft_strength_set(x: float) -> void:
	x = clampf(x, 0.0, SoftBody.STRENGTH_MAX)
	var d := S.soft.duplicate()
	if absf(x - 1.0) < 1e-9:
		d.erase("strength")
	else:
		d["strength"] = x
	S.soft = d
	_soft_draw()


func _soft_draw() -> void:
	if ui_body != null and ui_body.soft_shown != S.soft:
		ui_body.soft_sync(S)
	if S.soft.is_empty() and not soft_live.engaged:
		return
	soft_live.tick(self)


func _sec_draw() -> void:
	if _sec_line == null:
		_sec_line = MeshInstance3D.new()
		_sec_line.name = "secondary"
		_sec_line.mesh = ImmediateMesh.new()
		add_child(_sec_line)
	var im := _sec_line.mesh as ImmediateMesh
	im.clear_surfaces()
	var items: Array = S.secondary.get("items", []) if S != null else []
	if items.is_empty() or clean:
		return
	var t := clampf(playhead, 0.0, S.length())
	var cols := [Color(0.35, 0.85, 1.0, 0.9), Color(1.0, 0.6, 0.25, 0.9), Color(0.6, 1.0, 0.45, 0.9)]
	for k in items.size():
		var item: Dictionary = items[k]
		var th := SecondaryMotion.replay(S.secondary, item, t)
		var pts := SecondaryMotion.points(item, _sec_attach_now(item), th)
		im.surface_begin(Mesh.PRIMITIVE_LINES, Overlays._mat())
		im.surface_set_color(cols[k % cols.size()])
		for i in pts.size() - 1:
			im.surface_add_vertex(pts[i])
			im.surface_add_vertex(pts[i + 1])
		for p in pts:   # a small cross at every node: the joints the baked keys drive
			for ax in [Vector3.RIGHT, Vector3.UP, Vector3.BACK]:
				im.surface_add_vertex(p - ax * 0.012)
				im.surface_add_vertex(p + ax * 0.012)
		im.surface_end()


## HAIR STRANDS (ROADMAP 87; scripts/hair.gd). A ponytail of verlet strands rooted on the back of the head. "Hair: add a
## ponytail" sets S.hair and bakes it in one undo step: the sim runs over the scene's frames (the head and the body capsules
## at each frame) and the node points are kept in hair_frames, drawn at the playhead. Bake again after the animation
## changes (the file keeps the parameters, not the frames). Ctrl+Z takes the hair back.
var hair_frames: Array = []   # per scene frame: the strands' node points, flat (Hair.sim)
var hair_scene := -1          # the scene the frames were baked for (its instance id): another scene draws nothing
var _hair_line: MeshInstance3D


func _hair_add() -> void:
	var h := Hair.preset("ponytail")
	_do(func(): S.hair = h)
	_hair_bake()
	_say("added a ponytail (%d strands of %d segments) and baked it over %d frames (Ctrl+Z takes it back)" % [int(h["strands"]), int(h["n"]), hair_frames.size()])


func _hair_clear() -> void:
	if S.hair.is_empty():
		_say("no hair to clear: run Hair: add a ponytail to add one")
		return
	_do(func(): S.hair = {})
	hair_frames = []
	_say("took the hair off the scene (Ctrl+Z puts it back)")


## the head mesh's triangle corners in rest space (the same as _face_geo reads), for the roots
func _head_pts() -> PackedVector3Array:
	var pts := PackedVector3Array()
	if not pieces.has("head"):
		return pts
	var mesh: Mesh = (pieces["head"] as MeshInstance3D).mesh
	for si in mesh.get_surface_count():
		var arr := mesh.surface_get_arrays(si)
		var vs: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
		var ix: PackedInt32Array = arr[Mesh.ARRAY_INDEX]
		for i in ix:
			pts.append(vs[i])
	return pts


## BAKE: the head's frame and the body capsules at every scene frame (S.apply, the body put back as it was; pose, when given,
## sets the body for a time instead: the test's head turn), then the sim. Returns the frames and keeps them for the view.
func _hair_bake(pose := Callable()) -> Array:
	hair_frames = []
	hair_scene = -1
	if S == null or S.hair.is_empty():
		return hair_frames
	var p: Dictionary = S.hair
	var pts := _head_pts()
	var keep := B.state()
	var fps := S.fps
	var L := S.length()
	var nf := maxi(int(ceil(L * float(fps) - 1e-6)), 1) + 1
	var head := []
	var caps := []
	var roots := []
	for k in nf:
		var t := minf(float(k) / float(fps), L)
		if pose.is_valid():
			pose.call(t)
		else:
			S.apply(B, t)
		head.append([B.P["head"], B.G["head"]])
		var cs := []
		for part in Hair.CAPS:
			var c: Array = B.cap(part)
			cs.append([c[0], c[1], float(B.rad[part])])
		caps.append(cs)
		if k == 0:
			roots = Hair.roots(pts, p, B.p0["head"])
	B.set_state(keep)
	if roots.is_empty():
		_say("no head mesh to put the hair on: the strands need the head piece")
		return hair_frames
	hair_frames = Hair.sim(roots, p, fps, head, caps)
	hair_scene = S.get_instance_id()
	return hair_frames


## the overlay: each strand is a tapered tube (6 mm at the root, 2 mm at the tip; 6 sides a node), lit like the body in the
## hair token's colour, drawn at the playhead. The bundle is the strands' ring at the tie (Hair.roots)
var _hair_mat: StandardMaterial3D


func _hair_draw() -> void:
	if _hair_line == null:
		_hair_line = MeshInstance3D.new()
		_hair_line.name = "hair"
		_hair_line.mesh = ImmediateMesh.new()
		add_child(_hair_line)
	if _hair_mat == null:
		_hair_mat = StandardMaterial3D.new()
		_hair_mat.cull_mode = BaseMaterial3D.CULL_DISABLED
		_hair_mat.roughness = 0.55
	_hair_mat.albedo_color = Tok.c("hair")
	var im := _hair_line.mesh as ImmediateMesh
	im.clear_surfaces()
	if S == null or S.hair.is_empty() or hair_frames.is_empty() or hair_scene != S.get_instance_id() or clean:
		return
	var p: Dictionary = S.hair
	var n := int(p["n"])
	var N := n + 1
	var pts := Hair.at(hair_frames, clampf(playhead, 0.0, S.length()), S.fps)
	im.surface_begin(Mesh.PRIMITIVE_TRIANGLES, _hair_mat)
	const SIDES := 6
	for s in int(p["strands"]):
		var prev: Array = []
		for i in N:
			var a: Vector3 = pts[s * N + maxi(i - 1, 0)]
			var b: Vector3 = pts[s * N + mini(i + 1, n)]
			var c: Vector3 = pts[s * N + i]
			var T := (b - a)
			if T.length() < 1e-9:
				T = Vector3(0, -1, 0)
			T = T.normalized()
			var ref := Vector3.RIGHT if absf(T.dot(Vector3.UP)) > 0.9 else Vector3.UP
			var side := T.cross(ref).normalized()
			var upv := side.cross(T).normalized()
			var r := lerpf(0.003, 0.001, float(i) / float(n))   # 6 mm at the root, 2 mm at the tip
			var ring: Array = []
			for k in SIDES:
				var ang := TAU * float(k) / float(SIDES)
				var dir := side * cos(ang) + upv * sin(ang)
				ring.append([c + dir * r, dir])
			if not prev.is_empty():
				for k in SIDES:
					var k2 := (k + 1) % SIDES
					var q0: Array = prev[k]
					var q1: Array = prev[k2]
					var r0: Array = ring[k]
					var r1: Array = ring[k2]
					for v in [q0, r0, r1, q0, r1, q1]:
						im.surface_set_normal(v[1])
						im.surface_add_vertex(v[0])
			prev = ring
	im.surface_end()


