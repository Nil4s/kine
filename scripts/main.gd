	if not r["ok"]:
		_say("could not import %s: %s. Try another file, or export it again as .fbx with its mesh (Mixamo: With Skin)" % [path.get_file(), r["why"]])
		return ""
	var d: Dictionary = (r["scene"] as Scene).to_dict(B)
	d["plan"] = "Animation import of %s: %s. %s" % [path.get_file(), r["text"], r["report"]]
	var base := safe_file(String(d["scene"]))
	var out := UserPaths.w("res://scenes/_wip/%s.json" % base)
	var n := 2
	while FileAccess.file_exists(out):   # never over an earlier import
		out = UserPaths.w("res://scenes/_wip/%s_%d.json" % [base, n])
		n += 1
	_write(out, d)
	_load_scene(out, true)
	_rebuild_cards()
	_refresh()
	_say("imported %s as scenes/_wip/%s: %d cards, %s. Play it, then move its cards like any others%s" % [path.get_file(), out.get_file(), (r["scene"] as Scene).cards.size(), r["report"], ("  WARNING: " + "; ".join(PackedStringArray(r["warnings"]))) if not (r["warnings"] as Array).is_empty() else ""])
	return out


