## hovering a Fix button: the playhead jumps to the finding and a blue ghost shows the body there AFTER the fix; the
## scene is not touched until the click. {} = leave (ghost off; the playhead stays, so you can compare)
func _fix_hover(f: Dictionary) -> void:
	_pv_hover = f
	if f.is_empty() or _fixing:
		ov.fix_preview(S, [], 0.0)
		return
	playhead = clampf(f["t"], 0.0, S.length())
	_ps().apply(B, playhead)
	if _previews.has(f):
		_show_preview(f)
		return
	ov.fix_preview(S, [], 0.0)
	_say("PREVIEW: working out '%s'..." % Fixer.label(f, S))
	if _pv_job.is_empty():
		_pv_start(f)


## work a preview out on a copy of the scene and a body of its own, on a worker thread: the window never waits
func _pv_start(f: Dictionary) -> void:
	var sc := S.clone()
	var b := Body.new()
	b.load_files("res://data/skeleton.json", "res://data/body_limits.json")
	b.set_state(ov.GB.state())
	var job := {"f": f, "scene": sc, "out": [], "gen": _pv_gen}
	job["task"] = WorkerThreadPool.add_task(func(): job["out"] = Fixer.propose(f, sc, b))
	_pv_job = job


## a preview worker (Fixer.propose on a copy) shares STATIC caches with the main thread (FrameMemo, PoseCache, Scene's memos): a Fix, a
## Fix all or a realism judge run on the main thread while it works is a data race (a native crash, not a script error). Every
## main-thread run of those waits for the worker first; its answer is kept, the preview is not shown (the cards are about to change).
func _pv_quiesce() -> void:
	if _pv_job.is_empty():
		return
	WorkerThreadPool.wait_for_task_completion(_pv_job["task"])
	_pv_job = {}
	_previews.clear()
	_pv_gen += 1
	_pv_hover = {}
	ov.fix_preview(S, [], 0.0)


## called every frame: collect a finished preview job, show it if the mouse is still on its button, start the next
func _pv_poll() -> void:
	if _pv_job.is_empty() or not WorkerThreadPool.is_task_completed(_pv_job["task"]):
		return
	WorkerThreadPool.wait_for_task_completion(_pv_job["task"])
	var job := _pv_job
	_pv_job = {}
	if job["gen"] == _pv_gen:
		_previews[job["f"]] = job["out"]
	if not _pv_hover.is_empty() and not _fixing:
		if _previews.has(_pv_hover):
			_show_preview(_pv_hover)
		else:
			_pv_start(_pv_hover)


func _show_preview(f: Dictionary) -> void:
	ov.fix_preview(S, _previews[f], playhead)
	_say("PREVIEW: the blue ghost is this moment after '%s'.  Click to apply it (Ctrl+Z undoes)" % Fixer.label(f, S))


## FIX ON A LAYER (round 49, GATES NA2; scripts/layer_fix.gd): the fix's pose change as additive layers, cards untouched
func _fix_layer(f: Dictionary) -> void:
	ov.fix_preview(S, [], 0.0)
	_pv_hover = {}
	if _fixing:
		return
	_fixing = true
	_say("fixing %s on a layer... (it plays the scene to check the fix)" % f["rule"])
	await get_tree().process_frame
	_pv_quiesce()
	var r := LayerFix.make(f, S, ov.GB, _sm)
	if r["ok"]:
		_step_hint = "Fix on a layer"
		_push_undo()
		S.layers.append_array(r["layers"])
		layer_on = S.layers.size() - 1
		_dummy_hits()
		_ps().apply(B, playhead)
		_check()
	_refresh()
	var tail := ""
	if r["ok"]:   # the layer matches the fix AT the card; between cards it is close, not equal: say what Check now finds
		var still := findings.filter(func(x): return Fixer._same_finding(f, x))
		tail = ("   Check: %s is gone. " % f["rule"]) if still.is_empty() else ("   Check: %s is still found (a layer follows the fix at the card, only nearly between cards: the plain Fix is the full one). " % f["rule"])
		tail += "'Layer weaker' dials it; Ctrl+Z undoes it"
	_say(String(r["msg"]).replace("Fixed: ", "On a layer: ") + tail)
	_fixing = false


func _fix(f: Dictionary) -> void:
	ov.fix_preview(S, [], 0.0)
	_pv_hover = {}
	if _fixing:
		return
	if Fixer.label(f, S) == "":   # no fix for this rule: Fixer.apply has none to run (and _fixing would stay set)
		_say("%s has no automatic fix: click its card and drag the parts by hand" % f["rule"])
		return
	_fixing = true
	_say("fixing %s on card %d... (it plays the scene to check the fix)" % [f["rule"], f["card"] + 1])
	await get_tree().process_frame
	await get_tree().process_frame
	_pv_quiesce()
	var u := _snapshot()
	var t0 := Time.get_ticks_msec()
	var r: Dictionary = Fixer.apply(f, S, ov.GB, _sm)
	if r["kept"]:
		_bake_drop()   # the cards changed in place, not through _push_undo: the bake still holds the old poses
		undo.append(u)
		redo.clear()
		_rebuild_cards()
		_ps().apply(B, playhead)
		_check(r["after"])
	_refresh()
	if r["kept"]:
		var changed := []
		for i in mini(u["cards"].size(), S.cards.size()):
			if JSON.stringify(u["cards"][i]) != JSON.stringify(S.cards[i]):
				changed.append(i)
		_flash_cards(changed)
	_say(r["msg"] + ("   (Ctrl+Z undoes it)" if r["kept"] else "") + "   [%.1f s]" % ((Time.get_ticks_msec() - t0) / 1000.0))
	_fixing = false


func _fix_key(f: Dictionary) -> String:
	return "%s|%d|%.2f" % [f["rule"], int(f["card"]), float(f["t"])]


## FIX ALL (Nick, 10-25: "why not a button to fix all suggested"): every Fix in the CHECK list, in list order, one after the
## other. Each is the same Fixer.apply its own Fix button runs (kept only if its finding goes and nothing gets worse; else its
## cards go back and the words say why), and the list is read again after each kept fix. The whole run is ONE undo step: the
## snapshot is taken before the first fix. The frame is given back before each fix (progress on the button and the status
## line); Stop ends the run after the fix in hand. Its summary: "Fixed N; M need you: ..." (the refused fixes, skipped ones, and
## the findings with no automatic fix). _fixall_last keeps the numbers of the last run.
var _fixall_last := {}


func _fix_all_press() -> void:
	if _fixall_on:
		_fixall_stop = true
		_say("fix all: stopping after the fix in hand...")
		return
	_fix_all()


## tests: FIX ALL as one blocking call (Fixer.apply on the frame, no slices): the reference the sliced run must equal, bit for bit
var fixall_sync := false


func _fix_all() -> void:
	if _fixing or _fixall_on or _check_busy or S.cards.size() < 2 or not check_ran:
		return
	_fixall_on = true
	_fixall_stop = false
	_fixing = true
	_previews.clear()
	_pv_hover = {}
	ov.fix_preview(S, [], 0.0)
	# the run gives the frame back every 8 ms of work (FrameMemo slices, as Check does); _input holds every other click and key
	# meanwhile, so no edit, undo or second Check comes between two of its steps
	if not fixall_sync:
		FrameMemo.slice_begin(8.0)
	var u := _snapshot()   # taken before the first fix: the run is one undo step
	var t_run := Time.get_ticks_msec()
	var total := findings.filter(func(x): return Fixer.label(x, S) != "").size()
	var tried := {}
	var kept := 0
	var refused := {}   # key -> "rule at t s: why" for each fix Fixer put back (dropped again if a later try keeps it)
	var refused_at := {}   # key -> how many fixes were kept when it was refused (a refusal is tried once more only if the scene changed since)
	var retried := {}
	var worst := 0      # the longest single Fixer.apply (ms): the window is frozen that long
	var n := 0
	var cap := total * 3 + 5   # a kept fix can surface new findings; this bounds the run
	while n < cap and not _fixall_stop:
		var nxt = null
		for f in findings:
			if Fixer.label(f, S) != "" and not tried.has(_fix_key(f)):
				nxt = f
				break
		if nxt == null:
			# a fix that was refused ("made it worse", "did not remove it") may work now that other fixes changed the clip: once more
			# each (a refusal for "nothing could be changed" is a limit of the body, it does not move with the other cards)
			for rk in refused.keys():
				if not retried.has(rk) and int(refused_at[rk]) < kept and not String(refused[rk]).contains("nothing could be changed"):
					retried[rk] = true
					tried.erase(rk)
					nxt = true
			if nxt == null:
				break
			continue
		var f: Dictionary = nxt
		var fk := _fix_key(f)
		tried[fk] = true
		n += 1
		var prog := "Fixing %d of %d..." % [n, maxi(total, n)]
		if is_instance_valid(_fixall_btn):
			_fixall_btn.text = "Stop  (%s)" % prog
		_say("fix all: %s  %s at %.2f s, card %d" % [prog, f["rule"], f["t"], f["card"] + 1])
		await get_tree().process_frame
		if _fixall_stop:
			break
		# the fix runs on the MAIN thread, exactly as the Fix button runs it: Fixer's sampler keeps static caches (FrameMemo,
		# PoseCache, Rulebook) that the main thread also uses, so a worker would race them. The window waits for each fix
		# (its worst case is in the report); the frame is given back before each one.
		_pv_quiesce()
		var t0 := Time.get_ticks_usec()
		var w0 := FrameMemo.waited_usec
		var r: Dictionary
		if fixall_sync:
			r = Fixer.apply(f, S, ov.GB, _sm)
		else:
			r = await Fixer.apply_co(f, S, ov.GB, _sm)
		worst = maxi(worst, (Time.get_ticks_usec() - t0 - (FrameMemo.waited_usec - w0)) / 1000)   # the fix's own work, not the frames it gave back
		if r["kept"]:
			kept += 1
			refused.erase(fk)
			findings = r["after"]   # the scene the fix left, checked by Fixer
			_sm = {}
			_bake_drop()   # the cards changed in place: the bake still holds the old poses
		else:
			refused[fk] = "%s at %.2f s: %s" % [f["rule"], f["t"], String(r["msg"]).replace("Not applied: ", "").left(170)]
			refused_at[fk] = kept
	var not_reached := []
	for f in findings:
		if Fixer.label(f, S) != "" and not tried.has(_fix_key(f)):
			not_reached.append("%s at %.2f s (stopped)" % [f["rule"], f["t"]])
	var no_fix := []
	for f in findings:
		if Fixer.label(f, S) == "":
			no_fix.append("%s at %.2f s" % [f["rule"], f["t"]])
	if kept > 0:
		undo.append(u)
		redo.clear()
		_rebuild_cards()
		_ps().apply(B, playhead)
	FrameMemo.slice_end()
	_fixall_on = false
	_fixing = false
	var refused_list: Array = refused.values()
	_fixall_last = {"tried": n, "kept": kept, "total": total, "refused": refused_list, "not_reached": not_reached, "no_fix": no_fix,
		"worst_ms": worst, "ms": Time.get_ticks_msec() - t_run, "stopped": _fixall_stop}
	_check(findings)   # the list again, from the scene the run left (no second Check)
	_refresh()
	var need := []
	need.append_array(refused_list.map(func(s): return "could not fix: " + s))
	need.append_array(not_reached)
	need.append_array(no_fix.map(func(s): return "no automatic fix: " + s))
	_say("Fix all: fixed %d of %d in %.1f s%s.  %s" % [kept, total, (Time.get_ticks_msec() - t_run) / 1000.0,
		"  (Ctrl+Z takes the whole run back)" if kept > 0 else "",
		("%d need you: %s" % [need.size(), "; ".join(need)]) if not need.is_empty() else "nothing left to need you"])


## BG RUN (checkslice): the CHECK tools that play the whole clip (Fatigue, Speed limits, Safety sheet, Breakfall check, Weapon weight, Momentum
## ledger, Airborne spin check, Fix moves, Frame data) each held the main thread 1-3 s on a 4.7 s clip. They now hand their own analyser a
## CLONE of the scene and a body of its own on a worker thread (the analyser is the same function: the result is the blocking call's), and the
## window keeps drawing. A second click on the same tool cancels; an edit while it runs discards the result.
var _bg_gen := {}          # tag -> generation of the newest run
var _bg_busy := {}         # tag -> true while a run is waiting for its thread
var _bg_orphans: Array = []   # threads of cancelled runs: reaped when they end (a thread cannot be stopped)
var _bg_live: Array = []   # threads still running a bg_run / Polish: the app waits for them when it quits (a Thread freed while it runs crashes the exit)

## a body for a worker thread: its own skeleton, put in the live body's state (proportions, weapon, pose)
func bg_body(st: Dictionary) -> Body:
	var b := EventQuery._new_body()
	b.set_state(st)
	return b


## runs job() on a worker thread, a frame at a time; {"ok": true, "v": result}, or {"ok": false} when cancelled (a second call with the same
## tag while it runs) or when the open scene changed meanwhile. `say` = the status line while it runs.
func bg_run(tag: String, say: String, job: Callable) -> Dictionary:
	for th in _bg_orphans.filter(func(t): return not (t as Thread).is_alive()):
		(th as Thread).wait_to_finish()
		_bg_orphans.erase(th)
	if _bg_busy.get(tag, false):
		_bg_gen[tag] = int(_bg_gen.get(tag, 0)) + 1
		_bg_busy[tag] = false
		_say("%s cancelled" % tag)
		return {"ok": false}
	var gen := int(_bg_gen.get(tag, 0)) + 1
	_bg_gen[tag] = gen
	_bg_busy[tag] = true
	var key := S.cards.hash()
	var box := []
	var thr := Thread.new()
	thr.start(func(): box.append(job.call()))
	_bg_live.append(thr)
	var t0 := Time.get_ticks_msec()
	while thr.is_alive():
		await get_tree().process_frame
		if int(_bg_gen.get(tag, 0)) != gen:
			_bg_orphans.append(thr)
			return {"ok": false}
		_say_plain("%s  %.1f s  (click again to cancel)" % [say, (Time.get_ticks_msec() - t0) / 1000.0])
	thr.wait_to_finish()
	_bg_live.erase(thr)
	_bg_busy[tag] = false
	if box.is_empty():
		return {"ok": false}
	if S.cards.hash() != key:
		_say("%s: the scene changed while it ran; press it again" % tag)
		return {"ok": false}
	return {"ok": true, "v": box[0]}


## POLISH: the detail pass (tools/detail.gd) on the open scene -> scenes/_wip/<name>_polished.json, opened. Nick's file
## is never written; picking it in the list brings it back.
var _polish_gen := 0
var _polish_busy := false
var _polish_orphans: Array = []   # threads of cancelled runs: reaped when they end (a thread cannot be stopped)

func _polish() -> void:
	if S.cards.size() < 2:
		_say("Polish needs a scene of two cards or more: press Enter to add the body as a card (two at least), or open a scene in the list below")
		return
	for th in _polish_orphans.filter(func(t): return not (t as Thread).is_alive()):
		(th as Thread).wait_to_finish()
		_polish_orphans.erase(th)
	if _polish_busy:   # a second click cancels the run (its result is dropped)
		_polish_gen += 1
		_polish_busy = false
		_say("polish cancelled")
		return
	_say("polishing '%s'..." % S.name)
	var keep := B.state()   # lossless (round 8): to_dict rounds, so the live body jumped a rounding step
	var C := Scene.new()
	C.from_dict(S.to_dict(B, false))   # false: no bad_frames scan (1.2 s on 12 cards); the copy is graded by the pass itself
	B.set_state(keep)
	var n0 := C.cards.size()
	var base := S.name.trim_suffix("_polished")
	# the detail pass is minutes of Scene.apply on a copy: it runs on a worker thread with its OWN body, and the window keeps drawing
	# (it held the main thread for 2.7 s on a 4.7 s clip, ~1 min on a 60 s one). Nothing it touches is shared: the copy C, the body PB.
	_polish_busy = true
	_polish_gen += 1
	var gen := _polish_gen
	var box := []
	var thr := Thread.new()
	thr.start(func():   # its own body, made on the thread (reading the skeleton files is not free either)
		var PB := EventQuery._new_body()
		var pr: Array = DetailTool.polish(PB, C, 30)
		var D0: Scene = pr[0]
		D0.name = base + "_polished"
		var d0 := D0.to_dict(PB)   # the saved file's bad_frames scan (~1 s): here, not on the main thread
		d0["plan"] = "Polish (tools/detail.gd) from " + base
		box.append([pr, d0]))
	_bg_live.append(thr)
	var t_start := Time.get_ticks_msec()
	while thr.is_alive():
		await get_tree().process_frame
		if gen != _polish_gen:
			_polish_orphans.append(thr)
			return
		_say_plain("polishing '%s'... %d s  (click Polish again to cancel)" % [S.name, (Time.get_ticks_msec() - t_start) / 1000])
	thr.wait_to_finish()
	_bg_live.erase(thr)
	_polish_busy = false
	if box.is_empty():
		_say("polish failed: nothing came back")
		return
	var r: Array = box[0][0]
	var D: Scene = r[0]
	var path := UserPaths.w("res://scenes/_wip/%s.json" % D.name)
	_write(path, box[0][1])
	_load_scene(path, true)
	_rebuild_cards()
	_refresh()
	_say("polished: %d cards -> %d, one smooth curve.  Saved as %s; your '%s' is untouched.  Press Check to see what is left." % [n0, D.cards.size(), path.get_file(), base])


## RAGDOLL (ROADMAP 27, round 53): the body as it stands now goes limp and falls under gravity (ragdoll.gd, a deterministic
## position-based solver), the picked parts held in place (a pin is a particle of infinite mass where the part was). The
## fall is baked as cards (30 per second) into a NEW scene in scenes/_wip, opened; the live body and your scene are untouched.
func _ragdoll_fall() -> void:
	var pins: Array = []
	for j in group():
		if Ragdoll.is_sim(String(j)):
			pins.append(String(j))
	_say("ragdoll: falling%s..." % (" with %s held" % ", ".join(pins) if not pins.is_empty() else ""))
	await get_tree().process_frame
	var keep := B.state()
	var keep_ang: Dictionary = B.ang.duplicate()
	var R := Ragdoll.new()
	R.setup(B, pins)
	R.run(4.0)
	var cards := R.bake(keep_ang, Ragdoll.CARD_FPS)
	var rest := R.t_rest
	var contact := R.t_contact
	B.set_state(keep)
	var C := Scene.new()
	var base := safe_file(S.name.trim_suffix("_ragdoll") + "_ragdoll")
	C.from_dict({"scene": base, "fps": Ragdoll.CARD_FPS, "cards": cards})
	C.on_floor = false   # the solver is the floor and the feet: playback must not re-ground or re-plant them
	C.pin = false
	var d := C.to_dict(B)
	d["plan"] = "Ragdoll (scripts/ragdoll.gd) from %s, pins: %s" % [S.name, ", ".join(pins) if not pins.is_empty() else "none"]
	var out := UserPaths.w("res://scenes/_wip/%s.json" % base)
	var n := 2
	while FileAccess.file_exists(out):   # never over an earlier fall: _ragdoll_2, _ragdoll_3 ...
		out = UserPaths.w("res://scenes/_wip/%s_%d.json" % [base, n])
		n += 1
	_write(out, d)
	_load_scene(out, true)
	_rebuild_cards()
	_refresh()
	_say("ragdoll: %d cards, first floor contact %s, %s. Saved as %s; your '%s' is untouched." % [
		cards.size(), "%.2f s" % contact if contact >= 0.0 else "none",
		"at rest at %.2f s" % rest if rest >= 0.0 else "still moving at 4 s",
		out.get_file(), S.name])


## PUSH / RELAX / BLEND TO REST / BLEND TO NEIGHBOUR (round 41, GATES WW3, #279 #280): logic in inbetween.gd; one undo step
func _inbetween(op: String) -> void:
	var why := Inbetween.refuse(S, sel_card, op)
	if why != "":
		_say("%s: %s. Pick a middle card (one with a card before and after it)" % [op, why])
		return
	_push_undo()
	var js := Inbetween.joints_for(B, group())
	var r := Inbetween.run(B, S, sel_card, op, Inbetween.FACTOR, js)
	if S.on_floor:
		S._ground(B)
	B.apply_grip()
	_refresh()
	_say(Inbetween.describe(op, Inbetween.FACTOR, r, "%d parts" % js.size() if group().size() > 1 else "the whole body"))


## BREAKDOWNER (round 42, GATES XX4, #278): logic in breakdowner.gd. _bd_armed keeps a slider drag to ONE undo step
var _bd_armed := false
var _bd_pop: PopupPanel = null


func _breakdowner(f: float) -> void:
	var why := Breakdowner.refuse(S, sel_card)
	if why != "":
		_say("breakdowner: %s. Pick a middle card" % why)
		return
	if not _bd_armed:
		_push_undo()
	var js := Inbetween.joints_for(B, group())
	var r := Breakdowner.run(B, S, sel_card, f, js)
	if S.on_floor:
		S._ground(B)
	B.apply_grip()
	_refresh()
	_say(Breakdowner.describe(f, r, "%d parts" % js.size() if group().size() > 1 else "the whole body") + ".  Ctrl+Z undoes; Update keeps it on the card")


## Shift+E: a small slider, 0 = the card before, 1 = the card after, -0.5..1.5 overshoots. Closing it ends the undo step.
func _breakdowner_popup() -> void:
	var why := Breakdowner.refuse(S, sel_card)
	if why != "":
		_say("breakdowner: %s. Pick a middle card" % why)
		return
	if _bd_pop == null:
		_bd_pop = PopupPanel.new()
		var sl := HSlider.new()
		sl.name = "bd_slider"
		sl.min_value = Breakdowner.MIN_F
		sl.max_value = Breakdowner.MAX_F
		sl.step = 0.01
		sl.value = 0.5
		sl.custom_minimum_size = Vector2(260, 28)
		sl.tooltip_text = "BREAKDOWNER: 0 = like the card before, 1 = like the card after, past the ends = overshoot"
		sl.value_changed.connect(func(v): _breakdowner(v); _bd_armed = true)
		_bd_pop.add_child(sl)
		_bd_pop.popup_hide.connect(func(): _bd_armed = false)
		add_child(_bd_pop)
	_bd_armed = false
	_bd_pop.popup(Rect2i(Vector2i(get_viewport().get_mouse_position()) - Vector2i(130, 20), Vector2i(280, 40)))
	_say("breakdowner: drag the slider (0 = card before, 1 = card after, past the ends overshoots); Esc or a click away closes it")


## TWEEN MACHINE: the body = the picked card's two neighbours mixed by bias (Scene.mix_flat); Update keeps it
func _tween(bias: float) -> void:
	if sel_card <= 0 or sel_card >= S.cards.size() - 1:
		_say("tween: pick a card that has a card before it and after it")
		return
	if not _tween_armed:
		_push_undo()
		_tween_armed = true
	var a := Moves._flat(S.cards[sel_card - 1]["pose"])
	var b := Moves._flat(S.cards[sel_card + 1]["pose"])
	Scene.put(B, Scene.mix_flat(a, b, bias))
	if S.on_floor:
		S._ground(B)
	B.apply_grip()
	_refresh()
	_say("tween %d%%: '%s' -> '%s'.  Press Update on card %d to keep it (Ctrl+Z undoes)" % [round(bias * 100.0), S.cards[sel_card - 1]["name"], S.cards[sel_card + 1]["name"], sel_card + 1])


## a new in-between card after the picked one, halfway to the next
func _tween_add() -> void:
	if sel_card < 0 or sel_card >= S.cards.size() - 1:
		_say("+ tween: pick a card that has a card after it")
		return
	var a := Moves._flat(S.cards[sel_card]["pose"])
	var b := Moves._flat(S.cards[sel_card + 1]["pose"])
	_push_undo()
	Scene.put(B, Scene.mix_flat(a, b, 0.5))
	if S.on_floor:
		S._ground(B)
	B.apply_grip()
	var mv: float = S.move_time(sel_card + 1) * 0.5
	S.cards[sel_card + 1]["move"] = mv
	S.add("tween", B.to_dict(), sel_card + 1)
	S.cards[sel_card + 1]["move"] = mv
	S.cards[sel_card + 1]["hold"] = 0.0
	sel_card += 1
	playhead = S.times()[sel_card][1]
	_sync = true
	ui_tween.value = 0.5
	_sync = false
	_rebuild_cards()
	_refresh()
	_say("added a tween card (%d): slide 'tween' to favour either side, then Update" % (sel_card + 1))


## R18: DRAG A CARD TO REORDER. Press on a card's picture and move 6 px: the picture follows the mouse, a gold line shows the
## slot it would take, release drops it (one undo step; the card keeps its own move and hold), Esc cancels. Under 6 px
## it stays a click (pick) and a right-click still opens the menu.
const CARD_DRAG_PX := 6.0
const CARD_DRAG_LIFT := Vector2(0, -34)
var _cd_i := -1   # the card pressed (-1: none)
var _cd_from := Vector2.ZERO
var _cd_on := false
var _cd_eat := false   # the release that ends a drag must not also pick the card
var _cd_ghost: TextureRect
var _cd_line: ColorRect
var _cd_slot := -1


func _card_pick_click(i: int) -> void:
	if _cd_eat:
		_cd_eat = false
		return
	_card_pick(i)


## a press / motion / release on a card's picture; true when the event was part of a drag
func _card_drag_input(ev: InputEvent, i: int, nb: Button) -> bool:
	var mb := ev as InputEventMouseButton
	if mb != null and mb.button_index == MOUSE_BUTTON_LEFT:
		if mb.pressed:
			_cd_eat = false
			_cd_i = i
			_cd_from = mb.global_position
			_cd_on = false
			return false
		if _cd_i < 0:
			return false
		var was_on := _cd_on
		var slot := _cd_slot
		var from := _cd_i
		_card_drag_end()
		if was_on:
			_cd_eat = true
			if slot >= 0:
				var j := slot - 1 if slot > from else slot
				if j != from:
					_step_hint = "Move card"
					_card_reorder(from, j)
				else:
					_say("card %d stays where it is" % (from + 1))
			else:
				_say("drag cancelled: the cards are as they were")
		return was_on
	var mm := ev as InputEventMouseMotion
	if mm != null and _cd_i >= 0:
		if not (mm.button_mask & MOUSE_BUTTON_MASK_LEFT):
			_card_drag_end()
			return false
		if not _cd_on:
			if mm.global_position.distance_to(_cd_from) < CARD_DRAG_PX:
				return false
			_cd_on = true
			_cd_ghost = TextureRect.new()
			_cd_ghost.name = "card_drag_ghost"
			_cd_ghost.texture = nb.icon
			_cd_ghost.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			_cd_ghost.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			_cd_ghost.custom_minimum_size = Vector2(CARD_W - 8, CARD_PIC_H)
			_cd_ghost.size = Vector2(CARD_W - 8, CARD_PIC_H)
			_cd_ghost.modulate = Color(1, 1, 1, 0.8)
			_cd_ghost.mouse_filter = Control.MOUSE_FILTER_IGNORE
			_cd_ghost.top_level = true
			_cd_ghost.z_index = 90
			_cd_line = ColorRect.new()
			_cd_line.name = "card_drag_line"
			_cd_line.color = Tok.c("card_play")   # the gold of the playhead frame
			_cd_line.mouse_filter = Control.MOUSE_FILTER_IGNORE
			_cd_line.top_level = true
			_cd_line.z_index = 90
			ui_root.add_child(_cd_ghost)
			ui_root.add_child(_cd_line)
		_card_drag_move(mm.global_position)
		nb.accept_event()
		return true
	return false


## the ghost under the mouse and the gold line at the slot (0..n: the gap before card s)
func _card_drag_move(at: Vector2) -> void:
	if _cd_ghost == null:
		return
	_cd_ghost.global_position = at - _cd_ghost.size * 0.5 + CARD_DRAG_LIFT   # lifted so it does not hide the slot under the mouse
	var g := _card_slot_at(at.x)
	if g.is_empty():
		return
	_cd_slot = g["slot"]
	_cd_line.global_position = Vector2(g["x"], g["top"])
	_cd_line.size = Vector2(3, g["h"])


## R18 + R8: the slot (0..n, the gap before card s) a global x falls in, and the gold line's x / top / height for it
## ({} with no cards). One rule for a card being moved and a library pose being dropped
func _card_slot_at(gx: float) -> Dictionary:
	var kids: Array = []
	for k in ui_cards.get_children():
		if (k as Control).name.begins_with("card_"):
			kids.append(k)
	if kids.is_empty():
		return {}
	var slot := 0
	var top := 0.0
	var h := 0.0
	for k in kids.size():
		var r: Rect2 = (kids[k] as Control).get_global_rect()
		if gx > r.get_center().x:
			slot = k + 1
		top = r.position.y
		h = r.size.y
	var line_x: float
	if slot < kids.size():
		line_x = (kids[slot] as Control).get_global_rect().position.x - 2.0
	else:
		line_x = (kids[-1] as Control).get_global_rect().end.x + 1.0
	return {"slot": slot, "x": line_x, "top": top, "h": h}


func _card_drag_end() -> void:
	for n in [_cd_ghost, _cd_line]:
		if n != null and is_instance_valid(n):
			(n as Node).get_parent().remove_child(n)
			(n as Node).queue_free()
	_cd_ghost = null
	_cd_line = null
	_cd_i = -1
	_cd_on = false
	_cd_slot = -1


## Esc while a card is being dragged: nothing moves; the release that follows picks nothing
func _card_drag_cancel() -> bool:
	if not _cd_on:
		return false
	_card_drag_end()
	_cd_eat = true
	_say("drag cancelled: the cards are as they were")
	return true


## a card's name (round 13: the agent test found no way to name a card at all). One undo step
## a double-click on a card's title: a name box in its place (Enter keeps the name, Esc or clicking away keeps the old)
func _card_title_input(ev: InputEvent, i: int, nb: Button) -> void:
	var mb := ev as InputEventMouseButton
	if mb != null and mb.pressed and mb.ctrl_pressed and not mb.shift_pressed and mb.button_index == MOUSE_BUTTON_LEFT and not mb.double_click:
		nb.accept_event()   # R19: Ctrl+click toggles this card in the selection (the first one also takes the current card in)
		_cd_i = -1
		card_toggle(i)
		return
	if mb != null and mb.pressed and mb.shift_pressed and mb.button_index == MOUSE_BUTTON_LEFT and sel_card >= 0 and not mb.double_click:
		nb.accept_event()   # Shift+click: the range to this card (X1); the picked card and the body stay
		_cd_i = -1
		sel_end = i if i != sel_card else -1
		_range_of = sel_card
		msel = card_range()   # R19: the range is also the multi-selection (batch retime / delete / copy)
		_rebuild_cards()
		var r := card_range()
		_say("cards %d-%d selected: right-click for retime / hold / copy / delete, Faster / Slower retime them (a plain click picks one again)" % [r[0] + 1, r[-1] + 1])
		return
	if mb != null and mb.pressed and mb.button_index == MOUSE_BUTTON_RIGHT:
		nb.accept_event()
		_card_menu(i, mb.global_position)
		return
	if _card_drag_input(ev, i, nb):
		return
	if not (ev is InputEventMouseButton and ev.double_click and (ev as InputEventMouseButton).button_index == MOUSE_BUTTON_LEFT):
		return
	nb.accept_event()
	_card_name_edit(i, nb)


func _card_name_edit(i: int, nb: Button) -> void:
	var ed := LineEdit.new()
	ed.name = "edit_card_name"
	ed.text = S.cards[i]["name"]
	ed.custom_minimum_size = Vector2(nb.size.x, 24)
	nb.get_parent().add_child(ed)
	nb.get_parent().move_child(ed, nb.get_index())
	nb.visible = false
	ed.grab_focus()
	ed.select_all()
	ed.text_submitted.connect(func(t):
		ed.set_meta("done", true)   # the rename rebuilds the row, which takes the box's focus: not a cancel
		_step_hint = "Rename card"
		_card_rename(i, t))
	ed.focus_exited.connect(func():
		if not ed.has_meta("done"):
			ed.set_meta("done", true)
			_rebuild_cards.call_deferred())   # Esc / clicked away: the old name stays (after this event, never inside a rebuild)
	_say("type the card's new name, Enter keeps it (Esc: no change)")


## LOOP: close the seam (round 16, W2): the last card's pose = the first's, and the scene marked a loop
func _loop_close() -> void:
	if S.cards.size() < 2:
		_say("a loop needs 2 cards or more: add cards first (Enter)")
		return
	_push_undo()
	S.cards[-1]["pose"] = S.cards[0]["pose"].duplicate(true)
	S.loop = true
	if ui_loop != null:
		ui_loop.set_pressed_no_signal(true)
	check_ran = false
	_rebuild_cards()
	_ps().apply(B, playhead)
	_refresh()
	_say("the last card is now a copy of the first: the loop's end meets its start. Check grades the speed across it too.")


## PLANT EVERY SLIDING FOOT (round 43, GATES YY2): the work is Fixer.plant_all. One undo step, or none when it keeps nothing.
func _plant_all() -> void:
	_push_undo()
	var keep := B.state()
	var r := Fixer.plant_all(S, B)
	B.set_state(keep)   # Check samples the scene on B: the body goes back as it was
	if not r["kept"]:
		undo.pop_back()
		_say("%s. Press Check for the other rules" % r["msg"])
		return
	check_ran = false
	_rebuild_cards()
	_ps().apply(B, playhead)
	_refresh()
	_say("%s. One Ctrl+Z puts it back" % r["msg"])


## CLEAN UP MOCAP (round 42, GATES XX7): the work is in scripts/mocap_clean.gd. Needs a card per frame.
func _mocap_clean() -> void:
	if S.cards.size() < 8:
		_say("this scene has %d cards: clean-up reads a card per frame, like a .bvh import. Drop a .bvh on the window, or open an imported scene" % S.cards.size())
		return
	_push_undo()   # taken first, dropped again if nothing changed
	var keep := B.state()   # the analysis plays the scene on B; with nothing to do the body goes back as it WAS (the
	                        # playhead's pose is not always it: undo_audit, round 43, after the toe-off trim left nothing)
	var r := MocapClean.clean(S, B, {})
	if int(r["locked"]) + int(r["repaired"]) == 0:
		undo.pop_back()
		B.set_state(keep)
		_say("%s. Nothing to plant or mend: no standing foot and no pop in this scene. Press Check for the other rules" % r["text"])
		return
	check_ran = false
	_rebuild_cards()
	_ps().apply(B, playhead)
	_refresh()
	_say("%s. One Ctrl+Z puts it back" % r["text"])


func _card_rename(i: int, nm: String) -> void:
	nm = nm.strip_edges()
	if i < 0 or i >= S.cards.size() or nm == "":
		_say("pick a card and type a name (the name can't be empty)")
		return
	_push_undo()
	S.cards[i]["name"] = nm
	_rebuild_cards()
	_say("card %d is now '%s'" % [i + 1, nm])


func _card_update(i: int) -> void:
	_push_undo()
	S.cards[i]["pose"] = B.to_dict()
	if S.cards[i]["name"] == "pass-by":
		S.cards[i]["name"] = "pose %d" % (i + 1)
	_rebuild_cards()
	_say("card %d updated from the body" % (i + 1))


## SNAP TO FLOOR (ROADMAP 46): the picked card (or the body when no card is picked, or there are no cards) moves straight
## up or down so its lowest capsule point is on the floor; the joints stay. all = every card. One undo step
func _floor_snap(all := false) -> void:
	if all:
		if S.cards.is_empty():
			_say("no cards to snap: pose the body and press Enter to add it as a card, or use 'Snap to floor' for the body alone")
			return
		var n := S.cards.size()
		_do(func():
			FloorSnap.snap_all(S, B)
			S.apply(B, playhead)
			_rebuild_cards())
		_say("all %d cards are on the floor now: the lowest point of each is at 0 cm (Ctrl+Z takes it back)" % n)
		return
	if S.cards.is_empty():
		_do(func(): B.ground_body())
		_say("the body is on the floor now (Ctrl+Z takes it back)")
		return
	if sel_card < 0:
		_do(func(): B.ground_body())
		_say("the body is on the floor now, but no card is picked: click a card, then 'Update' keeps it there (Ctrl+Z takes it back)")
		return
	var i := sel_card
	_do(func():
		S.cards[i]["pose"] = FloorSnap.snapped_pose(B, S.cards[i]["pose"])
		S.apply(B, playhead)
		_rebuild_cards())
	_say("card %d is on the floor now: the lowest point at 0 cm, the joints as they were (Ctrl+Z takes it back)" % (i + 1))


func _card_del(i: int) -> void:
	_push_undo()
	S.cards.remove_at(i)
	sel_card = mini(sel_card, S.cards.size() - 1)
	playhead = minf(playhead, _ps().length())
	_rebuild_cards()
	_refresh()


func _card_move(i: int, d: int) -> void:
	var j := i + d
	if j < 0 or j >= S.cards.size():
		return
	_push_undo()
	var c = S.cards[i]
	S.cards[i] = S.cards[j]
	S.cards[j] = c
	sel_card = j
	_rebuild_cards()
	_refresh()


## FRAMES + PREVIEW RANGE (WW4, #262/#263): view settings, see scripts/preview_range.gd
func _toggle_frames() -> void:
	frames_view = not frames_view
	_say("the time shows in %s (click it to flip)" % ("frames, at %d fps" % S.fps if frames_view else "seconds"))
	_refresh()


func _pv_set(which: String, t: float) -> void:
	if which == "clear":
		pv_in = -1.0
		pv_out = -1.0
		_say("preview range cleared: Play and Loop use the whole scene")
	else:
		var at := playhead if t < 0.0 else t
		if which == "in":
			pv_in = at
		else:
			pv_out = at
		var sp := PreviewRange.span(pv_in, pv_out, _ps().length())
		if sp.is_empty():
			_say("%s point at %s; set the other one after it (the range must be longer than a frame)" % [which, Units.time(at, S.fps)])
		else:
			_say("preview range %s to %s: Play and Loop stay inside it (a view setting, not saved)" % [Units.time(sp[0], S.fps), Units.time(sp[1], S.fps)])
	_refresh()


func _fps_next() -> void:
	var k: int = PreviewRange.FPS_CHOICES.find(S.fps)
	_set_fps(PreviewRange.FPS_CHOICES[(k + 1) % PreviewRange.FPS_CHOICES.size()])


func _set_fps(f: int) -> void:
	if f == S.fps:
		_say("already at %d fps: run Frame rate: next to choose another" % f)
		return
	_push_undo()
	S.fps = f
	var off := PreviewRange.off_grid(S, f)
	if off == 0:
		_say("%d fps: every card keeps its seconds, all on whole frames" % f)
	else:
		_say("%d fps: every card keeps its seconds; %d card time%s not on a whole frame" % [f, off, " is" if off == 1 else "s are"])
	_refresh()


func _toggle_play() -> void:
	if S.cards.size() < 2 and rig_len() <= 0.0:   # an own rig with keys plays without cards (L78)
		_say("a scene needs two cards or more to play: press Enter to add the body as a card (two at least), or open a scene in the list below")
		return
	playing = not playing
	_a_after = -1.0   # the sound starts (or stops) with the next frame
	if playing and playhead >= play_len() - 0.01:
		playhead = 0.0
	var sp := PreviewRange.span(pv_in, pv_out, play_len())
	if playing and not sp.is_empty() and (playhead < sp[0] or playhead >= sp[1] - 0.01):
		playhead = sp[0]   # WW4: Play starts inside the range
	if playing:
		play_clock.start(play_clock.mode)   # ROADMAP 48: each pass counts its own dropped frames and speed
	_refresh()


## ROADMAP 48: REAL SPEED / EVERY FRAME, the playback mode. A view setting: the scene is not changed, no undo step.
