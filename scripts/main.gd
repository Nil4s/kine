	playhead = f["t"]
	sel_card = mini(f["card"], S.cards.size() - 1)
	_ps().apply(B, playhead)
	_rebuild_cards()
	_refresh()
	_say("%s at %s (card %d): %s" % [f["rule"], Units.time(f["t"], S.fps), sel_card + 1, f["msg"]])


