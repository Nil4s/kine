## s120 MOVING PARTS: the picked moving part's joint `name` keyed to value v (degrees; mm for a slide) at the playhead, ONE undo step. The part's own
## joint limit cuts the value and the words say so. Answers Props/PropJoints.key's dictionary ({} when no moving part is picked)
func _prop_joint_key(name: String, v: float) -> Dictionary:
	if sel_prop < 0 or sel_prop >= S.props.size() or not PropJoints.has_joints(S.props[sel_prop]):
		_say("pick a part that moves first (Save and use in a scene sends a part with hinges as one prop), then key its joint")
		return {}
	var i := sel_prop
	var r := {}
	_do(func(): r.merge(PropJoints.key(S.props[i], name, playhead, v)))
	_props_show()
	_doc_line()
	if not bool(r.get("ok", false)):
		_say(String(r.get("why", "no such joint")))
	elif bool(r["limited"]):
		_say("%s of the %s is keyed %.0f at %s, not the %.0f asked: the part's joint limit is %.0f (it stops there). Ctrl+Z takes it back" % [name, _prop_name(i), float(r["value"]), Units.time(playhead, S.fps), float(r["asked"]), float(r["limit"])])
	else:
		_say("%s of the %s is keyed %.0f at %s; move the playhead and key it again, it plays between. Ctrl+Z takes it back" % [name, _prop_name(i), float(r["value"]), Units.time(playhead, S.fps)])
	return r


func _prop_joint_step(delta: float) -> void:
	if sel_prop < 0 or sel_prop >= S.props.size() or not PropJoints.has_joints(S.props[sel_prop]):
		_say("pick a part that moves first (Save and use in a scene sends a part with hinges as one prop), then Joint: open 15 deg")
		return
	var j: Dictionary = PropJoints.joints_of_kind(String(S.props[sel_prop]["kind"]))[0]
	var cur := float(PropJoints.angles_at(S.props[sel_prop], playhead).get(String(j["name"]), 0.0))
	_prop_joint_key(String(j["name"]), cur + delta)


# ---------------------------------------------------------------- GPU TIERS (scripts/gpu_tier.gd): items of View > Graphics quality
func _gpu_menu_build(pm: PopupMenu) -> void:
	pm.add_separator("This PC's graphics card")
	pm.add_item(GpuTier.summary(GpuTier.info()), 100)
	pm.set_item_disabled(pm.get_item_index(100), true)
	pm.set_item_tooltip(pm.get_item_index(100), GREY_TAG.strip_edges() + " this line only names the graphics card this PC has")   # B07
	pm.add_check_item("Fast view (FSR 2)", 101)
	pm.set_item_tooltip(pm.get_item_index(101), "the live view is drawn at 2/3 size and sharpened back up (AMD FSR 2, built into Godot): for a PC whose graphics card is the limit. Videos you save are always full quality. Needs the High drawing engine (Forward+)")
	pm.add_separator("Saving video")
	for k in GpuTier.ENCODERS.size():
		pm.add_radio_check_item(GpuTier.ENCODER_NAMES[GpuTier.ENCODERS[k]], 110 + k)
		pm.set_item_tooltip(pm.get_item_index(110 + k), "which chip makes the .mp4. Auto and 'on the CPU' use the processor. The graphics card (NVENC) frees the processor but was not measurably faster in Kine's own exports; a choice it cannot do here falls back to the processor (remembered)")
	_gpu_menu_sync(pm)


func _gpu_menu_sync(pm: PopupMenu) -> void:
	var tier := String(GpuTier.info()["tier"])
	pm.set_item_checked(pm.get_item_index(101), GpuTier.fast_view)
	pm.set_item_disabled(pm.get_item_index(101), Quality.current_renderer() != "forward_plus")
	var _t101 := "the live view is drawn at 2/3 size and sharpened back up (AMD FSR 2, built into Godot): for a PC whose graphics card is the limit. Videos you save are always full quality. Needs the High drawing engine (Forward+)"
	pm.set_item_tooltip(pm.get_item_index(101), _t101 + ("" if Quality.current_renderer() == "forward_plus" else " " + GREY_TAG.strip_edges() + " this needs the High drawing engine: switch the drawing engine to High first"))   # B07
	for k in GpuTier.ENCODERS.size():
		var e: String = GpuTier.ENCODERS[k]
		var i := pm.get_item_index(110 + k)
		pm.set_item_checked(i, e == GpuTier.pref)
		var _no: bool = e != "auto" and not GpuTier.encoders_for(tier).has(e)
		pm.set_item_disabled(i, _no)
		pm.set_item_tooltip(i, "which chip makes the .mp4. Auto and 'on the CPU' use the processor. The graphics card (NVENC) frees the processor but was not measurably faster in Kine's own exports; a choice it cannot do here falls back to the processor (remembered)" + (" " + GREY_TAG.strip_edges() + " this PC's graphics card cannot make this video: pick Auto or the CPU" if _no else ""))   # B07


func _gpu_pressed(id: int, pm: PopupMenu) -> void:
	if id == 101:
		GpuTier.fast_view = not GpuTier.fast_view
		Quality.apply(get_viewport(), gfx_tier, light_key)
		_say("Fast view %s (remembered)" % ("on: the live view is drawn smaller and sharpened (FSR 2); saved videos stay full quality" if GpuTier.fast_view else "off"))
	elif id >= 110 and id < 110 + GpuTier.ENCODERS.size():
		GpuTier.pref = GpuTier.ENCODERS[id - 110]
		GpuTier._resolved.clear()
		_say("Video encoder: %s (remembered)" % GpuTier.ENCODER_NAMES[GpuTier.pref])
	GpuTier.save_settings(settings)
	_gpu_menu_sync(pm)


