## opens a scene file the one way every pick does (the scene list, the S box's scene rows): at once, or asking first
## when the scene open now has unsaved changes
func _open_scene_file(path: String, then := Callable(), answered := false) -> void:   # answered: the caller has just asked Save / Don't save already   # then: run once the scene is open (Easy's My scenes plays it)
	if path == scene_path and _unsaved() == false:
		if then.is_valid():
			then.call()
		return
	var go := func():
		_load_scene(path)
		_rebuild_cards()
		_refresh()
		if then.is_valid():
			then.call()
	if _unsaved() and not answered:
		_ask_save(_scene_label(), go)   # ROADMAP 50: Save / Don't save / Cancel
	else:
		go.call()


## New empty scene: asks first when the open scene has unsaved changes (ROADMAP 50)
func _new_asked() -> void:
	if _unsaved():
		_ask_save(_scene_label(), _new_scene)
	else:
		_new_scene()


## THE S BOX'S FILES (ROADMAP 52): the saved poses and scenes, listed the way _lists() lists them (poses/lib, poses,
## moves/ for a pose file; scenes, moves/ and scenes/_wip for a scene file: a file with cards or keys is a scene). Read
## when the box opens, not per keystroke
func _search_files() -> Array:
	var rows := []
	var scene := {}   # path -> is a scene file (each file read once)
	for dir in ["res://poses/lib", "res://poses", "res://moves", "res://scenes", "res://scenes/_wip"].reduce(func(a, x): return a + UserPaths.dirs(x), []):
		var d := DirAccess.open(dir)
		if d == null:
			continue
		var files := Array(d.get_files())
		files.sort()
		for f in files:
			if not f.ends_with(".json"):
				continue
			var path: String = dir + "/" + f
			if not scene.has(path):
				var txt := FileAccess.get_file_as_string(path)
				scene[path] = txt.contains("\"keys\"") or txt.contains("\"cards\"")
			var is_scene: bool = scene[path]
			# poses/ holds pose files and scenes/ scene files; moves/ holds both (each goes to the list the app shows it in)
			if (is_scene and "/poses" in dir) or (not is_scene and "/scenes" in dir):   # res:// or the user's copy (a build)
				continue
			rows.append(_file_row(path, "scene" if is_scene else "pose"))
	for mac in macros:   # ROADMAP 81: each saved macro is a row "Macro: <name>"
		var nm: String = mac["name"]
		rows.append({"name": Macros.ROW + nm, "kind": "macro", "also": "macro play recorded", "keys": "", "run": _macro_play.bind(nm),
			"desc": "%d steps, played on the part picked now: ONE undo step (Ctrl+Z takes all of it back)" % mac["steps"].size()})
	for sn in Histscript.list_names():   # O15: each saved script is a row "Script: <name>"
		rows.append({"name": Histscript.ROW + sn, "kind": "script", "also": "script run play replay history kscript", "keys": "", "run": _hs_play.bind(sn),
			"desc": "%s/%s%s: plays every line, ONE undo step (Ctrl+Z takes all of it back)" % [Histscript.DIR, sn, Histscript.EXT]})
	return rows


func _file_row(path: String, kind: String) -> Dictionary:
	var nm := path.get_file().get_basename().replace("_", " ")
	if kind == "pose":
		return {"name": nm, "kind": kind, "also": "pose", "keys": "", "run": _search_pose.bind(path),
			"desc": "%s: the body takes this pose (one undo step)" % path}
	return {"name": nm, "kind": kind, "also": "scene", "keys": "", "run": _open_scene_file.bind(path),
		"desc": "%s: opens the scene (asks first when this one has unsaved changes)" % path}


## MACROS (ROADMAP 81). Record: each palette command run while recording is a step; the words of a "Pose: ..." row are
## kept too. Play: the steps run in order on the part picked NOW (a step that needs a part stops the macro, naming the
## step, when none is picked); the whole play is one undo step. Undo / Redo / the macro commands are never steps.
const MACRO_SKIP := ["Record macro", "Stop macro recording", "Play macro...", "Undo", "Redo"]


func _macro_record() -> void:
	if rec_name != "":
		_say("already recording '%s': run the commands, then Stop macro recording" % rec_name)
		return
	rec_name = Macros.new_name(macros)
	rec_steps = []
	_macro_indicator()
	_say("recording '%s': each palette command you run is a step. Stop macro recording saves it" % rec_name)


func _macro_stop() -> void:
	if rec_name == "":
		_say("not recording: run Record macro first, then the commands, then Stop macro recording")
		return
	var nm := rec_name
	var n := rec_steps.size()
	if n > 0:
		macros.append({"name": nm, "steps": rec_steps})
	rec_name = ""
	rec_steps = []
	_macro_indicator()
	if n == 0:
		_say("'%s' has no steps, so nothing was saved: Record macro, run a command, then Stop" % nm)
	elif Macros.save_file(macros_file, macros):
		_say("saved '%s' with %d steps: type 'macro' in the S box to play it on any part" % [nm, n])
	else:
		_say("'%s' is kept for this session only: %s could not be written" % [nm, macros_file])


## a palette command or a Pose: row run while recording becomes a step (main's running signal, before it runs)
func _macro_note(n: String) -> void:
	if rec_name == "" or _macro_nest > 0 or n in MACRO_SKIP or n.begins_with(Macros.ROW):
		return
	var c := _command_named(n)
	if not c.is_empty():
		var has := B.ang.has(sel)
		rec_steps.append({"name": n, "words": "", "part": sel if has else "", "needs_part": bool(c["edits"]) and has})
	elif n.begins_with("Pose: "):
		rec_steps.append({"name": n, "words": n.substr(6), "part": "", "needs_part": false})
	else:
		return   # a saved pose or scene row is not a command: not a step
	_macro_indicator()


## O15 HISTORY AS A SCRIPT. The log hook: main's running signal (a palette command or a "Pose: ..." phrase). Undo / Redo and the
## script commands are not logged (an Undo would need the log to un-run a line); a command run by a key, a ribbon button or the
## local API does not pass the S box, so it is not in the log either
const HS_SKIP := ["Undo", "Redo", "Help: save this session as a script", "Help: run a script...", "Record macro", "Stop macro recording", "Play macro..."]


func _hs_note(n: String) -> void:
	if _hs_playing or _macro_nest > 0 or n in HS_SKIP:
		return
	var e := {"name": n, "id": "", "words": "", "sel": "", "t": Time.get_ticks_msec() / 1000.0}
	var c := _command_named(n)
	if not c.is_empty():
		e["id"] = c["id"]
	elif n.begins_with("Pose: "):
		e["words"] = n.substr(6)
	else:
		return   # a saved pose, scene, macro or script row is not a command
	if B.ang.has(sel) and sel != _hs_sel:
		e["sel"] = sel
		_hs_sel = sel
	_hs_log.append(e)


func _hs_save(name := "") -> String:
	if _hs_log.is_empty():
		_say("nothing to save yet: run a few commands from the S box, then Help: save this session as a script")
		return ""
	var nm := name if name != "" else Histscript.next_name()
	var path := Histscript.save(nm, _hs_log)
	if path == "":
		_say("the script could not be written to %s: check the disk, then run Help: save this session as a script again" % Histscript.DIR)
		return ""
	_say("saved %d commands as %s: Help: run a script... plays it back" % [_hs_log.size(), ProjectSettings.globalize_path(path)])
	return path


func _hs_play(nm: String) -> Dictionary:
	var path := "%s/%s%s" % [Histscript.DIR, nm, Histscript.EXT]
	if not FileAccess.file_exists(path):
		_say("there is no script called '%s': type 'script' in the S box to see the saved ones" % nm)
		return {"ok": false, "done": 0, "undo_steps": 0}
	return await _hs_run_text(FileAccess.get_file_as_string(path), nm)


## plays the lines through AgentTools.step (the local API's dispatch), all in ONE undo step (the macro play's way: _macro_nest
## makes every _push_undo after the first a no-op). Stops at the first line that cannot run, saying its line number and why
func _hs_run_text(text: String, label: String) -> Dictionary:
	if rec_name != "":
		_say("click 'Stop macro recording' first: a script cannot play while '%s' is being recorded" % rec_name)
		return {"ok": false, "done": 0, "undo_steps": 0}
	var tools = load("res://scripts/agent_tools.gd").new(self)
	var rows := Histscript.parse(text)
	var u0 := undo.size()
	_hs_playing = true
	_macro_nest = 1
	_macro_pushed = false
	_step_hint = Histscript.ROW + label
	var stop := ""
	var done := 0
	for r in rows:
		var where := "line %d (%s)" % [r["line"], r["text"]]
		if r["error"] != "":
			stop = "stopped at %s: %s" % [where, r["error"]]
			break
		var tok: String = r["tok"]
		if r["text"].begins_with("run ") and not tools.reg.has(tok):
			stop = "stopped at line %d: unknown command id '%s'. GET /describe or the S box lists the ids; fix or delete that line" % [r["line"], tok]
			break
		var st: Dictionary = await tools.step(tok)
		if not st["ok"]:
			stop = "stopped at %s: %s" % [where, st.get("error", "it failed")]
			break
		done += 1
	var opened := _macro_pushed
	_macro_nest = 0
	_hs_playing = false
	_step_hint = ""
	if opened:
		undo[-1]["name"] = Histscript.ROW + label
		_tree.set_name(_tree.cur, Histscript.ROW + label)
		_after_edit()
	_rebuild_cards()
	_refresh()
	var msg := ""
	if stop == "":
		msg = "script '%s': %d lines ran, %s" % [label, done, "one undo step (Ctrl+Z takes all of it back)" if opened else "they changed nothing"]
	elif opened:
		msg = "Script '%s' %s. The %d line(s) before it are one undo step: Ctrl+Z takes them back" % [label, stop, done]
	else:
		msg = "Script '%s' %s. Nothing in the scene changed" % [label, stop]
	_say(msg)
	return {"ok": stop == "", "done": done, "undo_steps": undo.size() - u0, "message": msg}


func _command_named(n: String) -> Dictionary:
	for c in ui_cmd.commands:
		if c["name"] == n:
			return c
	return {}


func _macro_indicator() -> void:
	rec_label.visible = rec_name != ""
	rec_label.text = "REC  %s   %d step%s   (Stop macro recording saves it)" % [rec_name, rec_steps.size(), "" if rec_steps.size() == 1 else "s"]


## ROADMAP 100: a plugin's command is ONE undo step, the macro play's way: its edits join the step opened before the
## first one (_push_undo is a no-op after it inside a command). A plugin that fails is disabled; its message is said
func _plugin_run(i: int, cid: String) -> void:
	var step := plugins.step_name(i, cid)
	_macro_nest = 1
	_macro_pushed = false
	var msg := plugins.run(i, cid)
	var opened := _macro_pushed
	_macro_nest = 0
	if opened:
		undo[-1]["name"] = step   # the status line would name it otherwise (the drag's step is named the same way)
		_tree.set_name(_tree.cur, step)
		_after_edit()
	_rebuild_cards()
	_refresh()
	if msg != "":
		_say(msg)
	elif not opened:
		_say("plugin command done: it changed nothing")
	else:
		_say("plugin command done: one undo step (Ctrl+Z takes it back)")


func _plugin_sel_get() -> Dictionary:
	return {"card": sel_card, "joint": sel, "object": sel_obj if sel_obj != "" else ("prop:%d" % sel_prop if sel_prop >= 0 else "")}


func _plugin_sel_card(i: int) -> void:
	sel_card = i
	sel_end = -1
	_rebuild_cards()


func _plugin_sel_joint(j: String) -> void:
	sel = j


func _plugin_mesh():
	return kmed.mesh if kmed != null and kmed.mesh != null else null


## L70: a plugin command that failed or ran too long takes its edits back: the step it opened is undone and dropped from redo
func _plugin_rollback() -> void:
	if not _macro_pushed:
		return
	_macro_nest = 0
	_macro_pushed = false
	_undo()
	if not redo.is_empty():
		redo.pop_back()


## L70: api.run_tool: the synchronous lines of the tool language (AgentTools.step always waits a frame, so it cannot run here):
## card=N  sel=<joint>  set=<joint>:bend,side,twist  name=<text>  pose=<words>  add  update
func _plugin_tool(tok: String) -> Dictionary:
	var no := func(why: String): return {"ok": false, "why": why}
	if tok.begins_with("card="):
		var n := int(tok.substr(5))
		if n < 1 or n > S.cards.size():
			return no.call("no card %d (the scene has %d)" % [n, S.cards.size()])
		_plugin_sel_card(n - 1)
	elif tok.begins_with("sel="):
		var j := tok.substr(4)
		if not (j in Body.BODY or j in Body.WEAPON):
			return no.call("no part '%s'" % j)
		sel = j
	elif tok.begins_with("set="):
		var p := tok.substr(4).split(":")
		var v: PackedStringArray = p[1].split(",") if p.size() == 2 else PackedStringArray()
		if p.size() != 2 or v.size() != 3 or not p[0] in Body.BODY:
			return no.call("set=<joint>:bend,side,twist  e.g. set=lowerarm_r:90,0,0")
		sel = p[0]
		_do(func(): B.set_ang_safe(p[0], Vector3(float(v[0]), float(v[1]), float(v[2]))))
	elif tok.begins_with("name="):
		if sel_card < 0 or tok.substr(5).strip_edges() == "":
			return no.call("name=<text> names the picked card: pick one first (card=N)")
		_card_rename(sel_card, tok.substr(5))
	elif tok.begins_with("pose="):
		var pr: Dictionary = _pose_words(tok.substr(5))
		if not pr["ok"]:
			return no.call(String(pr["error"]))
	elif tok == "add":
		_card_add()
	elif tok == "update":
		if sel_card < 0:
			return no.call("pick a card first (card=N)")
		_card_update(sel_card)
	else:
		return no.call("unknown tool line '%s': the lines are card=N, sel=<joint>, set=<joint>:b,s,t, name=<text>, pose=<words>, add, update" % tok)
	return {"ok": true, "why": "", "said": String(ui_status.text) if ui_status != null else ""}


## L70: api.export
func _plugin_export(kind: String, path: String) -> Dictionary:
	if kind == "bvh":
		if S.cards.size() < 2:
			return {"ok": false, "why": "an animation needs at least 2 cards before it can be exported"}
		var r := BvhExport.write(S, B, path)
		return {"ok": r[0] == OK, "why": "" if r[0] == OK else "could not write the file (%s)" % error_string(r[0])}
	return {"ok": false, "why": "unknown kind"}


## the S box's plugin rows follow the switches (a plugin switched on, off, or disabled itself)
func _plugins_changed() -> void:
	ui_cmd.commands = _commands() + plugins.command_rows()


func _macro_play(nm: String) -> void:
	var mac := Macros.find(macros, nm)
	if mac.is_empty():
		_say("there is no macro called '%s': type 'macro' in the S box to see the saved ones" % nm)
		return
	if rec_name != "":
		_say("click 'Stop macro recording' first: '%s' cannot play while '%s' is being recorded" % [nm, rec_name])
		return
	var steps: Array = mac["steps"]
	_macro_nest = 1
	_macro_pushed = false
	_step_hint = Macros.ROW + nm   # the one undo step is named after the macro
	var stop := ""
	var done := 0
	for i in steps.size():
		var st: Dictionary = steps[i]
		var where := "step %d of %d (%s)" % [i + 1, steps.size(), st["name"]]
		if st["needs_part"] and not B.ang.has(sel):
			stop = "stopped at %s: it needs a body part picked, and none is (the weapon or nothing is). Pick a body part, then run %s%s again" % [where, Macros.ROW, nm]
			break
		if st["words"] != "":
			var r: Dictionary = _pose_words(st["words"])
			if not r["ok"]:
				stop = "stopped at %s: %s" % [where, String(r["error"])]
				break
		else:
			var c := _command_named(st["name"])
			if c.is_empty():
				stop = "stopped at %s: that command is gone. Record the macro again" % where
				break
			(c["run"] as Callable).call()
		done += 1
	var opened := _macro_pushed   # an edit ran: the play's one undo step exists
	_macro_nest = 0
	_step_hint = ""
	_refresh()
	if stop == "":
		_say("played '%s': %d steps, one undo step (Ctrl+Z takes it back)" % [nm, done])
	elif opened:
		_say("Macro '%s' %s. The %d step(s) before it are one undo step: Ctrl+Z takes them back" % [nm, stop, done])
	else:
		_say("Macro '%s' %s. Nothing in the scene changed" % [nm, stop])


## a pose row of the S box: the body takes the pose, one undo step (the same as a pick in the Poses list)
func _search_pose(path: String) -> void:
	_push_undo()
	_load_pose(path)
	_refresh()
	_say("the body is now in pose '%s'" % path.get_file().get_basename().replace("_", " "))


var _clean := "[]"   # the cards as last opened or saved: anything else is unsaved work
var sel_end := -1    # X1: Shift+click a second card = the range from sel_card to it (-1 = just the picked card)
var _range_of := -1  # the picked card the range was made from: anything else picking a card ends the range


## the picked cards: the range sel_card..sel_end (either order), the one picked card, or none
func card_range() -> Array:
	if sel_card < 0 or sel_card >= S.cards.size():
		return []
	if sel_end < 0 or sel_end >= S.cards.size() or _range_of != sel_card:
		return [sel_card]
	return range(mini(sel_card, sel_end), maxi(sel_card, sel_end) + 1)


## R19: MULTI-SELECT CARDS. msel = the selected card indices (sorted), kept apart from sel_card (the current card, the body's pose).
## Ctrl+click toggles, Shift+click selects the range from the current card, a plain click selects one again.
var msel: Array = []
var card_clip: Array = []   # the copied cards (deep copies of the dictionaries)


func card_toggle(i: int) -> void:
	if i < 0 or i >= S.cards.size():
		return
	if msel.is_empty() and sel_card >= 0 and sel_card != i:
		msel = [sel_card]
	if i in msel:
		msel.erase(i)
	else:
		msel.append(i)
	msel.sort()
	_rebuild_cards()
	_say("%d card%s selected: right-click for retime / hold / copy / delete (a plain click picks one again)" % [msel.size(), "" if msel.size() == 1 else "s"])


## the cards the batch commands act on: the multi-selection, else the Shift range / the picked card
func card_sel() -> Array:
	return msel.duplicate() if not msel.is_empty() else card_range()


func _sel_or_say() -> Array:
	var idx := card_sel()
	if idx.is_empty():
		_say("no cards selected: Ctrl+click cards (or Shift+click a range) in the strip first")
	return idx


## batch retime: the move into each selected card and its hold x factor (an auto move becomes its number first). One undo step
func cards_retime(factor: float) -> String:
	var idx := _sel_or_say()
	if idx.is_empty():
		return "no cards selected"
	if not (factor >= 0.1 and factor <= 10.0):
		_say("retime by a factor from 0.1 to 10 (2 = twice as slow), not %s: type a factor in that range" % factor)
		return "bad factor"
	_step_hint = "Retime cards"
	_push_undo()
	_markers_hold()
	var mv := idx.map(func(i): return S.move_time(i) if i > 0 else 0.0)   # all read before any is written
	for n in idx.size():
		var i: int = idx[n]
		var c: Dictionary = S.cards[i]
		if i > 0:
			c["move"] = snappedf(maxf(0.04, mv[n] * factor), 0.001)
		c["hold"] = snappedf(float(c["hold"]) * factor, 0.001)
	_markers_follow()
	_rebuild_cards()
	_refresh()
	_say("%d cards x%s: the scene is now %s.  Ctrl+Z takes it back" % [idx.size(), String.num(factor, 2), Units.time(_ps().length(), S.fps)])
	return ""


func cards_set_hold(h: float) -> String:
	var idx := _sel_or_say()
	if idx.is_empty():
		return "no cards selected"
	_step_hint = "Set hold"
	_push_undo()
	_markers_hold()
	for i in idx:
		S.cards[i]["hold"] = maxf(0.0, h)
	_markers_follow()
	_rebuild_cards()
	_refresh()
	_say("%d cards hold %s s: the scene is now %s.  Ctrl+Z takes it back" % [idx.size(), String.num(h, 2), Units.time(_ps().length(), S.fps)])
	return ""


func cards_delete() -> String:
	var idx := _sel_or_say()
	if idx.is_empty():
		return "no cards selected"
	_step_hint = "Delete cards"
	_push_undo()
	var before := 0
	for i in idx:
		if i < sel_card:
			before += 1
	var rev := idx.duplicate()
	rev.sort()
	rev.reverse()
	for i in rev:
		S.cards.remove_at(i)
	sel_card = mini(sel_card - before, S.cards.size() - 1)
	msel = []
	sel_end = -1
	playhead = minf(playhead, _ps().length())
	_rebuild_cards()
	_refresh()
	_say("%d cards deleted.  Ctrl+Z brings them back" % idx.size())
	return ""


func cards_copy() -> String:
	var idx := _sel_or_say()
	if idx.is_empty():
		return "no cards selected"
	card_clip = idx.map(func(i): return (S.cards[i] as Dictionary).duplicate(true))
	_say("%d cards copied: pick the card they go after, then Paste (right-click a selected card, or the command 'Cards: paste after the current card')" % card_clip.size())
	return ""


## paste the copied cards (poses, move, hold, names exactly as copied) after the current card; they become the selection
func cards_paste() -> String:
	if card_clip.is_empty():
		_say("nothing copied: select cards (Ctrl+click) and copy them first")
		return "empty clipboard"
	_step_hint = "Paste cards"
	_push_undo()
	var at := sel_card + 1 if sel_card >= 0 else S.cards.size()
	msel = []
	for k in card_clip.size():
		S.cards.insert(at + k, (card_clip[k] as Dictionary).duplicate(true))
		msel.append(at + k)
	sel_end = -1
	_rebuild_cards()
	_refresh()
	_say("%d cards pasted after card %d.  Ctrl+Z takes them back" % [card_clip.size(), at])
	return ""


## RETIME (round 16+1, GATES X1): cards a..b (0-based, inclusive) play at pct %: the move into each and its hold x pct/100
## (to 1 ms). "" = done, else what was wrong. One undo step
func retime(a: int, b: int, pct: float) -> String:
	if S.cards.size() < 2:
		return "retime needs a scene of 2+ cards"
	if a < 0 or b >= S.cards.size() or a > b:
		return "no cards %d-%d (the scene has %d; the first must not be after the last)" % [a + 1, b + 1, S.cards.size()]
	if not (pct >= 10.0 and pct <= 1000.0):
		return "retime by 10 to 1000 %% (100 = as it is), not %s" % pct
	_push_undo()
	_markers_hold()
	S.retime(a, b, pct)   # the loop lives in Scene.retime (TextBlocking retimes a blocking by the same op)
	_markers_follow()
	_rebuild_cards()
	_refresh()
	_say("cards %d-%d at %.0f %%: the scene is now %s (Save scene keeps it)" % [a + 1, b + 1, pct, Units.time(_ps().length(), S.fps)])
	return ""


## AUTOSAVE (round 16, GATES W1): the unsaved scene to `autosave`, atomically: a temp file, then a rename, so a crash
## in the middle leaves the last good copy. Nothing unsaved, or nothing new since the last write: no write
func autosave_now() -> bool:
	if not _unsaved():
		return false
	var d := _scene_dict(false)   # TC3: the hero's file with its actors (the body kept). No bad_frames: that whole-scene
	# collision playback froze the app 1.4-7 s every 15 s on a two-fighter combo3; Save scene still writes them
	var what := JSON.stringify([d, scene_path])   # what is held, without the time: the same twice = no write
	if what == _as_last:
		return false
	var js := JSON.stringify({"scene": d, "path": scene_path, "at": Time.get_datetime_string_from_system(false, true)}, " ")
	var fp := ProjectSettings.globalize_path(autosave)
	DirAccess.make_dir_recursive_absolute(fp.get_base_dir())
	var f := FileAccess.open(fp + ".tmp", FileAccess.WRITE)
	if f == null:
		return false
	f.store_string(js)
	f.close()
	if DirAccess.rename_absolute(fp + ".tmp", fp) != OK:
		return false
	_as_last = what
	_ring_push(fp)
	return true


func _autosave_drop() -> void:
	var fp := ProjectSettings.globalize_path(autosave)
	for q in [fp, fp + ".tmp"]:
		if FileAccess.file_exists(q):
			DirAccess.remove_absolute(q)
	_as_last = ""


## RESTORE... (ROADMAP 59): every autosave written is also kept as the newest of RING_N rotating copies:
## user://autosave_1.json (the newest) .. user://autosave_5.json (the oldest; the next write drops it). A copy of the
## autosave file's bytes. A save or a quit does not drop them: the history is what Restore... is for, and it is bounded
func _ring_path(n: int) -> String:
	return autosave.get_basename() + "_%d.json" % n


func _ring_push(fp: String) -> void:
	if FileAccess.file_exists(_ring_path(RING_N)):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(_ring_path(RING_N)))
	for n in range(RING_N - 1, 0, -1):
		if FileAccess.file_exists(_ring_path(n)):
			DirAccess.rename_absolute(ProjectSettings.globalize_path(_ring_path(n)), ProjectSettings.globalize_path(_ring_path(n + 1)))
	DirAccess.copy_absolute(fp, ProjectSettings.globalize_path(_ring_path(1)))


## the kept autosaves, newest first: {path, at, name, cards, a} (a = the file's {scene, path, at}); unreadable ones skipped
func _ring_list() -> Array:
	var out := []
	for n in range(1, RING_N + 1):
		var p := _ring_path(n)
		if not FileAccess.file_exists(p):
			continue
		var a: Variant = JSON.parse_string(FileAccess.get_file_as_string(p))
		if not (a is Dictionary) or not (a.get("scene") is Dictionary) or not (a["scene"] as Dictionary).has("cards"):
			continue
		out.append({"path": p, "at": String(a.get("at", "")), "name": String(a["scene"].get("name", "")) if String(a["scene"].get("name", "")) != "" else String(a.get("path", "")).get_file().get_basename(), "cards": (a["scene"]["cards"] as Array).size(), "a": a})
	return out


## File > Restore...: the kept autosaves as a list (newest first) with a picture of the picked one. The copy is made by
## _restore_copy, after the scene on screen is saved or given up (it asks)
var ui_restore: AcceptDialog
var ui_restore_list: ItemList
var ui_restore_pic: TextureRect
var ui_restore_info: Label
var _restore_rows: Array = []
var _restore_shown := ""   # the autosave file whose picture the dialog shows


func _restore_open() -> void:
	_restore_rows = _ring_list()
	if _restore_rows.is_empty():
		_say("no autosaves kept yet: Kine keeps the last %d as you edit an unsaved scene (open File > Restore... to list them)" % RING_N)
		return
	if ui_restore == null:
		_restore_build()
	ui_restore_list.clear()
	for r in _restore_rows:
		ui_restore_list.add_item("%s   %s   %d cards" % [r["at"], r["name"] if r["name"] != "" else "(no name)", r["cards"]])
	ui_restore_list.select(0)
	_restore_pick(0)
	ui_restore.popup_centered()


func _restore_build() -> void:
	ui_restore = AcceptDialog.new()
	ui_restore.name = "restore_dialog"
	ui_restore.title = "Restore an autosave"
	ui_restore.ok_button_text = "Open as a new copy"
	ui_restore.min_size = Vector2i(620, 440)
	ui_restore.size = Vector2i(620, 440)   # the buttons sit at its foot: the content must not push them off the window
	var vb := VBoxContainer.new()
	vb.name = "restore_box"
	vb.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	vb.offset_bottom = -60
	ui_restore.add_child(vb)
	ui_restore_list = ItemList.new()
	ui_restore_list.name = "restore_list"
	ui_restore_list.custom_minimum_size = Vector2(0, 160)
	ui_restore_list.item_selected.connect(_restore_pick)
	vb.add_child(ui_restore_list)
	var hb := HBoxContainer.new()
	hb.name = "restore_row"
	vb.add_child(hb)
	ui_restore_pic = TextureRect.new()
	ui_restore_pic.name = "restore_pic"
	ui_restore_pic.custom_minimum_size = Vector2(SceneThumbs.SIZE.x * 3, SceneThumbs.SIZE.y * 3)
	ui_restore_pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	ui_restore_pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	hb.add_child(ui_restore_pic)
	ui_restore_info = Label.new()
	ui_restore_info.name = "restore_info"
	ui_restore_info.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	ui_restore_info.custom_minimum_size = Vector2(280, 0)
	ui_restore_info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	hb.add_child(ui_restore_info)
	ui_restore.confirmed.connect(_restore_go)
	add_child(ui_restore)


## the picked autosave: its time, scene, cards; its picture (drawn at once when cached, else when its turn comes)
func _restore_pick(i: int) -> void:
	if i < 0 or i >= _restore_rows.size():
		return
	var r: Dictionary = _restore_rows[i]
	_restore_shown = r["path"]
	ui_restore_info.text = "autosaved %s\n'%s', %d cards\nOpens as a NEW copy in scenes/_wip. The scene you have open and its file are not touched" % [
		r["at"], r["name"] if r["name"] != "" else "(no name)", r["cards"]]
	if thumbs != null:
		thumbs.request(r["path"])
		ui_restore_pic.texture = thumbs.picture(r["path"])


func _restore_go() -> void:
	var sel := ui_restore_list.get_selected_items()
	if sel.is_empty():
		_say("pick an autosave in the list, then Open as a new copy")
		return
	var r: Dictionary = _restore_rows[sel[0]]
	var go := func(): _restore_copy(r)
	if _unsaved():
		_ask_save(_scene_label(), go)   # asks first: opening replaces the scene on screen
	else:
		go.call()


## the autosave as a NEW scene in scenes/_wip, named after its scene (never over a file: _2, _3), opened as a clean copy
func _restore_copy(r: Dictionary) -> void:
	var a: Dictionary = r["a"]
	var nm := safe_file(String(r["name"])).trim_prefix("_wip/")
	var path: String = load("res://scripts/text_blocking.gd").unique_path(UserPaths.w("res://scenes/_wip"), (nm if nm != "" else "autosave") + "_restored")
	_write(path, a["scene"])
	_load_scene(path, true)
	_rebuild_cards()
	_refresh()
	_say("restored the autosave from %s as scenes/_wip/%s: %d cards. Your scenes are untouched" % [r["at"], path.get_file(), r["cards"]])


## RECENT (ROADMAP 59): the scenes opened or saved, newest first, at most RECENT_N, in the settings file [recent] scenes.
## A test's own settings file is the one written (never poser.cfg). A missing file stays listed, marked (missing), until
## RECENT_N newer scenes push it out
func _recent_list() -> Array:
	var cf := ConfigFile.new()
	cf.load(settings)
	var out := []
	for p in cf.get_value("recent", "scenes", []):
		out.append(String(p))
	return out


func _recent_note(path: String, saved := false) -> void:
	if path == "":
		return
	var l := _recent_list()
	l.erase(path)
	l.push_front(path)
	l = l.slice(0, RECENT_N)
	var cf := ConfigFile.new()
	cf.load(settings)
	cf.set_value("recent", "scenes", l)
	Recents.put_meta(cf, path, S, l)   # P13: when, how many cards, how long
	cf.save(settings)
	_recent_changed()
	if recents != null and (saved or not FileAccess.file_exists(Recents.thumb_path(path))):
		recents.capture(path)   # the picture of the 3D view, at save time (or the first time the scene is seen)


## THE START SCREEN at launch: once the recover offer and any intro are answered (and no tour is running)
func _start_screen_boot() -> void:
	for _i in 3:
		await get_tree().process_frame
	while ui_recover != null and ui_recover.visible:
		await ui_recover.visibility_changed
	# the opening intro plays first, and the start screen opens UNDER it (the intro is the top layer) just before it lets the app
	# through: the logo fades straight into the start screen, never into the bare app with the dummy in its T pose. A click that
	# skips the intro ends it at once: that frame opens the start screen too
	while intro != null and not intro._done and intro.t < intro.length() - KineIntro.FADE - 0.05:
		await get_tree().process_frame
	if tour_step < 0 and not onboard.pending:
		start_screen.show_screen(true)


## P13: the start panel, once the recover offer and any intro have been answered
## the Home button (icon + word): top bar in Expert, Easy's bar in Easy. It only opens the start screen (the unsaved-work question
## comes when a new project is then picked, as before)
