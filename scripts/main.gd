## ---- WEIGHT PAINT (ROADMAP 72): the skin of the body, painted. One stroke = one undo step; the weights are saved on release
## to user://weights/<key>.weights.json (the mannequin's own file is never written) and applied again on the next load.
func _wp_setup() -> void:
	wp = SkinPaint.read(pieces.values(), skel)
	if wp.is_empty() or wp["skin"] == null:
		wp = {}
		return
	if not SkinPaint.load_into(wp, wp_key) and wp.has("rejected"):   # SBUG2: a broken sidecar is set aside, never applied
		var moved := SkinPaint.quarantine(wp_key)
		wp_notice = "the saved skin weights (%s) are broken: %s. They were not used; the file is kept as %s. The body has its own weights." % [wp_key, wp["rejected"], moved.get_file() if moved != "" else "(could not be moved)"]
		push_warning(wp_notice)
		if ui_status != null:   # (at boot the status line does not exist yet: wp_notice stays for the first look)
			_say(wp_notice)
	SkinPaint.apply(wp)
	if wp_bind < 0:
		wp_bind = _wp_bind_of("lowerarm_r")


## the skin's bind index of a body joint (-1 when the skin does not bind it)
func _wp_bind_of(j: String) -> int:
	if wp.is_empty() or not bone_idx.has(j):
		return -1
	var skin: Skin = wp["skin"]
	var nm := skel.get_bone_name(int(bone_idx[j]))
	for k in skin.get_bind_count():
		if skin.get_bind_name(k) == nm:
			return k
	return -1


