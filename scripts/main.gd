	for f in n:
		var img: Image = await _blast_frame(shot, PlayblastExport.time_of(f, sp[0], sp[1], fps), fps, sp[0], sp[1])
		img.save_png("%s/frame_%04d.png" % [gdir, f])
	_shot_blast_end(shot)
	ui_root.visible = true
	clean = keep_clean
	_sides_apply()
	B.set_state(keep)
	playhead = keep_t
	playing = keep_playing
	_refresh()
	var ff := PlayblastExport.find_ffmpeg(ffmpeg_path) if with_mp4 else ""
	var mp4 := ""
	var how := ""
	if not with_mp4:
		how = ""
	elif ff == "":
		how = ". No .mp4: ffmpeg was not found; install it (winget install Gyan.FFmpeg, or ffmpeg.org), then run Export playblast (video) again, or set POSER_FFMPEG to ffmpeg.exe"
	elif PlayblastExport.encode(ff, gdir, fps, "%s/%s.mp4" % [gdir, nm], AudioTrack.audible_list(S.audio_tracks), sp[0]) == OK and FileAccess.file_exists("%s/%s.mp4" % [gdir, nm]):
		mp4 = "%s/%s.mp4" % [gdir, nm]
		how = " and %s.mp4" % nm
	else:
		how = ". No .mp4: ffmpeg (%s) failed on the frames; the PNGs are fine, run ffmpeg on them yourself" % ff
	_say_plain("playblast: %d PNG frames at %d fps (%s to %s) in %s%s" % [n, fps, Units.time(sp[0], S.fps), Units.time(sp[1], S.fps), dir, how])
	return {"dir": gdir, "frames": n, "mp4": mp4, "ffmpeg": ff}


## SAVE VIDEO (Easy's strip, Save video): the playblast as an .mp4 with no PNG frames. Each frame goes straight into ffmpeg's stdin
## while the next one renders (the encoder runs beside the renderer). A big progress line ("Saving video... 12 of 60 frames") and a
## Cancel button sit on a panel that is hidden only for each capture. Cancel deletes the folder, so no partial file stays. With no
## ffmpeg the PNG frames are kept (as Export playblast keeps them). Returns {"dir", "frames", "mp4", "ffmpeg"}; {} when refused or cancelled
var _pb_busy := false
var _pb_cancel := false
var _pb_layer: CanvasLayer
var _pb_label: Label
var _pb_bar: ProgressBar
var _pb_cancel_btn: Button


func _pb_panel_make() -> void:
	if _pb_layer != null:
		return
	_pb_layer = CanvasLayer.new()
	_pb_layer.layer = 90
	_pb_layer.name = "save_video_progress"
	add_child(_pb_layer)
	var pc := PanelContainer.new()
	pc.name = "panel"
	var sb := StyleBoxFlat.new()
	sb.bg_color = Tok.c("float")
	sb.border_color = Tok.c("accent")
	sb.set_border_width_all(2)
	sb.set_corner_radius_all(6)
	sb.set_content_margin_all(14)
	pc.add_theme_stylebox_override("panel", sb)
	pc.set_anchors_and_offsets_preset(Control.PRESET_CENTER_TOP)
	pc.offset_top = 70
	pc.custom_minimum_size = Vector2(560, 0)
	pc.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_pb_layer.add_child(pc)
	var vb := VBoxContainer.new()
	pc.add_child(vb)
	_pb_label = Label.new()
	_pb_label.name = "text"
	_pb_label.add_theme_font_size_override("font_size", 30)
	_pb_label.add_theme_color_override("font_color", Tok.c("text"))
	vb.add_child(_pb_label)
	_pb_bar = ProgressBar.new()
	_pb_bar.name = "bar"
	var fill := StyleBoxFlat.new()
	fill.bg_color = Tok.c("accent")
	_pb_bar.add_theme_stylebox_override("fill", fill)
	_pb_bar.custom_minimum_size = Vector2(0, 22)
	vb.add_child(_pb_bar)
	_pb_cancel_btn = Button.new()
	_pb_cancel_btn.name = "cancel"
	_pb_cancel_btn.text = "Cancel"
	_pb_cancel_btn.add_theme_font_size_override("font_size", 22)
	_pb_cancel_btn.tooltip_text = "stop saving the video: the folder and anything made so far are deleted; no video is kept"
	_pb_cancel_btn.pressed.connect(func(): _pb_cancel = true)
	vb.add_child(_pb_cancel_btn)
	_pb_layer.visible = false


func _save_video_playblast(root_dir := PlayblastExport.ROOT, clip := "", keep_frames := false) -> Dictionary:   # clip: the name the file takes (Easy: the clip's move words); "" = the scene's name; keep_frames: PNG frames kept beside the .mp4
	root_dir = UserPaths.w(root_dir)   # an exported build: the user's folder
	if _pb_busy:
		_say_plain("A video is already being saved: press Cancel on the progress panel to stop it")
		return {}
	if S.cards.size() < 2:
		_say_plain("NOT NOW: a playblast needs at least 2 cards (a move): press Enter to add a card, or open a scene in the list below")
		return {}
	var sp := PlayblastExport.span(pv_in, pv_out, _ps().length())
	var fps: int = S.fps
	var n := PlayblastExport.frame_count(sp[0], sp[1], fps)
	var base := clip if clip != "" else S.name
	var nm := safe_file(base) if base != "" else "scene"
	var dir := "%s/%s_%s" % [root_dir, nm, _stamp()]
	var gdir := ProjectSettings.globalize_path(dir)
	if DirAccess.make_dir_recursive_absolute(gdir) != OK:
		_say_plain("NOT DONE: the folder %s could not be made: close anything using it, or choose another place, and save the video again" % dir)
		return {}
	var ff := PlayblastExport.find_ffmpeg()
	var mp4 := "%s/%s.mp4" % [gdir, nm]
	_pb_busy = true
	_pb_cancel = false
	_pb_panel_make()
	_pb_layer.visible = true
	_pb_bar.value = 0.0
	_pb_label.text = "Saving video... 0 of %d frames" % n
	var keep := B.state()
	var keep_t := playhead
	var keep_playing := playing
	var keep_clean := clean
	playing = false
	clean = true
	_sides_apply()
	ui_root.visible = false
	var shot := _shot_blast_begin()
	var fast_hold := GpuTier.hold(get_viewport())   # Fast view (FSR 2) is for the live view: the file is rendered at full quality
	var pipe := {}   # the ffmpeg process and its stdin, started with the first frame (its size is the frame's)
	var done := 0
	var refused_pipe := false
	for f in n:
		if _pb_cancel:
			break
		_pb_layer.visible = false   # the panel is not in the picture of this capture
		var img: Image = await _blast_frame(shot, PlayblastExport.time_of(f, sp[0], sp[1], fps), fps, sp[0], sp[1])
		img.convert(Image.FORMAT_RGB8)
		if ff != "" and pipe.is_empty():
			var io := OS.execute_with_pipe(ff, PlayblastExport.args_pipe(img.get_width(), img.get_height(), fps, mp4, AudioTrack.audible_list(S.audio_tracks), sp[0]))
			if io.is_empty():
				refused_pipe = true
				break
			pipe = {"stdin": io["stdio"], "pid": io["pid"]}
			Children.add(io["pid"], io["stdio"])   # closing the app mid-save: the pipe is closed, then ffmpeg is killed
		if keep_frames and not pipe.is_empty():
			img.save_png("%s/frame_%04d.png" % [gdir, f])   # the story's film step keeps the frames beside the .mp4
		if pipe.is_empty():
			img.save_png("%s/frame_%04d.png" % [gdir, f])   # no ffmpeg: the PNG frames, as Export playblast keeps them
		else:
			(pipe["stdin"] as FileAccess).store_buffer(img.get_data())
		done += 1
		_pb_label.text = "Saving video... %d of %d frames" % [done, n]
		_pb_bar.value = 100.0 * float(done) / float(n)
		_pb_layer.visible = true
		await RenderingServer.frame_post_draw   # the panel is drawn (with the count, and Cancel reads) before the next frame
	_shot_blast_end(shot)
	GpuTier.release(get_viewport(), fast_hold)
	ui_root.visible = true
	clean = keep_clean
	_sides_apply()
	B.set_state(keep)
	playhead = keep_t
	playing = keep_playing
	_refresh()
	var cancelled := _pb_cancel
	if not pipe.is_empty():
		_pb_label.text = "Saving video... encoding the last frames" if not cancelled else "Cancelling..."
		_pb_layer.visible = true
		if cancelled:
			OS.kill(pipe["pid"])
		(pipe["stdin"] as FileAccess).close()
		while OS.is_process_running(pipe["pid"]):
			await get_tree().process_frame
		Children.done(pipe["pid"])
	var made := FileAccess.file_exists(mp4) and done == n
	_pb_layer.visible = false
	_pb_busy = cancelled   # a cancelled save stays busy until its folder is gone and it says so (else "not busy" was seen mid-cleanup)
	_pb_cancel = false
	if cancelled:
		for _try in 100:   # Windows keeps a file busy for a moment after ffmpeg exits: retry until the folder is gone
			PlayblastExport.rm_tree(gdir)
			if not DirAccess.dir_exists_absolute(gdir):
				break
			await get_tree().process_frame
		_say_plain("Video cancelled: nothing was kept")
		_pb_busy = false
		return {}
	if refused_pipe or (not pipe.is_empty() and not made):
		_say_plain("NOT DONE: ffmpeg (%s) could not make the video: close anything using %s and save the video again" % [ff, dir])
		return {}
	if pipe.is_empty() and ff == "":
		_say_plain("playblast: %d PNG frames at %d fps in %s. No .mp4: ffmpeg was not found; install it (winget install Gyan.FFmpeg, or ffmpeg.org), then save the video again, or set POSER_FFMPEG to ffmpeg.exe" % [n, fps, dir])
		return {"dir": gdir, "frames": n, "mp4": "", "ffmpeg": ""}
	return {"dir": gdir, "frames": n, "mp4": mp4 if pipe.is_empty() == false else "", "ffmpeg": ff}


## DELIVER: TURNTABLE VIDEO OF THIS POSE (ROADMAP_400 K08; scripts/turntable.gd): the CAMERA orbits the body once (frame k at yaw
## 360 k / n, n = seconds * fps), framed to the body and the held weapons with 15% margin, the 3D view only (no panels).
## The pose is the one on screen now (nothing is applied, nothing changes: not an edit). Written as an MJPEG .avi in
## user://turntables/<scene>_<stamp>.avi (AviWriter), plus an .mp4 beside it when ffmpeg is found. Returns {"avi", "mp4", "frames",
## "cams" (the camera of each frame), "quarters" ({k: Image} at 0/90/180/270 deg), "crop", "size", "fps"}; {} when refused.
func _export_turntable(seconds := 6.0, fps := 30, size := Vector2i(1280, 720), root_dir := Turntable.ROOT, ffmpeg_path := "") -> Dictionary:
	root_dir = UserPaths.w(root_dir)   # an exported build: the user's folder
	if seconds <= 0.0 or fps < 1 or size.x < 16 or size.y < 16:
		_say_plain("NOT DONE: a turntable needs seconds > 0, fps >= 1 and a size of at least 16x16: run Deliver: turntable video of this pose again with those")
		return {}
	var n := Turntable.frame_count(seconds, fps)
	var nm := safe_file(S.name) if S.name != "" else "scene"
	var stem := "%s/%s_%s" % [root_dir, nm, _stamp()]
	if DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(root_dir)) != OK:
		_say_plain("NOT DONE: the folder %s could not be made: close anything using it and run Deliver: turntable video of this pose again" % root_dir)
		return {}
	var keep_clean := clean
	var keep_big := big_view
	var keep_playing := playing
	var keep_dummy := dummy_on
	playing = false
	clean = true
	dummy_on = false   # the presentation shows the character (and what it holds) alone: no sparring dummy, no handles, no name tag
	_sides_apply()
	ui_root.visible = false
	_refresh()
	var vs := get_viewport().get_visible_rect().size
	var aspect := float(size.x) / float(size.y)
	var rect := Turntable.crop_rect(vs, aspect)
	var centre: Vector3 = B.P["pelvis"]
	var pit := pitch
	var d := Turntable.fit(Turntable.points(B), centre, pit, cam.fov, aspect, float(rect.size.y) / vs.y)
	var jpgs := []
	var cams := []
	var quarters := {}
	for k in n:
		var b := Basis.from_euler(Vector3(deg_to_rad(pit), deg_to_rad(Turntable.yaw_of(k, n, yaw)), 0))
		cam.transform = Transform3D(b, centre + b * Vector3(0, 0, d))
		cam.h_offset = 0.0
		cam.v_offset = 0.0
		cams.append(cam.transform)
		await get_tree().process_frame
		await RenderingServer.frame_post_draw
		var img: Image = get_viewport().get_texture().get_image().get_region(rect)
		if img.get_size() != size:
			img.resize(size.x, size.y, Image.INTERPOLATE_LANCZOS)
		img.convert(Image.FORMAT_RGB8)
		if (k * 4) % n == 0:
			quarters[k] = img.duplicate()
		jpgs.append(img.save_jpg_to_buffer(0.9))
	ui_root.visible = true
	clean = keep_clean
	big_view = keep_big
	playing = keep_playing
	dummy_on = keep_dummy
	_sides_apply()
	_cam()
	_refresh()
	var avi := stem + ".avi"
	var wrote := AviWriter.write(avi, jpgs, size.x, size.y, fps)
	var ff := PlayblastExport.find_ffmpeg(ffmpeg_path)
	var mp4 := ""
	var how := ""
	if ff != "" and wrote:
		var o := []
		if OS.execute(ff, PackedStringArray(["-y", "-loglevel", "error", "-i", ProjectSettings.globalize_path(avi), "-c:v", "libx264", "-pix_fmt", "yuv420p", ProjectSettings.globalize_path(stem + ".mp4")]), o, true) == OK and FileAccess.file_exists(stem + ".mp4"):
			mp4 = stem + ".mp4"
			how = " and an .mp4"
	_say_plain(("turntable: %d frames (%.1f s at %d fps, %dx%d) in %s.avi%s" % [n, seconds, fps, size.x, size.y, stem, how]) if wrote else "NOT DONE: the video file could not be written to %s: close anything using it and run Deliver: turntable video of this pose again" % root_dir)
	return {"avi": avi if wrote else "", "mp4": mp4, "frames": n, "cams": cams, "quarters": quarters, "crop": rect, "size": size, "fps": fps, "dist": d, "centre": centre}


## DELIVER: BREAKDOWN VIDEO (WITH THE JUDGES DRAWN) (ROADMAP_400 K23; scripts/judge_render.gd): the scene rendered frame by frame (n = length * fps)
## from a fixed camera (the current yaw / pitch, framed to the body over the WHOLE clip with 15% margin), side by side (left clean, right with
## the chosen overlays: "balance" COM + support polygon, "force" ground-reaction arrow, "boxes" hit / hurt boxes, "limits" red joint markers)
## or one view with them on, and under it a caption strip per frame: time, card, and the CHECK verdicts that fire on that frame.
## Written as an MJPEG .avi in user://breakdowns/<scene>_<stamp>.avi (+ .mp4 when ffmpeg is found). Every overlay toggle comes back as it was;
## nothing in the scene changes (not an edit). Returns {"avi", "mp4", "frames", "captions", "verdicts", "size", "fps", "sbs", "cam", "crop",
## "area", "images" ({k: Image} for the frames in keep_frames)}; {} when refused.
var judge_layer: JudgeRender
var judge_busy := false   # true while the breakdown pass runs: it poses the body frame by frame and restores it at the end


func _export_judge_render(side_by_side := true, overlays: Array = JudgeRender.ALL, fps := 0, size := Vector2i(1280, 720), root_dir := JudgeRender.ROOT, ffmpeg_path := "", keep_frames: Array = []) -> Dictionary:
	root_dir = UserPaths.w(root_dir)   # an exported build: the user's folder
	if S.cards.size() < 2:
		_say_plain("NOT NOW: a breakdown video needs at least 2 cards (a move): press Enter to add a card, then run Deliver: breakdown video (with the judges drawn) again")
		return {}
	if overlays.is_empty() or size.x < 64 or size.y < JudgeRender.STRIP_H + 32:
		_say_plain("NOT DONE: a breakdown needs at least one overlay (balance, force, boxes, limits) and a size of at least 64x%d: run Deliver: breakdown video (with the judges drawn) again with those" % (JudgeRender.STRIP_H + 32))
		return {}
	var rate: int = fps if fps > 0 else S.fps
	var n := JudgeRender.frame_count(S.length(), rate)
	var nm := safe_file(S.name) if S.name != "" else "scene"
	var stem := "%s/%s_%s" % [root_dir, nm, _stamp()]
	if DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(root_dir)) != OK:
		_say_plain("NOT DONE: the folder %s could not be made: close anything using it and run Deliver: breakdown video (with the judges drawn) again" % root_dir)
		return {}
	judge_busy = true
	var keep := B.state()
	var keep_t := playhead
	var keep_playing := playing
	var keep_clean := clean
	var keep_bal := bal.on
	var keep_boxes := fd_boxes
	var keep_dummy := dummy_on
	playing = false
	dummy_on = false   # the judges mark the character alone, as in the turntable: no sparring dummy
	# the pass over the clip: the verdicts per frame and the body's reach (for the framing)
	var fz := Feasible.check(S, B)
	var sm: Dictionary = _force_data() if overlays.has("force") else {}
	var pts := []
	var verdicts := []
	var captions := []
	for k in n:
		var t := JudgeRender.time_of(k, rate)
		_ps().apply(B, t)
		pts.append_array(Turntable.points(B))
		var vd := JudgeRender.verdicts_at(B, fz["findings"], t)
		verdicts.append(vd)
		captions.append(JudgeRender.caption(S, t, rate, vd))
	var lo := Vector3(INF, INF, INF)
	var hi := Vector3(-INF, -INF, -INF)
	for p in pts:
		lo = lo.min(p[0])
		hi = hi.max(p[0])
	var centre := (lo + hi) * 0.5
	var aw: int = size.x / 2 if side_by_side else size.x
	var ah: int = size.y - JudgeRender.STRIP_H
	clean = true
	_sides_apply()
	ui_root.visible = false
	if judge_layer == null:
		judge_layer = JudgeRender.new()
		add_child(judge_layer)
	var vs := get_viewport().get_visible_rect().size
	var rect := Turntable.crop_rect(vs, float(aw) / float(ah))
	var d := JudgeRender.fit_dist(pts, centre, yaw, pitch, cam.fov, float(aw) / float(ah), float(rect.size.y) / vs.y)
	var b := Basis.from_euler(Vector3(deg_to_rad(pitch), deg_to_rad(yaw), 0))
	var cam_xf := Transform3D(b, centre + b * Vector3(0, 0, d))
	var sv := SubViewport.new()   # the caption strip: a label rendered once per frame
	sv.size = Vector2i(size.x, JudgeRender.STRIP_H)
	sv.disable_3d = true
	sv.transparent_bg = false
	sv.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	var sbg := ColorRect.new()
	sbg.color = Tok.c("tl_bg")
	sbg.size = Vector2(size.x, JudgeRender.STRIP_H)
	sv.add_child(sbg)
	var lb := Label.new()
	lb.add_theme_font_size_override("font_size", clampi(size.x / 52, 11, 18))
	lb.add_theme_color_override("font_color", Tok.c("text"))
	lb.position = Vector2(10, 9)
	lb.size = Vector2(size.x - 20, JudgeRender.STRIP_H - 12)
	lb.clip_text = true
	sv.add_child(lb)
	add_child(sv)
	var jpgs := []
	var images := {}
	for k in n:
		var t := JudgeRender.time_of(k, rate)
		_ps().apply(B, t)
		playhead = t
		var halves := []
		for with_overlays in ([false, true] if side_by_side else [true]):
			bal.on = with_overlays and overlays.has("balance")
			fd_boxes = with_overlays and overlays.has("boxes")
			wt.render_active = true
			_refresh()
			cam.transform = cam_xf
			cam.h_offset = 0.0
			cam.v_offset = 0.0
			if with_overlays:
				judge_layer.show_frame(JudgeRender.arrow_at(sm, t) if overlays.has("force") else {}, JudgeRender.limit_joints(B) if overlays.has("limits") else [], B, cam_xf.origin, {"p": bal.last["com"], "col": BalanceView.colour(String(bal.last["state"]))} if bal.on and not bal.last.is_empty() else {})
			else:
				judge_layer.clear()
			lb.text = captions[k]
			await get_tree().process_frame
			await RenderingServer.frame_post_draw
			var img: Image = get_viewport().get_texture().get_image().get_region(rect)
			if img.get_size() != Vector2i(aw, ah):
				img.resize(aw, ah, Image.INTERPOLATE_LANCZOS)
			img.convert(Image.FORMAT_RGB8)
			halves.append(img)
			wt.render_active = false
		var strip: Image = sv.get_texture().get_image()
		strip.convert(Image.FORMAT_RGB8)
		var fr := Image.create(size.x, size.y, false, Image.FORMAT_RGB8)
		for h in halves.size():
			fr.blit_rect(halves[h], Rect2i(0, 0, aw, ah), Vector2i(h * aw, 0))
		fr.blit_rect(strip, Rect2i(0, 0, size.x, JudgeRender.STRIP_H), Vector2i(0, ah))
		if keep_frames.has(k):
			images[k] = fr.duplicate()
		jpgs.append(fr.save_jpg_to_buffer(0.9))
	sv.queue_free()
	judge_layer.clear()
	wt.draw(_ps(), playhead)
	bal.on = keep_bal
	fd_boxes = keep_boxes
	dummy_on = keep_dummy
	ui_root.visible = true
	clean = keep_clean
	playing = keep_playing
	_sides_apply()
	B.set_state(keep)
	playhead = keep_t
	_cam()
	_refresh()
	var avi := stem + ".avi"
	var wrote := AviWriter.write(avi, jpgs, size.x, size.y, rate)
	var ff := PlayblastExport.find_ffmpeg(ffmpeg_path)
	var mp4 := ""
	var how := ""
	if ff != "" and wrote:
		var o := []
		if OS.execute(ff, PackedStringArray(["-y", "-loglevel", "error", "-i", ProjectSettings.globalize_path(avi), "-c:v", "libx264", "-pix_fmt", "yuv420p", ProjectSettings.globalize_path(stem + ".mp4")]), o, true) == OK and FileAccess.file_exists(stem + ".mp4"):
			mp4 = stem + ".mp4"
			how = " and an .mp4"
	var fired := 0
	for vd in verdicts:
		fired += 1 if not (vd as Array).is_empty() else 0
	_say_plain(("breakdown: %d frames at %d fps, %s, %dx%d, a verdict fires on %d of them, in %s.avi%s" % [n, rate, "side by side" if side_by_side else "one view", size.x, size.y, fired, stem, how]) if wrote else "NOT DONE: the video file could not be written to %s: close anything using it and run Deliver: breakdown video (with the judges drawn) again" % root_dir)
	judge_busy = false
	return {"avi": avi if wrote else "", "mp4": mp4, "frames": n, "captions": captions, "verdicts": verdicts, "size": size, "fps": rate, "sbs": side_by_side, "cam": cam_xf, "crop": rect, "area": Vector2i(aw, ah), "images": images}


## MOTION BLUR (ROADMAP R3): off by default; a view setting like the smear frames (never saved, not an undo step). On: each
## playblast frame is the mean of blast_blur_n sub-frames spread over the shutter (PlayblastExport.shutter_times: 180 degrees =
## half the frame interval). Set from the command "Playblast: motion blur on/off" or the Export dialog's checkbox
var blast_blur := false
var blast_blur_n := 8
var blast_shutter := 0.5   # shutter as a fraction of the frame interval (0.5 = 180 deg); scripts/blast_blur.gd


func _blast_blur_toggle() -> void:
	blast_blur = not blast_blur
	if export_ui != null and export_ui.ui_blur != null:
		export_ui.ui_blur.set_pressed_no_signal(blast_blur)
	_say(("playblast motion blur on: %d sub-frames over a 180 deg shutter (%.1f ms at %d fps); a render takes %d times as long" % [blast_blur_n, 1000.0 * PlayblastExport.shutter_time(S.fps), S.fps, blast_blur_n]) if blast_blur else "playblast motion blur off")


## the image of the scene at time t as the playblast saves it: one render, or (motion blur on) the mean of the sub-frames over
## the shutter centred on t, kept inside [lo, hi]. With the blur off this is exactly the single render the playblast always did
func _blast_frame(shot: Dictionary, t: float, fps: int, lo: float, hi: float) -> Image:
	var ts: Array = BlastBlur.times(blast_blur, t, fps, blast_blur_n, blast_shutter, lo, hi)
	var imgs := []
	for tt in ts:
		playhead = tt
		_ps().apply(B, playhead)
		BlastBlur.on_time(playhead)
		wt.render_active = true   # R23: the weapon trail ribbon is part of the render (option "Weapon trail in renders")
		_refresh()
		_shot_blast_frame(shot)
		await get_tree().process_frame   # s276: a frame to settle (the first draw after a pose change shows the hands / hip one frame stale; r3 bar 2 caught it)
		await RenderingServer.frame_post_draw
		imgs.append(_shot_blast_image(shot, get_viewport().get_texture().get_image()))
		wt.render_active = false
		wt.draw(_ps(), playhead)
	return imgs[0] if imgs.size() == 1 else PlayblastExport.average(imgs)


## RENDER SHOTS TO VIDEO (ROADMAP round 2, R5; scripts/shot_render.gd): the camera sequencer's shots walked in order, each
## frame through ITS shot's camera (the cut falls on a frame boundary), PNGs in exports/shots/<scene>_<stamp>/ and, when ffmpeg is
## found, <scene>.mp4 beside them. A progress panel (percent, frame, shot) with a Cancel button; Esc cancels too: the app comes
## back as it was, the frames made so far stay, no .mp4. The panels are hidden only for the frame's capture.
## Returns {"dir", "frames", "mp4", "ffmpeg", "cancelled", "ranges", "want"}; {} when refused.
signal shots_render_done(result: Dictionary)
var _sr_busy := false
var _sr_cancel := false
var _sr_layer: CanvasLayer
var _sr_label: Label
var _sr_bar: ProgressBar


