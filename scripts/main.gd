## save the bat's place in the hand + the fingers as the new standard grip
func _save_grip() -> void:
	if not B.wep_on or B.wep_hand == "":
		_say("lock the bat to a hand first")
		return
	var h := B.wep_hand
	var sd := h.substr(h.length() - 2)
	var fing := {}
	for j in Body.FINGERS:
		if j.ends_with(sd):
			var v: Vector3 = B.ang[j]
			fing[j] = [snappedf(v.x, 0.1), snappedf(v.y, 0.1), snappedf(v.z, 0.1)]
	var d := {"_note": "standard %s grip, saved from the poser (body.gd weapon_to_hand)" % B.wep_kind, "weapon": B.wep_kind,
		"hand": h, "local_pos": Body._p(B.wep_lpos), "local_rot": Body._q(B.wep_lrot), "fingers": fing,
		"other_hand_m": B.grip_u if B.grip else -1.0}
	_confirm("Make this the standard %s grip?\nEvery weapon put in a hand from now on uses it; Ctrl+Z can't bring the old grip back." % B.wep_kind.replace("_", " "),
		"Make it standard", _save_grip_now.bind(d))


func _save_grip_now(d: Dictionary) -> void:
	_write("res://data/grips/%s.json" % B.wep_kind, d)
	_say("saved as the standard %s grip (where the main hand holds + the fingers%s)" % [B.wep_kind.replace("_", " "), ", + the other hand" if B.grip else ""])


## slide the main hand along the shaft, the weapon stays put, the body follows
func _slide(d: float) -> void:
	if not B.wep_on or B.wep_hand == "":
		_say("put a weapon in the hand first")
		return
	if not slide_body:
		B.slide_in_hand(-d)
		B.apply_grip()
		_say("the weapon slid in the hand: hand at %s from the lower end" % Units.len(B.hold_u()))
		return
	if B.slide_hand(d):
		_say("main hand at %s from the lower end%s" % [Units.len(B.hold_u()), ", the other hand re-gripped" if B.grip else ""])
	else:
		_say("the arm can't reach further that way: turn the weapon or move the body first")


## BLADE TURN / HEAD TILT (w4-bladeturn): the weapon turns inside the hand that holds it; the hand does not move. The card
## keeps it (one undo step per slider drag or button press). Words for the label: "Blade turn: 90° (edge forward)".
func _turn_word(d: float) -> String:
	var a := absf(d)
	if a <= 22.5:
		return "as held"
	if a >= 157.5:
		return "flipped"
	return "edge forward" if d > 0.0 else "edge back"


func _tilt_word(d: float) -> String:
	if absf(d) < 1.0:
		return "level"
	return "forward" if d > 0.0 else "back"


## the blade's turn and tilt (radians) now: the turn in the hand from the saved grip, the card keeps it, the other hand follows
## the handle or lets go if it can't (said)
## returns the words for the status line when the other hand let go ("" when it kept its grip)
func _blade_apply(turn_rad: float, tilt_rad: float) -> String:
	var tilt0 := B.wep_tilt
	B.set_blade(turn_rad, tilt_rad)
	var note := ""
	if B.grip:
		var miss := B.apply_grip()
		if miss > 0.02:
			B.grip = false
			note = "the other hand let go: it can't follow the handle that far round"
	if absf(B.wep_tilt - tilt0) > 1e-6:
		B.refit_fingers()   # w4-fingertilt: the shaft tipped, so the fingers that hold it close round it again
	_blade_card()
	return note


func _blade_by(deg: float) -> void:
	if not B.wep_on or B.wep_hand == "":
		_say("no weapon in a hand: put one in a hand first")
		return
	var note := _blade_apply(B.wep_turn + deg_to_rad(deg), B.wep_tilt)
	var said := "the blade turned %d°: %s; the hand and its grip stay" % [roundi(rad_to_deg(B.wep_turn)), _turn_word(rad_to_deg(B.wep_turn))]
	if note != "":
		said = "the blade turned %d°: %s; %s" % [roundi(rad_to_deg(B.wep_turn)), _turn_word(rad_to_deg(B.wep_turn)), note]
	_say(said)


func _on_blade_slider(v: float, k: String) -> void:
	if not B.wep_on or B.wep_hand == "":
		return
	var note := ""
	if k == "turn":
		note = _blade_apply(deg_to_rad(v), B.wep_tilt)
	else:
		note = _blade_apply(B.wep_turn, deg_to_rad(v))
	if note != "":
		_say(note)
	_after_edit()


## the picked card keeps the body's weapon (as a pose change does): the card the playhead is on when none is picked
func _blade_card() -> void:
	var ci := sel_card if sel_card >= 0 else LimbIK.card_at(S, playhead)
	if ci < 0 and not S.cards.is_empty():   # the playhead between cards (walk12: Flip said "flipped" and saved nothing): the nearest card in time
		var ts: Array = S.times()
		var best := INF
		for i in ts.size():
			var dd := 0.0 if playhead >= float(ts[i][0]) and playhead <= float(ts[i][1]) else minf(absf(playhead - float(ts[i][0])), absf(playhead - float(ts[i][1])))
			if dd < best:
				best = dd
				ci = i
	if ci < 0 or ci >= S.cards.size():
		return
	S.cards[ci]["pose"] = B.to_dict()
	_rebuild_cards()


## the blade sliders read the body back (no signal); shown while a weapon is in a hand
func _blade_sync() -> void:
	var held: bool = B != null and B.wep_on and B.wep_hand != "" and not _hides("figure")   # bug6: a house has no fighter, so no blade rows
	for k in ui_blade:
		var d: Dictionary = ui_blade[k]
		if not is_instance_valid(d["box"]):
			continue
		(d["box"] as Control).visible = held
		if not held:
			continue
		var v: float = rad_to_deg(B.wep_turn if k == "turn" else B.wep_tilt)
		var sl := d["slider"] as HSlider
		sl.set_value_no_signal(v)
		EasySliders._place_rest(sl, d["tick"])
		(d["label"] as Label).text = ("Blade turn: %d° (%s)" % [roundi(v), _turn_word(v)]) if k == "turn" else ("Head tilt: %d° (%s)" % [roundi(v), _tilt_word(v)])


## HANDS ROW (w4-handlock). The weapon's two hands in plain buttons: both hold it / let the off hand go / the weapon
## follows the hand (the old Free the bat). Each press is one undo step (_do); the state is said in words.
const HAND_NAME := {"hand_r": "Right hand", "hand_l": "Left hand"}


func _off_hand() -> String:
	return "hand_l" if B.wep_hand == "hand_r" else "hand_r"


## the off hand (the one not holding the weapon) is on the handle now
func _off_on_handle() -> bool:
	return B.wep_on and B.wep_hand != "" and B.grip and String(B.grip2.get("hand", "")) == _off_hand()


## the hands row: an overlay under the top bar (Expert: right of the browser; Easy: at the left), shown while a weapon is in a
## hand (Easy: and an arm or hand is picked). The Easy side panel gets only the lock (its height is fixed by the card strip).
func _hands_block(easy_side: bool) -> VBoxContainer:
	var box := VBoxContainer.new()
	box.name = "easy_lock_block" if easy_side else "hands_row"
	box.add_theme_constant_override("separation", 4)
	var d := {"box": box, "easy": easy_side}
	if easy_side:
		d["lock"] = _button("Lock this part", _toggle_lock.bind(""), "a locked part keeps its pose while you change the rest: it cannot be dragged")
		d["lock"].toggle_mode = true
		d["lock"].name = "easy_lock_part"
		box.add_child(d["lock"])
	else:
		d["state"] = _label("", 15, "info", true)
		d["state"].name = "hands_state"
		box.add_child(d["state"])
		var hb := HFlowContainer.new()   # the buttons under the state line, wrapping into a second row (a column covered the body; one row ran off the view)
		hb.custom_minimum_size = Vector2(330, 0)   # narrow: at 1280 wide the view beside a centred body is ~350 px
		hb.add_theme_constant_override("h_separation", 4)
		hb.add_theme_constant_override("v_separation", 4)
		box.add_child(hb)
		d["both"] = _button("Both hands", _do.bind(_hands_both), "puts the second hand back on the weapon's handle (one undo step)")
		d["both"].name = "btn_both_hands"
		hb.add_child(d["both"])
		d["let_l"] = _button("Free left hand", _do.bind(_hands_let_go.bind("hand_l")), "takes the left hand off the weapon: it stays where it is, free to move (one undo step)")
		d["let_l"].name = "btn_let_go_left"
		hb.add_child(d["let_l"])
		d["let_r"] = _button("Free right hand", _do.bind(_hands_let_go.bind("hand_r")), "takes the right hand off the weapon: it stays where it is, free to move (one undo step)")
		d["let_r"].name = "btn_let_go_right"
		hb.add_child(d["let_r"])
		d["follow"] = _button("Weapon in hand", _do.bind(_bat_lock), "on: the weapon moves with the hand that holds it. Off: the weapon moves alone (the old Free the bat)")
		d["follow"].toggle_mode = true
		d["follow"].name = "btn_weapon_follows"
		hb.add_child(d["follow"])
		d["only"] = _button("Only this part", _only_part_toggle, "on (default): a drag moves only the part you grab: no smart follow, no balance re-centre, and a second hand on the weapon lets go. Off: the old follow")
		d["only"].toggle_mode = true
		d["only"].name = "btn_only_part"
		hb.add_child(d["only"])
		d["turn90"] = _button("Turn blade 90°", _do.bind(_blade_by.bind(90.0)), "the blade rolls a quarter turn about the handle, inside the hand: the hand and its grip stay (one undo step; the card keeps it)")
		d["turn90"].name = "btn_turn_blade"
		hb.add_child(d["turn90"])
		d["flip"] = _button("Flip blade", _do.bind(_blade_by.bind(180.0)), "the blade turns half a turn about the handle: head the other way (one undo step; the card keeps it)")
		d["flip"].name = "btn_flip_blade"
		hb.add_child(d["flip"])
	ui_hands.append(d)
	_hands_refresh()
	return box


## C66: the hands card finds a free spot again when the camera or the layout moved something under it (only then: it does not
## follow an orbit that leaves it clear)
var _hands_sig := ""


func _hands_dock_tick() -> void:
	if ui_hands_panel == null or not is_instance_valid(ui_hands_panel) or not ui_hands_panel.visible or cam == null or B == null or (easy != null and easy.on):
		return
	var sig := str([cam.global_transform, cam.fov, cam.size, bottom_h, get_viewport().get_visible_rect().size, ui_bar.get_global_rect() if ui_bar != null else Rect2()])
	if sig == _hands_sig:
		return
	_hands_sig = sig
	var vs := get_viewport().get_visible_rect().size
	var vrect := Rect2(float(LEFT_W), float(TOP_H), vs.x - float(LEFT_W) - float(RIGHT_W), vs.y - float(TOP_H) - float(bottom_h))
	if not HandsDock.clear(ui_hands_panel, HandsDock.blockers(self, ui_hands_panel, vrect, [ui_status, ui_mouse, ui_bar, ui_cube]), HandsDock.points(self), vrect):
		_hands_refresh()


var _hd_last_key := 0   # L58: the hands card's last placement inputs and where it went
var _hd_last_pos := Vector2(INF, INF)
var _hd_last_size := Vector2.ZERO
var _props_gen := 0   # L58: counts the prop redraws (the hands card avoids props)


func _hands_refresh() -> void:
	if B == null:
		return
	var held: bool = B.wep_on and B.wep_hand != ""
	var on_h := _off_on_handle()
	var o := _off_hand()
	var wn := B.wep_kind.replace("_", " ")
	var st := ""
	if held:
		st = "%s holds the %s.  %s: %s" % [HAND_NAME[B.wep_hand], wn, HAND_NAME[o], "on the handle" if on_h else "free"]
	elif B.wep_on:
		st = "the %s is not in a hand (Weapon follows the hand puts it in one)" % wn
	else:
		st = "no weapon in a hand"
	var arm_pick := sel.begins_with("hand") or sel.begins_with("upperarm") or sel.begins_with("lowerarm")
	var easy_on: bool = easy != null and easy.on
	if ui_hands_panel != null and is_instance_valid(ui_hands_panel):
		ui_hands_panel.visible = held and not ExpertPages.PAGES.has(cur_page) and (not easy_on or arm_pick) and not _hides("figure")   # the pose pages only; bug6: never on a page that hides the figure (a 3D BUILDING project keeps the fighter's weapon state from ANIMATION)
		# the view's bottom RIGHT, over the floor, above the status line (under the top bar it covered the head; at the
		# left it met the "Click a part" tip)
		var vs := get_viewport().get_visible_rect().size
		var _hk := PerfDoc.t()
		ui_hands_panel.reset_size()
		PerfDoc.add("h_reset", _hk)
		if easy_on:   # Easy: the view's bottom left, over the floor (under its bar the "What should he do?" picker covered it: walk12;
			# its slider panel is at the right)
			ui_hands_panel.position = Vector2(12.0, vs.y - float(BOTTOM_H) - ui_hands_panel.size.y - 64.0)
		elif ui_hands_panel.visible or PerfDoc.slow:   # L12: a hidden card is not placed (it is placed in the refresh that shows it)
			var ps := ui_hands_panel.size
			var x0 := float(LEFT_W) + 12.0
			var x1 := vs.x - float(RIGHT_W) - 12.0 - ps.x
			var y0 := float(TOP_H) + 8.0
			var y1 := vs.y - float(BOTTOM_H) - ps.y - 64.0   # above the mouse-hint line...
			for lb in [ui_mouse, ui_status]:   # ...and above where that line and the status line really are (the scene panel
				if lb != null and is_instance_valid(lb) and lb.is_visible_in_tree():   # can be taller than BOTTOM_H: the strip covered them)
					y1 = minf(y1, lb.get_global_rect().position.y - ps.y - 8.0)
			_hk = PerfDoc.t()
			var body := _body_screen_rect().grow(12.0)
			PerfDoc.add("h_rect", _hk)
			var vrect := Rect2(float(LEFT_W), float(TOP_H), vs.x - float(LEFT_W) - float(RIGHT_W), vs.y - float(TOP_H) - float(bottom_h))   # C66
			var hb_flow: Control = null
			for d0 in ui_hands:
				if not d0["easy"] and d0.has("both"):
					hb_flow = (d0["both"] as Control).get_parent()
					(d0["state"] as Label).text = st   # its wrapped height is part of the card's size
			var _hd_blk: Array = HandsDock.blockers(self, ui_hands_panel, vrect, [ui_status, ui_mouse, ui_bar, ui_cube]) if hb_flow != null else []   # L58b: a Button planted on the view changes the key (the cached skip ignored it)
			var _hd_key := hash([_hd_blk, body, vrect, ps, x0, x1, y0, y1, _props_gen, sel, cur_page, held, B.wep_hand, B.wep_kind, on_h])   # L58: the same inputs place the card in the same spot
			if _hd_key == _hd_last_key and _hd_last_pos.is_finite():
				ui_hands_panel.size = _hd_last_size   # L58b: place() had set the size too (reset_size above shrinks it back)
				ui_hands_panel.position = _hd_last_pos
			else:
				_hk = PerfDoc.t()
				var docked: bool = hb_flow != null and HandsDock.place(ui_hands_panel, hb_flow, vrect, _hd_blk, body, HandsDock.points(self))
				PerfDoc.add("h_dock", _hk)
				if not docked:
					var pick := Vector2(x1, y1)
					for c in [Vector2(x1, y1), Vector2(x0, y0), Vector2(x0, y1), Vector2(x1, y0)]:
						if not Rect2(c, ps).intersects(body):
							pick = c
							break
					ui_hands_panel.position = PickDodge.fit(ui_hands_panel, pick, Rect2(float(LEFT_W) + 8.0, float(TOP_H) + 8.0, vs.x - float(LEFT_W) - float(RIGHT_W) - 16.0, vs.y - float(TOP_H) - 16.0 - float(BOTTOM_H) - 56.0), PickDodge.points(self))   # C29: never over a body pick point
				_hd_last_key = _hd_key
				_hd_last_pos = ui_hands_panel.position
				_hd_last_size = ui_hands_panel.size
		ui_hands_panel.position = ui_hands_panel.position.clamp(Vector2.ZERO, (vs - ui_hands_panel.size).max(Vector2.ZERO))   # no candidate fits a short window: it still stays on the view
	var _hk2 := PerfDoc.t()
	for d in ui_hands:
		if not is_instance_valid(d["box"]):
			continue
		if d["easy"]:
			(d["lock"] as Button).visible = sel != "" and not (sel in Body.WEAPON) and not _hides("figure")
			_set_label(d["lock"], "Unlock this part" if locked_parts.has(sel) else "Lock this part")
			(d["lock"] as Button).set_pressed_no_signal(locked_parts.has(sel))
			continue
		(d["state"] as Label).text = st
		(d["both"] as Button).disabled = on_h
		_grey(d["let_l"], "" if (on_h and o == "hand_l") else "the left hand is not holding the weapon: nothing to let go")   # B07: greyed says why
		_grey(d["let_r"], "" if (on_h and o == "hand_r") else "the right hand is not holding the weapon: nothing to let go")
		(d["follow"] as Button).set_pressed_no_signal(held)
		(d["only"] as Button).set_pressed_no_signal(only_part)
	PerfDoc.add("h_rows", _hk2)
	_hk2 = PerfDoc.t()
	_blade_sync()
	PerfDoc.add("h_blade", _hk2)


## the body's box on screen (its joints projected; empty when it is behind the camera)
func _body_screen_rect() -> Rect2:
	var r := Rect2()
	var first := true
	for j in B.P:
		var p: Vector3 = B.P[j]
		if cam.is_position_behind(p):
			continue
		var q := cam.unproject_position(p)
		if first:
			r = Rect2(q, Vector2.ZERO)
			first = false
		else:
			r = r.expand(q)
	return r


func _hands_both() -> void:
	if not B.wep_on or B.wep_hand == "":
		_say("no weapon in a hand: put one in a hand first")
		return
	var o := _off_hand()
	B.free_hand = ""
	var off := B.capture_second()
	if off < 0.0 or off > 0.05:
		B.grip = true   # the grip the hand had (or the fitted one) takes it back to the handle
	_say("%s back on the %s: both hands hold it" % [HAND_NAME[o], B.wep_kind.replace("_", " ")])


func _hands_let_go(h: String) -> void:
	if not B.wep_on or B.wep_hand == "" or h == B.wep_hand or not B.grip:
		return
	B.grip = false
	B.free_hand = h
	_say("%s let go of the %s (Both hands hold it puts it back)" % [HAND_NAME[h], B.wep_kind.replace("_", " ")])


## a drag of another part while both hands hold the weapon: the off hand lets go (only the part dragged moves)
func _hands_let_go_auto() -> void:
	var o := _off_hand()
	B.grip = false
	B.free_hand = o
	_hands_note = "%s let go of the %s: only the part you drag moves (Both hands hold it puts it back)" % [HAND_NAME[o], B.wep_kind.replace("_", " ")]


func _only_part_toggle() -> void:
	only_part = not only_part
	_say("only the part you drag moves: no smart follow, no balance re-centre" if only_part else "the old follow is on: a drag also moves the joints it is linked to, and the body keeps its balance")
	_refresh()


## G: the second hand on / off. On: if that hand is already on the shaft, it keeps the grip it has there.
func _toggle_second() -> void:
	if B.grip:
		B.grip = false
		_say("second hand off the weapon")
		return
	B.free_hand = ""
	var off := B.capture_second()
	if off < 0.0 or off > 0.05:
		B.grip = true   # the fitted grip of this kind (or the rough reach) takes the hand to the shaft
	_say("second hand on the weapon at %s" % Units.len(B.grip_u))


## the main hand to the weapon's lower end (6 cm of shaft left below the fist), in 3 cm steps so the arm follows
## smoothly; stops where the arm can't go further
func _hand_to_end() -> void:
	if not B.wep_on or B.wep_hand == "":
		_say("put a weapon in the hand first")
		return
	var n := 0
	while B.hold_u() > 0.09 and n < 60:
		var d := -minf(0.03, B.hold_u() - 0.06)
		if slide_body:
			if not B.slide_hand(d):
				break
		else:
			# round 36: slide_in_hand moves the hand's place on the shaft BY d; this was -d (copied from _slide's
			# key, where d is the weapon's move), so with "weapon moves" on the hand climbed to the far end
			if B.hold_u() + d < 0.0:
				break
			B.slide_in_hand(d)
			B.apply_grip()
		n += 1
	_say("main hand at %s from the lower end%s" % [Units.len(B.hold_u()), "" if B.hold_u() <= 0.1 else " (the arm can't follow further: turn the weapon or the body)"])


func _slide_mode() -> void:
	slide_body = not slide_body
	ui_slide_btn.text = "Slide , . : body follows" if slide_body else "Slide , . : weapon moves"
	_say("now , and . %s" % ("move the hand along the weapon, the weapon stays and the arm follows" if slide_body else "slide the weapon through the hand, the hand stays"))


## switch the weapon kind; if one is in a hand, it goes back in that hand with this kind's grip
func _kind(k: String) -> void:
	var h := B.wep_hand
	B.wep2_on = false   # one weapon picked: the off-hand one is put away
	B.set_kind(k)
	if B.wep_on and h != "":
		B.weapon_to_hand(h)
	elif not B.wep_on:
		B.weapon_to_hand("hand_r")
	sel = "bat_handle"
	_say(easy_holds(k) if easy != null and easy.on else {"metal_bat": "metal bat (84 cm)", "staff": "staff / bo (180 cm): slide your hand along it with , and .  and put the other hand on with G, [ ]",
		"long_hammer": "long hammer (110 cm, steel head across the tip): G for both hands, [ ] to slide the other hand",
		"long_axe": "long axe (1.2 m haft, a Dane axe's): G for both hands, [ ] to slide the other hand. Import a video now and he holds it in both",
		"sword": "arming sword (92 cm, one hand, 1.1 kg)",
		"longsword": "longsword (1.2 m, hand-and-a-half): G puts the second hand on or takes it off; a video import switches it per frame",
		"katana": "katana (1.0 m, both hands on the tsuka): G takes the second hand off or back",
		"spear": "spear (2 m, both hands, 55 cm apart): [ ] slides the front hand, , and . the back hand",
		"dagger": "dagger (30 cm, one hand)"}.get(k, PartWeapon.says(k)))


## A PART becomes the fighter's weapon (Easy Part and Expert Part's "Give it to the fighter"): PartWeapon registers its numbers and shape,
## then the bat hand takes it as any kind (one undo step). Returns the kind, "" when the Part has no solid yet
func give_part_weapon(rec: Dictionary) -> String:
	var kind := PartWeapon.register(rec)
	if kind == "":
		_say("That part has no solid yet: draw a shape and pull it up first")
		return ""
	_do(_kind.bind(kind))
	return kind


## a held Part changed: its numbers and shape are made anew (no undo step of its own: the Part's edit is the step)
func part_weapon_changed(rec: Dictionary) -> void:
	if not PartWeapon.is_part(B.wep_kind) or B.wep_kind != PartWeapon.key_of(rec):
		return
	if PartWeapon.register(rec) != "":
		var h := B.wep_hand
		B.set_kind(B.wep_kind)
		if B.wep_on and h != "":
			B.weapon_to_hand(h)


## DUAL WIELD (round 33, Nick 10-16): a dagger in each hand; the main one in the right (or the hand it is in now),
## the off-hand one in the other. Mirror swaps what the hands hold
func _two_daggers() -> void:
	var h := B.wep_hand if B.wep_on and B.wep_hand != "" else "hand_r"
	B.grip = false
	B.set_kind("dagger")
	B.weapon_to_hand(h)
	B.grip = false
	B.wep2_kind = "dagger"
	B.wep2_to_hand(B.twin(h))
	sel = "bat_handle"
	_say("two daggers: one in each hand (30 cm). Mirror pose swaps them: the other hand leads")


# ---------------------------------------------------------------- words

## a plain name for a part: "upperarm_r" -> "right upper arm"
## LEFT AND RIGHT (round 24, GATES EE2, UPGRADES #42): his left red (the floor's X, "his left"), his right blue, the
## middle dark; the joint dots and the selected part's name carry it
const SIDE_L := Color(0.9, 0.3, 0.3)
const SIDE_R := Color(0.3, 0.5, 0.95)
const SIDE_MID := Color(0.15, 0.15, 0.18)


static func side_col(j: String) -> Color:
	return SIDE_L if j.ends_with("_l") else (SIDE_R if j.ends_with("_r") else SIDE_MID)


func nice(j: String) -> String:
	return nice_of(j, B.wep_kind)


## a joint's plain name; static so a check that has no main (Rulebook's loop seam) names it the same way. wep: the held weapon kind
static func nice_of(j: String, wep: String) -> String:
	if (j == "bat_handle" or j == "bat_barrel") and wep.begins_with(PartWeapon.PREFIX):   # a Part weapon: its own name
		return "%s (%s)" % [PartWeapon.name_of(wep), "handle" if j == "bat_handle" else "barrel"]
	var names := {"pelvis": "hips", "spine_01": "lower back", "spine_02": "middle back", "spine_03": "chest",
		"neck_01": "neck", "head": "head", "clavicle": "shoulder", "upperarm": "upper arm", "lowerarm": "elbow / forearm",
		"hand": "wrist / hand", "thigh": "hip joint / thigh", "calf": "knee / shin", "foot": "ankle / foot", "ball": "toes",
		"bat_handle": "bat (handle)", "bat_barrel": "bat (barrel)"}
	if names.has(j):
		return names[j]
	var side := ""
	var base := j
	if j.ends_with("_l") or j.ends_with("_r"):
		side = "left " if j.ends_with("_l") else "right "
		base = j.substr(0, j.length() - 2)
	for f in ["thumb", "index", "middle", "ring", "pinky"]:
		if base.begins_with(f + "_"):
			var k := int(base.substr(base.length() - 1))
			return side + f + " finger, " + ["", "base", "middle", "tip"][k] + " joint"
	return side + names.get(base, base)


func _angles_words(j: String, v: Vector3) -> String:
	var out := []
	var L: Dictionary = B.lim[j]
	for k in 3:
		var key: String = ["bend", "side", "twist"][k]
		var r: Vector2 = L[key]
		if r.y - r.x > 0.5:
			out.append("%s %.0f°" % [["swing", "raise/tilt", "roll"][k], v[k]])
	return "   ".join(out)


func _how(j: String) -> String:
	if j in Body.WEAPON:
		return ""
	if j == "pelvis":
		return "Drag: tip the whole body.   Shift+drag: turn it.   Ctrl+drag: move it.   (or the sliders)"
	if j in ["hand_r", "hand_l"]:
		return "Drag: the whole arm follows the wrist.   Alt+drag: bend only the wrist.   Shift+drag: roll the hand."
	if j in ["foot_r", "foot_l"]:
		return "Drag: the whole leg follows the ankle.   Alt+drag: bend only the ankle.   Shift+drag: roll the foot."
	if j in Body.FINGERS:
		return "Drag: curl this finger joint.   Use the buttons below for the whole hand (open / grip / fist)."
	return "Drag: rotate it (its far end follows the mouse).   Shift+drag: roll it about its own length."


## FEEDBACK YOU CAN SEE (round 24, GATES EE3, UPGRADES #41): Ctrl+Z / Ctrl+Y show a toast over the view naming the
## step, gone after TOAST_T (a new one replaces it); a Fix flashes the cards it changed, fading back over FLASH_T
const TOAST_T := 1.6
const EASY_TOAST_T := 3.0   # Easy's toast: a few seconds, then gone (or replaced by the next action's message)
const FLASH_T := 0.7
const FLASH_COL := Color(1.7, 1.5, 0.75)
var ui_toast: Label
var _toast_gen := 0


func _toast(t: String) -> void:
	if ui_root == null:
		return
	if ui_toast == null:
		ui_toast = Label.new()
		ui_toast.name = "toast"
		ui_toast.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ui_toast.add_theme_font_size_override("font_size", 18)
		ui_toast.add_theme_color_override("font_color", Tok.c("say"))
		var sb := StyleBoxFlat.new()
		sb.bg_color = Tok.c("say_bg")
		sb.set_corner_radius_all(8)
		sb.set_content_margin_all(10)
		ui_toast.add_theme_stylebox_override("normal", sb)
		ui_root.add_child(ui_toast)
	ui_toast.text = t
	ui_toast.visible = true
	var hold := EASY_TOAST_T if easy != null and easy.on else TOAST_T
	ui_toast.set_anchors_and_offsets_preset(Control.PRESET_CENTER_TOP, Control.PRESET_MODE_MINSIZE)
	ui_toast.position.y = 96
	if bld != null and bld.on:
		bld.place_toast(ui_toast)   # BUILD: low in the view, never over the panel
		bld.place_toast.call_deferred(ui_toast)
	elif easy != null and easy.on:
		_easy_toast_place(ui_toast)
		_easy_toast_place.call_deferred(ui_toast)   # again once the strip has its new size (an undo can grow or shrink it this frame)
	_toast_off_buttons.call_deferred(ui_toast)   # S252: whatever the mode placed, the toast never sits on a button (L58: at the end of the frame, not inside an Undo)
	_toast_gen += 1
	var g := _toast_gen
	get_tree().create_timer(hold).timeout.connect(func():
		if g == _toast_gen and is_instance_valid(ui_toast):
			ui_toast.visible = false)


## S252: the toast's rect is moved, if it covers a visible button, to the nearest spot inside the window that covers none
## (and no side panel / browser / timeline either: their buttons are the obstacles; the panels' own rects are added below)
func _toast_off_buttons(t: Label) -> void:
	if t == null or not is_instance_valid(t) or not t.visible:
		return
	var org := Vector2.ZERO
	if t.get_parent() is Control:
		org = (t.get_parent() as Control).global_position
	var sz := t.size
	var vp := get_viewport().get_visible_rect().size
	var obs: Array = []
	_collect_button_rects(self, obs)
	var cur := Rect2(t.global_position, sz)
	var hit := false
	for b in obs:
		var q: Rect2 = cur.intersection(b)
		if q.size.x > 1.0 and q.size.y > 1.0:
			hit = true
			break
	if not hit and Rect2(Vector2.ZERO, vp).encloses(cur):
		return
	var best := Vector2(INF, INF)
	var bd := INF
	var y := float(TOP_H) + 4.0
	while y + sz.y <= vp.y - 4.0:
		var x := 4.0
		while x + sz.x <= vp.x - 4.0:
			var r := Rect2(Vector2(x, y), sz)
			var free := true
			for b in obs:
				var q: Rect2 = r.intersection(b)
				if q.size.x > 1.0 and q.size.y > 1.0:
					free = false
					break
			if free:
				var d := (Vector2(x, y) - cur.position).length_squared()
				if d < bd:
					bd = d
					best = Vector2(x, y)
			x += 12.0
		y += 6.0
	if bd < INF:
		t.position = best - org


## the toast is taken down now: an Easy action's new message replaces the old one (say, the library, a saved video)
func _toast_clear() -> void:
	if ui_toast != null:
		ui_toast.visible = false



## EASY TOAST PLACE (walk-through item 1): in Easy the toast takes the first place in the window that covers no visible Button:
## under the top bar, then just under each button's or panel's bottom edge (Easy's strip sits there). Falls back to the old place (y 96).
func _easy_toast_place(t: Label) -> void:
	var org := Vector2.ZERO
	if t.get_parent() is Control:
		org = (t.get_parent() as Control).global_position
	t.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT, Control.PRESET_MODE_MINSIZE)
	var sz := t.size
	var vp := get_viewport().get_visible_rect().size
	var btns: Array = []
	_collect_button_rects(self, btns)
	# the Easy panels a toast must not sit on either (the picker, its strip, the welcome and status lines, the card strip)
	var panels := [ui_mouse, ui_status, ui_bar, ui_cards, easy.home.strip, easy.home._scrub_row, easy.home.panel, ui_library]   # the scrub row: a slider is no button
	for n in panels:
		if n is Control and is_instance_valid(n) and (n as Control).is_visible_in_tree() and (n as Control).size.y > 0.0:
			btns.append((n as Control).get_global_rect())
	var ys: Array = [float(TOP_H) + 8.0]
	for b in btns:
		ys.append((b as Rect2).end.y + 6.0)
	ys.sort()
	var x := (vp.x - sz.x) * 0.5
	for y in ys:
		var r := Rect2(Vector2(x, y), sz)
		if r.end.y > vp.y:
			continue
		var free := true
		for b in btns:
			var q: Rect2 = r.intersection(b)
			if q.size.x > 1.0 and q.size.y > 1.0:
				free = false
				break
		if free:
			t.position = Vector2(x, y) - org
			return
	t.position = Vector2(x, 96.0) - org


## the global rects of the visible Buttons under n (a button in a hidden panel is not visible in the tree)
func _collect_button_rects(n: Node, out: Array) -> void:
	if n is Button and (n as Button).is_visible_in_tree() and (n as Button).size.x > 0.0:
		out.append((n as Control).get_global_rect())
	for c in n.get_children():
		_collect_button_rects(c, out)


