		add_child(ui_clash)
	_clash_do = _clash_go.bind(nm, then)
	ui_clash.dialog_text = "A different scene called '%s' already exists.\nReplace it with this one? Ctrl+Z can't bring the old file back.\nOr save this one as '%s_2'." % [nm, nm]
	ui_clash.popup_centered()
	if easy != null and easy.on:
		ui_clash_new.call_deferred("grab_focus")   # Easy: Enter takes the new name
	_say("A scene called '%s' already exists: Replace it, or Save as a new name" % nm)


## how = "replace" | "new" | "cancel" (the dialog's buttons, and what a test calls)
func _clash_choose(how: String) -> void:
	if not _clash_do.is_valid():   # already answered (a canceled after a button is not a second answer)
		return
	var go := _clash_do
	_clash_do = Callable()
	ui_clash.hide()
	go.call(how)


func _clash_go(how: String, nm: String, then: Callable) -> void:
	if how == "cancel":
		_say("kept open: nothing was saved under the name '%s'" % nm)
		return
	if how == "new":
		nm = _free_name(nm)
		ui_scene_name.text = nm
	_save_scene_now(nm)
	_then_if_saved(then)


## the first name_2, name_3... whose scene file is free
func _free_name(nm: String) -> String:
	var k := 2
	while FileAccess.file_exists(UserPaths.w("res://scenes/%s.json" % safe_file("%s_%d" % [nm, k]))):
		k += 1
	return "%s_%d" % [nm, k]


## the save went through: `then` goes on (an unsaved scene, a refused save, a guest's save: nothing goes on)
func _then_if_saved(then: Callable) -> void:
	if then.is_valid() and not _unsaved():
		then.call()


## A NAME AS A FILE (round 17, GATES X3): the name as typed stays the scene's (or pose's) name, shown and saved inside the
## file; the FILE's name is made safe: / \ : * ? " < > | and control characters -> _, spaces -> _ (as before),
## no leading dot (so no "..": nothing escapes the folder), no trailing dot or space (Windows drops them), a Windows
## device name (CON, NUL, COM1...) gets a _, at most 100 characters. Letters of any script and emoji stay. One leading
## "_wip/" is kept as the folder (machine copies and tests save there)
static func safe_file(nm: String) -> String:
	nm = nm.strip_edges()
	var pre := ""
	if nm.begins_with("_wip/") or nm.begins_with("_wip\\"):
		pre = "_wip/"
		nm = nm.substr(5)
	var out := ""
	for ch in nm:
		out += "_" if ch in ["/", "\\", ":", "*", "?", "\"", "<", ">", "|", " "] or ch.unicode_at(0) < 32 else ch
	out = out.rstrip(".")
	while out.begins_with("."):
		out = "_" + out.substr(1)
	var stem := out.get_slice(".", 0).to_upper()
	if stem in ["CON", "PRN", "AUX", "NUL"] or (stem.length() == 4 and (stem.begins_with("COM") or stem.begins_with("LPT")) and stem[3] in "123456789"):
		out += "_"
	out = out.left(100)
	return pre + out if out != "" else ""


## `Kine.exe --position 3000,3000 -- --selfcheck-save` (an exported build's own check; not run from source, no test uses it):
## one Easy card (Punch) builds its clip, Save scene writes the scene, the scene is reopened and must hold the same cards (>= 2).
## Files go to the user's real folder (UserPaths.w: Documents/Kine in a build), named selfcheck_<unix time>, so they stay there
## for the check. One line goes to user://selfcheck.txt (SELFCHECK OK|FAIL ...), then the app quits.
func _selfcheck_save() -> void:
	var clip := ""
	for i in 1200:   # the clip builds over frames: wait for it (about 20 s at most)
		await get_tree().process_frame
		if i == 0:
			easy.home.card(3)   # Punch
		if scene_path.begins_with(UserPaths.user_root() + "/scenes/_wip/") and FileAccess.file_exists(scene_path):
			clip = scene_path
			break
	for _k in 10:
		await get_tree().process_frame
	var nm := "selfcheck_%d" % Time.get_unix_time_from_system()
	ui_scene_name.text = nm
	_save_scene_now(nm)
	var saved := scene_path
	_new_scene()
	_load_scene(saved)
	_rebuild_cards()
	for _k in 4:
		await get_tree().process_frame
	var n := S.cards.size()
	var ok := clip != "" and FileAccess.file_exists(clip) and FileAccess.file_exists(saved) and n >= 2
	var line := "SELFCHECK %s clip=%s (exists %s) scene=%s (exists %s) reopened_cards=%d root=%s" % ["OK" if ok else "FAIL", clip,
		FileAccess.file_exists(clip), saved, FileAccess.file_exists(saved), n, UserPaths.user_root()]
	print(line)
	var f := FileAccess.open("user://selfcheck.txt", FileAccess.WRITE)
	if f != null:
		f.store_line(line)
		f.close()
	get_tree().quit()


func _save_scene_now(nm: String) -> void:
	if co != null and co.connected() and not co.is_host:
		_say("live co-edit: the host saves the scene (your fighter's work is on its side too): ask the host to save, or save your own copy under another name")
		return
	var H := _hero_scene()   # TC3: the file is the hero's scene, whoever is active
	H.name = nm if nm != "" else "scene_" + _stamp()   # the name as typed: what the scene is called
	BodyFile.before_save(self, safe_file(H.name).get_file())   # G07: an applied body with no file yet: a NEW .kbody first
	var d := _scene_dict()   # TC3: the hero's file with its actors (lossless: the body kept, round 8)
	var fname := safe_file(H.name) if safe_file(H.name) != "" else "scene_" + _stamp()
	var tpv: Node = get_node_or_null(KMeshVPaintUI.NODE)   # L55: the painted texture goes beside the scene (PNG) and is recorded in its JSON
	var tps: Dictionary = tpv.texture_source() if tpv != null else {}
	KMeshTPaintFile.record(d, tps, "%s_tpaint.png" % fname)
	if not _write("res://scenes/%s.json" % fname, d):   # S271: say it was skipped; the old file and scene_path stay as they were
		_say("not saved: a test run may not overwrite the shipped scene %s (save under another name, or a zz_ name)" % fname)
		return
	if not tps.is_empty():
		KMeshTPaintFile.write_png(tps, ProjectSettings.globalize_path(UserPaths.w("res://scenes/%s_tpaint.png" % fname)))
	if np.loaded:
		np.update_file(UserPaths.w("res://scenes/%s.json" % fname))   # R27: the index of your habits learns the saved scene
	_clean = _doc_key()
	_autosave_drop()
	scene_path = UserPaths.w("res://scenes/%s.json" % fname)
	_recent_note(scene_path, true)
	_journal_saved()
	_lists()
	_refresh()
	if easy != null and easy.on:   # Easy: "Saved run 68 (3.3 seconds)." (the name as its words; the length to a tenth of a second)
		_say("Saved %s (%.1f seconds)." % [H.name.replace("_", " "), roundf(H.length() * 10.0 + 0.001) / 10.0])   # the 0.001: 3.25 s reads 3.3, not 3.2 (float)
		if easy.home != null:   # the toast says where it went: the file's name and its folder (the status line keeps its words)
			_toast("Saved as %s in %s" % [fname, easy.home.folder_line(scene_path)])
	else:
		_say("saved scene %s: %d cards, %s, %d frames with parts inside each other" % [H.name, H.cards.size(), Units.time(H.length(), S.fps), d["bad_frames"].size()])


## the scene list's pick: opens it at once when nothing would be lost, asks first when the scene open now has changes
## that are not saved (opening can't be undone)
func _scene_picked(i: int) -> void:
	var p := String(ui_scenes.get_item_metadata(i))
