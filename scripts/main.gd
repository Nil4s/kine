## THE PAGE BAR: nine buttons, icon and name; every page is a real page (the expert ones are hidden in Easy mode)
func _build_page_bar() -> void:
	var bar := PanelContainer.new()
	bar.name = "page_bar"
	bar.theme_type_variation = "BottomBar"
	bar.anchor_top = 1.0
	bar.anchor_bottom = 1.0
	bar.anchor_right = 1.0
	bar.offset_top = -PAGE_H
	bar.grow_vertical = Control.GROW_DIRECTION_BEGIN   # never past the window's bottom edge, whatever the theme adds
	ui_page_bar = bar
	ui_root.add_child(bar)
	var h := HBoxContainer.new()
	h.alignment = BoxContainer.ALIGNMENT_CENTER
	h.add_theme_constant_override("separation", 4)
	bar.add_child(h)
	var group := ButtonGroup.new()
	for p in PAGES_ALL:
		var b := Button.new()
		b.name = ("tab_" + String(PAGE_ROW[p]).to_lower()) if PAGE_ROW.has(p) else ("page_" + p.to_lower())
		b.text = p
		b.icon = Icons.tex("page_" + p.to_lower())
		b.focus_mode = Control.FOCUS_NONE
		b.theme_type_variation = "RibbonTab"
		b.custom_minimum_size = Vector2(TAB_W, PAGE_H - 10)
		if PAGE_ROW.has(p):
			var i := PAGES.find(p)
			b.toggle_mode = true
			b.button_group = group
			b.tooltip_text = ("%s page (Shift+%d): %s" % [p, i + 1, PAGE_TIPS[p]]) if i >= 0 else "%s page: %s" % [p, PAGE_TIPS[p]]
			b.pressed.connect(func(): _step_hint = "Page: " + p; _page_set(p))
			ui_page_btns[p] = b
			ui_ribbon_tabs[PAGE_ROW[p]] = b
		var cell := Control.new()   # the tab's room: a plain Control has no minimum from its child, so the tab's own text cannot widen the bar
		cell.name = "cell_" + b.name
		cell.clip_contents = false   # P172LAYOUTS: the tab button is 30 px tall (its text), the cell 26: a clip cut 4 px off the bottom of every page tab
		cell.custom_minimum_size = Vector2(TAB_W, PAGE_H - 10)
		b.set_anchors_preset(Control.PRESET_FULL_RECT)
		cell.add_child(b)
		if p != "BUILD":
			h.add_child(cell)   # BUILD's tab joins the bar only in a 3D BUILDING project (_page_tabs_sync): every other bar is the nine pages
		if p == "DELIVER":
			var sep := VSeparator.new()
			sep.custom_minimum_size.x = 14
			h.add_child(sep)
	# R6: the one obvious next step, on every page, to the right of the page buttons (the page bar is every page's own strip)
	ui_next = Button.new()
	ui_next.name = "next_step"
	ui_next.focus_mode = Control.FOCUS_NONE
	ui_next.flat = true
	ui_next.alignment = HORIZONTAL_ALIGNMENT_LEFT
	ui_next.clip_text = true
	ui_next.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	ui_next.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	ui_next.custom_minimum_size = Vector2(0, PAGE_H - 10)
	ui_next.add_theme_font_size_override("font_size", 12)   # as the page tabs: the default 16 made this button 35 px tall and pushed the page tabs up out of the bar
	ui_next.add_theme_color_override("font_color", Tok.c("say"))
	ui_next.add_theme_color_override("font_hover_color", Tok.c("say"))
	ui_next.pressed.connect(_next_run)
	var next_box := Control.new()   # the Next: line's room: a plain Control has no minimum from its child, so the text is clipped, not the bar widened
	next_box.name = "next_box"
	next_box.clip_contents = false   # P172LAYOUTS: the Next: button is 29 px tall, its box 26: clipped 3 px (the text is clipped inside the button)
	next_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	next_box.size_flags_stretch_ratio = 2.0   # the Next: line gets the spare room first, the chips second
	next_box.custom_minimum_size = Vector2(0, PAGE_H - 10)
	ui_next.set_anchors_preset(Control.PRESET_FULL_RECT)
	next_box.add_child(ui_next)
	h.add_child(next_box)
	nt.load_file()
	ui_nt_box = HBoxContainer.new()
	ui_nt_box.name = "nt_chips"
	ui_nt_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	ui_nt_box.add_theme_constant_override("separation", 3)
	h.add_child(ui_nt_box)
	for i in 3:
		var ch := Button.new()
		ch.name = "nt_chip_%d" % i
		ch.focus_mode = Control.FOCUS_NONE
		ch.clip_text = true
		ch.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		ch.custom_minimum_size = Vector2(CHIP_MIN_W, PAGE_H - 12)
		ch.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		ch.add_theme_font_size_override("font_size", 11)
		ch.add_theme_color_override("font_color", Tok.c("say"))
		ch.visible = false
		ch.pressed.connect(_nt_run.bind(i))
		ui_nt_box.add_child(ch)
	_next_sync()
	_fit_page_bar()


## THE PAGE BAR OF A PROJECT KIND: a 3D BUILDING project shows BUILD | STAGE | CHECK | DELIVER (BUILD first); every other
## kind shows the nine pages it always had (BUILD is only that kind's page)
const BUILD_TABS := ["BUILD", "STAGE", "CHECK", "DELIVER"]
func _page_tabs_sync() -> void:
	if ui_page_btns.is_empty() or S == null:
		return
	var building: bool = S.kind == "building"
	var h := ui_page_bar.get_child(0) as Control
	var bc := (ui_page_btns["BUILD"] as Button).get_parent() as Control
	if building and bc.get_parent() == null:
		h.add_child(bc)
	elif not building and bc.get_parent() != null:
		h.remove_child(bc)
	if building:
		h.move_child(bc, 0)
	for p in PAGES_ALL:
		((ui_page_btns[p] as Button).get_parent() as Control).visible = BUILD_TABS.has(p) or not building
	_fit_page_bar()


## the page tabs narrow (their names ellipsis) when the window is too narrow for them, the Next: line and the chips:
## the room left after NEXT_RESERVE, split between the tabs, between TAB_MIN_W and TAB_W
func _fit_page_bar() -> void:
	if ui_page_btns.is_empty() or ui_page_bar == null:
		return
	var room := get_viewport().get_visible_rect().size.x - 16.0   # the bar's own margins
	var shown := ui_page_btns.values().filter(func(b): return (b as Button).get_parent().visible and (b as Button).get_parent().is_inside_tree()).size()
	var w := clampf(floorf((room - NEXT_RESERVE) / maxi(shown, 1)), TAB_MIN_W, TAB_W)
	for b in ui_page_btns.values():
		((b as Button).get_parent() as Control).custom_minimum_size.x = w   # the tab's cell (its clip) takes the width
	for p in ui_page_btns:   # C51: a narrow cell (1024x600) drops the icon so the name fits
		C51Tabs.apply(p, ui_page_btns[p], w)


## R6: THE ONE NEXT STEP, computed from the state; the same on every page, never empty. {text, cmd, kind}: cmd is the
## registry name of the command it runs ("" for a Fix, which is a button under a finding, not a registry row)
func next_step() -> Dictionary:
	if S.cards.is_empty():
		return {"text": "Clip this pose (Enter)", "cmd": "CLIP this pose (add a card)", "kind": "clip"}
	if S.cards.size() < 2:
		return {"text": "Clip the next pose (Enter): Check needs two clips", "cmd": "CLIP this pose (add a card)", "kind": "clip"}
	if not check_ran or undo.size() != check_at:
		return {"text": "Run Check", "cmd": "Check the motion", "kind": "check"}
	for f in findings:
		if f["sev"] == "FAIL":
			var lbl := Fixer.label(f, S)
			return {"text": "Fix the first problem: %s at %.2f s, card %d%s" % [f["rule"], f["t"], f["card"] + 1, (" (" + lbl.trim_prefix("Fix: ") + ")") if lbl != "" else " (jump to it)"], "cmd": "", "kind": "fix", "finding": f}
	var sk := strike_state()   # R7: a fist strike that does not reach the dummy's head is the next thing to do
	if not sk.is_empty() and dummy_on and float(sk["gap"]) > STRIKE_LANDS:
		if float(sk["aim_gap"]) > STRIKE_LANDS * 0.2:
			if T.dist > 0.61:
				return {"text": "Dummy closer: the arm cannot reach its head from %s (the fist stops %.0f cm short)" % [Units.len(T.dist), float(sk["gap"]) * 100.0], "cmd": "Dummy closer", "kind": "dummy"}
		else:
			return {"text": "Land the punch: its fist ends %.0f cm from the dummy's head (Strike: aim the fist at the dummy's head)" % (float(sk["gap"]) * 100.0), "cmd": "Strike: aim the fist at the dummy's head", "kind": "aim"}
	return {"text": "Export this clip (Export...)", "cmd": "Export...", "kind": "export"}


## R7: A PUNCH THAT LANDS. The contact card = the card a hand travels fastest into (wrist, average over the card's move; unarmed
## scenes only, at least Rulebook.STRIKE_MIN m/s: a swinging arm is not a strike). gap = the hand capsule to the dummy's head capsule,
## minus both radii (m): <= 0 touching, 0.05 = "within 5 cm". aim_gap = the same after solving the arm onto the head's skin on a
## scratch body (> 1 cm = out of arm's reach: the dummy has to come closer). {} = not a fist strike (or no cards / a weapon).
const STRIKE_LANDS := 0.05
var _sk_body: Body = null
var _sk_memo := {}


func _fist_gap(X: Body, hand: String) -> float:
	var hc: Array = X.cap(hand)
	var hd: Array = T.cap("head")
	return Body.seg_seg(hc[0], hc[1], hd[0], hd[1]) - float(X.rad[hand]) - float(T.D.rad["head"])


## solve X's `hand` arm so the fist touches the skin of the dummy's head on the side facing the hero (the body already posed at the
## strike card); returns the gap left (m)
func _fist_aim(X: Body, hand: String) -> float:
	var hd: Array = T.cap("head")
	var mid: Vector3 = ((hd[0] as Vector3) + (hd[1] as Vector3)) * 0.5
	var out := Vector3(-mid.x, 0.0, -mid.z)   # from the dummy's head toward the hero
	out = out.normalized() if out.length() > 1e-6 else Vector3(0, 0, -1)
	var skin: Vector3 = mid + out * float(T.D.rad["head"])
	for it in 6:
		var hc: Array = X.cap(hand)
		var wrist: Vector3 = X.P[hand]
		var far: Vector3 = hc[1] if ((hc[1] as Vector3) - wrist).length() > ((hc[0] as Vector3) - wrist).length() else hc[0]
		X.reach(hand, skin + out * float(X.rad[hand]) - (far - wrist))
	return _fist_gap(X, hand)


func strike_state() -> Dictionary:
	if S.cards.size() < 2:
		return {}
	var key := "%s|%.3f" % [JSON.stringify(S.cards).hash(), T.dist]
	if _sk_memo.get("key", "") == key:
		return _sk_memo["val"]
	var val := {}
	var armed := false
	for c in S.cards:
		armed = armed or not (c["pose"].get("weapon", {}) as Dictionary).is_empty()
	if not armed:
		if _sk_body == null:
			_sk_body = Body.new()
			_sk_body.load_files("res://data/skeleton.json", "res://data/body_limits.json")
		var X := _sk_body
		var ts: Array = S.times()
		var prev := {}
		var best := {}
		for i in S.cards.size():
			S.apply(X, float(ts[i][1]))
			var cur := {"hand_r": X.P["hand_r"], "hand_l": X.P["hand_l"]}
			if i > 0:
				var dt := maxf(S.move_time(i), 1.0 / 30.0)
				for h in ["hand_r", "hand_l"]:
					var v: float = ((cur[h] as Vector3) - (prev[h] as Vector3)).length() / dt
					if best.is_empty() or v > float(best["v"]):
						best = {"card": i, "hand": h, "v": v, "t": float(ts[i][1])}
			prev = cur
		if not best.is_empty() and float(best["v"]) >= Rulebook.STRIKE_MIN:
			S.apply(X, float(best["t"]))
			best["gap"] = _fist_gap(X, best["hand"])
			best["aim_gap"] = _fist_aim(X, best["hand"])
			val = best
	_sk_memo = {"key": key, "val": val}
	return val


## Strike: aim the fist at the dummy's head. The contact card's pose is the body there with the striking arm solved onto the head's
## skin (Body.reach on the shoulder and elbow); everything else on the card stays. One undo step
func _strike_aim() -> void:
	var sk := strike_state()
	if sk.is_empty():
		_say("no fist punch to aim: start from New from template: Punch (or clip a guard and a punch), then press this again")
		return
	var i: int = sk["card"]
	var hand: String = sk["hand"]
	var gap := 0.0
	_do(func():
		Scene.put(B, Moves._flat(S.cards[i]["pose"]))
		gap = _fist_aim(B, hand)
		S.cards[i]["pose"] = B.to_dict()
		sel_card = i
		playhead = S.times()[i][1]
		_rebuild_cards())
	if gap > 0.01:
		_say("card %d '%s': the %s fist stops %.0f cm from the dummy's head: it is out of arm's reach, so press Dummy closer, then this again" % [i + 1, S.cards[i]["name"], "left" if hand == "hand_l" else "right", gap * 100.0])
	else:
		_say("card %d '%s': the %s fist now lands on the dummy's head (gap %.1f cm).  Run Check, then Ctrl+Z takes it back" % [i + 1, S.cards[i]["name"], "left" if hand == "hand_l" else "right", gap * 100.0])


func _next_sync() -> void:
	if ui_next == null:
		return
	var n := next_step()
	ui_next.text = "Next:  " + String(n["text"])
	ui_next.tooltip_text = "the one next step for this scene; click it to do it"
	_nt_sync(n)


## P17: a command ran (palette, key, ribbon, chip). A macro's replay is one action, not many habits; the same name twice in one frame is one run
func _nt_note(n: String) -> void:
	if _macro_nest > 0 or _command_named(n).is_empty():
		return
	var fr := Engine.get_process_frames()
	if n == _nt_name and fr == _nt_frame:
		return
	_nt_name = n
	_nt_frame = fr
	nt.record(n, cur_page)
	_nt_sync.call_deferred({})


## a command that cannot do anything now (no card, one card) is not offered
func _nt_can(n: String) -> bool:
	if _command_named(n).is_empty():
		return false
	match n:
		"Check the motion", "Blend to next card": return S.cards.size() >= 2
		"Play / pause": return not S.cards.is_empty()
	return true


func _nt_sync(nx := {}) -> void:
	if ui_nt_box == null or ui_cmd == null or ui_cmd.commands.is_empty():
		return
	if nx.is_empty():
		nx = next_step()
	var pick: Array = nt.suggest(cur_page, _nt_can, 3, [String(nx.get("cmd", ""))])
	for i in ui_nt_box.get_child_count():
		var ch := ui_nt_box.get_child(i) as Button
		ch.visible = i < pick.size()
		if ch.visible:
			ch.text = String(pick[i])
			ch.tooltip_text = "you often do this next: %s (click to run it; Help: forget my command habits resets)" % pick[i]


func _nt_run(i: int) -> void:
	var ch := ui_nt_box.get_child(i) as Button
	var c := _command_named(ch.text)
	if c.is_empty():
		return
	_step_hint = ch.text
	_why_cmd = ch.text
	(c["run"] as Callable).call()
	_nt_sync()


func _nt_forget() -> void:
	nt.forget()
	_nt_sync()
	_say_plain("forgot your command habits: the chips after Next: start from the default sequence again")


func _next_run() -> void:
	var n := next_step()
	_step_hint = String(n["text"])
	match n["kind"]:
		"clip": _card_add()
		"check": _check()
		"dummy": _dummy_move(-0.25)
		"aim": _strike_aim()
		"fix":
			var f: Dictionary = n["finding"]
			if Fixer.label(f, S) != "":
				_fix(f)
			else:
				_goto_finding(f)
		_: _export_dialog_open()
	_next_sync()


## A PAGE (a view change: no undo step, the scene untouched): its ribbon row and its panels. Remembered in the settings file
## page-switch profiler (PAGES speed work): off by default; a test sets page_prof_on and reads page_prof (label -> microseconds)
var page_prof_on := false
var page_prof := {}
var _pp_last := 0


func _pp(label) -> void:
	if not page_prof_on:
		return
	var now := Time.get_ticks_usec()
	if label != null:
		page_prof[label] = int(page_prof.get(label, 0)) + now - _pp_last
	_pp_last = now


func _page_set(p: String, save := true) -> void:
	if not PAGE_ROW.has(p):
		return
	if easy != null and easy.on and ExpertPages.PAGES.has(p):
		return   # the expert pages are hidden in Easy mode (ExpertPages; the Shift+7..9 keys too)
	if p == "BUILD" and S.kind != "building":
		return   # the BUILD page belongs to a 3D BUILDING project
	_pp(null)
	var was_page := cur_page
	var was_mesh := ExpertPages.PAGES.has(cur_page)
	var is_mesh := ExpertPages.PAGES.has(p)
	if was_mesh and p != cur_page and _body_sculpt_on():
		ksc.stop()   # the body sculpt goes back to the body (ExpertPages._sculpt_body_left) before the page moves on
	var leave_msg := ""
	if was_mesh and not is_mesh:
		leave_msg = _mesh_leave_apply()   # the fighter's body: an edit is applied as one undo step, and the body closes
	if is_mesh and not was_mesh:   # a mesh page: the posing body's target dummy goes away (as Easy does), remembered
		_pose_dummy_was = dummy_on
		if dummy_on:
			dummy_on = false
			_dummy_hits()
	elif was_mesh and not is_mesh and _pose_dummy_was:   # back to a posing page: the dummy is as it was
		_pose_dummy_was = false
		if easy != null and easy.on:
			easy._dummy_was = true   # Easy came on from the mesh page: Easy's own way back gets the dummy (its set_on saved it off)
		elif not dummy_on:
			dummy_on = true
			_dummy_hits()
	_pp("leave")
	cur_page = p
	if bld != null:
		bld.page_changed(was_page, p)
	_pp("pre_show")
	_mesh_show_sync()
	_pp("mesh_show_sync")
	if is_mesh and save and not _mesh_opening and not _mesh_open() and not (kmed != null and kmed.on) and not (ksc != null and ksc.on):
		_mesh_open_later()   # only when nothing is open: a test cube open on another page is not stopped by it   # a mesh page with nothing open: the fighter's body opens by itself (no Test cube click), a frame or two later
	elif not is_mesh:
		_mesh_pending = false   # left for a posing page before the body opened: nothing to open
	_pp("mesh_auto_open")
	_hands_refresh()   # the hands strip is for the pose pages only
	_pp("hands_refresh")
	var page_said := ""
	if save and p != was_page:   # the status line says this page's own hint (it was the last page's message)
		page_said = "%s page: %s" % [p, PAGE_TIPS[p]]
	if leave_msg != "":
		page_said = (page_said + "   " if page_said != "" else "") + leave_msg   # what the leaving did, on the same status line
	if page_said != "":
		_say(page_said)
	for k in fold:
		fold[k] = _page_want(p, k)
	_pp("say_fold")
	_ribbon_row(PAGE_ROW[p])
	_pp("ribbon_row")
	if ui_reactions != null and p != "STAGE":
		ui_reactions.visible = false   # R16: the picker belongs to the STAGE page
	if ui_library != null and p != "STAGE":
		ui_library.visible = false   # the object library too (STAGE's SET row opens it)
	_pp("reactions")
	_sides_apply()
	_pp("sides_apply")
	_layout_bottom()
	_pp("layout_bottom")
	_chrome_sync()
	_pp("chrome_sync")
	_fit_rows.call_deferred()
	if tag != null:
		_refresh()   # the part tag and the joint dots follow the page (hidden on the mesh pages)
		_cam()   # _refresh shows every axis word again: the camera's fit hides those under the bottom bars
	_pp("refresh_cam")
	if model_cards != null:
		model_cards.page_opened(p)   # MODEL's task cards, when wanted (the first open in Expert)
	if page_tour != null and page_tour.card != null and not (model_cards != null and model_cards.open):
		page_tour.opened.call_deferred(p)   # P01: the page's first-use tour, once its panels are laid out
	_pp("tour")
	if save:
		var cf := ConfigFile.new()
		cf.load(settings)
		if cf.get_value("layout", "page", "POSE") != p:
			cf.set_value("layout", "page", p)
			cf.save(settings)
	_pp("save_cfg")


## MESH PAGES (Expert only): the posing overlays (inspector, part tag, joint dots, target dummy) stay off on MODEL / SCULPT / SURFACE
func _mesh_page() -> bool:
	return ExpertPages.PAGES.has(cur_page) and not (easy != null and easy.on)


## a mesh opened from a posing page (the search box, a shortcut): its own page first, so the posing browser and inspector
## step aside and the mesh panels have the left column (a cube opened on POSE drew its primitive panel over the browser)
## Also from a mesh page that does not show this object (the sphere opened from MODEL, the cube from SCULPT): that page hides it
## (_mesh_show_sync) and its strokes / clicks waited, so a sculpt in pose opened from MODEL moved nothing
func _mesh_page_for(p: String) -> void:
	if (easy != null and easy.on) or not ui_page_btns.has(p):
		return
	if not _mesh_page() or ((p == "SCULPT") != (cur_page == "SCULPT")):
		var was := _mesh_opening
		_mesh_opening = true   # the mesh opened here is the caller's: the page switch does not open the body as well
		_page_set(p)
		_mesh_opening = was


## the mesh this page shows is open: the sphere on SCULPT, the cube on MODEL and SURFACE
func _mesh_open() -> bool:
	if cur_page == "SCULPT":
		return ksc != null and ksc.on
	return kmed != null and kmed.on


## each mesh page shows only its own object: the cube on MODEL and SURFACE, the sphere on SCULPT, neither on the other pages.
## A hidden object is kept (its edits, undo and panels), so leaving and coming back loses nothing
func _mesh_show_sync() -> void:
	var mesh_pg := _mesh_page()
	if kmed != null:
		kmed.set_showing(mesh_pg and cur_page != "SCULPT", cur_page == "MODEL")
		kmed.sync_panels()   # the MODEL panels belong to MODEL: whatever opened the mesh
	if ksc != null:
		ksc.set_showing(mesh_pg and cur_page == "SCULPT")
	_mesh_edit_sync()


## the hint in the view while a mesh page has no mesh open; gone as soon as one is open or the page is left
func _mesh_hint_sync() -> void:
	if ui_mesh_hint == null:
		return
	_mesh_edit_sync()
	var txt: String = ExpertPages.HINTS.get(cur_page, "") if _mesh_page() else ""
	var show := txt != "" and not _mesh_open() and not _mesh_pending and not (model_cards != null and model_cards.open)
	if ui_mesh_hint.text != txt:
		ui_mesh_hint.text = txt
	if ui_mesh_hint.visible != show:
		ui_mesh_hint.visible = show
	if ui_mesh_hint_box.visible != show:
		ui_mesh_hint_box.visible = show
	if show:
		_mesh_hint_place()


## the hint's box: top centre of the clear view (under the ribbon), sized to its text
func _mesh_hint_place() -> void:
	ui_mesh_hint_box.reset_size()
	var cl := nav_clear_rect()
	var y := cl.position.y + 8.0 + ((ui_mesh_edit_box.size.y + 6.0) if (ui_mesh_edit_box != null and ui_mesh_edit_box.visible) else 0.0)
	ui_mesh_hint_box.position = Vector2(cl.position.x + (cl.size.x - ui_mesh_hint_box.size.x) * 0.5, y)


## the line at the top of a mesh page: what it edits now (the body, the test cube, the test sphere, or the file's name)
func _mesh_edit_sync() -> void:
	if ui_mesh_edit_box == null:
		return
	var show := _mesh_page()
	var txt := ""
	if show:
		if _mesh_pending and not _mesh_open():
			txt = "Opening the fighter's body..."
		elif BaseBody.is_open(self) or _body_sculpt_on():
			txt = "Editing: the fighter's body"
		elif ksc != null and ksc.on:
			txt = "Editing: Test sphere"
		elif kmed != null and kmed.on:
			var nm := ""
			if kmed.files != null and String(kmed.files.path) != "":
				nm = String(kmed.files.path).get_file().get_basename()
			txt = "Editing: %s" % (nm if nm != "" else "Test cube")
		else:
			txt = "Editing: nothing open yet (Switch... picks one)"
	if ui_mesh_edit.text != txt:
		ui_mesh_edit.text = txt
	if ui_mesh_edit_box.visible != show:
		ui_mesh_edit_box.visible = show
	if show:
		var cl := nav_clear_rect()
		ui_mesh_edit_box.reset_size()
		ui_mesh_edit_box.position = Vector2(cl.position.x + (cl.size.x - ui_mesh_edit_box.size.x) * 0.5, cl.position.y + 8.0)


func _body_sculpt_on() -> bool:
	return ksc != null and ksc.on and ksc.source.is_valid()


## the body's open is heavy (0.3-0.4 s: its mesh is built and read): a page switch shows "opening..." and does it two frames later,
## so the switch itself stays a UI toggle. The page it lands on is read when it runs (MODEL -> SCULPT meanwhile: that one)
var _mesh_pending := false


func _mesh_open_later() -> void:
	if _mesh_pending:
		return
	_mesh_pending = true
	_mesh_edit_sync()
	_mesh_open_wait.call_deferred()


func _mesh_open_wait() -> void:
	await get_tree().process_frame
	await get_tree().process_frame   # one painted frame of the "opening..." state
	if not _mesh_pending:
		return
	_mesh_pending = false
	var hint: String = ui_status.text
	var page_hint := hint.begins_with("%s page" % cur_page)   # the open's own status words came before the page's hint when it was synchronous: the hint still wins
	_mesh_boot_open()
	if page_hint and ui_status.text != hint:
		_say(hint)


## a mesh page with nothing open: the fighter's body opens (SCULPT: the body is sculpted, as "Sculpt the body" does)
func _mesh_auto_open(p: String) -> void:
	var was := _mesh_opening
	_mesh_opening = true
	if p == "SCULPT":
		ExpertPages._sculpt_body(self)
	else:
		BaseBody.start(self)
	_mesh_opening = was


## the boot's own _mesh_auto_open, once the world is built: only if the page is still a mesh page with nothing open
func _mesh_boot_open() -> void:
	if _mesh_page() and not _mesh_open() and not _body_sculpt_on() and not BaseBody.is_open(self):
		_mesh_auto_open(cur_page)
		_mesh_edit_sync()


## leaving the fighter's body (a posing page, Switch..., a test cube or sphere): an edit is applied as ONE undo step (Ctrl+Z
## takes it back), then the body closes and the fighter is back on screen. No edit: nothing is applied and no step is made
## -> the status line's words for what was done ("" when the body was not open). BaseBody._leave applies an edit
func _mesh_leave_apply() -> String:
	if _body_sculpt_on():
		ksc.stop()   # ExpertPages._sculpt_body_left: the strokes stay on the body's mesh
	if not BaseBody.is_open(self):
		return ""
	kmed.stop()   # the body is left: its edit applied (BaseBody.leave_apply), the fighter's parts back on screen
	return _leave_said


## the Switch... button: the menu of what this page can edit
func _mesh_switch_open() -> void:
	var r := ui_mesh_switch.get_global_rect()
	ui_mesh_switch_menu.position = Vector2i(int(r.position.x), int(r.end.y))
	ui_mesh_switch_menu.popup()


## the Switch... pick: 0 the fighter's body, 1 the test cube, 2 the test sphere. What was open is applied and closed first
func _mesh_switch_pick(id: int) -> void:
	if id == 0 and BaseBody.is_open(self):
		return
	_mesh_leave_apply()
	if id == 0:
		_mesh_auto_open("MODEL")
	elif id == 1:
		_kmesh_edit_start()
	else:
		_sculpt_start()
	_mesh_edit_sync()


func _page_want(p: String, which: String) -> bool:
	var o: Dictionary = page_fold.get(p, {})
	if o.has(which):
		return o[which]
	return PAGE_LAYOUT[p].get(which, base_fold[which])


## the user's pages from the settings file (their own folds per page, the page they left on)
func _pages_load(cf: ConfigFile) -> void:
	base_fold = fold.duplicate()
	for p in PAGES:
		for k in fold:
			if cf.has_section_key("pages", p + "_" + k):
				if not page_fold.has(p):
					page_fold[p] = {}
				page_fold[p][k] = cf.get_value("pages", p + "_" + k)
	var pg: String = cf.get_value("layout", "page", "POSE")
	if PAGE_ROW.has(pg) and pg != "POSE":
		_page_set(pg, false)


func _view_menu_fill() -> void:
	var pm := ui_view_menu.get_popup()
	pm.clear()
	var i := 0
	for b in ui_ribbon["VIEW"].get_children():
		if b is Button:
			pm.add_item(label_of(b), i)
			if ICON_OF.has(label_of(b)):
				pm.set_item_icon(pm.get_item_count() - 1, Icons.small(ICON_OF[label_of(b)]))
		i += 1


func _view_menu_pick(i: int) -> void:
	_run_tool(ui_ribbon["VIEW"].get_child(i), ui_view_menu)


## a tab's tools in its groups' order with a thin divider between groups (RR1); unnamed tools stay at the end
func _group(t: String) -> void:
	var row: HBoxContainer = ui_ribbon[t]
	var at := 0
	var gs: Array = RIBBON_GROUPS.get(t, [])
	for gi in gs.size():
		if gi > 0:
			var sep := VSeparator.new()
			sep.name = "group_sep"
			sep.custom_minimum_size.x = 12
			row.add_child(sep)
			row.move_child(sep, at)
			at += 1
		for lab in gs[gi][1]:
			for c in row.get_children():
				if c is Button and label_of(c) == lab:
					row.move_child(c, at)
					at += 1
					break


## each caption under its group: from its first shown tool's left to its last's right; none shown -> hidden
func _place_caps() -> void:
	for t in ui_caps:
		for pair in ui_caps[t]:
			var cap: MenuButton = pair[0]
			var shown: Array = (pair[1] as Array).filter(func(b): return (b as Control).is_visible_in_tree())
			cap.visible = t == _ribbon_tab and not shown.is_empty() and not (easy != null and easy.on) and not (bld != null and bld.part != null and bld.part.easy)   # Easy has no groups: its big buttons would sit on the captions
			if not cap.visible:
				continue
			var par := cap.get_parent() as Control
			var x0: float = (shown[0] as Control).get_global_rect().position.x - par.global_position.x
			var x1: float = (shown[-1] as Control).get_global_rect().end.x - par.global_position.x
			cap.position = Vector2(x0, 0)
			cap.size = Vector2(maxf(x1 - x0, cap.get_minimum_size().x), CAP_H)


## a tool picked by name from a menu (a caption's, or More's): the same as pressing it; a menu tool opens its own
## menu where the picker was
func _run_tool(b: Control, at: Control) -> void:
	if b is MenuButton:
		var pm := (b as MenuButton).get_popup()
		(b as MenuButton).about_to_popup.emit()
		pm.position = Vector2i(at.get_screen_position() + Vector2(0, at.size.y))
		pm.popup()
	elif b is Button:
		(b as Button).pressed.emit()


## THE TOP BAR ON A SMALL WINDOW (round 21, GATES BB1, UPGRADES #4): at 1280 x 720 the ANIMATE and VIEW tabs pushed
## History, Search and Help off the window. When the bar does not fit: first COMPACT (each label loses its "(key)":
## the key stays in the tooltip, on the ? list and in Search), then the tab's last tools go into a "More" menu, last
## first, until it fits. Run on a tab switch, a resize and a UI size change. Widths are summed from each control's own
## minimum (a container's cached minimum lags a text change by a frame)
var ui_tb: HBoxContainer
var ui_top_right: Array = []
var ui_more: MenuButton
var _ribbon_tab := "POSE"
var _more_tools: Array = []   # the tools now in More, in order


func _min_w(n: Control) -> float:
	if not n.visible:
		return 0.0
	if n is BoxContainer:
		var w := 0.0
		var k := 0
		for c in n.get_children():
			if c is Control and (c as Control).visible:
				w += _min_w(c)
				k += 1
		return w + maxf(0, k - 1) * n.get_theme_constant("separation")
	return maxf(n.get_minimum_size().x, n.custom_minimum_size.x)


func _top_fits() -> bool:
	# the room: to the window's right edge less the top panel's own right margin (round 22: a fixed 6 px was 4 short)
	# the top panel: the NEAREST PanelContainer up the tree (round 40: since round 36 the row sits in a VBox, so the
	# parent cast was null, the margin read 0 and the bar could run 10 px off the window)
	var right := 0.0
	var pc: Node = ui_tb.get_parent()
	while pc != null and not pc is PanelContainer:
		pc = pc.get_parent()
	if pc != null:
		var sb := (pc as PanelContainer).get_theme_stylebox("panel")
		right = sb.get_margin(SIDE_RIGHT) if sb != null else 0.0
	var room := get_viewport().get_visible_rect().end.x - right - ui_tb.get_global_rect().position.x
	var w := 0.0
	var k := 0
	for c in ui_tb.get_children():
		if c is Control and (c as Control).visible:
			k += 1   # every shown child takes a gap, the expanding filler too (round 22: it was left out, 6 px short)
			if not ((c as Control).size_flags_horizontal & Control.SIZE_EXPAND):
				w += _min_w(c)
	return w + maxf(0, k - 1) * ui_tb.get_theme_constant("separation") <= room


func _fit_top() -> void:
	if ui_tb == null:
		return
	_place_caps.call_deferred()   # the captions follow whatever this pass hides
	var all: Array = []
	for t in RIBBON_ALL:
		all.append_array(ui_ribbon[t].get_children())
	all.append_array(ui_top_right)
	for b in all:
		if b is Button and b.has_meta("full"):
			b.text = b.get_meta("full")
	var rest: Array = RIBBON_REST.get(_ribbon_tab, [])
	for b in ui_ribbon[_ribbon_tab].get_children():
		(b as Control).visible = (bld == null or bld.part == null or bld.part.ribbon_shows(b, _ribbon_tab)) and not (b is Button and label_of(b) in rest)   # BUILD: the house tools or the Part workspace's, never both; RIBBON_REST: under the caption only
	_tidy_dividers()
	var tools: Array = ui_ribbon[_ribbon_tab].get_children().filter(func(c): return c is Button and (c as Control).visible)
	ui_more.visible = false
	_more_tools = []
	if _top_fits():
		return
	for b in all:
		if b is Button and " (" in b.text:
			b.set_meta("full", b.text)
			if b.tooltip_text == "":
				b.tooltip_text = b.text
			elif not b.text in b.tooltip_text:
				b.tooltip_text = b.text + ": " + b.tooltip_text
			b.text = b.text.get_slice(" (", 0)
	ui_more.visible = true
	var k := tools.size() - 1
	while not _top_fits() and k >= 0:
		(tools[k] as Control).visible = false
		_more_tools.push_front(tools[k])
		k -= 1
	_tidy_dividers()
	if _more_tools.is_empty():
		ui_more.visible = false
		return
	var pm := ui_more.get_popup()
	pm.clear()
	for i in _more_tools.size():
		pm.add_item(label_of(_more_tools[i]), i)


## bug6: a group divider of the shown ribbon row shows only between two shown tools (never doubled, first or last: those were
## the "empty slots" before House name), and only the dividers of the set the row shows now (house tools or the Part workspace's)
func _tidy_dividers() -> void:
	var row: Array = ui_ribbon[_ribbon_tab].get_children()
	var prev_tool := false
	var pending: Control = null
	for c in row:
		var ctl := c as Control
		if ctl is VSeparator:
			var mine: bool = bld == null or bld.part == null or bld.part.ribbon_shows(ctl, _ribbon_tab)
			ctl.visible = false
			if mine and prev_tool:
				pending = ctl
				prev_tool = false
		elif ctl.visible:
			if pending != null:
				pending.visible = true
				pending = null
			prev_tool = true


## a tool picked from More: the same as pressing it (a menu tool opens its own menu where More is)
