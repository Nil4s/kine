	var tmp := "user://share/_tmp"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(tmp))
	var g := _export_glb(tmp)
	if g == "":
		return {}
	var info := ShareLink.glb_info(FileAccess.get_file_as_bytes(g))
	var nm := S.name if S.name != "" else "scene"
	var r := ShareLink.write(g, nm, int(info.get("frames", 0)), S.fps, root)
	DirAccess.remove_absolute(g)
