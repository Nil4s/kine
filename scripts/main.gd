		if oS != S and e.has("attrs") and var_to_str(e["attrs"]) != var_to_str(oS.attrs):
			oS.attrs = e["attrs"].duplicate(true)
			for a in actors_rt:
				if a["S"] == oS:
					a["t"] = NAN
	_refresh()


## EDIT FUNNEL vs POSE BAKE: an edit changes the cards (or any field apply reads) in place; the bake poll notices only a frame
## later, and until then Scene.apply would serve the poses of the content as it WAS (to Check, to a fix's re-sample, to the
## next undo step). Every edit goes through _push_undo (and every undo/redo through _restore), so both drop the bakers
## first; _bake_poll starts fresh ones from the new content.
func _bake_drop(extra: Scene = null) -> void:
	simc.edited()   # L42: an edit / undo / redo: the sim cache's memoized scene keys are dropped
	var seen := _bake_scenes()
	if extra != null:
		seen.append(extra)
	for sc in seen:
		if (sc as Scene).baker != null:
			(sc as Scene).baker.stop()
			(sc as Scene).baker = null


## drop only the bakers whose content no longer matches their scene (~1 ms a scene)
func _bake_validate() -> void:
	for sc in _bake_scenes():
		var bk: PoseBake = (sc as Scene).baker
		if bk != null and bk.sig != PoseBake.signature(sc):
			bk.stop()
			(sc as Scene).baker = null


func _push_undo() -> void:
	_bake_drop()
	if mm_ui != null:
		mm_ui.halt()   # an edit ends the motion matching preview: it would write its next frame over the edit (the toggle pushes its step first, then starts)
	if bm_ui != null:
		bm_ui.halt()
	if _undo_merge:   # Easy's + Add pose after a drag: no new step; easy_mode.add_pose renames the drag's step and keeps its undo state
		_step_hint = ""
		_step_easy = ""
		_jpending = true
		_co_sync()
		return
	if _macro_nest > 0:   # ROADMAP 81: a macro's edits share the one undo step, opened before its first edit
		if _macro_pushed:
			return
		_macro_pushed = true
	_tree_sync()
	if _jpending:
		_journal_write()   # the scene now is the last step's result: journaled before this step changes anything
	var u := _snapshot()
	if _step_hint != "":
		u["hint"] = step_name(_step_hint)
	_step_hint = ""
	if _step_easy != "":
		u["easy"] = _step_easy
	_step_easy = ""
	undo.append(u)
	_tree.push(u)   # a new branch node when there was a redo: the abandoned future stays in the tree
	_undo_tips()
	_history_rows.call_deferred()
	if undo.size() > UndoBudget.MAX_STEPS:
		undo.pop_front()
		undo_dropped += 1
		_tree.trim_root()
	redo.clear()
	UndoBudget.settle(self)   # Friday 175: the old steps packed, the oldest forgotten over the memory budget
	_jpending = true
	_co_sync()


## the top bar's Undo / Redo on a mesh page: the page's own mesh history (the pose's is a different list). true = taken
func _mesh_undo(back: bool) -> bool:
	if bld != null and bld.asm != null and bld.asm.undo_redo(back):   # G1MOTION: the Assembly screen's own steps (a drive added), while it is on
		return true
	if ksc != null and ksc.on and ksc.showing:
		ksc.undo_redo(back)
		return true
	if kmed != null and kmed.on and kmed.showing:
		kmed.undo_redo(back)
		return true
	return false


func _undo() -> void:
	if _mesh_undo(true):
		return
	sk.fitted = []   # I9: the faint fitted skeleton belongs to the pose that was undone
	var sk_hist: Variant = sk.hist.back() if not sk.hist.is_empty() else null
	sk.flips = {}   # ...and so do its flip handles, unless this undo takes back a flip (below)
	sk.hpos = []
	sk.queue_redraw()
	_tree_sync()
	if undo.is_empty():
		_say("nothing to undo yet: move a part of the body, and Undo takes that back" if (easy != null and easy.on) else "nothing to undo yet: click a part and drag it, and Ctrl+Z will take that back")
		_toast("Nothing to undo")   # S252: an empty stack says so in words, on the toast too
		return
	var u: Dictionary = undo.pop_back()
	_actor_set(int(u.get("actor", 0)))   # TC3: the redo step is taken on the actor this step changes
	var now := _snapshot()
	now["_sz"] = UndoBudget.raw_size_of(u)   # L58: an estimate until the next push measures it (UndoBudget.settle)
	now["_szest"] = true
	now["name"] = _step_label(u)   # the step keeps its name on the way back and forth
	if u.has("lib"):   # ROADMAP 96: a pack imported into the library: its files go to the trash, redo brings them back
		now["lib"] = u["lib"]
	if u.has("libedit"):   # C02: a pose library edit (delete / update) goes back and forth with the step
		now["libedit"] = u["libedit"]
	if u.get("swap", false):
		now["swap"] = true   # a whole-scene swap goes back and forth
	if u.has("easy"):
		now["easy"] = u["easy"]   # the Easy short name goes back and forth with the step, as its name does
	redo.append(now)
	_tree.step_back(now)
	_restore(u)
	UndoBudget.settle(self, true)
	_easy_forget_msg()
	_rehearse_again()   # I14: the comparison is read again from the clip as it now is
	if u.has("lib"):
		PosePack.lib_move(u["lib"], true, library)
	if u.has("libedit"):
		PoseLibraryEdit.step(u["libedit"], true, self)
	if sk_hist != null and B.state() == sk_hist["state"] and not sk.last.is_empty():
		sk.hist.pop_back()   # a flip was undone: its handles come back, each limb on the candidate it had
		sk.last = sk_hist["rep"]
		var fl: Dictionary = sk.last["flips"]
		for k in fl:
			if sk_hist["idx"].has(k):
				fl[k]["i" if fl[k]["kind"] == "limb" else "side"] = sk_hist["idx"][k]
		sk.flips = fl
		sk.fitted = SketchPose._skel(B, cam)
		_sk_show_handles()
	_say(("Took back: " + easy_name(u)) if easy != null and easy.on else "Undid: " + now["name"])   # Easy says the short name too; S252: Expert's status line and toast say the same words, a name always follows
	_toast(("Took back: " + easy_name(u)) if easy != null and easy.on else "Undid: " + now["name"])   # Easy's toast and status line say the same words ("Took back: Faster")
	_undo_tips()
	_history_rows()
	_jpending = true
	_co_sync()


## FUNDO2: the Easy part's last sentence ("Colour: Blue") named a step that Undo or Redo just changed: it goes, and its hint shows the next thing to press
func _easy_forget_msg() -> void:
	if bld != null and bld.part != null and bld.part.ep != null:
		bld.part.ep.msg = ""


func _redo() -> void:
	if _mesh_undo(false):
		return
	_tree_sync()
	if redo.is_empty():
		_say("Nothing to redo")   # S252: said in words (status line and toast), never a silent key press or an empty "Redid:"
		_toast("Nothing to redo")
		return
	var r: Dictionary = redo.pop_back()
	_actor_set(int(r.get("actor", 0)))   # TC3: as _undo
	var now := _snapshot()
	now["_sz"] = UndoBudget.raw_size_of(r)   # L58: as _undo
	now["_szest"] = true
	now["name"] = _step_label(r)
	if r.has("lib"):   # ROADMAP 96: as _undo, the other way: the import's files come back out of the trash
		now["lib"] = r["lib"]
	if r.has("libedit"):
		now["libedit"] = r["libedit"]
	if r.get("swap", false):
		now["swap"] = true
	if r.has("easy"):
		now["easy"] = r["easy"]
	undo.append(now)
	_tree.step_forward(now)
	_restore(r)
	UndoBudget.settle(self, true)
	_easy_forget_msg()
	_rehearse_again()   # I14
	if r.has("lib"):
		PosePack.lib_move(r["lib"], false, library)
	if r.has("libedit"):
		PoseLibraryEdit.step(r["libedit"], false, self)
	_say(("Put back: " + easy_name(r)) if easy != null and easy.on else "Redid: " + now["name"])
	_toast(("Put back: " + easy_name(r)) if easy != null and easy.on else "Redid: " + now["name"])   # Easy: the same words as the status line
	_undo_tips()
	_history_rows()
	_jpending = true
	_co_sync()


## ROADMAP 96: Share scene as a pack...: the saved scene (scenes/<name>.json) packed for someone else; nothing is changed here
