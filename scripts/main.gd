## I2 REACT TO THE HIT (PHYSICS; scripts/hit_physics.gd): the hit decides. The first moment a weapon or fist lands on a fighter's body
## (the fighters' report, measured now on clones like R16's contact) gives WHERE, the push's direction and the impulse (m_eff x v_rel);
## the MuJoCo humanoid (tools/physics/react.py) is run from the struck fighter's pose at the contact, on the R13 worker; its BVH comes
## in by R15's importer and the cards land on the struck fighter from the contact (R16's insert). One undo step; the attacker is
## never touched. victim: the fighter to look at (-1: whoever is hit first). The offer: when the report finds a contact, a small
## button sits at the contact in the view (hit_offer_btn) until the reaction is made; the result wears a label of the measured impulse
var hit_offer_btn: Button = null
var hit_label: Label = null
var hit_info := {}          # the last physics reaction: {"victim", "t0", "t1", "text", "res"}
var hit_offer := {}         # the contact the report found: {"victim", "t", "on", "at"}


## the first contact on a body part (a hit or a strike; not a weapon-on-weapon clash) that lands on `victim` (-1: any), measured now on clones
func _hit_row_for(victim := -1) -> Dictionary:
	_actors_sync()
	if actors_rt.size() < 2:
		return {}
	var hs: Scene = (actors_rt[0]["S"] as Scene).clone()
	var others := []
	for i in range(1, actors_rt.size()):
		others.append({"name": actors_rt[i]["name"], "S": (actors_rt[i]["S"] as Scene).clone(), "xf": actors_rt[i]["xf"]})
	for r in _fighters_measure(hs, others)["hits"]:   # sorted by time
		if (r["kind"] == "hit" or r["kind"] == "struck") and not Body.is_wep(String(r["on"])):
			var v: int = 0 if r["by"] == "other" else int(r["vs"])
			if victim < 0 or v == victim:
				return r
	return {}


func _react_physics(victim := -1) -> void:
	_actors_sync()
	if not _fighters_on():
		_say("React to the hit (physics) needs two fighters: 'Actor: add a second fighter' first, then let a weapon or fist touch the other one")
		return
	var row := _hit_row_for(victim)
	if row.is_empty():
		_say("no weapon or fist touches a fighter's body in this scene: swing into the other fighter (Check > Dummy lists the contacts), then try again")
		return
	var vk: int = 0 if row["by"] == "other" else int(row["vs"])   # the struck fighter
	var sk: int = int(row["vs"]) if row["by"] == "other" else 0   # the striker
	var blow := HitPhysics.measure(actors_rt[vk]["S"], actors_rt[vk]["B"], actors_rt[vk]["xf"], row, actors_rt[sk]["B"], actors_rt[sk]["S"])
	if not blow["ok"]:
		_say("no physics reaction: %s (pick a hit on a body part, then try again)" % blow["why"])
		return
	var Bw := _imp_body((actors_rt[vk]["B"] as Body).state())
	_imp_begin("physics reaction of %s" % actors_rt[vk]["name"], func(): return HitPhysics.work(blow, Bw, "hit"), _react_physics_land.bind(vk))


## the sim's clip lands: its cards go onto the struck fighter from the contact (one undo step, the struck fighter's own)
func _react_physics_land(res: Dictionary, vk: int) -> bool:
	if not res["ok"]:
		_say("the physics reaction could not be made: %s. Python 3 with mujoco and scipy is needed (pip install mujoco scipy), then press the button again" % res["why"])
		return false
	_actors_sync()
	if vk >= actors_rt.size():
		return false
	var fps: int = maxi(1, (actors_rt[vk]["S"] as Scene).fps)
	var t: float = snappedf(float(res["blow"]["t"]), 1.0 / float(fps))
	_actor_go(vk)
	_push_undo()
	var clip: Scene = res["clip"]
	ReactionPicker.insert(S, clip, t)
	playhead = t
	_ps().apply(B, playhead)
	_rebuild_cards()
	ov.mark_dirty()
	wt.mark_dirty()
	_refresh()
	var txt := HitPhysics.label(res)
	hit_info = {"victim": vk, "t0": t, "t1": t + ReactionPicker.LEAD_MOVE + clip.length(), "text": txt, "res": res, "n": (actors_rt[vk]["S"] as Scene).cards.size()}
	hit_offer = {}
	_say("%s reacts to the hit at %s (%s): %d cards from the MuJoCo humanoid; Ctrl+Z takes them off" % [actors_rt[vk]["name"] if vk > 0 else "the hero", Units.time(t, S.fps), txt, clip.cards.size()])
	return true


## the contact the report found is offered as a button at the contact; the measured label shows while the playhead is in the reaction
func _hit_ui_tick() -> void:
	if not hit_info.is_empty() and (int(hit_info["victim"]) >= actors_rt.size() or (actors_rt[int(hit_info["victim"])]["S"] as Scene).cards.size() != int(hit_info["n"])):
		hit_info = {}   # an undo (or any edit that changes the cards) takes the label with the reaction
	if hit_offer.is_empty() and hit_info.is_empty():
		if hit_offer_btn != null and hit_offer_btn.visible:
			hit_offer_btn.visible = false
		if hit_label != null and hit_label.visible:
			hit_label.visible = false
		return
	var vp := get_viewport().get_visible_rect().size
	if not hit_info.is_empty() and playhead >= float(hit_info["t0"]) - 1e-6 and playhead <= float(hit_info["t1"]):
		if hit_label == null:
			hit_label = Label.new()
			hit_label.name = "hit_label"
			hit_label.add_theme_font_size_override("font_size", 14)
			hit_label.add_theme_color_override("font_color", Tok.c("heading"))
			var sb := StyleBoxFlat.new()
			sb.bg_color = Tok.c("float")
			sb.set_corner_radius_all(5)
			sb.set_content_margin_all(5)
			hit_label.add_theme_stylebox_override("normal", sb)
			hit_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
			ui_root.add_child(hit_label)
		hit_label.text = String(hit_info["text"])
		hit_label.visible = true
		var k: int = int(hit_info["victim"])
		var W: Vector3 = _stage_xf() * (actors_rt[k]["xf"] as Transform3D) * ((actors_rt[k]["B"] as Body).P["head"] as Vector3)
		var sp := cam.unproject_position(W) + Vector2(-hit_label.size.x * 0.5, -hit_label.size.y - 70.0)
		hit_label.position = Vector2(clampf(sp.x, 8.0, maxf(8.0, vp.x - hit_label.size.x - 8.0)), clampf(sp.y, 8.0, maxf(8.0, vp.y - 40.0)))
	elif hit_label != null:
		hit_label.visible = false
	if not hit_offer.is_empty() and (hit_info.is_empty() or playhead < float(hit_info["t0"]) - 1e-6 or playhead > float(hit_info["t1"])):
		if hit_offer_btn == null:
			hit_offer_btn = Button.new()
			hit_offer_btn.name = "hit_offer"
			hit_offer_btn.focus_mode = Control.FOCUS_NONE
			hit_offer_btn.add_theme_font_size_override("font_size", 13)
			hit_offer_btn.pressed.connect(func(): _react_physics(int(hit_offer.get("victim", -1))))
			ui_root.add_child(hit_offer_btn)
		hit_offer_btn.text = "React to the hit (physics): %s at %s" % [String(hit_offer["on"]).replace("_", " "), Units.time(float(hit_offer["t"]), S.fps)]
		hit_offer_btn.tooltip_text = "a weapon or fist touches this fighter here: the MuJoCo humanoid reacts to the measured impulse, from this moment. One Ctrl+Z"
		hit_offer_btn.visible = true
		var W2: Vector3 = _stage_xf() * (hit_offer["at"] as Vector3)
		if cam.is_position_behind(W2):
			hit_offer_btn.visible = false
		else:
			var p2 := cam.unproject_position(W2) + Vector2(14.0, 14.0)
			hit_offer_btn.position = Vector2(clampf(p2.x, 8.0, maxf(8.0, vp.x - hit_offer_btn.size.x - 8.0)), clampf(p2.y, 8.0, maxf(8.0, vp.y - 40.0)))
	elif hit_offer_btn != null:
		hit_offer_btn.visible = false


## the weapon's drawn shape: rebuilt when its kind changes (WeaponMesh), then placed in the weapon's frame, the knob at
## x[0] and +Y along x[1] (Body.wep_xform), so each piece sits where its grip-frame cylinder is
func _wep_model_place(model: Node3D, kind: String, x: Array) -> void:
	var key := kind + "#%d" % int(Body.KINDS.get(kind, {}).get("rev", 0))   # a Part's shape is drawn again when its record changed
	if String(model.get_meta("kind", "")) != key:
		for c in model.get_children():
			model.remove_child(c)
			c.queue_free()
		model.add_child(WeaponMesh.build(kind))
		model.set_meta("kind", key)
	model.transform = Transform3D(Basis(x[1] as Quaternion), x[0] as Vector3)


## the drawn pieces of both weapons (the shading modes and the isolation switch them with the body)
func weapon_pieces() -> Array:
	var out := []
	for root in [wep_model, wep2_model]:
		if root != null:
			out.append_array(root.find_children("*", "MeshInstance3D", true, false))
	return out


func _cyl(top: float, bottom: float, m: Material) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var c := CylinderMesh.new()
	c.top_radius = top
	c.bottom_radius = bottom
	mi.mesh = c
	mi.material_override = m
	add_child(mi)
	return mi


## one translucent capsule for part j (parts[j], mats[j]): a weapon's always; a body part's only while the Collision
## view is on (show_caps), since a body part is picked and lit on its own skin
func _new_cap(j: String) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.name = "cap_" + j
	var cm := CapsuleMesh.new()
	cm.radius = B.rad[j]
	cm.height = 1.0
	cm.radial_segments = 20
	cm.rings = 6
	mi.mesh = cm
	var m := StandardMaterial3D.new()
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mi.material_override = m
	add_child(mi)
	parts[j] = mi
	mats[j] = m
	return mi


## PRECISE PICK (Nick 10-19): the pick and the highlight read the body's skinned pieces as drawn (scripts/skin_pick.gd)
func _skp_build() -> void:
	var part_of := {}
	for j in pieces:
		part_of[pieces[j]] = j
	skp.build(pieces.values(), skel, part_of)


## a capsule (or cylinder) from a to b: Godot's meshes run along their local Y
func _place(mi: MeshInstance3D, a: Vector3, b: Vector3, r: float, capsule := true) -> void:
	var d := b - a
	var L := d.length()
	if capsule:
		if (not B.seg_s.is_empty() or mi.has_meta("pr")) and (mi.mesh as CapsuleMesh).radius != r:
			(mi.mesh as CapsuleMesh).radius = r   # PR1: proportions change a part's radius (a default body: as before)
			mi.set_meta("pr", true)
		(mi.mesh as CapsuleMesh).height = maxf(L + 2.0 * r, 2.0 * r + 0.001)
	else:
		(mi.mesh as CylinderMesh).height = maxf(L, 0.001)
	var y := d / L if L > 1e-6 else Vector3.UP
	var x := y.cross(Vector3.FORWARD if absf(y.dot(Vector3.FORWARD)) < 0.9 else Vector3.RIGHT).normalized()
	var z := x.cross(y)
	mi.transform = Transform3D(Basis(x, y, z), (a + b) * 0.5)


func _refresh() -> void:
	if uiw != null:
		uiw.refresh()   # L95: the quaternion readout follows the playhead and the picked part
	var _rf := PerfDoc.t()
	var _rx := _rf
	if ic_ui != null:
		ic_ui.sync()   # plan 137: the target's flash on its 2 frames
	PerfDoc.add("r_ic", _rf)
	_rf = PerfDoc.t()
	if not PerfDoc.refresh_plant:   # (L64 test control: a refresh that should have run is skipped)
		_hands_refresh()   # HANDS (w4-handlock): the hands rows say the state
	PerfDoc.add("r_hands", _rf)
	_rf = PerfDoc.t()
	_light_apply()
	PerfDoc.add("r_light", _rf)
	_rf = PerfDoc.t()
	_refimg_sync()
	PerfDoc.add("r_head", _rf)
	_rf = PerfDoc.t()
	_actors_view()
	PerfDoc.add("r_actors", _rf)
	_curve_sync()
	_simc_badge_sync()   # POL1106b: the sim cache badge follows every edit, undo and bake
	if ui_akey != null and auto_key:
		ui_akey.queue_redraw()   # the frame reads Tok on each draw: a palette switch shows at once
	if not sel_more.is_empty() and sel != _group_sel:
		sel_more = []
	PerfDoc.add("rx00", _rx)
	_rx = PerfDoc.t()
	_sym_prev = B.ang.duplicate()
	if ui_body != null and ui_body.visible and not ui_body.dragging:
		ui_body.sync(S.body, B)   # an undo, a load or a retarget moved the body: the sliders and the readout follow
	PerfDoc.add("rx01", _rx)
	_rx = PerfDoc.t()
	var _pk := PerfDoc.t()
	if not PerfStub.skip("skinning"):
		Overlays.pose_skeleton(skel, bone_idx, B)
	CharImportApp.update(self)   # L9: an imported rigged character stands on the pose (scripts/char_import_app.gd)
	PerfDoc.add("skinning", _pk)
	PerfDoc.add("rx02", _rx)
	_rx = PerfDoc.t()
	var _ck := PerfDoc.t()
	corr.reuse = not PerfDoc.refresh_full and S.dq_skin <= 0.0 and not B.has_meta("spline_body") and not B.has_stretch() and S.soft.is_empty() and not soft_live.engaged   # L64
	corr.update(B)
	PerfDoc.add("sk_corr", _ck)
	_ck = PerfDoc.t()
	var spl_dq: bool = B.has_meta("spline_body")   # L33: a back driven by a spline chain
	if spl_dq and B.has_stretch():
		dq_skin_pass.update(0.0)   # the stretch pass builds on the rest mesh, not on the DQ one
	stretch_skin.update(B)   # L33: after the corrective (its mesh is the rest this corrects); nothing without a stretch
	PerfDoc.add("sk_stretch", _ck)
	_ck = PerfDoc.t()
	dq_skin_pass.update(1.0 if (spl_dq and not B.has_stretch()) else S.dq_skin)   # L33: a back driven by a spline chain is skinned by DQ (a plain blend caves in at its bends; with a stretch the stretch pass owns the mesh)
	PerfDoc.add("sk_dq", _ck)
	# H04: after the corrective (its mesh is the rest DQ corrects)
	PerfDoc.add("rx03", _rx)
	_rx = PerfDoc.t()
	_face_draw()   # ROADMAP 31 + 74: the jaw, the mouth shape, the brows and the eyes at the playhead (scripts/face.gd)
	for tg in ui_toggles:
		(tg[0] as Button).set_pressed_no_signal(tg[1].call())
	_doc_line()
	_next_sync()
	_insp_fit.call_deferred()   # RR2: rows shown / hidden change the box's height
	_sync_weapon()
	PerfDoc.add("rx04", _rx)
	_rx = PerfDoc.t()
	_throw_refresh()   # THROW CHECK (N040, L34)
	_lock_refresh()   # LOCK CHECK (N041)
	_fight_refresh()   # L76 FIGHT BAKE
	_fd_refresh()   # FRAME DATA (ROADMAP 12): the strip and the boxes on active frames
	if ui_browser != null and ui_browser.visible:
		ui_browser.follow()
	PerfDoc.add("rx05", _rx)
	_rx = PerfDoc.t()
	_rf = PerfDoc.t()
	var touching: Dictionary = B.touching_parts_ref() if PerfDoc.slow else B.touching_parts()   # L12: one capsule per part per frame
	PerfDoc.add("r_touch", _rf)
	_rf = PerfDoc.t()
	var looks := {}   # PRECISE PICK: each body part's light on its own skin (SkinPick.set_looks)
	# EASY QUIET: no standing pick light, name tag or joint dots on a beginner's body (a blue "right upper arm" over the punch
	# read as a fault); the hover light stays (what a click would grab) and the pick shows while a part is dragged
	var quiet: bool = easy != null and easy.on and dragging == ""
	var mesh_hide := _hides("joints")
	var mesh_pg := _mesh_page() or mesh_hide   # the mesh pages: no part tag, no joint dots (the posing overlays)
	for j in Body.ORDER + Body.WEAPON + Body.WEAPON2:
		var body: bool = not (j in Body.WEAPON or j in Body.WEAPON2)
		if dots.has(j):
			dots[j].position = B.P[j]
		var lk := part_look(j, touching)
		if (quiet or (mesh_pg and dragging == "")) and lk in ["sel", "limit"]:   # the mesh pages: the posing pick and limit lights are not the mesh's
			lk = ""
		if easy != null and easy.on and lk == "limit":   # EASY QUIET: no joint-limit tint either (no action a beginner can take on it)
			lk = ""
		if easy != null and easy.on and lk == "touch":   # EASY QUIET: the contact red (two parts in contact: thighs, torso) is not shown; a beginner cannot act on it, and Easy's red note means Check
			lk = ""
		if body:
