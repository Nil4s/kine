func _on_drop(files: PackedStringArray) -> void:
	for f in files:
		if f.to_lower().ends_with(".bvh") and AnimImport.is_kine_bvh(f):
			_import_bvh(f)
		elif f.to_lower().ends_with(".bvh"):
			_import_anim(f)
		elif f.get_extension().to_lower() == "fbx":
			_import_anim(f)
		elif VIDEO_EXT.has(f.get_extension().to_lower()):
			_import_video(f)
		elif f.to_lower().ends_with(".json") and VideoImport.load_file(f)["ok"]:
			_import_pose(f)
		elif f.to_lower().ends_with(".json"):   # MY PARTS (ROADMAP 84): a .json is a part file someone shared (not a pose): it goes into My parts, or is refused with the reason
			_import_my_part(f)
		elif kmed != null and kmed.on and KMeshRefPlanes.is_image(f):   # B21: a picture on the model preview: a reference plane
			kmed.refp.add(f)
		else:
			_import_file(f)


## ---- AUDIO TRACKS (GAP_ANALYSIS row 23; ROADMAP 77; scripts/audio_track.gd). The scene keeps S.audio_tracks: a list of
## {"path", "offset", "gain_db", "role", "mute", "solo"}. The sounding tracks are mixed offline into ONE stream (AudioTrack.mix:
## each at its offset and gain, summed, clipped) and ONE player plays that premix from the playhead. The playhead follows the
## player's own clock, so the tracks are in step by construction. A change is mixed once it has been quiet for AUDIO_MIX_QUIET
## (a drag of an offset mixes once, at its end); adding, removing, opening and undo mix at once. Lip sync and beats read their
## own track's stream, not the premix.
const AUDIO_SLICE_EXTRA := 0.04   # s added to one frame for a scrub slice
const AUDIO_MIX_QUIET := 150000   # usec: a change is mixed after this long without another change
var graph_wave := false         # L14: the sound's waveform under the graph editor's curves (view only)
var audio_envs: Array = []      # per track: AudioTrack.envelope of its file ({} = not loaded)
var audio_mixes := 0            # how many premixes were built (tests)
var audio_mix_usec := 0         # how long the last premix took to build, usec (tests)
var audio_gap: Array = []       # per track: the premix's audio clock minus the playhead, read right after the playhead was set; NAN when not playing (tests). All tracks share one clock.
var audio_from_clock := false   # this frame's playhead came from the audio clock (tests)
var audio_slices := 0           # how many scrub slices were sounded (tests)
var audio_pick := -1            # the track the Audio commands act on (picked by clicking its lane); -1 = none
var mouth_mi: MeshInstance3D   # LIP-SYNC (ROADMAP 31): the mouth drawn on the head, from S.lip (lip_sync.gd); made on first use
var _a_streams: Array = []      # per track: its AudioStream (AudioTrack.load_stream); null = none
var _a_pcm: Array = []         # per track: its stream decoded at the mix rate (AudioTrack.decode), made on load; a re-mix only sums these
var audio_decode_usec := 0     # how long the last load took to decode the tracks, usec (tests)
var audio_swap_usec := 0       # the main thread's time to swap a finished premix in, usec (tests)
var _a_task := -1              # the WorkerThreadPool task building the next premix (-1 = none in flight)
var _a_result: Array = []      # the task's output: [PCM bytes]
var _a_job_key := "<unset>"   # the state the task's premix is built for; it becomes _a_key when swapped in
var _a_job_rate := 0
var _a_job_t0 := 0
var _a_paths: Array = []        # the paths the streams were loaded for (a change of files reloads at once)
var _a_mixer: AudioStreamPlayer # the one player: plays the premix (made on first use)
var _a_mix_len := 0.0           # s: the premix's length; 0 = nothing to play
var _a_key := "<unset>"         # the state the premix was built for (path, offset, gain and audibility per track)
var _a_last_key := "<unset>"    # the key seen last frame (a change restarts the quiet period)
var _a_key_at := 0              # usec when the key last changed
var _a_after := -1.0            # the playhead at the end of the last tick (a different one now = the user moved it)
var _a_slice_until := 0         # msec when the scrub slice stops
var _a_slice_frame := -1


## the state the premix depends on: each track's file, offset, gain and whether it sounds (role does not change the mix)
func _a_key_now() -> String:
	var on := AudioTrack.audible(S.audio_tracks)
	var out := []
	for i in S.audio_tracks.size():
		var t: Dictionary = S.audio_tracks[i]
		out.append([String(t.get("path", "")), float(t.get("offset", 0.0)), float(t.get("gain_db", 0.0)), on[i]])
	return var_to_str(out)


## the stream of track i (null = none)
func audio_stream(i := 0) -> AudioStream:
	return _a_streams[i] if i >= 0 and i < _a_streams.size() else null


func _audio_mixer() -> AudioStreamPlayer:
	if _a_mixer == null:
		_a_mixer = AudioStreamPlayer.new()
		_a_mixer.name = "audio_mix"
		add_child(_a_mixer)
	return _a_mixer


## the premix's position on the timeline (the playhead's time), -1.0 when it is not playing
func audio_mix_position() -> float:
	if _a_mixer == null or not _a_mixer.playing:
		return -1.0
	return _a_mixer.get_playback_position() + AudioServer.get_time_since_last_mix()


## the playhead as the audio clock reads it: the premix's read point, plus the time since the last mix, less the output
## latency (the premix's time is the timeline's time); -1.0 when it is not playing
func _audio_clock() -> float:
	if _a_mixer == null or not _a_mixer.playing:
		return -1.0
	return _a_mixer.get_playback_position() + AudioServer.get_time_since_last_mix() - AudioServer.get_output_latency()


## the tracks' files changed (open, add, remove, undo): load every stream and its envelope, and mix at once
func _audio_reload() -> void:
	var n := S.audio_tracks.size()
	_a_streams = []
	_a_pcm = []
	_a_paths = []
	audio_envs = []
	var t0 := Time.get_ticks_usec()
	var rate := int(AudioServer.get_mix_rate())
	for i in n:
		var path := String(S.audio_tracks[i]["path"])
		var st: AudioStream = AudioTrack.load_stream(path)
		_a_streams.append(st)
		_a_pcm.append(AudioTrack.decode(st, rate) if st != null else PackedFloat32Array())
		_a_paths.append(path)
		audio_envs.append({} if path == "" else AudioTrack.envelope(st, path))
	audio_decode_usec = Time.get_ticks_usec() - t0
	if ui_curve != null:
		ui_curve.wave_envs = audio_envs   # L14
	if audio_pick >= n:
		audio_pick = -1
	_audio_remix_now()
	if ui_timeline != null:
		_tl_height()
		_layout_bottom()   # ROADMAP 77: each audio track adds a lane row; the panel makes room for it
		ui_timeline.queue_redraw()


## mixes the sounding tracks into the premix now; the player starts it again from the playhead on the next tick
## starts a premix on a worker thread (the old one keeps playing); _audio_swap puts it in when it is ready
func _audio_remix_now() -> void:
	if _a_task >= 0:
		return   # one is being built: the state is checked again once it is swapped in
	var on := AudioTrack.audible(S.audio_tracks)
	var rate := int(AudioServer.get_mix_rate())
	var pcms := []
	var starts := []
	var gains := []
	for i in S.audio_tracks.size():
		if on[i] and i < _a_pcm.size() and not (_a_pcm[i] as PackedFloat32Array).is_empty():
			pcms.append(_a_pcm[i])
			starts.append(int(round(float(S.audio_tracks[i]["offset"]) * rate)))
			gains.append(db_to_linear(float(S.audio_tracks[i]["gain_db"])))
	if pcms.is_empty():
		var mixer := _audio_mixer()
		mixer.stop()
		mixer.stream = null
		_a_mix_len = 0.0
		_a_key = _a_key_now()
		audio_mixes += 1
		_a_after = -1.0
		_a_slice_until = 0
		return
	_a_job_key = _a_key_now()
	_a_job_rate = rate
	_a_result = [null]
	_a_job_t0 = Time.get_ticks_usec()
	_a_task = WorkerThreadPool.add_task(AudioTrack.mix_bytes.bind(pcms, starts, gains, _a_result), false, "premix")


## the finished premix goes in on the main thread: one stream swap, and the player plays it from the current playhead
func _audio_swap() -> void:
	WorkerThreadPool.wait_for_task_completion(_a_task)
	_a_task = -1
	var t0 := Time.get_ticks_usec()
	var w := AudioTrack.wav_of(_a_result[0], _a_job_rate)
	var mixer := _audio_mixer()
	mixer.stream = w
	_a_mix_len = w.get_length()
	_a_key = _a_job_key
	audio_mixes += 1
	audio_mix_usec = Time.get_ticks_usec() - _a_job_t0
	_a_result = []
	if playing and playhead >= 0.0 and playhead < _a_mix_len:
		mixer.play(playhead)   # the one seek
		_a_after = playhead
	else:
		mixer.stop()
		_a_after = -1.0
	_a_slice_until = 0
	audio_swap_usec = Time.get_ticks_usec() - t0




func _audio_ask() -> void:
	var fd := FileDialog.new()
	fd.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	fd.access = FileDialog.ACCESS_FILESYSTEM
	fd.filters = PackedStringArray(["*.wav, *.ogg, *.mp3 ; sounds"])
	fd.use_native_dialog = true
	fd.title = "A sound for the timeline"
	fd.file_selected.connect(func(p): _audio_set(p); fd.queue_free())
	fd.canceled.connect(fd.queue_free)
	add_child(fd)
	fd.popup_centered(Vector2i(800, 500))


## add a sound as a new track (one undo step). role "" = music when no track is music yet, else sfx. Returns true when it loaded
func _audio_set(path: String, role := "") -> bool:
	if not AudioTrack.EXTS.has(path.get_extension().to_lower()):
		_say("could not add %s: it is not a wav, ogg or mp3; pick one of those" % path.get_file())
		return false
	var st := AudioTrack.load_stream(path)
	if st == null:
		_say("could not add %s: the file is missing or Godot cannot read it; pick another wav, ogg or mp3" % path.get_file())
		return false
	var r := role
	if r == "":
		r = "sfx" if AudioTrack.index_of_role(S.audio_tracks, "music") >= 0 else "music"
	_push_undo()
	S.audio_tracks.append(AudioTrack.clean({"path": path, "role": r}))
	audio_pick = S.audio_tracks.size() - 1
	_audio_reload()
	var env: Dictionary = audio_envs[audio_pick]
	_say("sound added as track %d (%s): %s, %s from 0.00 s%s" % [audio_pick + 1, r, path.get_file(), Units.time(st.get_length(), S.fps), "" if env.get("ok", false) else " (ogg / mp3 / compressed wav have no waveform here: a flat bar with the name stands in; it still plays)"])
	_refresh()
	return true


## the track an Audio command acts on: the one picked on its lane, or the only one. -1 = none (the message says what to do)
func _audio_target() -> int:
	if S.audio_tracks.is_empty():
		_say("no sound on the timeline: run Audio: add a sound file first")
		return -1
	if audio_pick >= 0 and audio_pick < S.audio_tracks.size():
		return audio_pick
	if S.audio_tracks.size() == 1:
		return 0
	_say("pick a track first: click its lane on the timeline (its name mutes it), then run this again")
	return -1


## a track's yes / no flag (mute, solo): toggled, one undo step
func _audio_flag(i: int, key: String) -> void:
	var on := not bool(S.audio_tracks[i].get(key, false))
	_push_undo()
	if on:
		S.audio_tracks[i][key] = true
	else:
		S.audio_tracks[i].erase(key)
	var nm: String = String(S.audio_tracks[i]["path"]).get_file()
	if key == "mute":
		_say("%s is %s (Ctrl+Z puts it back)" % [nm, "muted: silent in Play, the scrub and the playblast" if on else "sounding again"])
	else:
		_say("%s is %s (Ctrl+Z puts it back)" % [nm, "soloed: only the soloed tracks sound" if on else "not soloed"])
	if ui_timeline != null:
		ui_timeline.queue_redraw()
	_refresh()


func _audio_mute_picked() -> void:
	var i := _audio_target()
	if i >= 0:
		_audio_flag(i, "mute")


func _audio_solo_picked() -> void:
	var i := _audio_target()
	if i >= 0:
		_audio_flag(i, "solo")


## the role cycles music -> voice -> sfx. Music: the beats read it; voice: the lip sync reads it; sfx: plays and mixes only
func _audio_role_next() -> void:
	var i := _audio_target()
	if i < 0:
		return
	var r := String(S.audio_tracks[i].get("role", "music"))
	var nxt: String = AudioTrack.ROLES[(AudioTrack.ROLES.find(r) + 1) % AudioTrack.ROLES.size()]
	_push_undo()
	S.audio_tracks[i]["role"] = nxt
	var what: String = {"music": "the beats read it (Beats: find the beats in the sound)", "voice": "the lip sync reads it (Lip-sync: from the audio track)", "sfx": "it plays and mixes; nothing else reads it"}[nxt]
	_say("track %d is now the %s track: %s (Ctrl+Z puts it back)" % [i + 1, nxt, what])
	if ui_timeline != null:
		ui_timeline.queue_redraw()
	_refresh()


## ---- LIP-SYNC (ROADMAP 31; scripts/lip_sync.gd). The channel S.lip is baked from the sound on the timeline; the mouth
## is a dark shape on the head: its width from the mouth shape, its opening from the jaw channel.
func _lip_from_audio() -> void:
	var i := AudioTrack.index_of_role(S.audio_tracks, "voice")   # ROADMAP 77: the voice track (the first track when none is tagged voice)
	if i < 0:
		_say("no sound on the timeline: run Audio: add a sound file first (a wav)")
		return
	var t: Dictionary = S.audio_tracks[i]
	var r := LipSync.read_wav(String(t["path"]))
	if not r["ok"]:
		_say("lip-sync: %s (try another sound)" % r["why"])
		return
	var off := float(t["offset"])
	var A := LipSync.analyse(LipSync.windows(r["mono"], int(r["rate"])))
	var lip := LipSync.bake(A, S.fps, off, maxf(S.length(), off + float(r["length"])))
	_push_undo()
	S.lip = lip
	var opened := 0
	for sh in (A["shape"] as PackedStringArray):
		if sh != "M":
			opened += 1
	_say("lip-sync baked: %d mouth changes, %d of %d windows voiced, jaw 0-%d° (Ctrl+Z removes it)" % [lip["mouth"].size(), opened, (A["shape"] as PackedStringArray).size(), int(LipSync.JAW_MAX)])
	_refresh()

## THE FACE on the head (ROADMAP 74; scripts/face.gd): the brows (L/R), the eyes (look + blink), and the mouth (the jaw and
## the viseme shape). Drawn at the playhead from the face keys and the lip-sync channel (the lip sync drives the jaw and the
## visemes when it is there). While the Face panel is open its sliders are the preview. Nothing shows with neither.
var face_root: Node3D           # the brows and eyes (made on first use)
var face_brow: Array = []       # [brow_l, brow_r] MeshInstance3D (BoxMesh)
var face_eye: Array = []        # [eye_l, eye_r] (sclera, SphereMesh)
var face_pupil: Array = []      # [pupil_l, pupil_r]
var face_ui: FaceUI
## I01-I04 (scripts/face_geo.gd): the face as REAL GEOMETRY, opt-in (default off: the painted face above is untouched)
var face_geo_on := false
var face_geo_au := {}              # extra AU weights {"AU12": 1.0} added to what the face channels give (presets, the test)
var face_geo_data := {}
var face_geo_root: Node3D
var face_geo_mask: MeshInstance3D
var face_geo_eye_nodes: Array = []
var face_geo_head0: Mesh           # the head piece's own mesh, put back when the geometry goes off
var face_geo_key := ""
var face_geo_viseme := ""          # L23: a viseme name (rest A E I O U MBP FV L TH, or a lip-sync letter) that overrides the lip-sync shape; "" = follow the lip sync


func _face_make() -> void:
	face_root = Node3D.new()
	face_root.name = "face_parts"
	add_child(face_root)
	for i in 2:
		var b := MeshInstance3D.new()
		var bm := BoxMesh.new()
		bm.size = Vector3(1, 1, 1)
		b.mesh = bm
		b.material_override = StandardMaterial3D.new()
		b.material_override.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		face_root.add_child(b)
		face_brow.append(b)
		var e := MeshInstance3D.new()
		var sm := SphereMesh.new()
		sm.radius = 0.5
		sm.height = 1.0
		e.mesh = sm
		e.material_override = StandardMaterial3D.new()
		e.material_override.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		face_root.add_child(e)
		face_eye.append(e)
		var p := MeshInstance3D.new()
		p.mesh = sm
		p.material_override = StandardMaterial3D.new()
		p.material_override.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		face_root.add_child(p)
		face_pupil.append(p)


func _face_draw() -> void:
	var live := face_ui != null and face_ui.live()
	var ex: Dictionary = S.expr_at(playhead)
	var elp := el_ui != null and el_ui.pv   # I08: the living eyes preview shows its track
	var on := live or elp or not S.lip.is_empty() or not S.face.is_empty() or not ex.is_empty() or face_geo_on
	if not on:
		if face_geo_root != null:
			face_geo_root.visible = false
		if mouth_mi != null:
			mouth_mi.visible = false
		if face_root != null:
			face_root.visible = false
		return
	if mouth_mi == null:
		mouth_mi = MeshInstance3D.new()
		var sm := SphereMesh.new()
		sm.radius = 0.5
		sm.height = 1.0
		mouth_mi.mesh = sm
		mouth_mi.material_override = StandardMaterial3D.new()
		mouth_mi.material_override.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		add_child(mouth_mi)
	if face_root == null:
		_face_make()
	var P: Dictionary = Face.pose(face_ui.values(), {}, playhead) if live else (el_ui.pose_now() if elp else Face.at(S.face, S.lip, playhead, ex))
	if face_geo_on and face_geo_root != null:
		_face_geo_draw(P)
		face_root.visible = false
		mouth_mi.visible = false
		return
	var geo := _face_geo()
	if geo.is_empty():
		return   # no head mesh to anchor on
	var g: Quaternion = B.G["head"]
	var front: Vector3 = g * Vector3(0, 0, 1)
	var up: Vector3 = g * Vector3(0, 1, 0)
	var left: Vector3 = g * Vector3(1, 0, 0)   # +X = the hero's LEFT (data/skeleton.json)
	var ink: Color = Tok.c("ink")
	var pupil_c: Color = Tok.c("accent")
	var white: Color = Tok.c("text")
	var blink := float(P["blink"])
	face_root.visible = true
	for side in 2:
		var sx := 1.0 if side == 0 else -1.0   # side 0 = the left (+X), 1 = the right
		var sfx := "_l" if side == 0 else "_r"
		var v := float(P["brow" + sfx])
		var bpos := face_at(geo["brow" + sfx]) + front * 0.004 + up * (0.012 * v)
		var tilt := -clampf(v, -1.0, 1.0) * 0.3 * sx
		var bb: MeshInstance3D = face_brow[side]
		(bb.material_override as StandardMaterial3D).albedo_color = ink
		bb.transform = Transform3D(Basis(g) * Basis(Vector3(0, 0, 1), tilt) * Basis.from_scale(Face.BROW_SIZE), bpos)
		var epos := face_at(geo["eye" + sfx]) + front * 0.001
		var eb: MeshInstance3D = face_eye[side]
		(eb.material_override as StandardMaterial3D).albedo_color = white
		var lid := (1.0 - 0.9 * blink) * (1.0 - 0.5 * float(P["squint"])) * (1.0 + 0.5 * float(P["widen"]))   # AU6/7 narrow the eye, AU5 opens it (R22)
		eb.transform = Transform3D(Basis(g) * Basis.from_scale(Vector3(Face.EYE_SIZE.x, Face.EYE_SIZE.y * lid, Face.EYE_SIZE.z)), epos)
		var look := left * sin(deg_to_rad(float(P["eye_yaw_deg"]))) + up * sin(deg_to_rad(float(P["eye_pitch_deg"])))
		var pb: MeshInstance3D = face_pupil[side]
		(pb.material_override as StandardMaterial3D).albedo_color = pupil_c
		pb.visible = blink < 0.5
		pb.transform = Transform3D(Basis(g) * Basis.from_scale(Vector3(Face.IRIS_D, Face.IRIS_D, Face.IRIS_D * 0.6)), epos + front * 0.003 + look * 0.005)
	var jaw := float(P["jaw_deg"])
	var sz := Face.mouth_size(String(P["mouth"]), jaw)
	(mouth_mi.material_override as StandardMaterial3D).albedo_color = Tok.c("fail")
	mouth_mi.visible = true
	var pr := float(P["press"])   # AU23/24: the lips tighten into a thin line (R22)
	sz = Vector3(sz.x * (1.0 - 0.25 * pr), sz.y * (1.0 - 0.5 * pr), sz.z)
	mouth_mi.transform = Transform3D(Basis(g) * Basis.from_scale(Vector3(sz.x * Face.MOUTH_W_K, sz.y, sz.z)), face_at(geo["mouth"]) + front * 0.002 - up * sz.y * 0.25)


## the face geometry on or off. On: the mask, two eyes and the mouth cavity are built (once), the head piece loses its lower-face
## triangles (restored when off). One undo-free view switch, like the shading modes.
func _face_geo_toggle() -> void:
	_face_geo_set(not face_geo_on)
	_say("face geometry %s (eyes with lids, lips, teeth, tongue, nose; off = the painted face)" % ("on" if face_geo_on else "off"))


func _face_geo_set(on: bool) -> void:
	if on == face_geo_on or not pieces.has("head"):
		return
	var hp: MeshInstance3D = pieces["head"]
	if on:
		if face_geo_data.is_empty():
			face_geo_data = FaceGeo.build(_head_pts())
		face_geo_head0 = hp.mesh
		hp.mesh = FaceGeo.cut_head(hp.mesh as ArrayMesh, face_geo_data)
		if face_geo_root == null:
			face_geo_root = Node3D.new()
			face_geo_root.name = "face_geometry"
			add_child(face_geo_root)
			face_geo_mask = MeshInstance3D.new()
			face_geo_mask.name = "mask"
			face_geo_mask.material_override = FaceGeo.mask_material(hp.material_override)   # the head's own material, sRGB vertex colours
			face_geo_root.add_child(face_geo_mask)
			for e in face_geo_data["eyes"]:
				var en := MeshInstance3D.new()
				en.mesh = FaceGeo.eye_mesh(float(e["r"]))
				en.material_override = FaceGeo.eye_material()
				face_geo_root.add_child(en)
				face_geo_eye_nodes.append(en)
			var cav := MeshInstance3D.new()
			cav.mesh = FaceGeo.cavity_mesh(face_geo_data)
			cav.name = "cavity"
			cav.material_override = FaceGeo.cavity_material()   # lit, curved, red: not the old black box
			face_geo_root.add_child(cav)
			for nm in ["teeth_up", "teeth_lo", "tongue", "nose"]:
				var mi := MeshInstance3D.new()
				mi.name = nm
				match nm:
					"teeth_up":
						mi.mesh = FaceGeo.teeth_mesh(face_geo_data, true)
						mi.material_override = FaceGeo.tooth_material()
					"teeth_lo":
						mi.mesh = FaceGeo.teeth_mesh(face_geo_data, false)
						mi.material_override = FaceGeo.tooth_material()
					"tongue":
						mi.mesh = FaceGeo.tongue_mesh(face_geo_data)
						mi.material_override = FaceGeo.tongue_material()
					"nose":
						mi.mesh = FaceGeo.nose_mesh(face_geo_data, FaceGeo.SKIN)
						mi.material_override = FaceGeo.mask_material(hp.material_override)
				face_geo_root.add_child(mi)
			for pd in FaceGeo.head_parts(face_geo_data, FaceGeo.SKIN):   # L23: the ears
				var ei := MeshInstance3D.new()
				ei.name = String(pd["name"])
				ei.mesh = pd["mesh"]
				ei.material_override = FaceGeo.mask_material(hp.material_override)
				face_geo_root.add_child(ei)
			var chn := MeshInstance3D.new()   # L23: the chin and the jaw line under the mask, riding the jaw (no hollow under the chin)
			chn.name = "chin"
			chn.material_override = FaceGeo.mask_material(hp.material_override)
			face_geo_root.add_child(chn)
		face_geo_key = ""
		face_geo_on = true
	else:
		face_geo_on = false
		if face_geo_head0 != null:
			hp.mesh = face_geo_head0
		if face_geo_root != null:
			face_geo_root.visible = false
	_refresh()


## draw the geometry for the face pose P (Face.pose): the channels map to AUs (brows +: AU1, -: AU4; blink: AU45; squint: AU6),
## the jaw channel to the jaw bone, the eye angles to the eye bones; face_geo_au adds more AU weights
func _face_geo_draw(P: Dictionary) -> void:
	var d: Dictionary = face_geo_data
	face_geo_root.visible = true
	var g: Quaternion = B.G["head"]
	face_geo_root.transform = Transform3D(Basis(g), face_at(Vector3.ZERO))
	var bv := (float(P["brow_l"]) + float(P["brow_r"])) * 0.5
	var au := {"AU1": maxf(bv, 0.0), "AU4": maxf(-bv, 0.0), "AU45": float(P["blink"]), "AU6": float(P["squint"])}
	# the viseme shape drives the mouth AUs (L23: the full set; the lip sync's own jaw channel keeps the jaw, an override brings its own)
	# The lip sync's own letters (P["mouth"]) keep the six-AU shape (FaceGeo.viseme_au) the USD face export can write (UsdWire / usdwire
	# bars: six BlendShapes); the full ten-viseme set (the 14 AUs) is the explicit override face_geo_viseme.
	var vp := FaceGeo.viseme_pose(face_geo_viseme) if face_geo_viseme != "" else {}
	var vz: Dictionary = vp.get("au", {}) if face_geo_viseme != "" else FaceGeo.viseme_au(String(P.get("mouth", "")))
	for k in vz:
		au[k] = float(au.get(k, 0.0)) + float(vz[k])
	for k in face_geo_au:
		au[k] = float(au.get(k, 0.0)) + float(face_geo_au[k])
	var st := {"au": au, "jaw_deg": float(P["jaw_deg"]), "eye_pitch_deg": float(P["eye_pitch_deg"]), "eye_yaw_deg": float(P["eye_yaw_deg"]), "viseme": String(vp.get("viseme", ""))}
	if face_geo_viseme != "":
		st["jaw_deg"] = float(vp.get("jaw_deg", 0.0))
	var key := str(st)
	if key != face_geo_key:
		face_geo_key = key
		var skin := FaceGeo.SKIN
		var hm: Material = (pieces["head"] as MeshInstance3D).material_override
		if hm is StandardMaterial3D:
			skin = (hm as StandardMaterial3D).albedo_color
		var wrk := FaceWrinkle.compute(d, st)
		face_geo_mask.mesh = FaceWrinkle.mask_mesh(d, wrk["verts"], wrk, skin)
		# L62 I09: the wrinkle shader only while a wrinkle muscle is driven (a neutral face keeps the head's own StandardMaterial3D)
		var wr_on := false
		for gv in FaceWrinkle.gates(au):
			wr_on = wr_on or gv > 0.0
		if wr_on and not (face_geo_mask.material_override is ShaderMaterial):
			face_geo_mask.material_override = FaceWrinkle.material(hm)
		elif not wr_on and face_geo_mask.material_override is ShaderMaterial:
			face_geo_mask.material_override = FaceGeo.mask_material(hm)
		var tf := FaceGeo.eye_transforms(d, st)
		for i in 2:
			(face_geo_eye_nodes[i] as Node3D).transform = tf[i]
		var jx := FaceGeo.jaw_transform(d, st)   # the lower teeth and the tongue ride the jaw bone
		(face_geo_root.get_node("teeth_lo") as Node3D).transform = jx
		(face_geo_root.get_node("tongue") as Node3D).transform = FaceGeo.tongue_transform(d, st)
		(face_geo_root.get_node("chin") as MeshInstance3D).mesh = FaceGeo.chin_mesh(d, st, skin)
		var nose_mi := face_geo_root.get_node("nose") as MeshInstance3D
		var nsk := FaceGeo.SKIN
		if hm is StandardMaterial3D:
			nsk = (hm as StandardMaterial3D).albedo_color
		if nose_mi.get_meta("skin", Color(0, 0, 0)) != nsk:
			nose_mi.set_meta("skin", nsk)
			nose_mi.mesh = FaceGeo.nose_mesh(d, nsk)


var face_geo: Dictionary = {}   # the anchors on the head mesh in rest space (Face.anchors), read once from the head piece


func _face_geo() -> Dictionary:
	if face_geo.is_empty() and pieces.has("head"):
		var mesh: Mesh = (pieces["head"] as MeshInstance3D).mesh
		var pts := PackedVector3Array()
		for si in mesh.get_surface_count():
			var arr := mesh.surface_get_arrays(si)
			var vs: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
			var ix: PackedInt32Array = arr[Mesh.ARRAY_INDEX]
			for i in ix:
				pts.append(vs[i])
		face_geo = Face.anchors(pts)
	return face_geo


## a point on the head given in REST space, carried by the head joint now (the same carry as Body.cap): where it is in the world
func face_at(rest: Vector3) -> Vector3:
	return (B.P["head"] as Vector3) + (B.G["head"] as Quaternion) * (rest - (B.p0["head"] as Vector3))


## L92: frame-rate conversion (scripts/fps_wave.gd). The target is the next of 24 / 30 / 60 after the scene's rate
func _fps_convert_to(snap: bool) -> void:
	var n := 30 if S.fps == 24 else (60 if S.fps == 30 else 24)
	var r := FpsWave.serve(self, {"action": "convert", "fps": n, "snap": snap})
	if not r["ok"]:
		_say(String(r["error"]))
		return
	var res: Dictionary = r["result"]
	_say("frame rate %d -> %d fps: %d keys kept at their exact times%s" % [res["from"], res["to"], res["keys"], (", %d moved to whole frames (largest %.1f ms), %d kept in place" % [(res["moves"] as Array).size(), 1000.0 * float(res["max_move"]), res["kept"]]) if snap else ""])


func _fps_convert_ask() -> void:
	_fps_convert_to(false)


func _fps_snap_ask() -> void:
	_fps_convert_to(true)


func _graph_wave_toggle() -> void:
	FpsWave.serve(self, {"action": "wave"})
	_say("graph editor waveform " + ("on" if graph_wave else "off"))


func _audio_remove() -> void:
	var i := _audio_target()
	if i < 0:
		return
	_push_undo()
	var nm: String = String(S.audio_tracks[i]["path"]).get_file()
	S.audio_tracks.remove_at(i)
	audio_pick = -1
	_audio_reload()
	_say("track removed from the timeline: %s (the file is still on disk; add it again to bring it back)" % nm)
	_refresh()

## the sound's loudness in steps of 3 dB (about 1.4x the amplitude), -30 .. +12 dB; saved as gain_db, used by playback
## and mixed into the playblast's mp4 (PlayblastExport.args). One undo step
## ROADMAP 10: the human-limits rules in or out of Check (HumanLimits.on), then Check again
func _human_check() -> void:
	if _own_gate("human_limits"):
		return
	HumanLimits.on = not HumanLimits.on
	_check()
	_say(("Check now asks 'could a human do this?' too: joint speed and tipping against recorded limits (experimental)" if HumanLimits.on else "Check is back to the rulebook alone"))


## "Is this clip physically possible?": Check with the feasibility verdict (scripts/feasible.gd) switched on
func _feasible_check() -> void:
	if _own_gate("feasible"):
		return
	HumanLimits.on = true
	_check()
	if S.cards.size() < 2:
		return   # Check said what to do (add cards); a "PASS" over nothing would be a false verdict
	var vf := findings.filter(func(f): return f["rule"] == "FEASIBLE")
	_say("physically possible? " + ("PASS: nothing here a body could not do" if vf.is_empty() else String(vf[0]["msg"]).split(" ")[0] + ": click a finding to jump to its frames and read the reason"))


## TWINNING (ROADMAP 19; scripts/twinning.gd): the mirror twins the default Check does not grade. Shown in the Check list.
func _twin_check() -> void:
	if S.cards.size() < 2:
		_say("Check: twinning needs a scene of two cards or more: add a card first")
		return
	var f := Twinning.findings(S, ov.GB)
	_check(f)
	_say("twinning: nothing moves as a mirror twin for 0.3 s or more" if f.is_empty() else "twinning: %d range(s) listed in Check; 'Fix: offset the picked side by 3 frames' offsets the picked side" % f.size())


func _twin_fix() -> void:
	var side := "l" if sel.ends_with("_l") else ("r" if sel.ends_with("_r") else "")
	if side == "":
		_say("pick a left or right arm or leg part first: the side to offset (picked: %s)" % sel)
		return
	var ranges := []
	for f in Twinning.findings(S, ov.GB):
		ranges.append({"kind": f["kind"], "t0": f["t0"], "t1": f["t1"]})
	if ranges.is_empty():
		_say("no twinning to fix: Check: twinning lists none, so pick another check")
		return
	_push_undo()   # one undo step for the whole offset
	var n := Twinning.offset(S, ov.GB, side, ranges)
	_refresh()
	var left := Twinning.findings(S, ov.GB)
	_check(left)
	_say("offset the %s side by %d frames over %d range(s): %d joint(s) moved, %d twin range(s) left (Ctrl+Z undoes it)" % [
		"left" if side == "l" else "right", Twinning.OFFSET, ranges.size(), n, left.size()])


func _audio_gain(step: float) -> void:
	var i := _audio_target()
	if i < 0:
		return
	var cur := float(S.audio_tracks[i]["gain_db"])
	var g := clampf(cur + step, -30.0, 12.0)
	if absf(g - cur) < 1e-6:
		_say("the sound is already as %s as it goes (%+.0f dB): try the other way" % ["loud" if step > 0 else "quiet", g])
		return
	_push_undo()
	S.audio_tracks[i]["gain_db"] = g
	_say("the sound is at %+.0f dB now (0 = as recorded; Ctrl+Z puts it back)" % g)
	_refresh()

## MUSIC BEATS (ROADMAP 32; scripts/beat_track.gd): the beats of the sound, kept in the scene as "beats_audio"
func _beats_find() -> void:
	var mi := AudioTrack.index_of_role(S.audio_tracks, "music")
	if mi < 0 or audio_stream(mi) == null:
		_say("no music track on the timeline: run Audio: add a sound file first (beats need a wav with the music role)")
		return
	var r := BeatTrack.analyze(audio_stream(mi))
	if not r["ok"]:
		_say("beats: %s (try another sound)" % r["msg"])
		return
	_push_undo()
	S.beats_audio = r["beats"]
	var nd := 0
	for b in r["beats"]:
		if b["down"]:
			nd += 1
	_say("beats: %d at %.1f BPM%s.  Beats: snap the contact cards moves hits onto them.  Ctrl+Z undoes" % [r["beats"].size(), float(r["bpm"]), (", %d bars (4/4 grid) marked" % nd) if nd > 0 else ", no 4/4 grid evident (every beat plain)"])
	if ui_timeline != null:
		ui_timeline.queue_redraw()
	_refresh()

## snaps each contact card (the card a hit marker sits on) onto its nearest beat; one undo step. Runs on a clone first:
## when any card would need more than 25 % of its move, nothing changes and the message says why
func _beats_snap() -> void:
	if S.beats_audio.is_empty():
		_say("no beats yet: run Beats: find the beats in the sound first")
		return
	var trial := S.clone()
	var mi := AudioTrack.index_of_role(S.audio_tracks, "music")
	var r := BeatTrack.snap(trial, S.beats_audio, float(S.audio_tracks[mi]["offset"]) if mi >= 0 else 0.0)
	if not r["ok"]:
		_say(r["msg"] + " (pick other cards, or add a hit marker)")
		return
	var worst := 0.0
	for mv in r["moves"]:
		worst = maxf(worst, absf(float(mv[1])))
	_push_undo()
	_markers_hold()
	S.cards = trial.cards
	_markers_follow()
	_retimed()
	_say("%d contact card(s) snapped onto the beat (largest move %.0f ms).  Ctrl+Z undoes" % [r["contacts"], worst * 1000.0])

## WEIGHT FEEL (ROADMAP 40; scripts/weight_feel.gd): the swing's wind-up and recovery by the held weapon's inertia
func _weight_feel() -> void:
	var trial := S.clone()
	var r := WeightFeel.apply(trial, B)
	if not r["ok"]:
		_say(r["msg"] + " (nothing changed; pick another weapon or card, then try again)")
		return
	_push_undo()
	_markers_hold()
	S.cards = trial.cards
	_markers_follow()
	_retimed()
	_say(r["msg"] + ".  Ctrl+Z undoes")


## WEIGHT SLIDER (L23; WeightFeel.slider): the open scene heavier / lighter by a step of the slider (log2 of the mass ratio)
func _weight_step(d: float) -> void:
	var c := WeightFeel.contact_card(S)
	var v := (float(S.cards[c].get("weight_s", 0.0)) if c >= 0 else 0.0) + d
	var trial := S.clone()
	var r := WeightFeel.slider(trial, v)
	if not r["ok"]:
