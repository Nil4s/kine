# ---------------------------------------------------------------- camera

## arrows slide the view (Shift+arrows turn around the body), PageUp / PageDown zoom; held = keeps moving
func _keys_camera(dt: float) -> void:
	var fo := get_viewport().gui_get_focus_owner()
	if fo is LineEdit or fo is SpinBox:
		return
	var x := float(Input.is_key_pressed(KEY_RIGHT)) - float(Input.is_key_pressed(KEY_LEFT))
	var y := float(Input.is_key_pressed(KEY_UP)) - float(Input.is_key_pressed(KEY_DOWN))
	var z := float(Input.is_key_pressed(KEY_PAGEDOWN)) - float(Input.is_key_pressed(KEY_PAGEUP))
	if x == 0.0 and y == 0.0 and z == 0.0:
		return
	if StickyKeys.held(KEY_SHIFT):
		yaw -= x * 90.0 * dt
		pitch = clampf(pitch + y * 60.0 * dt, -89.0, 89.0)
	else:
		var sp := dist * 0.6 * dt
		target += cam.global_basis.x * x * sp + cam.global_basis.y * y * sp
	dist = clampf(dist * (1.0 + z * 1.2 * dt), 0.4, 12.0)
	_cam()


## the mesh pages (walk-through 4): the orbit may go under the floor (a downward right-drag, pitch up to +89), and the bottom view
## is Ctrl+Numpad7 (Blender's). The animation pages keep their camera as it was.
func _mesh_orbit() -> bool:
	return cur_page == "MODEL" or cur_page == "SCULPT"


## Numpad . frames the selection (the faces' centres, else the verts), Home frames the whole mesh; Ctrl+Numpad7 is the bottom view
func _mesh_view_key(k: InputEventKey) -> bool:
	if not _mesh_orbit():
		return false
	var fo := get_viewport().gui_get_focus_owner()
	if fo is LineEdit or fo is SpinBox:
		return false
	var plain := not (k.ctrl_pressed or k.alt_pressed or k.shift_pressed)
	if k.keycode == KEY_KP_7 and k.ctrl_pressed and not (k.alt_pressed or k.shift_pressed):
		_view(6, true)   # from below: the ViewCube's bottom face (pitch +89)
		return true
	if k.keycode == KEY_KP_PERIOD and plain:
		return _frame_pts(_sel_points(), "the selection")
	if k.keycode == KEY_HOME and plain:
		return _frame_pts(_mesh_points(), "the mesh")
	return false


func _sel_points() -> Array:
	var pts := []
	if kmed == null or not kmed.on or kmed.mesh == null or kmed.sel == null:
		return pts
	if not kmed.sel.faces.is_empty():
		for fi in kmed.sel.faces.keys():
			pts.append(kmed.view.global_transform * kmed.mesh.face_center(int(fi)))
	elif not kmed.sel.verts.is_empty():
		for v in kmed.sel.verts.keys():
			pts.append(kmed.view._to_world(int(v)))
	return pts


func _mesh_points() -> Array:
	var pts := []
	if kmed == null or not kmed.on or kmed.mesh == null:
		return pts
	for v in kmed.mesh.verts.size():
		pts.append(kmed.view._to_world(v))
	return pts


## the view turns (keeping yaw and pitch) to look at the centre of pts, the distance taking in their spread
func _frame_pts(pts: Array, what: String) -> bool:
	if pts.is_empty():
		_say("Model: nothing to frame yet: pick something first (Home frames the whole mesh)")
		return true
	var c := Vector3.ZERO
	for p in pts:
		c += p
	c /= float(pts.size())
	var r := 0.0
	for p in pts:
		r = maxf(r, (p - c).length())
	_turn_to(yaw, pitch, clampf(maxf(r * 3.0, 0.6), 0.4, 12.0), c, true)
	_say("Model: framed %s" % what)
	return true


## the camera looks at the body, shifted so the body sits in the middle of the free space between the panels
func _cam() -> void:
	if shot_through and _shot_apply():
		_dummy_view()
		return   # THE SHOT CAMERA: looking through it, the view is the keyed camera (_shot_apply)
	var b := Basis.from_euler(Vector3(deg_to_rad(pitch), deg_to_rad(yaw), 0))
	cam.transform = Transform3D(b, target + b * Vector3(0, 0, dist))
	if grid_node != null:
		grid_node.transparency = 0.85 if (_mesh_orbit() and cam.transform.origin.y < 0.0) else 0.0   # under the floor (MODEL / SCULPT): the grid fades, the underside shows
	var vs := get_viewport().get_visible_rect().size if is_inside_tree() else Vector2(1600, 900)
	var mpp := 2.0 * dist * tan(deg_to_rad(cam.fov * 0.5)) / vs.y
	if easy.on:   # EASY: the look-at point sits in the free rect under the Easy bar / strip, the body framed there (easy_mode.gd frame_clip)
		var eo: Vector2 = easy.offsets(vs, mpp)
		cam.h_offset = eo.x
		cam.v_offset = eo.y
	else:
		cam.h_offset = (rw() - lw()) * 0.5 * mpp
		cam.v_offset = (bottom_h + 6 + LINE_H - TOP_H) * 0.5 * mpp * -1.0   # RR5: centred above the status line too
	if vx != null and vx.quad_on:
		vx.cam_quad()   # K14: the perspective pane is a quarter of the free view
	_axis_labels_fit(vs)
	_dummy_view()


## the axis words are 3D text drawn over the whole window: one that falls below the free view (under the say-line, the
## scene strip or the page bar) is hidden, so no 3D label sits on a bottom bar
func _axis_labels_fit(vs: Vector2) -> void:
	if stage_root == null or not is_inside_tree():
		return
	var floor_y := vs.y - bottom_h - LINE_H - 8.0
	for c in stage_root.get_children():
		if c is Label3D and String(c.name).begins_with("axis_"):
			c.visible = not _hides("figure") and not cam.is_position_behind((c as Label3D).global_position) and cam.unproject_position((c as Label3D).global_position).y < floor_y


## THE CUBE'S VIEWS (round 22, GATES CC2, UPGRADES #22): look FROM direction d (the camera sits at target + d * dist),
## a face, an edge (two faces) or a corner (three). Smooth: the turn eases over VIEW_T seconds the short way round (yaw
## wrapped to within 180 of where it is). Keys 1-5 stay instant (_view): tests and the CLI shoot right after them
const VIEW_T := 0.3
const HOME := {"yaw": 0.0, "pitch": -8.0, "dist": 4.0, "target": Vector3(0, 0.95, 0)}   # the view the poser opens with
var _view_tw: Tween


func _view_dir(d: Vector3, smooth := true) -> void:
	d = d.normalized()
	var y1 := rad_to_deg(atan2(d.x, d.z))
	var p1 := clampf(-rad_to_deg(asin(clampf(d.y, -1.0, 1.0))), -89.0, 89.0)
	if absf(d.y) > 0.999:
		y1 = yaw   # straight up or down: keep the turn round the vertical as it is
	_turn_to(y1, p1, dist, target, smooth)


func _view_home(smooth := true) -> void:
	if easy != null and easy.on and easy.frame_dist() > 0.0:   # Easy: the first view keeps the body framed (easy_mode.gd frame_clip)
		_turn_to(HOME["yaw"], HOME["pitch"], easy.frame_dist(), easy.follow_target(), smooth)
		return
	_turn_to(HOME["yaw"], HOME["pitch"], _home_dist(), HOME["target"], smooth)
	_home_fit(smooth)


## C62: HOME's yaw / pitch, then the Fit button's framing (the whole body inside nav_clear_rect: under the toolbar, beside the
## panels, above the bottom bar). At 1280 x 720 the 4 m HOME view drew the head at y 38..80, under the Pose-from-words button.
## Smooth: the fitted goal is worked out on the spot and the turn is run again towards it
func _home_fit(smooth: bool) -> void:
	if shot_through or (easy != null and easy.on) or _mesh_orbit():
		return
	var y0 := yaw
	var p0 := pitch
	var d0 := dist
	var t0 := target
	yaw = HOME["yaw"]
	pitch = HOME["pitch"]
	dist = _home_dist()
	target = HOME["target"]
	_nav_fit()
	var d1 := dist
	var t1 := target
	yaw = y0
	pitch = p0
	dist = d0
	target = t0
	_home_set = [d1, t1]
	_turn_to(HOME["yaw"], HOME["pitch"], d1, t1, smooth)


var _home_set: Array = []   # [dist, target] the last home fit chose: while the camera still sits there the user has not moved it


func _home_refit() -> void:
	if _home_set.size() == 2 and is_equal_approx(dist, float(_home_set[0])) and target.is_equal_approx(_home_set[1]) 			and is_equal_approx(yaw, float(HOME["yaw"])) and is_equal_approx(pitch, float(HOME["pitch"])):
		_home_fit(false)


## HOME's distance, but never so close that the body (feet to head: 1.9 m about the target) is cut by the panels: the free view is
## the window minus the top bar, the bottom panel with its page bar and the status line. A small free view backs the camera off
## (the page bar's 38 px cut the toes off at 1600 x 900 with the whole panel open); a big one keeps HOME's 4 m
func _home_dist() -> float:
	var vs := get_viewport().get_visible_rect().size if is_inside_tree() else Vector2(1600, 900)
	var free_h := vs.y - float(TOP_H + bottom_h + 6 + LINE_H) - 16.0
	var need := 1.9 * vs.y / (2.0 * tan(deg_to_rad(cam.fov * 0.5)) * maxf(free_h, 100.0))
	return maxf(float(HOME["dist"]), need)


func _turn_to(y1: float, p1: float, d1: float, t1: Vector3, smooth: bool) -> void:
	if _view_tw != null and _view_tw.is_valid():
		_view_tw.kill()
	var y0 := yaw
	var y_goal := y1   # where it ends: the yaw asked for (the key views' own numbers, 180 not -180)
	y1 = y0 + wrapf(y1 - y0, -180.0, 180.0)   # the short way round
	if not smooth:
		yaw = y_goal
		pitch = p1
		dist = d1
		target = t1
		_cam()
		return
	var p0 := pitch
	var d0 := dist
	var t0 := target
	_view_tw = create_tween()
	_view_tw.tween_method(func(k: float):
		var e := ease(k, -2.0)   # in-out
		yaw = lerpf(y0, y1, e)
		pitch = lerpf(p0, p1, e)
		dist = lerpf(d0, d1, e)
		if not (easy != null and easy.on):   # Easy: the look-at point is the follow's (easy_mode.gd follow_tick), not the tween's
			target = t0.lerp(t1, e)
		_cam(), 0.0, 1.0, VIEW_T)
	_view_tw.tween_callback(func(): yaw = y_goal; _cam())


func _view(k: int, smooth := false) -> void:
	var y := 0.0
	var p := -8.0
	match k:
		2: y = -90.0
		3: p = -89.0
		4: y = 180.0
		5: y = 90.0
		6: p = 89.0   # from below (the ViewCube's bottom face)
	_turn_to(y, p, dist, target, smooth)


# ---------------------------------------------------------------- picking + dragging

## PRECISE PICK (Nick 10-19: "100% precise to the body"): the body part is the one whose SKIN the ray meets first,
## on the mesh as drawn now (SkinPick.pick: the posed triangles, the part with the most skin weight at the hit point).
## The weapon keeps its capsule (it is not skinned); the nearer of the two wins, as before. Hidden parts: the ray goes
## through them (KK1)
func _pick(mp: Vector2) -> String:
	var t0 := Time.get_ticks_usec()
	var o := cam.project_ray_origin(mp)
	var d := cam.project_ray_normal(mp)
	var hit: Array = skp.pick(o, d, hidden_parts)
	var best: String = hit[0]
	var best_t: float = hit[1]
	for j in (Body.WEAPON if B.wep_on else []):
		if hidden_parts.has(j):
			continue
		var c: Array = B.cap(j)
		var res := _ray_seg(o, d, c[0], c[1])
		if res.y <= maxf(float(B.rad[j]) * 1.15, 0.014) and res.x < best_t:
			best_t = res.x
			best = j
	_pick_t = best_t
	pick_us = Time.get_ticks_usec() - t0
	return easy_hand_of(best) if easy != null and easy.on else best


## EASY PICKS THE HAND (Nick: a beginner presses a hand, gets a finger, and the drag does nothing): in Easy every finger and
## thumb joint picks its hand, and each toe (ball) its foot, so a press anywhere on the hand moves the arm by the hand (IK).
## Expert keeps the finger. Used by _pick only: the one place the pick, the hover and the press all read it
static func easy_hand_of(j: String) -> String:
	var side := "_l" if j.ends_with("_l") else "_r"
	if j in Body.FINGERS:
		return "hand" + side
	if j.begins_with("ball_"):
		return "foot" + side
	return j


## the part's name the words show: Easy says "right hand" / "left foot"; Expert says nice(j)
func part_words(j: String) -> String:
	if easy != null and easy.on and (j.begins_with("hand_") or j.begins_with("foot_")):
		return ("left " if j.ends_with("_l") else "right ") + ("hand" if j.begins_with("hand") else "foot")
	return nice(j)


static func _ray_seg(o: Vector3, d: Vector3, a: Vector3, b: Vector3) -> Vector2:
	var u := b - a
	var w := o - a
	var A := d.dot(d)
	var Bq := d.dot(u)
	var C := u.dot(u)
	var D := d.dot(w)
	var E := u.dot(w)
	var den := A * C - Bq * Bq
	var t := 0.0
	if den > 1e-9:
		t = (A * E - Bq * D) / den
	t = clampf(t, 0.0, 1.0)
	var s := maxf(0.0, (u * t - w).dot(d) / A)
	return Vector2(s, ((o + d * s) - (a + u * t)).length())


func _unhandled_input(ev: InputEvent) -> void:
	if camx != null and camx.key(ev):   # C01: Alt+Left / Alt+Right = previous / next view
		get_viewport().set_input_as_handled()
		return
	if camnav != null and camnav.gesture(ev):   # W01: trackpad-safe pan / pinch
		get_viewport().set_input_as_handled()
		return
	if blk != null and blk.input(ev):   # B16 / GRS: G / R / S: the model preview's always, the body's with the Blender-style layer on (off by default)
		get_viewport().set_input_as_handled()
		return
	if feint_ui != null and feint_ui.on and feint_ui.input(ev):   # I20: Tab picks the variant, P previews, Enter accepts, Esc puts the ghosts away
		get_viewport().set_input_as_handled()
		return
	if counter_ui != null and counter_ui.on and counter_ui.input(ev):   # I3: Tab picks the next ghost, Enter places it, Esc puts them away
		get_viewport().set_input_as_handled()
		return
	if rig_ui != null and not S.own_rig.is_empty() and rig_ui.input(ev):   # OWN RIG (L73): a press on one of its bones picks it
		get_viewport().set_input_as_handled()
		return
	if bed != null and bed.on and bed.input(ev):   # J01: the bone editor's keys (E, Shift+A, X, Tab, Esc), picks and end-ball drags
		get_viewport().set_input_as_handled()
		return
	if bld != null and bld.on and bld.input(ev):   # BUILD: a drag on the floor makes a room, a click on a wall a door; typed sizes
		get_viewport().set_input_as_handled()
		return
	if kmed != null and kmed.on and kmed.showing and kmed.input(ev):   # ROADMAP_400 A05/A06: the test cube's keys (1/2/3, B, L, X, Esc) and clicks
		get_viewport().set_input_as_handled()
		return
	if ev is InputEventKey and ev.pressed and not ev.echo and _mesh_view_key(ev as InputEventKey):   # walk-through 4: Ctrl+Numpad7 bottom, Numpad . frame the selection, Home frames the mesh
		get_viewport().set_input_as_handled()
		return
	if ksc != null and ksc.on and ksc.showing and ksc.input(ev):   # ROADMAP_400 C01/C02: the test sphere's brush keys and strokes
		get_viewport().set_input_as_handled()
		return
	if sk.on and _sk_input(ev):   # I9: a left drag is a stroke; Enter fits, Backspace takes the last stroke back
		get_viewport().set_input_as_handled()
		return
	if pwui != null and pwui.on and pwui.input(ev):   # ROADMAP 92: a click on the floor adds a path point, Enter builds, Esc cancels
		get_viewport().set_input_as_handled()
		return
	if ev is InputEventKey and not ev.pressed and hk != null:
		hk.released(ev as InputEventKey)   # the ? that is held: its cheat sheet hides
	if wp_on and _wp_input(ev):   # WEIGHT PAINT (ROADMAP 72): a press on the body paints, the rest of the mouse is the view's
		return
	if ev is InputEventMouseButton:
		var mb := ev as InputEventMouseButton
		if mb.pressed and easy != null and easy.sliders != null and easy.sliders.hit(mb.position):
			return   # EASY SIDE SLIDERS: a press on that panel belongs to its slider, not to the body behind it
		if mb.pressed and vx != null:
			vx.press(mb.position)   # K14: a press on the perspective pane makes it the active one
		if mb.pressed and ui_cmd.visible:
			ui_cmd.close()   # a click in the view puts the search away
		if mb.pressed:
			hover_part = ""   # a press ends the hover (the drag shows the selection)
			_fh_clear()
			if loa.armed and mb.button_index != MOUSE_BUTTON_LEFT:
				loa.armed = false   # ROADMAP 23: any other press cancels the line-of-action stroke
				_say("line of action cancelled")
			if camnav != null and camnav.press(mb):   # W01: remapped orbit / pan / zoom gestures, zoom to cursor
				return
			if mb.button_index == MOUSE_BUTTON_LEFT and nav_tool != "":   # the nav bar's Orbit / Pan tool (HH2)
				dragging = nav_tool
			elif mb.button_index == MOUSE_BUTTON_LEFT and loa.armed:
				loa.armed = false
				loa.begin(mb.position)
				dragging = "loa"
			elif mb.button_index == MOUSE_BUTTON_LEFT:
				if hitbox_ui != null and hitbox_ui.press(mb.position):   # ROADMAP 36: a box's handle, or a box picked in the view, takes the press
					return
				if _rp_press(mb.position):   # ROADMAP 91: a root handle or a facing arrow of the root path takes the press
					return
				if _frh_press(mb.position):   # ROADMAP 6: a foot's roll handle takes the press
					return
				if _dgb_press(mb.position):   # I24: the balance marker (Shift+B on) takes the press
					return
				if _sph_press(mb.position):   # ROADMAP 61: a spine spline handle takes the press
					return
				if _trail_press(mb.position):   # ROADMAP 69: a key dot on a pinned part's trail takes the press
					return
				if _ikh_press(mb.position):   # IK2: an IK handle drawn here takes the press
					return
				var j := _pick(mb.position)
				var pp := _pick_prop(mb.position)
				var pa := _pick_actor(mb.position)   # TC4: another fighter's part, nearer than ours: it becomes the active one
				if int(pa[0]) >= 0 and (j == "" or float(pa[2]) < _pick_t) and (int(pp[0]) < 0 or float(pa[2]) < float(pp[1])):
					_actor_go(int(pa[0]))   # the view does not move (_stage_sync); the press goes on as a press on that part
					_say_plain("fighter %d of %d (%s): edits, cards and Ctrl+Z are this one's now" % [actor_on + 1, actors_rt.size(), "the hero" if actor_on == 0 else actors_rt[actor_on]["name"]])
					j = String(pa[1])
					_pick_t = float(pa[2])
					pp = [-1, INF]
				if int(pp[0]) >= 0 and (j == "" or float(pp[1]) < _pick_t):   # a prop in front of the body: the prop
					_prop_press(int(pp[0]), mb.position, float(pp[1]))
					return
				if sel_prop >= 0:
					sel_prop = -1
					_props_show()
				redspots.press(j, mb.position, playhead)   # N074: a glowing part opens its finding and Fix (the press goes on)
				if easy != null and easy.sliders != null:
					easy.sliders.part_picked(j)   # EASY SIDE SLIDERS: the part's panel opens; a press on nothing shuts it ("" = nothing picked)
				if j != "" and locked_parts.has(j):   # LOCKED (round 26, GG3): picked, never grabbed; no undo step
					sel = j
					playing = false
					_refresh()
					_say_plain("the %s is locked: right-click it > Unlock, or S and type 'unlock'" % nice(j))
				elif j != "":
					_drag_locks = _lock_snap()
					_hands_note = ""   # HANDS: a new drag says its own auto let-go, once
					_num_start = B.state()   # Esc during the drag puts this back (HH1)
					_num_axis = 0
					_num_text = ""   # each drag types afresh
					_push_undo()
					undo[-1]["name"] = "Drag " + nice(j)   # ROADMAP 45: the drag's step is named by what it moved
					if easy.on:
						undo[-1]["easy"] = "Move " + easy_part(j)   # Easy's Undo: "Undo: Move hand", not "Drag left wrist .."
						undo[-1]["drag"] = true   # Easy: a + Add pose straight after this drag joins this step (easy_mode.add_pose)
					_tree.set_name(_tree.cur, undo[-1]["name"])
					_press_node = _tree.cur   # the release drops this step if the body did not change
					_undo_tips()
					_group_press(j, mb.ctrl_pressed, mb.position)
					sel = j
					_clicked_part = true   # the tour's step 1 (clicking the part already picked counts too)
					_end_teach()   # RR5: the first pick ends the welcome, for good
					dragging = "joint"
					_grab = Vector3(NAN, NAN, NAN)
					_pd = {}
					_pd_mp = Vector2(NAN, NAN)
					if not j in Body.WEAPON and not j in ["hand_r", "hand_l", "foot_r", "foot_l"] and B.P.has(j) and sel_more.is_empty():   # a SET (Select: spine, Ctrl+click) turns every member by the same change (the old drag): PartDrag spreads or swings a turn its own way
						_pd = PartDrag.begin(B, j, cam.project_ray_origin(mb.position), cam.project_ray_normal(mb.position))
					_sd = _smart_begin(j, mb.alt_pressed)
					_lb = LiveBalance.begin(B, j) if keep_balance and not mb.alt_pressed and sel_more.is_empty() else {}   # N066
					_lb_r = {}
					playing = false
					_refresh()
			elif mb.button_index == MOUSE_BUTTON_RIGHT:
				dragging = "orbit"
				_rpress = {"at": mb.position, "yaw": yaw, "pitch": pitch, "part": _pick(mb.position)}
			elif mb.button_index == MOUSE_BUTTON_MIDDLE:
				dragging = "pan"
			elif mb.button_index == MOUSE_BUTTON_WHEEL_UP:
				dist = maxf(0.5, dist * 0.9)
				_cam()
			elif mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				dist = minf(12.0, dist / 0.9)
				_cam()
		else:
			var was := dragging
			dragging = ""
			_lb = {}   # N066: the pose stays as the last frame left it
			ouch.hide_readout()   # N064: the meter is for the drag only
			_num_on = false
			if was == "prop":
				_prop_release()
			if was == "ik_handle":
				_ikh_release()
			if was == "spine_handle":
				_sph_release()
			if was == "trail_key":
				_trail_release()
			if was == "loa":
				_loa_release(mb.shift_pressed)
			if was == "foot_handle":
				_frh_release()
			if was == "balance_drag":
				_dgb_release()
			if was == "root_path":
				_rp_release()   # ROADMAP 91: one undo step per drag
			if was == "box_handle" and hitbox_ui != null:
				hitbox_ui.release()   # ROADMAP 36: one undo step for a moved box handle
			# a right CLICK (not a drag) on a part: the ring. The few pixels it wobbled are not a turn: undone
			if (was == "orbit" or was == "rclick") and mb.button_index == MOUSE_BUTTON_RIGHT and not _rpress.is_empty():
				if mb.position.distance_to(_rpress["at"]) < 5.0 and _rpress["part"] != "":
					yaw = _rpress["yaw"]
					pitch = _rpress["pitch"]
					_cam()
					_ring_open(_rpress["part"], mb.position)
				_rpress = {}
			if was == "joint" and not _gp.is_empty():
				_group_release(mb.position)
			if was == "joint" and not is_nan(_grab.x):
				if sel in ["hand_r", "hand_l"] and B.wep_on and B.wep_hand != "" and B.wep_hand != sel:
					var r := GripMagnet.drag(B, sel, _grab)   # NA6: the one full fit, on release (the drag was quick)
					_after_edit()
					if r != "free":
						_say(_grip_said(r, sel))
				_grab = Vector3(NAN, NAN, NAN)
				_refresh()   # the reach marker goes with the drag
			if was == "joint" and _tree.cur == _press_node and B.state() == _num_start:
				# a click (press and release, the body not moved): its step goes, so Undo does not "do nothing". Checked after the
				# group pick (a Ctrl+click that dropped its own step has moved the tree on), and before the card and auto-key
				# lines, which would otherwise read the step under it
				_drop_undo()
				_press_node = -1
			elif was == "joint" and easy != null and easy.on and sel_card >= 0 and not auto_key:
				easy.card_follows_drag()   # walk-through 5: Easy, a card picked: the drag changes that card (one undo step, "Change pose")
			elif was == "joint":
				_autokey_card()   # ROADMAP 42: the drag that moved the body keys a card at the playhead (its undo step is the press's)
	elif ev is InputEventMouseMotion and dragging != "":
		var mm := ev as InputEventMouseMotion
		var rel := mm.relative
		if dragging == "prop":
			_prop_move(mm.position)
			return
		if dragging == "ik_handle":
			_ikh_move(mm.position)
			return
		if dragging == "spine_handle":
			_sph_move(mm.position)
			return
		if dragging == "trail_key":
			_trail_move(mm.position)
			return
		if dragging == "loa":
			loa.add_point(mm.position)
			return
		if dragging == "foot_handle":
			_frh_move(mm.position)
			return
		if dragging == "balance_drag":
			_dgb_move(mm.position)
			return
		if dragging == "root_path":
			_rp_move(mm.position)
			return
		if dragging == "box_handle":
			hitbox_ui.move(mm.position)
			return
		if dragging == "orbit":
			if shot_through:
				campiv.own_begin()   # C07: opt-in, the camera turns about its own position
				_shot_hand_over()   # as Blender: orbiting leaves the camera view, from where the camera was
			rel = camx.inv("orbit", rel)   # C01
			camnav.orbit_pre()   # W01
			yaw -= rel.x * 0.4
			pitch = clampf(pitch + (rel.y if _mesh_orbit() else -rel.y) * 0.4, -89.0, 89.0)   # MODEL / SCULPT: a downward drag turns the camera under the floor
			camnav.orbit_post()   # W01: orbit around the cursor point / the selection
			_cam()
		elif dragging == "zoom":
			camnav.zoom_drag_move(rel, mm.position)   # W01
		elif dragging == "pan":
			rel = camx.inv("pan", rel)   # C01
			var k := dist * 0.0012
			target += -cam.global_basis.x * rel.x * k + cam.global_basis.y * rel.y * k
			_cam()
		elif dragging == "joint" and not _num_on:   # a typed angle holds the part (HH1)
			var before: Vector3 = B.ang[sel] if not sel in Body.WEAPON else Vector3.ZERO
			_pd_mp = mm.position
			_drag_joint(rel, mm.shift_pressed, mm.ctrl_pressed, mm.alt_pressed)
			_group_follow(before)
			if _lock_keep(_drag_locks):   # a hand's reach can turn a locked arm: it stays
				_refresh()
	elif ev is InputEventMouseMotion:
		_hover_at((ev as InputEventMouseMotion).position)
	elif ev is InputEventKey and ev.pressed:
		var k := ev as InputEventKey
		if not _pressing and (get_viewport().gui_get_focus_owner() is LineEdit or get_viewport().gui_get_focus_owner() is SpinBox):
			return
		if cm_ui != null and cm_ui.key(k):   # I23: Enter writes the previewed combo, Esc drops it (only while its ghost is shown)
			return
		if _sg_key(k):   # R27: Tab cycles the next-pose ghosts, Enter takes the picked one, Esc hides them (only while they are shown)
			return
		if kt != null and kt.key(k):   # P20: Coming from Blender / Maya: the toast, Shift+Enter on its offer, "Blender keys win"
			return
		if hk.dispatch(k):   # a key the user gave a command (or a built-in key that moved away): scripts/hotkeys.gd
			return
		if k.keycode == KEY_ESCAPE and ui_keys != null and ui_keys.visible:
			keys_overlay(false)
			return
		if k.alt_pressed and not k.ctrl_pressed and k.keycode == KEY_E:   # Alt+E relax, Shift+Alt+E blend to the card before (Blender's keys; WW3)
			_step_hint = "Blend to previous card" if k.shift_pressed else "Relax to the in-between"
			_inbetween("prev" if k.shift_pressed else "relax")
			return
		if k.shift_pressed and not k.ctrl_pressed and not k.alt_pressed and k.keycode == KEY_E:   # Shift+E the breakdowner slider (XX4)
			_step_hint = "Breakdowner"
			_breakdowner_popup()
			return
		var combo: String = ("Ctrl+" if k.ctrl_pressed else "") + ("Shift+" if k.shift_pressed else "") + KEY_WORD.get(k.keycode, OS.get_keycode_string(k.keycode))
		for c in ui_cmd.commands:
			if c["keys"] == combo:
				_nt_note(c["name"])
				_step_hint = c["name"]
				_why_cmd = c["name"]
		if k.ctrl_pressed and k.alt_pressed and k.keycode == KEY_Q:   # K14: Ctrl+Alt+Q the quad view
			vx.quad_toggle()
			return
		if k.ctrl_pressed:
			match k.keycode:
				KEY_Z: _undo()
				KEY_K: ui_cmd.open() if (bld != null and bld.part != null and bld.part.ep != null and bld.part.ep.active()) else _toggle_autokey()   # s097: Easy Part: Ctrl+K opens the action search; elsewhere ROADMAP 42 auto-key on / off
				KEY_Y: _redo()
				KEY_S: _save_scene() if k.shift_pressed or (easy != null and easy.on) else _save_pose()   # Ctrl+Shift+S = the scene (round 15, V3); Easy: Ctrl+S too (startwalk bar 8: a beginner's Ctrl+S wrote a pose into moves/)
				KEY_E: _inbetween("push")   # Ctrl+E push from the in-between (WW3)
				KEY_C: _copy_pose()
				KEY_V: _paste_pose("mirrored" if k.shift_pressed else "")
				KEY_BRACKETRIGHT: _marker_jump(true)
				KEY_BRACKETLEFT: _marker_jump(false)
			return
		match k.keycode:
			KEY_S:
				ui_cmd.open()
			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5 when k.alt_pressed and not k.shift_pressed:   # Alt+1..5: the camera views, now that Shift+1..5 are the pages
				_view(k.keycode - KEY_0)
			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9 when k.shift_pressed:   # Shift+1..9: the pages (7-9: the expert pages)
				_page_set(PAGES[k.keycode - KEY_1])
			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
				_view(k.keycode - KEY_0)
			KEY_R: _do(func(): _reset_part())
			KEY_Q: _do(func(): _snap(45.0 if k.shift_pressed else 90.0))
			KEY_M when k.shift_pressed: _tool(0)
			KEY_M: _do(func(): _mirror_side("_r"))
			KEY_N: _do(func(): _mirror_side("_l"))
			KEY_C:
				show_caps = not show_caps
				_refresh()
			# into the right hand, as its button says ("In right hand (B)"); already there = off (V3: a bat in the LEFT
			# hand used to come off, so B, B to move it)
			KEY_B when k.shift_pressed:   # before KEY_B (the bat): match takes the first pattern that fits
				bal.on = not bal.on
				_refresh()
				_say(("%s.  Green = inside the feet, amber = within 2 cm of the edge, red = he tips, grey = in the air" % bal.words()) if bal.on else "balance off")
			KEY_B: _do(func(): _bat_remove() if B.wep_on and B.wep_hand == "hand_r" else _bat_put("hand_r"))
			KEY_L: _do(func(): _bat_lock())
			KEY_F: _do(func(): _fingers_cycle())
			KEY_G: _do(_toggle_second)
			KEY_H: _dummy_toggle()
			KEY_DELETE when sel_prop >= 0 and not k.ctrl_pressed and not k.alt_pressed:   # the picked prop goes (Easy's bar and Expert's SET have the same Remove / Delete prop; one undo step inside _prop_del)
				_prop_del()
			KEY_U when not k.shift_pressed: cards_use_usual()   # I10: the picked cards take your usual timing
			KEY_K: _key_part()
			KEY_T when k.shift_pressed:
				if not sel in Body.BODY:
					_say("Shift+T pins a trail on a BODY part: click one first (the weapon's own trail is T)")
				elif sel == ov.auto_pin:
					ov.auto_pin = ""   # the trail shown while picked becomes a pin: it stays when another part is picked
					_refresh()
					_say("trail on %s pinned: it stays when you pick another part.  Shift+T again removes it." % sel)
				else:
					var on := ov.toggle_pin(sel)
					_refresh()
					_say(("trail pinned on %s (its end).  Shift+T again removes it.  %s" % [sel, ov.info]) if on else "trail on %s removed" % sel)
			KEY_T:
				ov.trail_on = not ov.trail_on
				ov.mark_dirty()
				wt.mark_dirty()
				_refresh()
				_say(ov.info if ov.trail_on else "motion trail off")
			KEY_O when k.shift_pressed:
				_tool(1)
			KEY_Y:
				_tool(2)
			KEY_O:
				ov.onion_on = not ov.onion_on
				_refresh()
				_say("onion skin: orange = the card before, green = the card after" if ov.onion_on else "onion skin off")
			KEY_BRACKETLEFT: _do(func(): B.grip_u = GripBook.clamp_hold(B.wep_kind, B.wep_len, clampf(B.grip_u - 0.03, 0.0, B.wep_len)))
			KEY_BRACKETRIGHT: _do(func(): B.grip_u = GripBook.clamp_hold(B.wep_kind, B.wep_len, clampf(B.grip_u + 0.03, 0.0, B.wep_len)))
			KEY_COMMA: _do(func(): _slide(-0.03))
			KEY_PERIOD: _do(func(): _slide(0.03))
			KEY_MINUS: _do(func(): B.set_weapon_len(B.wep_len - 0.05))
			KEY_EQUAL: _do(func(): B.set_weapon_len(B.wep_len + 0.05))
			KEY_SPACE: _toggle_play()
			KEY_TAB: _big_view()
			KEY_F6: _kb_enter()
			KEY_ENTER, KEY_KP_ENTER: _card_add()


func _drag_joint(rel: Vector2, twist: bool, move: bool, alt: bool) -> void:
	B.last_stop = {}
	if only_part and B.grip and B.wep_on and B.wep_hand != "" and sel != _off_hand():
		_hands_let_go_auto()   # HANDS: only the part dragged moves, so the second hand on the weapon lets go
	var mpp := 2.0 * dist * tan(deg_to_rad(cam.fov * 0.5)) / get_viewport().get_visible_rect().size.y
	var dw: Vector3 = cam.global_basis.x * rel.x * mpp - cam.global_basis.y * rel.y * mpp
	var tip := sel in ["hand_r", "hand_l", "foot_r", "foot_l"]
	if sel in Body.WEAPON:
		_drag_bat(rel, dw, twist, alt)
		var wn := _take_note()
		if wn != "":
			_say(ui_status.text + wn)
		return
	if sel == "pelvis" and move:
		B.offset += dw
		B.fk()
	elif twist:
		var v: Vector3 = B.ang[sel]
		B.set_ang_safe(sel, Vector3(v.x, v.y, v.z + rel.x * 0.5))
	elif tip and move:   # Ctrl+drag a hand / foot: swing the elbow / knee round, the end held (IK POLE)
		B.swing_pole(sel, rel.x * 0.5)
	elif tip and not alt:
		if is_nan(_grab.x):
			_grab = B.P[sel]
		_grab += dw
		# CONTACT (ROADMAP 88): a hand with contact on and a wall / table in the set is held on the nearest face, palm on it
		var faces: Array = ContactIK.surfaces(S.props) if ik_contact and sel in ["hand_r", "hand_l"] else []
		# THE MAGNET (round 47, GATES CC3): the free hand near the weapon the other hand holds snaps onto its handle,
		# slides and rolls along it, lets go when pulled off (no weapon in the other hand: the plain reach, as before)
		if not faces.is_empty():
			ContactIK.reach(B, sel, _grab, faces)
		elif sel in ["hand_r", "hand_l"]:
			_magnet = GripMagnet.drag(B, sel, _grab, true)   # NA6: quick while the mouse moves; searched once on release
		else:
			B.reach(sel, _grab)
	elif not _pd.is_empty() and not is_nan(_pd_mp.x) and _pd.get("part", "") == sel:
		var follow := Callable()
		if shoulder_follow and not only_part and sel.begins_with("upperarm"):
			follow = func(): B.shoulder_follow(sel.right(2))   # YY5, inside the rounds so the handle still lands on the mouse
		PartDrag.move(B, _pd, cam.project_ray_origin(_pd_mp), cam.project_ray_normal(_pd_mp), follow)   # ROADMAP 41: any part, no mode
	else:
		var p: Vector3 = B.P[sel]
		var e: Vector3 = B.E[sel]
		if sel == "pelvis":
			e = B.P["neck_01"]
		var r1 := e - p
		var r2 := r1 + dw
		var ax := r1.cross(r2)
		if ax.length() > 1e-9:
			B.turn_world(sel, Quaternion(ax.normalized(), r1.angle_to(r2)))
	if not _sd.is_empty() and not alt and not twist and not move:
		_smart_step(tip)
	_lb_step(tip and not alt and not move and not twist, alt)   # N066: keep him over his feet (the dragged joint untouched)
	_arm_edit = sel if sel.begins_with("upperarm") and not move and not only_part and (_pd.is_empty() or is_nan(_pd_mp.x)) else ""   # a part drag followed the shoulder itself
	_after_edit()
	var v2: Vector3 = B.ang[sel]
	if _magnet in ["snap", "held", "let go"] and tip and not move and not twist:
		var mw := {"snap": "SNAPPED onto the %s: both hands hold it now (drag along it to slide, round it to roll, away to let go)",
			"held": "SLIDING the hand on the %s", "let go": "LET GO of the %s"}
		_say(String(mw[_magnet]) % B.wep_kind.replace("_", " "))
		_magnet = ""
		return
	_magnet = ""
	var what: String = "ROLLING" if twist else ({"look": "LOOKING WITH", "bend": "BENDING THE SPINE AT", "move": "MOVING THE BODY BY"}.get(PartDrag.kind(sel), "ROTATING") if not _pd.is_empty() and not is_nan(_pd_mp.x) else ("MOVING" if (move and sel == "pelvis") else ("SWINGING THE %s OF" % ("ELBOW" if sel.begins_with("hand") else "KNEE") if tip and move else ("PULLING" if tip and not alt else "ROTATING"))))
	if easy != null and easy.on:   # Easy: the stop in plain words, no degree readout (stop_words says which)
		_say("%s the %s%s%s%s" % [what, part_words(sel), stop_words(B.last_stop), LiveBalance.words(_lb_r), _take_note()])
	else:
		_say("%s the %s     %s%s%s%s" % [what, nice(sel), _angles_words(sel, v2), stop_words(B.last_stop), LiveBalance.words(_lb_r), _take_note()])


## SMART DRAG (ROADMAP I12, scripts/smart_drag.gd): the press learns (or loads) the model of how your poses co-vary and takes the
## conditioning for the chain this drag turns; every move then lets the rest of the body follow, the feet planted, the
## balance held. Alt at the press, follow 0, a weapon, a set, or a pelvis move: the old one-joint drag, exactly
func _smart_begin(j: String, alt: bool) -> Dictionary:
	if not smart_drag or alt or only_part or smart_follow <= 0.0 or j in Body.WEAPON or not sel_more.is_empty() or j == "pelvis":
		return {}
	if easy != null and easy.on:
		return {}   # Easy: a drag moves only the part you drag (Nick 10-24: "while dragging an arm the whole body moves"); Expert keeps the follow
	if not sd.ready_model() and not sd.refresh():
		return {}
	return sd.begin(B, j, locked_parts.keys())


func _smart_step(tip: bool) -> void:
	sd.apply(B, _sd, smart_follow)
	if tip:
		if not is_nan(_grab.x):
			B.reach(sel, _grab)   # the fist goes back to the mouse; the followers settle on the second pass
	elif not _pd.is_empty() and not is_nan(_pd_mp.x) and _pd.get("part", "") == sel:
		var fl := Callable()
		if shoulder_follow and sel.begins_with("upperarm"):
			fl = func(): B.shoulder_follow(sel.right(2))
		PartDrag.move(B, _pd, cam.project_ray_origin(_pd_mp), cam.project_ray_normal(_pd_mp), fl)
	sd.apply(B, _sd, smart_follow)


## NEVER FALLS WHILE POSING (N066, scripts/live_balance.gd): after the drag's own edit, the hips slide so the COM stays inside the
## planted feet. pull: a hand / foot on IK, put back on its target after the hips move. Alt during the drag: the correction is
## taken back and he is let fall for the rest of this drag
func _lb_step(pull: bool, alt: bool) -> void:
	if _lb.is_empty() or only_part:   # HANDS: Only the part I drag: nothing else re-centres
		_lb_r = {}
		return
	var redo := Callable()
	if pull and not is_nan(_grab.x) and not (sel in ["hand_r", "hand_l"] and (ik_contact or (B.wep_on and B.wep_hand != "" and B.wep_hand != sel))):
		redo = func(): B.reach(sel, _grab)
	if alt:
		LiveBalance.untake(B, _lb, redo)
		_lb = {}
		_lb_r = {}
		return
	_lb_r = LiveBalance.step(B, _lb, redo)


func _toggle_keep_balance() -> void:
	if _own_gate("balance"):
		return
	keep_balance = not keep_balance
	var cf := ConfigFile.new()
	cf.load(settings)
	cf.set_value("pose", "keep_balance", keep_balance)
	cf.save(settings)
	_say("KEEP BALANCE ON: while you drag, the hips slide so he stays over his feet (Alt+drag lets him fall)" if keep_balance else "keep balance off: a drag can tip him over his feet")


func _smart_set_follow(d: float) -> void:
	smart_follow = clampf(snappedf(smart_follow + d, 0.05), 0.0, 1.0)
	_say("smart drag follow %d %% (0 = a drag moves only the joint you grab; Alt+drag does that too)" % roundi(smart_follow * 100.0))


func _toggle_smart_drag() -> void:
