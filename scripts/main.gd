## FINAL RENDER (GAP_AUDIT_1106 #3; scripts/final_render.gd): opts {"preset": "final"|"draft", "w", "h", "first", "count"} makes this the same
## render through a SubViewport of w x h (default 1920x1080) with the quality preset on, over the frame range first .. first+count-1
## (default: every frame); the PNGs are numbered from 0000 within that range and the mp4 is made of exactly them.
func _render_shots(root_dir := ShotRender.ROOT, ffmpeg_path := "", opts := {}) -> Dictionary:
	root_dir = UserPaths.w(root_dir)   # an exported build: the user's folder
	if _sr_busy:
		_say_plain("A shot render is already running: press Esc (or Cancel render) to stop it, then run Render shots to video again")
		return {}
	if _shot_shots().is_empty():
		_say_plain("NOT NOW: this scene has no shots: run Shots: add at a time on the timeline to cut a shot (each shot gets its camera), then Render shots to video (mp4) again")
		return {}
	if S.cards.size() < 2:
		_say_plain("NOT NOW: a render needs at least 2 cards (a move): press Enter to add a card, or open a scene in the list below")
		return {}
	if RenderEstimate.show_first:
		_render_estimate()   # C25: opt-in, the estimate is said before the first frame
	var fps: int = S.fps
	var length: float = _ps().length()
	var n := ShotRender.frame_count(length, fps)
	var rng := ShotRender.ranges(_shot_shots(), length, fps)
	var nm := safe_file(S.name) if S.name != "" else "scene"
	var preset := String(opts.get("preset", ""))
	var first_f := clampi(int(opts.get("first", 0)), 0, n - 1)
	var last_f := mini(n, first_f + int(opts.get("count", n)))
	n = last_f - first_f   # the frames this render makes
	var dir := "%s/%s_%s%s" % [root_dir, nm, _stamp(), ("_" + preset) if preset != "" else ""]
	var gdir := ProjectSettings.globalize_path(dir)
	if DirAccess.make_dir_recursive_absolute(gdir) != OK:
		_say_plain("NOT DONE: the folder %s could not be made: close anything using it, or choose another place, and run Render shots to video again" % dir)
		return {}
	_sr_busy = true
	_sr_cancel = false
	_sr_panel_make()
	_sr_layer.visible = true
	_sr_bar.value = 0.0
	_sr_label.text = "Rendering shots: starting..."
	var keep := B.state()
	var keep_t := playhead
	var keep_playing := playing
	var keep_clean := clean
	playing = false
	clean = true   # the shot frame is the largest 16:9 in the CLEAN window: its rect is taken there, as the playblast does
	_sides_apply()
	await get_tree().process_frame
	var shot := _shot_blast_begin()
	clean = keep_clean
	_sides_apply()
	var svp: SubViewport = null
	var svp_cam: Camera3D = null
	var fr_lights := [light_key, light_fill, light_rim]
	var fr_saved := {}
	var fr_hide := []
	var fr_outline: Variant = null
	if preset != "":
		svp = SubViewport.new()
		svp.size = Vector2i(int(opts.get("w", FinalRender.DEFAULT_RES.x)), int(opts.get("h", FinalRender.DEFAULT_RES.y)))
		svp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
		add_child(svp)   # no own world: it draws this scene's World3D
		svp_cam = Camera3D.new()
		svp_cam.keep_aspect = Camera3D.KEEP_HEIGHT
		svp.add_child(svp_cam)
		svp_cam.current = true
		fr_saved = FinalRender.apply(preset, world_env, svp, fr_lights)
		# the editor's own visuals are not part of the picture: the grid, the axes, the body's sky outline (collapsed to zero thickness)
		for nd in [grid_node, _axis_node()]:
			if nd != null:
				fr_hide.append([nd, nd.visible])
				nd.visible = false
		if _body_outline != null:
			fr_outline = _body_outline.get_shader_parameter("grow")
			_body_outline.set_shader_parameter("grow", 0.0)
	var done := 0
	for r in rng:
		for j in int(r["count"]):
			if _sr_cancel:
				break
			var f: int = int(r["first"]) + j
			if f < first_f or f >= last_f:
				continue
			_sr_label.text = "Rendering shots: frame %d of %d  (shot %d of %d: %s)" % [f - first_f + 1, n, int(r["shot"]) + 1, _shot_shots().size(), _shot_shots()[int(r["shot"])]["name"]]
			_sr_bar.value = 100.0 * float(done) / float(n)
			_say_plain("rendering shots: %d%%  (frame %d of %d; Esc or Cancel render stops it)" % [int(100.0 * done / n), f - first_f + 1, n])
			await RenderingServer.frame_post_draw   # one drawn frame WITH the progress panel; a click on Cancel is read meanwhile
			if _sr_cancel:
				break
			clean = true   # the capture frame: no panels, no handles (they are built by _refresh, so it runs AFTER clean is on)
			_sides_apply()
			ui_root.visible = false
			_sr_layer.visible = false
			var sub_imgs := []
			var hq := preset == "final_hq"
			var hq_sub := int(opts.get("subframes", FinalHQ.PRESET["subframes"]))
			var hq_acc := maxi(1, int(opts.get("accum", FinalHQ.PRESET["accum"])))
			var tt_list: Array = FinalHQ.motion_times(float(f) / fps, fps, hq_sub, float(opts.get("shutter", FinalHQ.PRESET["shutter"])), 0.0, float(maxi(ShotRender.frame_count(length, fps) - 1, 0)) / fps) if hq else BlastBlur.times(blast_blur, float(f) / fps, fps, blast_blur_n, blast_shutter, 0.0, float(maxi(n - 1, 0)) / fps)
			for tt in tt_list:
				playhead = tt
				_ps().apply(B, playhead)
				BlastBlur.on_time(playhead)
				wt.render_active = true   # R23
				_refresh()
				_shot_blast_frame(shot)
				if svp != null:
					var sv := shot_view_at(playhead)   # the shot camera itself, the whole frame (no crop of the window)
					svp_cam.global_transform = sv["xf"]
					svp_cam.fov = ShotCam.fov_v(float(sv["f"]))
					svp_cam.attributes = cam.attributes
					if hq:
						var kk := shot_at(playhead)
						var fd: float = float(sv["focus"]) if not is_nan(float(sv["focus"])) else maxf(0.5, (kk["pos"] as Vector3).distance_to(kk["aim"] as Vector3))
						if svp_cam.attributes == null:
							FinalHQ.dof(svp_cam, fd)
						await get_tree().process_frame   # SDFGI / SSAO settle on the new pose
						await get_tree().process_frame
						await get_tree().process_frame
						var base_xf: Transform3D = svp_cam.global_transform
						for ak in hq_acc:
							svp_cam.global_transform = FinalHQ.jitter_xf(base_xf, FinalHQ.jitter(ak, hq_acc), svp_cam.fov, fd, svp.size.y)
							sub_imgs.append(await FinalRender.grab(get_tree(), svp))
						svp_cam.global_transform = base_xf
					else:
						if preset == "final":
							await get_tree().process_frame   # SSAO / SDFGI settle on the new pose
							await get_tree().process_frame
						sub_imgs.append(await FinalRender.grab(get_tree(), svp))
				else:
					await get_tree().process_frame
					await RenderingServer.frame_post_draw
					sub_imgs.append(_shot_blast_image(shot, get_viewport().get_texture().get_image()))
			if hq:
				var hq_acc_r: Dictionary = FinalHQ.accumulate_var(sub_imgs)
				var hq_img: Image = hq_acc_r["img"]
				if bool(opts.get("denoise", FinalHQ.PRESET["denoise"])):
					hq_img = FinalHQ.denoise(hq_img, hq_img, -1, -1.0, -1.0, hq_acc_r["var"])   # self-guided, edge-stop scaled by the sub-samples' own variance (SVGF-style)
				FinalHQ.to_rgb8(hq_img).save_png("%s/frame_%04d.png" % [gdir, f - first_f])
			else:
				(sub_imgs[0] if sub_imgs.size() == 1 else PlayblastExport.average(sub_imgs)).save_png("%s/frame_%04d.png" % [gdir, f - first_f])
			wt.render_active = false
			ui_root.visible = true
			_sr_layer.visible = true
			clean = keep_clean
			_sides_apply()
			_refresh()
			done += 1
		if _sr_cancel:
			break
	_shot_blast_end(shot)
	if svp != null:
		FinalRender.restore(fr_saved, world_env, svp, fr_lights)
		for h in fr_hide:
			(h[0] as Node3D).visible = h[1]
		if _body_outline != null and fr_outline != null:
			_body_outline.set_shader_parameter("grow", fr_outline)
		svp.queue_free()
	ui_root.visible = true
	clean = keep_clean
	_sides_apply()
	B.set_state(keep)
	playhead = keep_t
	playing = keep_playing
	_refresh()
	var cancelled := _sr_cancel
	var ff := ""
	var mp4 := ""
	var how := ""
	if cancelled:
		how = "Cancelled: %d of %d frames were made and stay in that folder; no .mp4. Run Render shots to video again to make it all" % [done, n]
	else:
		_sr_label.text = "Encoding the .mp4..."
		_sr_bar.value = 100.0
		await get_tree().process_frame
		ff = PlayblastExport.find_ffmpeg(ffmpeg_path)
		if ff == "":
			how = ". No .mp4: ffmpeg was not found; install it (winget install Gyan.FFmpeg, or ffmpeg.org), then run Render shots to video again, or set POSER_FFMPEG to ffmpeg.exe"
		elif PlayblastExport.encode(ff, gdir, fps, "%s/%s.mp4" % [gdir, nm], AudioTrack.audible_list(S.audio_tracks), float(first_f) / float(fps)) == OK and FileAccess.file_exists("%s/%s.mp4" % [gdir, nm]):
			mp4 = "%s/%s.mp4" % [gdir, nm]
			how = " and %s.mp4" % nm
		else:
			how = ". No .mp4: ffmpeg (%s) failed on the frames; the PNGs are fine, run ffmpeg on them yourself" % ff
	_sr_layer.visible = false
	_sr_busy = false
	_sr_cancel = false
	if cancelled:
		_say_plain("shot render stopped. " + how)
	else:
		_say_plain("shots rendered: %d frames at %d fps (%d shots, %s) in %s%s" % [n, fps, rng.size(), Units.time(length, S.fps), dir, how])
	var res := {"dir": gdir, "frames": done, "mp4": mp4, "ffmpeg": ff, "cancelled": cancelled, "ranges": rng, "want": n}
	shots_render_done.emit(res)
	return res


## REVIEW WITH FRAME COMMENTS (ROADMAP 29; scripts/review.gd): the playblast's frames (the same capture, no mp4, the frames
## kept in a temporary folder and removed after) -> ONE self-contained page, root/<scene>_<date>.html (never over an
## earlier one). Returns the page's path; "" when refused. Nothing leaves the machine.
func _export_review(root_dir := Review.DIR) -> String:
	root_dir = UserPaths.w(root_dir)   # an exported build: the user's folder
	if S.cards.size() < 2:
		_say_plain("NOT NOW: a review page needs at least 2 cards (a move): press Enter to add a card, or open a scene in the list below")
		return ""
	var fps: int = S.fps
	var first := roundi(PlayblastExport.span(pv_in, pv_out, _ps().length())[0] * float(fps))   # the scene frame of the first page frame
	var rs: Dictionary = await _export_playblast("user://review_frames", "", false)
	if rs.is_empty():
		return ""
	var gdir: String = rs["dir"]
	var n: int = rs["frames"]
	var uris := []
	for f in n:
		var png := "%s/frame_%04d.png" % [gdir, f]
		var u := Review.frame_uri(png)
		if u != "":
			uris.append(u)
		DirAccess.remove_absolute(png)
	DirAccess.remove_absolute(gdir)
	if uris.size() != n:
		_say_plain("NOT DONE: %d of %d frames could not be read back for the page; nothing was written" % [n - uris.size(), n])
		return ""
	var date := Time.get_date_string_from_system()
	var dir_abs := ProjectSettings.globalize_path(root_dir)
	DirAccess.make_dir_recursive_absolute(dir_abs)
	var out := Review.page_path(safe_file(S.name) if S.name != "" else "scene", date, root_dir)
	var fh := FileAccess.open(out, FileAccess.WRITE)
	if fh == null:
		_say_plain("NOT DONE: the page %s could not be written: close anything using it, and run Review: export a review page again" % out)
		return ""
	fh.store_string(Review.html(S.name if S.name != "" else "scene", fps, first, uris, date))
	fh.close()
	_say_plain("review page: %d frames at %d fps in %s. Open it in any browser; comments are kept there, and Download comments writes a .json to import back" % [n, fps, out])
	return out


func _review_import_ask() -> void:
	var fd := FileDialog.new()
	fd.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	fd.access = FileDialog.ACCESS_FILESYSTEM
	fd.filters = PackedStringArray(["*.json ; review comments"])
	fd.use_native_dialog = true
	fd.title = "Import review comments (.json)"
	fd.file_selected.connect(func(p): _review_import(p); fd.queue_free())
	fd.canceled.connect(fd.queue_free)
	add_child(fd)
	fd.popup_centered(Vector2i(800, 500))


## the comments of a review page's .json as notes on this scene: one undo step; the ones already here are not doubled.
## Returns the number added, -1 when refused (the reason on the status line, nothing changed)
func _review_import(path: String) -> int:
	var r := Review.from_comments(FileAccess.get_file_as_string(path))
	if not r["ok"]:
		_say("could not import %s: %s; pick the .json a review page saved" % [path.get_file(), r["why"]])
		return -1
	var before := S.notes.size()
	_push_undo()
	S.notes = Review.merge(S.notes, r["notes"])
	_markers_changed()
	var added := S.notes.size() - before
	_say("imported %d comments from %s as notes on the timeline (%d were already there): click one to jump. Ctrl+Z undoes" % [r["notes"].size(), path.get_file(), r["notes"].size() - added])
	return added


## EXPORT .BVH (round 34, GATES OO2): the scene as exports/<scene>.bvh (BvhExport, the writer tools/export_bvh.gd uses):
## the skeleton with UE5's bone names, every frame, the weapons as joints in their hands. Every retargeter reads BVH.
func _export_bvh(dir := "res://exports") -> String:
	dir = UserPaths.w(dir)   # an exported build: the user's folder
	if S.cards.size() < 2:
		_say_plain("NOT NOW: an animation needs at least 2 cards (a move)")
		return ""
	var acts := _export_actors()
	if not acts.is_empty():   # TC6: a BVH holds one skeleton, so one file per fighter, placed by its root channels
		var rs := BvhExport.write_actors(acts, dir, _export_base())
		_refresh()
		var bad := rs.filter(func(r): return r[1] != OK)
		if not bad.is_empty():
			_say_plain("NOT DONE: %s could not be written (%s)" % [(bad[0][0] as String).get_file(), error_string(bad[0][1])])
			return ""
		_say_plain("exported one .bvh per fighter: %s (%d frames at %d fps each, placed where they stand). Opens in Blender, MotionBuilder, Cascadeur and any retargeter" % [", ".join(rs.map(func(r): return (r[0] as String).get_file())), rs[0][2]["frames"], rs[0][2]["fps"]])
		return rs[0][0]
	var nm := S.name if S.name != "" else "scene"
	var path := "%s/%s.bvh" % [dir, nm]
	var r := BvhExport.write(S, B, path)
	_refresh()
	if r[0] != OK:
		_say_plain("NOT DONE: the .bvh could not be written (%s)" % error_string(r[0]))
		return ""
	var info: Dictionary = r[1]
	_say_plain("exported %s.bvh: %d joints, %d frames at %d fps%s. Opens in Blender, MotionBuilder, Cascadeur and any retargeter" % [nm, info["joints"], info["frames"], S.fps, " (the weapons as joints in their hands)" if not BvhExport.weapons_of(S).is_empty() else ""])
	return path


## EXPORT .USDA (round 42, GATES XX9): the scene as exports/<scene>.usda (UsdExport): a UsdSkel SkelRoot, Skeleton and
## SkelAnimation, one time sample per frame. Opens in Blender, Houdini, Maya, usdview, Omniverse.
func _export_usd(dir := "res://exports") -> String:
	dir = UserPaths.w(dir)   # an exported build: the user's folder
	if S.cards.size() < 2:
		_say_plain("NOT NOW: an animation needs at least 2 cards (a move)")
		return ""
	var acts := _export_actors()
	if not acts.is_empty():   # TC6: every fighter in one stage, a SkelRoot each at its placement
		var mp := "%s/%s.usda" % [dir, _export_base()]
		var mr := UsdExport.write_actors(acts, mp)
		_refresh()
		if mr[0] != OK:
			_say_plain("NOT DONE: the .usda could not be written (%s)" % error_string(mr[0]))
			return ""
		_say_plain("exported %s: %d fighters (%s), a UsdSkel each at its place, %d frames at %d fps (Y up, metres; the weapons are not in it)" % [mp.get_file(), acts.size(), ", ".join(mr[1]["prims"]), mr[1]["frames"], mr[1]["fps"]])
		return mp
	var nm := S.name if S.name != "" else "scene"
	var path := "%s/%s.usda" % [dir, nm]
	var r := UsdExport.write(S, B, path)
	_refresh()
	if r[0] != OK:
		_say_plain("NOT DONE: the .usda could not be written (%s)" % error_string(r[0]))
		return ""
	_say_plain("exported %s.usda: %d joints, %d frames at %d fps (UsdSkel, Y up, metres; the weapons are not in it)" % [nm, r[1]["joints"], r[1]["frames"], S.fps])
	return path


## EXPORT .USDA, SKINNED (L19): the fighter as a UsdSkel with its skinned mesh, joint weights and, with the face geometry on, the six AU
## BlendShapes (UsdWire.character: the imported CharImport character when one stands, else the mannequin). exports/<scene>_skinned.usda.
func _export_usd_skinned(dir := "res://exports") -> String:
	dir = UserPaths.w(dir)   # an exported build: the user's folder
	if S.cards.size() < 2:
		_say_plain("NOT NOW: an animation needs at least 2 cards (a move)")
		return ""
	if not _export_actors().is_empty():
		_say_plain("NOT NOW: the skinned .usda is one fighter; with several fighters, Export animation (.usda) puts each one in its file")
		return ""
	var nm := S.name if S.name != "" else "scene"
	var path := "%s/%s_skinned.usda" % [dir, nm]
	var keep := B.state()
	var ch := UsdWire.character(S, B, self)
	if ch.is_empty():
		B.set_state(keep)
		_say_plain("NOT DONE: there is no skinned body to write (the imported character could not be fitted)")
		return ""
	var r := UsdExport.write_skinned(S, B, ch, path)
	B.set_state(keep)
	_refresh()
	if r[0] != OK:
		_say_plain("NOT DONE: the .usda could not be written (%s)" % error_string(r[0]))
		return ""
	_say_plain("exported %s_skinned.usda: %d vertices, %d joints, %d blend shape%s, %d frames at %d fps (UsdSkel mesh with joint weights, Y up, metres; the weapons are not in it)" % [nm, r[1]["verts"], r[1]["joints"], r[1]["shapes"], "" if r[1]["shapes"] == 1 else "s", r[1]["frames"], S.fps])
	return path


## EXPORT USD LAYERS (ROADMAP 79, GATES USDL): the scene as exports/<name>_usd/ (UsdExport.write_layers): a root <name>.usda
## whose sublayers are the props and camera, the joint point cache (Points, not Alembic), one override per animation layer,
## the base animation and the skeleton. Returns the root's path ("" when not written). One fighter only: with several, the
## flat Export animation (.usda) holds them all.
func _export_usd_layers(dir := "res://exports") -> String:
	dir = UserPaths.w(dir)   # an exported build: the user's folder
	if S.cards.size() < 2:
		_say_plain("NOT NOW: an animation needs at least 2 cards (a move)")
		return ""
	if not _export_actors().is_empty():
		_say_plain("NOT NOW: the layers are one fighter; with several fighters, Export animation (.usda) puts each one in its file")
		return ""
	var nm := S.name if S.name != "" else "scene"
	var r := UsdExport.write_layers(S, B, dir, nm)
	_refresh()
	if r[0] != OK:
		_say_plain("NOT DONE: the layers could not be written (%s); check the exports folder is writable" % error_string(r[0]))
		return ""
	var info: Dictionary = r[1]
	_say_plain("exported %s_usd/: %d layer%s under %s (mute one in your DCC; a lower layer shows only once the one above it is muted), joints in %s_points.usda as a point cache (no Alembic: see the export dialog)" % [
		UsdExport.prim_name(nm), info["layers"], "" if info["layers"] == 1 else "s", (info["root"] as String).get_file(), UsdExport.prim_name(nm)])
	return info["root"]


## TWO CHARACTERS IN THE EXPORTS (round 50, GATES TC6): every fighter, hero first, with its own body, scene and placement
## (its xf in the hero's space); [] with one fighter, and the exports write what they always wrote
func _export_actors() -> Array:
	_actors_sync()
	if S.crowd.is_empty():
		if actors_rt.size() < 2:
			return []
		return actors_rt.map(func(a): return {"name": a["name"], "S": a["S"], "B": a["B"], "xf": a["xf"]})
	# ROADMAP 95: a crowd is exported as one more actor per copy, beside the fighter itself (the hero, then the others)
	var acts := []
	if actors_rt.is_empty():
		acts.append({"name": "hero", "S": S, "B": B, "xf": Transform3D.IDENTITY})
	else:
		acts.append_array(actors_rt.map(func(a): return {"name": a["name"], "S": a["S"], "B": a["B"], "xf": a["xf"]}))
	_crowd_sync()
	for m in crowd_men:
		acts.append({"name": "crowd_%02d" % int(m["k"]), "S": m["sc"], "B": m["B"], "xf": Crowd.placement(m["c"])})
	return acts


## the file name of a multi-fighter export: the hero's scene, whoever is active
func _export_base() -> String:
	var nm := _hero_scene().name
	return safe_file(nm) if nm != "" else "scene"


func _av_now() -> float:
	return float(autover_clock.call()) if autover_clock.is_valid() else Time.get_ticks_msec() / 1000.0


func _av_load(path: String) -> Scene:
	var d = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not (d is Dictionary):
		return null
	var V := Scene.new()
	V.from_dict(d)
	return V


## the sentence for a new snapshot d against the newest one in `list` ("first snapshot" when there is none)
func _av_diff_vs_latest(list: Array, d: Dictionary) -> String:
	if list.is_empty():
		return "first snapshot"
	var A := _av_load(list[0])
	if A == null:
		return ""
	var B := Scene.new()
	B.from_dict(d)
	return SnapDiff.summary(A, B, func(j): return nice(j))


## the scene as it is now is the state the next timed snapshot is measured against
func _av_rebase() -> void:
	var d := _scene_dict(false)
	_av_json = JSON.stringify(d)
	_av_scene = Scene.new()
	_av_scene.from_dict(d)
	_av_dir = versions_dir()


## called every frame (and by the test with a fake clock): one snapshot per autover_min minutes of editing, only
## when the scene changed. The first look only sets the baseline.
func autover_tick() -> bool:
	if autover_min <= 0:
		_av_t = -1.0
		return false
	var now := _av_now()
	if _av_t < 0.0 or _av_dir != versions_dir():
		_av_t = now
		_av_rebase()
		return false
	if now - _av_t < autover_min * 60.0:
		return false
	_av_t = now
	var d := _scene_dict(false)
	var js := JSON.stringify(d)
	if js == _av_json:
		return false   # nothing changed since the last snapshot: none taken
	var list := versions()
	var n := 1 if list.is_empty() else (list[0] as String).get_file().get_basename().substr(1).to_int() + 1
	var B := Scene.new()
	B.from_dict(d)
	d = _scene_dict()
	d["version"] = {"n": n, "saved": Time.get_datetime_string_from_system(false, true), "auto": true,
		"diff": SnapDiff.summary(_av_scene, B, func(j): return nice(j))}
	_autover_write("%s/v%03d.json" % [versions_dir(), n], d)
	_av_json = js
	_av_scene = B
	_autover_prune()
	return true


func _autover_write(path: String, d: Dictionary) -> void:
	_write(path, d)


## keeps the newest autover_keep timed snapshots; manual ones are never touched
func _autover_prune() -> void:
	var autos := []
	for p in versions():   # newest first
		var d = JSON.parse_string(FileAccess.get_file_as_string(p))
		if d is Dictionary and bool((d.get("version", {}) as Dictionary).get("auto", false)):
			autos.append(p)
	for i in range(maxi(autover_keep, 1), autos.size()):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(autos[i]))


func _autover_cfg_save() -> void:
	var cf := ConfigFile.new()
	cf.load(settings)
	cf.set_value("versions", "auto_min", autover_min)
	cf.set_value("versions", "auto_keep", autover_keep)
	cf.save(settings)


func _autover_cfg_load(testing: bool) -> void:
	var cf := ConfigFile.new()
	if cf.load(settings) == OK:
		autover_min = clampi(int(cf.get_value("versions", "auto_min", 5)), 0, 120)
		autover_keep = clampi(int(cf.get_value("versions", "auto_keep", 30)), 1, 500)
	if testing:
		autover_min = 0   # a test never snapshots into scenes/ on its own; r20_test turns it on with its own folder


func _autover_cycle() -> void:
	var steps := [0, 2, 5, 10, 15]
	var i := steps.find(autover_min)
	autover_min = steps[(i + 1) % steps.size()]
	_av_t = -1.0
	_autover_cfg_save()
	_say_plain("timed snapshots: %s" % ("off" if autover_min == 0 else "every %d min while you edit, last %d kept" % [autover_min, autover_keep]))


func _versions_menu() -> void:
	var pm := ui_versions.get_popup()
	pm.clear()
	pm.add_item("Save a version now", 0)
	pm.add_item("Timed snapshots: %s  (click: next)" % ("off" if autover_min == 0 else "every %d min" % autover_min), 5)
	pm.set_item_tooltip(pm.item_count - 1, "while you edit, a snapshot every few minutes if the scene changed (off, 2, 5, 10, 15 min). The last %d are kept; versions you save yourself are never removed" % autover_keep)
	pm.add_separator()
	_version_paths = versions()
	if _version_paths.is_empty():
		pm.add_item("no versions yet", 1)
		pm.set_item_disabled(pm.item_count - 1, true)
		pm.set_item_tooltip(pm.item_count - 1, "NOT NOW: this scene has no versions yet. 'Save a version now' (above) keeps the scene as it is, to come back to")
	for i in _version_paths.size():
		var d: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(_version_paths[i]))
		var v: Dictionary = d.get("version", {})
		pm.add_item("v%d   %s   %d cards%s" % [v.get("n", 0), String(v.get("saved", "")).get_slice(" ", 1).left(5), (d.get("cards", []) as Array).size(), "   (timed)" if bool(v.get("auto", false)) else ""], 100 + i)
		if String(v.get("diff", "")) != "":   # R20: what changed since the one before, under its row
			pm.add_item("        " + String(v["diff"]), 1)
			pm.set_item_disabled(pm.item_count - 1, true)
	# COMPARE WITH (ROADMAP 28): ids 50.. compare, 2 stops, 3 restores the one compared (ids 100.. restore a row)
	pm.add_separator()
	pm.add_item("Diff report: what changed, in words...", 4)   # ROADMAP 98: two versions, or one and the open scene
	pm.set_item_tooltip(pm.item_count - 1, "a readable list of what changed between two versions (or a version and the open scene): cards added, removed, moved, joints, timing, props, markers, notes, settings. Read only")
	if not _version_paths.is_empty():
		pm.add_separator()
		for i in mini(_version_paths.size(), 50):
			pm.add_item("Versions: compare with v%d ..." % _version_n(_version_paths[i]), 50 + i)
			pm.set_item_tooltip(pm.item_count - 1, "the version over the open scene: its body as a magenta ghost at the playhead, the changes card by card, and marks on the timeline where a joint differs by more than 2 deg")
	if not vdiff.is_empty():
		pm.add_separator()
		pm.add_item("Versions: restore this one (v%d)" % _version_n(vdiff["path"]), 3)
		pm.set_item_tooltip(pm.item_count - 1, "opens the compared version as the scene's cards, one undo step (the scene's file is not touched)")
		pm.add_item("Versions: stop comparing", 2)


func _version_picked(id: int) -> void:
	if id == 4:   # ROADMAP 98: the diff report (ids 0..3 are taken, 50.. compare, 100.. restore)
		_sdiff_open()
	elif id == 0:
		_save_version()
	elif id == 5:
		_autover_cycle()
	elif id == 2:
		_vdiff_clear()
	elif id == 3 and not vdiff.is_empty():
		var p: String = vdiff["path"]
		_vdiff_clear()
		_open_version(p)
	elif id >= 100 and id - 100 < _version_paths.size():
		_open_version(_version_paths[id - 100])
	elif id >= 50 and id < 100 and id - 50 < _version_paths.size():
		_compare_version(_version_paths[id - 50])


func _version_n(path: String) -> int:
	var d = JSON.parse_string(FileAccess.get_file_as_string(path))
	return int((d.get("version", {}) as Dictionary).get("n", 0)) if d is Dictionary else 0


## COMPARE WITH (ROADMAP 28): the version laid over the open scene (ghost at the playhead, rows, timeline marks)
func _compare_version(path: String) -> void:
	var old := VersionDiff.load_scene(path)
	if old == null:
		_say_plain("NOT NOW: %s will not open as a scene" % path.get_file())
		return
	vdiff = {"path": path, "name": path.get_file().get_basename(), "scene": old}
	_vdiff_update()
	ui_timeline.queue_redraw()
	_refresh()
	var n_rows: int = vdiff["rows"].size()
	_say_plain("comparing with %s: %d change%s, %d frame%s over 2 deg (magenta on the timeline).  Versions: stop comparing, to clear" % [vdiff["name"], n_rows, "" if n_rows == 1 else "s", vdiff["marks"].size(), "" if vdiff["marks"].size() == 1 else "s"])


func _vdiff_clear() -> void:
	vdiff = {}
	ui_vdiff.visible = false
	ui_timeline.queue_redraw()
	_refresh()


## DIFF REPORT (ROADMAP 98, scripts/scene_report.gd): the panel, built once. Top left of the view, like the compare list.
