	if u["scene"] == S and u.has("beats_audio") and var_to_str(u["beats_audio"]) != var_to_str(S.beats_audio):
		S.beats_audio = u["beats_audio"].duplicate(true)   # ROADMAP 32: the music beats, undone like a card
		if ui_timeline != null:
