func _ready() -> void:
	# THE QUALITY WORKER (Easy's My scenes badges): Kine --headless --kine-quality-worker <list.json> grades the list and quits
	# before anything else starts (no UI, no autosave). Checked first, so the app's start-up never runs in that process.
	var wargs := OS.get_cmdline_args()
	var smoke_args := PackedStringArray(wargs) + OS.get_cmdline_user_args()
	if InstallSmoke.wanted(smoke_args):   # L16: the clean-machine install test's launch; checks the install, writes nothing, exits 0 or 3
		process_mode = Node.PROCESS_MODE_DISABLED
		var smoke_code := InstallSmoke.run(smoke_args)
		get_tree().quit(smoke_code)
		return
	var wi := wargs.find("--kine-quality-worker")
	if wi >= 0 and wi + 1 < wargs.size():
		process_mode = Node.PROCESS_MODE_DISABLED   # the app's per-frame work (autosave, auto-version) must not run in this process
		SceneQualityWorker.run(wargs[wi + 1])
		get_tree().quit()
		return
	SlicerSend.prewarm()   # the Export dialog's slicer lookup (~2 s) runs on a worker thread now, not at the first open
	BootProfile.start()   # KINE_BOOT_PROFILE=1 / --boot-profile: the start-up blocks, timed (scripts/boot_profile.gd)
	RenderingServer.set_debug_generate_wireframes(true)   # K01: the wireframe view needs this before any mesh is made
	# EVERY WIDGET BY NAME (round 14, U2): each control the window builds is named from what it says (scripts/names.gd)
	# at once (a click that rebuilds a row must not leave it nameless for a frame); one with nothing to say yet (its
	# text is set after it is added) gets its name a frame later
	get_tree().node_added.connect(func(n: Node):
		if kb_nav and n is Control and _kb_kind(n):
			_kb_take(n)
		if Names.wants(n):
			if Names.said(n) != "":
				Names.give(n)
			else:
				_name_later.call_deferred(n))
	onboard = Onboarding.new()
	onboard.m = self
	add_child(onboard)
	guided_pose = GuidedPose.new()
	guided_pose.m = self
	add_child(guided_pose)
	BootProfile.mark("onboard node")
	model_cards = ModelCards.new()
	model_cards.m = self
	add_child(model_cards)
	build_choose = BuildChoose.new()
	build_choose.m = self
	add_child(build_choose)
	page_tour = PageTour.new()
	page_tour.m = self
	add_child(page_tour)
	BootProfile.mark("page_tour node")
	easy = EasyMode.new()   # first: lw() / rw() read easy.on while the world is built (scripts/easy_mode.gd)
	easy.m = self
	add_child(easy)
	BootProfile.mark("easy node")
	B.load_files("res://data/skeleton.json", "res://data/body_limits.json")
	BootProfile.mark("load skeleton+limits")
	var testing: bool = Engine.get_main_loop().get_script() != null
	sticky.set_on(StickyKeys.saved() if (not testing or OS.get_environment("KINE_STICKY_FILE") != "") else false)   # C11
	KineLang.apply_saved(testing)   # FRIDAY 99: the remembered language (English unless Portugues was picked in the start screen's Settings)
	if testing:
		settings = "user://poser_test_%d.cfg" % OS.get_process_id()
		autosave = "user://autosave_test_%d.json" % OS.get_process_id()
		library = "user://zz_lib_%d" % OS.get_process_id()
		Houses.dir = "user://zz_houses_%d" % OS.get_process_id()   # a test never lists or writes the real saved houses
		macros_file = "user://macros_test_%d.json" % OS.get_process_id()   # a test never touches the real macros file
		sd.cache_path = "user://zz_smart_drag_%d.json" % OS.get_process_id()   # I12: a test's own model cache
		smart_drag = false   # I12: off in a test until it turns it on (the older drag tests measure the one-joint drag)
		keep_balance = false   # N066: off in a test until it turns it on (the older drag tests measure the plain drag)
		sj = SuggestionJournal.new("user://zz_suggestion_journal_%d.json" % OS.get_process_id())   # I26: a test never reads or writes the real journal
		myhits.sj = sj
		nt.path = "user://zz_next_tool_%d.json" % OS.get_process_id()   # P17: a test never reads or writes the real next-command file (its chips made small_window / pages flaky)
		np.cache_path = "user://zz_next_pose_%d.json" % OS.get_process_id()   # R27: a test's own index; the ghosts are off in a test until it turns them on
		sg_on = false
		style_ui.on = false   # I17: like Nick is off in a test until it turns it on
		bt_ui.stars_path = "user://zz_best_take_%d.json" % OS.get_process_id()   # I38: a test's own stars file
		style_ui.path = "user://zz_style_print_%d.json" % OS.get_process_id()   # I17: a test's own fingerprint file
		usual_on = false   # I10: a test keeps the app's default timing on new cards until it turns this on
		BootProfile.mark("test settings")
	_autover_cfg_load(testing)
