## a label for one option: the open scene, or a version (its number, the time it was saved, its cards)
func _sdiff_label(p: String) -> String:
	if p == "":
		return "now (the open scene)"
	var d: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(p))
	var v: Dictionary = d.get("version", {}) if d is Dictionary else {}
	return "v%d  %s  %d cards" % [v.get("n", 0), String(v.get("saved", "")).get_slice(" ", 1).left(5), (d.get("cards", []) as Array).size()]


## the report opens on the newest version against the open scene (the usual question: what did I change since I saved)
func _sdiff_open(old_paths := []) -> void:   # old_paths: the saved versions offered (the test's seam; {} = this scene's versions)
	_sdiff_paths = [""]
	_sdiff_paths.append_array(old_paths if not old_paths.is_empty() else versions())
	ui_sdiff_a.clear()
	ui_sdiff_b.clear()
	for i in _sdiff_paths.size():
		ui_sdiff_a.add_item(_sdiff_label(_sdiff_paths[i]), i)
		ui_sdiff_b.add_item(_sdiff_label(_sdiff_paths[i]), i)
	ui_sdiff_a.select(1 if _sdiff_paths.size() > 1 else 0)
	ui_sdiff_b.select(0)
	ui_sdiff.visible = true
	_sdiff_run()
	if _sdiff_paths.size() == 1:
		_say_plain("no versions to compare yet: Versions, 'Save a version now' keeps this scene to compare with later")


## the rows of the two picked sides: the older (A) against the newer (B). Nothing is written.
func _sdiff_run() -> void:
	var pa: String = _sdiff_paths[ui_sdiff_a.selected]
	var pb: String = _sdiff_paths[ui_sdiff_b.selected]
	var A: Scene = S if pa == "" else VersionDiff.load_scene(pa)
	var Bs: Scene = S if pb == "" else VersionDiff.load_scene(pb)
	if A == null or Bs == null:
		_say_plain("NOT NOW: %s will not open as a scene: pick another version" % (pa if A == null else pb).get_file())
		return
	_sdiff_a = A
	_sdiff_rows = SceneReport.report(A, Bs, func(j): return nice(j))
	for c in ui_sdiff_list.get_children():
		ui_sdiff_list.remove_child(c)
		c.queue_free()
	var head := "No changes: %s and %s are the same (%d cards each)" % [_sdiff_label(pa), _sdiff_label(pb), Bs.cards.size()]
	if not _sdiff_rows.is_empty():
		var nj := 0
		for r in _sdiff_rows:
			if r["kind"] == "joint":
				nj += 1
		head = "%d changes (%d joints over 0.5 deg), %s is newer.  Click a row to go to its card" % [_sdiff_rows.size(), nj, _sdiff_label(pb)]
		if pb != "":
			head += "  (jumps work on the open scene: pick 'now' as the newer side)"
	ui_sdiff_head.text = head
	if _sdiff_rows.is_empty():
		_sdiff_line("nothing differs in the cards, the poses, the timing, the props, markers, notes or settings")
	for k in _sdiff_rows.size():
		var r: Dictionary = _sdiff_rows[k]
		var b := Button.new()
		b.name = "sdiff_row_%d" % k
		b.flat = true
		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
		b.text = r["text"]
		b.clip_text = true
		b.focus_mode = Control.FOCUS_NONE
		if int(r["card"]) < 0:
			b.disabled = true
			b.tooltip_text = "the card is not in the newer side, so there is no place to jump to"
		else:
			b.tooltip_text = "go to card %d and select %s" % [int(r["card"]) + 1, String(r["joint"]) if r["joint"] != "" else "the card"]
			b.pressed.connect(_sdiff_jump.bind(k))
		ui_sdiff_list.add_child(b)
	if ui_sdiff_both.button_pressed and _sdiff_last_card() >= 0:
		_sdiff_ghost(_sdiff_rows[_sdiff_last_card()])


## a plain line in the list (no row)
func _sdiff_line(t: String) -> void:
	var l := _label(t, 13, "text:0.85", true)
	ui_sdiff_list.add_child(l)


## the row index of the last jump (-1 = none): the ghost follows it
var _sdiff_last := -1


func _sdiff_last_card() -> int:
	return _sdiff_last if _sdiff_last >= 0 and _sdiff_last < _sdiff_rows.size() else -1


## a row clicked: the playhead and the card selected in the open scene, the joint selected too (the body is posed from
## the scene; nothing is written)
func _sdiff_jump(k: int) -> void:
	var r: Dictionary = _sdiff_rows[k]
	var c: int = int(r["card"])
	if c < 0:
		return
	if ui_sdiff_b.selected != 0:
		_say_plain("jumps work on the open scene: pick 'now' as the newer side of the diff report")
		return
	_sdiff_last = k
	sel_card = c
	sel_end = -1
	playing = false
	playhead = float(r["t"])
	if r["joint"] != "":
		sel = r["joint"]
	_ps().apply(B, playhead)
	_rebuild_cards()
	if ui_sdiff_both.button_pressed:
		_sdiff_ghost(r)
	_refresh()
	_say_plain("card %d '%s'%s" % [c + 1, S.cards[c]["name"], ("  -  " + nice(r["joint"]) if r["joint"] != "" else "")])


## SHOW BOTH: the older side's pose at the older card, ghosted (magenta) over the open scene at the picked row's card.
## A card that is not in the older side has no ghost to show.
func _sdiff_ghost(r: Dictionary) -> void:
	var has: bool = float(r["ta"]) >= 0.0 and _sdiff_a != null
	vdiff = {"path": "", "name": "older", "scene": _sdiff_a if has else null, "ghost_t": float(r["ta"]) if has else 0.0, "sdiff": true,
		"rows": [], "marks": []}   # the timeline reads the compare's marks: none here
	_refresh()


func _sdiff_both_toggled(on: bool) -> void:
	if on:
		var k := _sdiff_last_card()
		if k >= 0:
			_sdiff_ghost(_sdiff_rows[k])
	elif vdiff.get("sdiff", false):
		vdiff = {}
		_refresh()


func _sdiff_close() -> void:
	ui_sdiff.visible = false
	ui_sdiff_both.set_pressed_no_signal(false)
	if vdiff.get("sdiff", false):
		vdiff = {}
		_refresh()


## the rows and the frame marks of the compared version against the open scene; the panel's text
func _vdiff_update() -> void:
	if vdiff.is_empty():
		return
	var old: Scene = vdiff["scene"]
	vdiff["rows"] = VersionDiff.card_rows(old, S)
	vdiff["marks"] = VersionDiff.frame_marks(old, S)
	var lines := ["comparing: %s (%d cards)  vs  now (%d cards)" % [vdiff["name"], old.cards.size(), S.cards.size()]]
	if vdiff["rows"].is_empty() and vdiff["marks"].is_empty():
		lines.append("no differences: the two are the same")
	for r in vdiff["rows"]:
		var mark: String = {"added": "+ added    ", "removed": "- removed  ", "retimed": "~ retimed  ", "joints": "~ joints   "}[r["kind"]]
		lines.append("%s%s  %s" % [mark, r["name"], r["detail"]])
	var marks: Array = vdiff["marks"]
	if not marks.is_empty():
		lines.append("frames over 2 deg: %d, %.2f s to %.2f s" % [marks.size(), float(marks[0]["t"]), float(marks[-1]["t"])])
	ui_vdiff_text.text = "
".join(lines)
	ui_vdiff.visible = true


## a version's cards into the open scene: one undo step, the scene then unsaved (its file untouched)
func _open_version(path: String) -> void:
	var d: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(path))
	var V := Scene.new()
	V.from_dict(d)
	_do(func():
		S.cards = V.cards   # the cards only: an undo step holds the cards, not the scene's settings (Natural, Loop)
		sel_card = -1
		S.apply(B, 0.0))
	playhead = 0.0
	ov.mark_dirty()
	wt.mark_dirty()
	_rebuild_cards()
	_refresh()
	_say_plain("back to version %d: %d cards (Ctrl+Z undoes; Save scene keeps it)" % [d.get("version", {}).get("n", 0), S.cards.size()])


func _input(ev: InputEvent) -> void:
	StickyKeys.current = sticky
	sticky.filter(ev)   # C11: sticky modifier keys (off unless Settings turns them on)
	# FIX ALL runs in slices (its sampler is part way through a clip between two frames): only its own button answers meanwhile
	if _fixall_on and (ev is InputEventKey or (ev is InputEventMouseButton and not (is_instance_valid(_fixall_btn) and _fixall_btn.get_global_rect().has_point((ev as InputEventMouseButton).position)))):
		get_viewport().set_input_as_handled()
		return
	if sk.on and ev is InputEventKey and ev.pressed and (ev as InputEventKey).keycode == KEY_ESCAPE:   # I9: Esc leaves Sketch mode, the strokes are dropped
		_sk_toggle()
		get_viewport().set_input_as_handled()
		return
	if _sr_busy and ev is InputEventKey and ev.pressed and (ev as InputEventKey).keycode == KEY_ESCAPE:   # Esc stops a shot render
		_sr_cancel = true
		get_viewport().set_input_as_handled()
		return
	if ev is InputEventKey and ev.pressed and (ev as InputEventKey).keycode == KEY_ESCAPE and _card_drag_cancel():
		get_viewport().set_input_as_handled()
		return
	if hk != null and hk.take_input(ev):   # the hotkey editor: a key for the row being set, or Esc closes it
		get_viewport().set_input_as_handled()
		return
	# the gear's box closes on a press outside it and its gear (RR4)
	if ui_gear != null and ui_gear.visible and ev is InputEventMouseButton and (ev as InputEventMouseButton).pressed:
		var at := (ev as InputEventMouseButton).position
		if not ui_gear.get_global_rect().has_point(at) and not ui_gear_btn.get_global_rect().has_point(at):
			ui_gear.visible = false
	if (ev is InputEventMouseButton or ev is InputEventKey) and ev.is_pressed() and not ev.is_echo():
		_tour_inputs += 1
		if tour_step >= 0 and ev is InputEventKey and (ev as InputEventKey).keycode == KEY_ESCAPE:
			_tour_end(true)   # Esc closes the tour (QQ3)
			get_viewport().set_input_as_handled()
			return
	if ev is InputEventKey and ev.pressed and not ev.echo and _num_key(ev as InputEventKey):
		get_viewport().set_input_as_handled()
		return
	if nav_tool != "" and ev is InputEventKey and ev.pressed and (ev as InputEventKey).keycode == KEY_ESCAPE:
		_nav_set("")
		get_viewport().set_input_as_handled()
		return
	# Esc in keyboard mode: before the focused control sees it (a text box would only drop its caret)
	if kb_nav and ev is InputEventKey and ev.pressed and not ev.echo and (ev as InputEventKey).keycode == KEY_ESCAPE:
		_kb_leave()
		get_viewport().set_input_as_handled()


## a control's name, once its text is set (it is added first, labelled right after)
func _name_later(n: Node) -> void:
	Names.give(n)


## RECORD (the --record / --playblast flags; GATES WW6): play the scene, one frame per 1/fps, from the clean big view.
## dir: PNG frames go there ("" = none); avi: one MJPEG AVI of the same frames ("" = none); burn: scene name, frame,
## seconds and the Check finding count drawn into each frame. Returns the number of frames.
func _record(dir: String, fps: int, burn: bool, avi: String) -> int:
	if dir != "":
		DirAccess.make_dir_recursive_absolute(dir)
	for p in ui_side:
		p.visible = false
	ui_root.visible = false
	clean = true
	big_view = true
	dist = 4.6
	target = Vector3(0, 1.05, 0.2)
	_cam()
	cam.v_offset = 0.0
	var finds := -1
	var layer: CanvasLayer = null
	if burn:
		if S.cards.size() >= 2:
			finds = Rulebook.check(S, ov.GB, Rulebook.sample(S, ov.GB)).size()
		layer = Playblast.make_overlay()
		add_child(layer)
	var jpgs := []
	var n := int(ceil(_ps().length() * fps))
	for f in n + 1:
		playhead = float(f) / fps
		_ps().apply(B, playhead)
		_refresh()
		if layer != null:
			(layer.get_node("burn") as Label).text = Playblast.text(S.name, f, playhead, finds)
		await get_tree().process_frame
		await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		if dir != "":
			img.save_png("%s/frame_%04d.png" % [dir, f])
		if avi != "":
			jpgs.append(img.save_jpg_to_buffer(0.9))
	if layer != null:
		layer.queue_free()
	if avi != "" and not jpgs.is_empty():
		var sz := get_viewport().get_visible_rect().size
		AviWriter.write(avi, jpgs, int(sz.x), int(sz.y), fps)
	return n + 1


## SHADING + FPS TRUTH (round 42, GATES XX10): the logic is in scripts/shading.gd
func _shading_next() -> void:
	var nxt := Shading.next_mode(shading.mode)
	shading.set_mode(self, nxt)
	_say("shading: %s (a view setting, not saved in the scene).  Shading: next goes on to %s" % [nxt, Shading.next_mode(nxt)])


## K01 / K02: SHADING MODES AND STUDIO LIGHTS (scripts/shading.gd). View settings: remembered in the settings file, no undo step.
func _shading_set(md: String) -> void:
	if shading.mode == md:
		_say("the view is already drawn %s: pick another shading from the shading menu (top right of the view)" % md)
		return
	shading.set_mode(self, md)
	if md != "silhouette":
		shading.save_cfg(self)
	_shade_menu_sync()
	_say("shading: %s%s (a view setting, remembered; the shading menu top right of the view picks another)" % [md, (" " + shading.matcap) if md == "matcap" else ""])


func _matcap_set(k: String) -> void:
	shading.matcap = k
	shading.set_mode(self, "matcap")
	shading.save_cfg(self)
	_shade_menu_sync()
	_say("shading: matcap %s (a view setting, remembered)" % k)


func _lights_set(id: String) -> void:
	if shading.lights == id:
		_say("the view already has %s: pick another from the lights menu (top right of the view)" % Shading.LIGHT_NAMES[id])
		return
	shading.lights = id
	shading.apply_lights(self)
	shading.save_cfg(self)
	_shade_menu_sync()
	_say("lights: %s, %d shining (a view setting, remembered; a shot's own lighting preset still wins while that shot plays)" % [Shading.LIGHT_NAMES[id], Shading.light_count(self)])


func _sky_toggle() -> void:
	shading.sky = not shading.sky
	shading.apply_sky(self)
	shading.save_cfg(self)
	_shade_menu_sync()
	_say("sky background %s (a view setting, remembered; the lights menu top right of the view toggles it)" % ("on: a gradient sky" if shading.sky else "off: the flat colour"))


## CG2: a picture (.hdr or .exr) as the sky behind the figure and the light on it: a file dialog, then the sky is on
