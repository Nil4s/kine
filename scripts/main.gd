## G23: the list of archetypes (scripts/archetypes.gd); picking one is ONE undo step through proportions_set
var ui_arch_dlg: ConfirmationDialog
var ui_arch_list: ItemList
func _archetype_dialog() -> void:
	if ui_arch_dlg == null:
		ui_arch_dlg = ConfirmationDialog.new()
		ui_arch_dlg.name = "archetype_dialog"
		ui_arch_dlg.title = "Body: fighter archetype"
		ui_arch_dlg.min_size = Vector2i(420, 360)
		ui_arch_list = ItemList.new()
		ui_arch_list.name = "archetype_list"
		ui_arch_list.size_flags_vertical = Control.SIZE_EXPAND_FILL
		for id in Archetypes.ORDER:
			var a: Dictionary = Archetypes.TABLE[id]
			ui_arch_list.add_item("%s   %s, %.0f kg" % [a["name"], Units.stature(float(a["stature"])), float(a["mass"])])
			ui_arch_list.set_item_tooltip(ui_arch_list.item_count - 1, String(a["src"]))
		ui_arch_list.item_activated.connect(func(i):
			ui_arch_dlg.hide()
			archetype_set(Archetypes.ORDER[i]))
		ui_arch_dlg.add_child(ui_arch_list)
		ui_arch_dlg.confirmed.connect(func():
			var sel := ui_arch_list.get_selected_items()
			if sel.is_empty():
				_say("pick an archetype in the list first, then press OK")
			else:
				archetype_set(Archetypes.ORDER[sel[0]]))
		add_child(ui_arch_dlg)
	ui_arch_dlg.popup_centered()


func archetype_set(id: String) -> void:
	proportions_set(Archetypes.body_for(id))
	_say(Archetypes.say(id))
	if ui_body != null:
		ui_body.sync(S.body, B, true)


func _proportions_dialog() -> void:
	if ui_prop_dlg == null:
		ui_prop_dlg = ConfirmationDialog.new()
		ui_prop_dlg.name = "proportions_dialog"
		ui_prop_dlg.title = "Body: proportions"
		ui_prop_dlg.min_size = Vector2i(340, 0)
		var v := VBoxContainer.new()
		ui_prop_preset = OptionButton.new()
		ui_prop_preset.name = "opt_preset"
		for k in PROP_KEYS:
			ui_prop_preset.add_item("the mannequin as shipped (%s)" % Units.stature(Proportions.DEFAULT_STATURE) if k == "" else ("custom stature" if k == "custom"
				else "%s (ANSUR II, %s)" % [Proportions.PRESET_NAMES[k], Units.stature(float(Proportions.PRESETS[k]["stature"]))]))
		ui_prop_preset.item_selected.connect(func(i):
			var k: String = PROP_KEYS[i]
			if k != "custom":
				ui_prop_stature.set_value_no_signal(Units.to_unit(Proportions.DEFAULT_STATURE if k == "" else float(Proportions.PRESETS[k]["stature"])))
		v.add_child(ui_prop_preset)
		var h := HBoxContainer.new()
		var l := Label.new()
		l.text = "stature (%s)" % Units.suffix()
		h.add_child(l)
		ui_prop_stature = SpinBox.new()
		ui_prop_stature.name = "spin_stature"
		ui_prop_stature.min_value = Units.to_unit(1.0)
		ui_prop_stature.max_value = Units.to_unit(2.3)
		ui_prop_stature.step = Units.to_unit(0.001)
		ui_prop_stature.get_line_edit().text_submitted.connect(func(t: String):   # P14: "6 ft", "70 in", "178 cm" typed into the field
			var mm := Units.parse_m(t)
			if not is_nan(mm):
				ui_prop_stature.set_value_no_signal(Units.to_unit(mm))
				ui_prop_preset.select(PROP_KEYS.size() - 1))
		ui_prop_stature.value_changed.connect(func(_x): ui_prop_preset.select(PROP_KEYS.size() - 1))
		h.add_child(ui_prop_stature)
		v.add_child(h)
		ui_prop_dlg.add_child(v)
		ui_prop_dlg.confirmed.connect(func():
			var k: String = PROP_KEYS[ui_prop_preset.selected]
			if k == "":
				proportions_set({})
			elif k == "custom":
				var d := S.body.duplicate(true)
				d.erase("preset")
				d["stature"] = Units.from_unit(ui_prop_stature.value)
				proportions_set(d)
			else:
				proportions_set(Proportions.preset(k)))
		add_child(ui_prop_dlg)
	var at := PROP_KEYS.find(String(S.body.get("preset", ""))) if not S.body.is_empty() else 0
	ui_prop_preset.select(at if at >= 0 else PROP_KEYS.size() - 1)
	ui_prop_stature.set_value_no_signal(float(S.body.get("stature", Proportions.DEFAULT_STATURE)) * 100.0)
	ui_prop_dlg.popup_centered()


## BODY FROM 5 NUMBERS (G13; scripts/body_from_numbers.gd): height, weight, sex, age, build in a small dialog; OK sets the scene's
## body through proportions_set (ONE undo step) and says the percentile.
var ui_nums_dlg: ConfirmationDialog
var ui_nums := {}


func _body_nums_dialog() -> void:
	if ui_nums_dlg == null:
		ui_nums_dlg = ConfirmationDialog.new()
		ui_nums_dlg.name = "body_numbers_dialog"
		ui_nums_dlg.title = "Body: from 5 numbers"
		ui_nums_dlg.min_size = Vector2i(360, 0)
		var v := VBoxContainer.new()
		var rows := [["height (cm)", "spin_height", 175.0, 100.0, 230.0, 0.5], ["weight (kg)", "spin_weight", 80.0, 20.0, 250.0, 0.5], ["age (years)", "spin_age", 30.0, 5.0, 100.0, 1.0]]
		for r in rows:
			var h := HBoxContainer.new()
			var l := Label.new()
			l.text = r[0]
			l.custom_minimum_size = Vector2(110, 0)
			h.add_child(l)
			var sp := SpinBox.new()
			sp.name = r[1]
			sp.min_value = r[3]
			sp.max_value = r[4]
			sp.step = r[5]
			sp.value = r[2]
			h.add_child(sp)
			v.add_child(h)
			ui_nums[r[1]] = sp
		for r in [["sex", "opt_sex", ["man", "woman"]], ["build", "opt_build", ["lean", "average", "heavy"]]]:
			var h := HBoxContainer.new()
			var l := Label.new()
			l.text = r[0]
			l.custom_minimum_size = Vector2(110, 0)
			h.add_child(l)
			var o := OptionButton.new()
			o.name = r[1]
			for t in r[2]:
				o.add_item(t)
			if r[1] == "opt_build":
				o.select(1)
			h.add_child(o)
			v.add_child(h)
			ui_nums[r[1]] = o
		var rd := Label.new()
		rd.name = "readout"
		rd.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		rd.custom_minimum_size = Vector2(340, 40)
		v.add_child(rd)
		ui_nums["readout"] = rd
		var upd := func(_x = 0):
			var p := _body_nums_predict()
			rd.text = BodyFromNumbers.readout(p)
		for k in ["spin_height", "spin_weight", "spin_age"]:
			(ui_nums[k] as SpinBox).value_changed.connect(upd)
		for k in ["opt_sex", "opt_build"]:
			(ui_nums[k] as OptionButton).item_selected.connect(upd)
		ui_nums_dlg.add_child(v)
		ui_nums_dlg.confirmed.connect(func(): body_from_numbers(_body_nums_args()))
		add_child(ui_nums_dlg)
		upd.call()
	ui_nums_dlg.popup_centered()


func _body_nums_args() -> Array:
	return [(ui_nums["spin_height"] as SpinBox).value, (ui_nums["spin_weight"] as SpinBox).value,
		"female" if (ui_nums["opt_sex"] as OptionButton).selected == 1 else "male", (ui_nums["spin_age"] as SpinBox).value,
		BodyFromNumbers.BUILDS[(ui_nums["opt_build"] as OptionButton).selected]]


func _body_nums_predict() -> Dictionary:
	var a := _body_nums_args()
	return BodyFromNumbers.predict(a[0], a[1], a[2], a[3], a[4])


## the five numbers -> the scene's body: ONE undo step (proportions_set); says the percentile. a = [cm, kg, sex, age, build]
func body_from_numbers(a: Array) -> Dictionary:
	var p := BodyFromNumbers.predict(a[0], a[1], a[2], a[3], a[4])
	var nd := proportions_set(BodyFromNumbers.body_for(a[0], a[1], a[2], a[3], a[4]))
	_say("body: " + BodyFromNumbers.readout(p) + "; Ctrl+Z takes it back")
	return nd


## THE BODY PAGE (scripts/body_panel.gd). A drag previews on the live body (no history); the end is ONE undo step through
## proportions_set. The sole stays as high above the floor as it was (a standing body stays on the floor).
var _body_lo := 0.0
var _body_off := Vector3.ZERO
func _body_begin() -> void:
	B.set_proportions(S.body)   # the stage's own body (a half-done preview is dropped)
	_body_lo = B.sole_low()
	_body_off = B.offset
	_step_hint = "Body: proportions"


func _body_preview(nd: Dictionary) -> void:
	B.set_proportions(nd)
	B.offset.y += _body_lo - B.sole_low()
	B.fk()
	_refresh()


func _body_commit(nd: Dictionary) -> void:
	B.set_proportions(S.body)   # back to where the drag began: the undo step starts from the real body, exactly
	B.offset = _body_off
	B.fk()
	proportions_set(nd)
	if ui_body != null:
		ui_body.sync(S.body, B, true)


## the scene's proportions -> d ({} = the default body): cards retargeted, one undo step. Returns what was set.
func proportions_set(d: Dictionary) -> Dictionary:
	var nd := Proportions.clean(d)
	if nd == S.body:
		_say("the body already has these proportions: pick another preset or stature in 'Body: proportions...'")
		return nd
	var lo0 := B.sole_low()
	_do(func():
		Proportions.retarget(S, B, nd)
		B.set_proportions(nd)   # the pose as it was, on the new bones
		if S.cards.is_empty():
			B.offset.y += lo0 - B.sole_low()   # no cards to carry the height: the soles stay as high as they were
			B.fk()
		_dummy_hits()
		ov.mark_dirty()
		wt.mark_dirty()
		if bld != null:
			bld.sync()   # C2: a Part dimension bound to the body re-solves now
		if not S.cards.is_empty():
			S.apply(B, playhead))
	var st := float(nd.get("stature", Proportions.DEFAULT_STATURE))
	_say("body: %s, %.1f cm tall; every card keeps its angles, the feet stay on the floor (Ctrl+Z takes it back)" % [Proportions.PRESET_NAMES.get(String(nd.get("preset", "")), "the mannequin as shipped" if nd.is_empty() else "custom"), st * 100.0])
	return nd


## NEXT-POSE SUGGESTIONS (ROADMAP R27; the three sources and their ranking are in scripts/next_pose.gd). While a card is
## current (POSE or ANIMATE page, not playing) up to three poses that may come next are shown as small translucent ghosts at
## the body's side (display nodes only) and as three thumbnails after the card in the strip. Tab cycles them, Enter or a click
## on a thumbnail takes the picked one as a new card after the current one (ONE undo step, its timing from its source), Esc
## hides them. Nothing in the scene changes until one is taken. View > Next poses turns it off (remembered; on by default;
## off under a test script until the test turns it on).
var sg_on := true
var sg_list: Array = []     # [{NextPose suggestion + "pose": the full pose dictionary}]
var sg_sel := -1            # the ghost Tab picked (-1 = none yet: Enter then adds a card as ever)
var sg_ms := 0.0            # how long the last compute took
var _sg_sig: Array = []
var _sg_hidden := false
var _sg_strip: Control = null
var _sg_bodies: Array = []
var _sg_task := -1
var _sg_res := {}


func _sg_toggle() -> void:
	sg_on = not sg_on
	_sg_hidden = false
	_sg_sig = []
	_onion_save()
	_refresh()
	_say("next-pose ghosts on: pick a card and its likely next poses show beside the body.  Tab cycles, Enter takes one, Esc hides" if sg_on else "next-pose ghosts off (View > Next poses turns them back on)")


func _sg_want() -> bool:
	return sg_on and not _sg_hidden and cur_page in ["POSE", "ANIMATE"] and sel_card >= 0 and sel_card < S.cards.size() and not playing and ui_cards != null


func _sg_next_pose() -> Variant:
	return S.cards[sel_card + 1]["pose"] if sel_card + 1 < S.cards.size() else null


func _sg_same() -> bool:
	return not _sg_sig.is_empty() and is_same(_sg_sig[0], S) and _sg_sig[1] == sel_card and _sg_sig[2] == S.cards.size() and sel_card < S.cards.size() and is_same(_sg_sig[3], S.cards[sel_card]["pose"]) and is_same(_sg_sig[4], _sg_next_pose())


func _sg_tick() -> void:
	if nb_ui == null:
		nb_ui = NextBeatUI.new(self)
	if nb_ui.wants():   # I44: two fighters: the beats of the exchange take the place of the single fighter's next poses
		if not sg_list.is_empty() or _sg_strip != null:
			sg_list = []
			sg_sel = -1
			_sg_sig = []
			ov.sugg_hide()
			_sg_strip_sync()
		nb_ui.tick()
		return
	if not nb_ui.list.is_empty() or nb_ui.pv != null:
		nb_ui.clear()
	if _sg_hidden and sel_card >= 0 and sel_card < S.cards.size() and not _sg_same():
		_sg_hidden = false   # another card (or its pose changed): the ghosts come back
	if not _sg_want():
		if not sg_list.is_empty() or _sg_strip != null:
			sg_list = []
			sg_sel = -1
			_sg_sig = []
			ov.sugg_hide()
			_sg_strip_sync()
		return
	if _sg_same():
		_sg_place()
		return
	var c: Dictionary = S.cards[sel_card]
	_sg_sig = [S, sel_card, S.cards.size(), c["pose"], _sg_next_pose()]
	_sg_motion_start()
	var dt: float = float(c["move"]) if float(c["move"]) > 0.0 else S.move_time(sel_card)
	if dt < 0.05:
		dt = 0.4
	var nx: Variant = _sg_next_pose()
	sg_list = np.suggest(c["pose"], String(c["name"]), dt, scene_path, String(c.get("phase", "")), nx if nx is Dictionary else {})
	sg_list = sj.sort_offers("next pose", sg_list, func(x): return String(x["src"]))   # I26: the sources you keep come first
	sg_ms = np.last_ms
	sg_sel = -1
	for i in sg_list.size():
		sg_list[i]["pose"] = _sg_pose(sg_list[i])
		_sg_apply(_sg_body(i + 1), sg_list[i])   # the ghost's body, posed once; _sg_place only moves it
	_sg_show()


## the pose dictionary of a suggestion: the current card's body (its weapon in its hand, its proportions) with the suggestion's angles and hips
func _sg_pose(s: Dictionary) -> Dictionary:
	var sb := _sg_body(0)
	_sg_apply(sb, s)
	return sb.to_dict()


func _sg_body(i: int) -> Body:
	while _sg_bodies.size() <= i:
		var nb := Body.new()
		nb.load_files("res://data/skeleton.json", "res://data/body_limits.json")
		_sg_bodies.append(nb)
	return _sg_bodies[i]


func _sg_apply(sb: Body, s: Dictionary) -> void:
	sb.set_proportions(S.body)
	sb.from_dict(S.cards[sel_card]["pose"])
	var full: PackedFloat32Array = s["full"]
	for i in Body.ORDER.size():
		var j: String = Body.ORDER[i]
		if sb.lim.has(j):
			sb.ang[j] = sb.clamp_ang(j, Vector3(full[i * 3], full[i * 3 + 1], full[i * 3 + 2]))
	sb.offset = s["off"]
	sb.fk()


func _sg_color(s: Dictionary) -> Color:
	return Tok.c("sg_" + String(s["src"]))


func _sg_show() -> void:
	_sg_place()
	_sg_strip_sync()


## the ghosts beside the body (the camera's right); also after the camera moved
func _sg_place() -> void:
	if sg_list.is_empty():
		ov.sugg_hide()
		return
	var items := []
	for i in sg_list.size():
		items.append({"body": _sg_body(i + 1), "col": _sg_color(sg_list[i]), "sel": i == sg_sel,
			"text": _sg_text(i)})
	# fit the row between the body and the right panel: the pixels per metre at the body, the body's right edge on screen
	var at: Vector3 = B.P["pelvis"]
	var flat := Vector3(cam.global_basis.x.x, 0.0, cam.global_basis.x.z)
	flat = flat.normalized() if flat.length() > 1e-4 else Vector3.RIGHT
	var p0 := cam.unproject_position(at)
	var ppm := maxf(absf(cam.unproject_position(at + flat).x - p0.x), 1.0)
	var vs := get_viewport().get_visible_rect().size
	var body_r := p0.x
	for j in ["head", "hand_l", "hand_r", "foot_l", "foot_r", "lowerarm_l", "lowerarm_r"]:
		body_r = maxf(body_r, cam.unproject_position(B.P[j]).x)
	if B.wep_on:
		body_r = maxf(body_r, cam.unproject_position(B.wep_point(B.wep_len)).x)
	var avail := vs.x - rw() - 14.0 - body_r - 10.0
	var slot := clampf(avail / float(sg_list.size()), 80.0, 200.0)
	var sc := clampf(slot / (1.15 * ppm), 0.28, 0.62)
	var step := slot / ppm
	ov.sugg_show(items, at, cam.global_basis.x, sc, (body_r + 10.0 - p0.x) / ppm + 0.5 * step, step)


## a ghost's label over its head, on two lines so three of them fit side by side: "1" and the label cut at its middle space or hyphen
func _sg_text(i: int) -> String:
	var lab: String = sg_list[i]["label"]
	var cut := lab.find(" ", lab.length() / 2 - 3)
	if cut < 0:
		cut = lab.find("-")
	if cut >= 0:
		lab = lab.left(cut + (1 if lab[cut] == "-" else 0)) + "
" + lab.substr(cut + (1 if lab[cut] == "-" else 0)).strip_edges()
	return "%s%d  %s" % ["> " if i == sg_sel else "", i + 1, lab]


func _sg_visible() -> bool:
	return _sg_want() and not sg_list.is_empty()


func _sg_key(k: InputEventKey) -> bool:
	if nb_ui != null and nb_ui.key(k):   # I44: Tab / Enter / Esc on the next beats of two fighters
		return true
	if not _sg_visible() or k.echo:
		return false
	var plain := not k.ctrl_pressed and not k.alt_pressed and not k.shift_pressed
	if k.keycode == KEY_TAB and plain:
		sg_sel = (sg_sel + 1) % sg_list.size()
		_sg_place()
		_sg_strip_sync()
		_say("next pose %d of %d: %s.  Enter takes it, Tab for the next, Esc hides" % [sg_sel + 1, sg_list.size(), sg_list[sg_sel]["tip"]])
		return true
	if k.keycode in [KEY_ENTER, KEY_KP_ENTER] and plain and sg_sel >= 0:
		_sg_accept(sg_sel)
		return true
	if k.keycode == KEY_ESCAPE and plain:
		_sg_hidden = true
		_sg_tick()
		_say("next-pose ghosts hidden: pick another card, or View > Next poses, to bring them back")
		return true
	return false


## take suggestion i as a new card after the current one: ONE undo step; the timing is its source's
func _sg_accept(i: int) -> void:
	if i < 0 or i >= sg_list.size() or sel_card < 0:
		return
	var s: Dictionary = sg_list[i]
	_step_hint = "Next pose: " + String(s["label"])
	_push_undo()
	var at := sel_card + 1
	S.add(String(s["name"]), (s["pose"] as Dictionary).duplicate(true), at)
	var sj_d := sj.learned("next pose", String(s["src"]))   # I26: the move time you always change it by, applied
	var sj_mv := float(s["mv"]) if is_nan(sj_d) or float(s["mv"]) <= 0.0 else maxf(0.04, float(s["mv"]) + sj_d)
	S.cards[at]["move"] = sj_mv
	var sj_sc: Scene = S
	sj.log("next pose", String(s["src"]), at, {"field": "move", "base": float(s["mv"]), "applied": sj_mv}, undo.size(),
		func(): return sj_sc.cards[at]["move"] if at < sj_sc.cards.size() else null)
	S.cards[at]["hold"] = float(s["hd"])
	var us := false
	if String(s["src"]) == "between":
		if float(s["mv"]) > 0.0:
			S.cards[at]["usual"] = {"mv": float(s["mv"]), "hd": float(s["hd"])}   # I10: the in-between comes timed the way you time it
			us = true
	else:
		us = _usual_apply(at)   # I10: a taken ghost comes with your usual timing when there is one, else its source's
	sel_card = at
	sel_end = -1
	playhead = S.times()[at][1]
	Scene.put(B, Moves._flat(S.cards[at]["pose"]))
	_rebuild_cards()
	_refresh()
	_say("took the %s as card %d '%s'%s.  Ctrl+Z takes it back" % [String(s["label"]), at + 1, s["name"], " with your usual timing" if us else ""])


## I10 YOUR TIMING (scripts/next_pose.gd usual): while usual_on, a card newly added after another (Clip this pose, a taken ghost,
## Duplicate) comes with the median move and hold of the nearest transitions in your saved scenes, tagged so the strip says
## "your usual 0.18 s" in its own colour until the timing is touched; none near enough = the app's default, untouched.
var usual_on := true


func _usual_for(at: int, force := false) -> Dictionary:
	if (not usual_on and not force) or at <= 0 or at >= S.cards.size():
		return {}
	return np.usual(S.cards[at - 1]["pose"], S.cards[at]["pose"], String(S.cards[at]["name"]))


## the card at `at` takes your usual timing; false when there is none to take
func _usual_apply(at: int, force := false) -> bool:
	var u := _usual_for(at, force)
	if u.is_empty():
		return style_ui != null and not force and style_ui.new_card(S, at)   # I17: no usual for this pose pair: his median for the kind (like Nick)
	S.cards[at]["move"] = float(u["mv"])
	S.cards[at]["hold"] = float(u["hd"])
	S.cards[at]["usual"] = {"mv": float(u["mv"]), "hd": float(u["hd"])}
	return true


## Duplicate: a copy of card i right after it, with your usual timing for that step when there is one (else the original's)
func _card_duplicate(i: int) -> void:
	if i < 0 or i >= S.cards.size():
		_say("pick a card first, then Duplicate")
		return
	_push_undo()
	var c: Dictionary = S.cards[i]
	S.add(String(c["name"]) + " copy", (c["pose"] as Dictionary).duplicate(true), i + 1)
	S.cards[i + 1]["move"] = float(c["move"])
	S.cards[i + 1]["hold"] = float(c["hold"])
	var us := _usual_apply(i + 1)
	sel_card = i + 1
	sel_end = -1
	playhead = S.times()[sel_card][1]
	_rebuild_cards()
	_refresh()
	_say("duplicated card %d%s.  Ctrl+Z takes it back" % [i + 1, " with your usual timing" if us else ""])


## U / "Use my usual timing": the picked cards take your usual move and hold, ONE undo step; a card with no usual keeps its timing
func cards_use_usual() -> String:
	var idx := card_sel()
	if idx.is_empty():
		_say("pick a card first (click one in the strip), then press U")
		return "no cards selected"
	var plan := {}
	for i in idx:
		var u := _usual_for(i, true)
		if not u.is_empty():
			plan[i] = u
	if plan.is_empty():
		_say("no usual timing for the picked card%s yet: fewer than %d of your saved scenes' steps are within %.0f deg of this one.  Time it by hand and save the scene, and it learns" % [
			"" if idx.size() == 1 else "s", NextPose.T_MIN, NextPose.T_MAXD])
		return "no usual"
	_step_hint = "Use my usual timing"
	_push_undo()
	_markers_hold()
	for i in plan:
		S.cards[i]["move"] = float(plan[i]["mv"])
		S.cards[i]["hold"] = float(plan[i]["hd"])
		S.cards[i]["usual"] = {"mv": float(plan[i]["mv"]), "hd": float(plan[i]["hd"])}
	_markers_follow()
	_rebuild_cards()
	_refresh()
	_say("%d card%s now %s your usual timing (move %s s, hold %s s for the first): the scene is %s.  Ctrl+Z takes it back" % [plan.size(), "" if plan.size() == 1 else "s", "have" if plan.size() > 1 else "has",
		String.num(float(plan[plan.keys()[0]]["mv"]), 2), String.num(float(plan[plan.keys()[0]]["hd"]), 2), Units.time(_ps().length(), S.fps)])
	return ""


