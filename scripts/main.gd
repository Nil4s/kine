## where a new prop goes: in front of the body, beside it first (the dummy stands straight ahead), the first spot
## whose footprint keeps 10 cm clear of the body, the dummy and every other prop; none clear: the last spot tried
func _prop_spot(kind: String) -> Vector3:
	var o := Vector3(B.offset.x, 0.0, B.offset.z)
	var spot := o
	for dz in [1.0, 1.8, 2.6]:
		for dx in [-1.0, 1.0, -1.9, 1.9, 0.0]:
			spot = o + Vector3(dx, 0.0, dz)
			var r := _foot(Props.make(kind, Props.xf_at(spot, 0.0))).grow(0.1)
			var clear := not (dummy_on and r.grow(0.3).has_point(Vector2(T.xf.origin.x, T.xf.origin.z)))   # 0.3: the dummy's body
			clear = clear and not r.intersects(Rect2(Vector2(o.x, o.z) - Vector2(0.3, 0.3), Vector2(0.6, 0.6)))   # nor on the body's own feet (a 2 m platform beside him)
			for q in S.props:
				clear = clear and not r.intersects(_foot(q))
			if clear:
				return spot
	return spot


## a prop's footprint on the floor (x, z), from its solid boxes' corners
func _foot(p: Dictionary) -> Rect2:
	var r := Rect2()
	var first := true
	for sw in Props.solids(p):
		var xf: Transform3D = sw["xf"]
		var h: Vector3 = sw["half"]
		for sx in [-1.0, 1.0]:
			for sz in [-1.0, 1.0]:
				var c := xf * Vector3(h.x * sx, 0.0, h.z * sz)
				if first:
					r = Rect2(Vector2(c.x, c.z), Vector2.ZERO)
					first = false
				else:
					r = r.expand(Vector2(c.x, c.z))
	return r


## a prop of the set in front of the body, on the floor (or on what it lands over); picked; one undo step
func _prop_add(kind: String, at: Variant = null) -> void:   # at: a floor point to put it on (Easy's drop from the Library; Use in scene beside the body); null = the spot in front of the body
	if not Props.has_kind(kind):
		return
	_push_undo()
	var spot: Vector3 = _prop_spot(kind) if at == null or at == Vector3.INF else (at as Vector3)
	var p := Props.make(kind, Props.xf_at(spot, 0.0))
	var xf: Transform3D = p["xf"]
	xf.origin.y = Props.snap_y(p, S.props)
	p["xf"] = xf
	S.props.append(p)
	sel_prop = S.props.size() - 1
	_props_show()
	_doc_line()
	if easy.on:   # Easy has no SET ribbon: the sit is the panel's "Sit on it" (walk-through round 5), or the strip's "Sit on the chair" once a clip is built (the panel is hidden then: walk-through 10, B)
		var sit_say := ""
		if kind in SIT_ON:
			sit_say = "; the strip's Sit on the chair seats him on it" if easy.home.shown() == "strip" else "; Sit on it in the panel seats him on it"
		_say("added a %s in front of the body: drag it to move it%s; Undo takes it back" % [_prop_name(sel_prop), sit_say])
	else:
		_say("added a %s in front of the body: drag it to move it; Turn and Delete are in SET; Ctrl+Z takes it back" % _prop_name(sel_prop))


func _prop_turn(deg: float) -> void:
	if sel_prop < 0 or sel_prop >= S.props.size():
		return
	if _outl_locked_say(sel_prop):
		return
	_push_undo()
	_prop_live(sel_prop)
	var d := Props.to_dict(S.props[sel_prop])
	d["yaw"] = wrapf(float(d["yaw"]) + deg, -180.0, 180.0)
	S.props[sel_prop] = Props.from_dict(d)
	Outliner.moved(S, "prop:%d" % sel_prop)   # L36: its children turn / grow with it
	_prop_autokey(sel_prop)
	_props_show()
	_doc_line()
	_say("turned the %s to %.0f°" % [_prop_name(sel_prop), float(d["yaw"])])


## SIZE of the picked prop (Easy's Bigger / Smaller: f = 1.15 or 1 / 1.15; Expert reads the same field): one undo step; the
## range is Props.SIZE_MIN..SIZE_MAX, and at the end of it the status says so
func _prop_resize(f: float) -> void:
	if sel_prop < 0 or sel_prop >= S.props.size():
		return
	var old := Props.scale_of(S.props[sel_prop])
	var new_s := clampf(old * f, Props.SIZE_MIN, Props.SIZE_MAX)
	if absf(new_s - old) < 0.0005:
		_say("the %s is as %s as it goes" % [_prop_name(sel_prop), "big" if f > 1.0 else "small"])
		return
	if _outl_locked_say(sel_prop):
		return
	_push_undo()
	_prop_live(sel_prop)
	var d := Props.to_dict(S.props[sel_prop])
	d["scale"] = snappedf(new_s, 0.0001)
	S.props[sel_prop] = Props.from_dict(d)
	Outliner.moved(S, "prop:%d" % sel_prop)   # L36: its children turn / grow with it
	_prop_autokey(sel_prop)
	_props_show()
	_doc_line()
	_say("the %s is %s now (%d%% of its real size)" % [_prop_name(sel_prop), "bigger" if f > 1.0 else "smaller", roundi(new_s * 100.0)])


## COLOUR of the picked prop (Easy's Colour button cycles Props.COLOUR_ORDER; the first press gives blue): one undo step
func _prop_colour() -> void:
	if sel_prop < 0 or sel_prop >= S.props.size():
		return
	_push_undo()
	_prop_live(sel_prop)
	var order: Array = Props.COLOUR_ORDER
	var cur := order.find(Props.colour_of(S.props[sel_prop]))
	var nxt := String(order[(cur + 1) % order.size()])
	var d := Props.to_dict(S.props[sel_prop])
	if nxt == "grey":
		d.erase("colour")
	else:
		d["colour"] = nxt
	S.props[sel_prop] = Props.from_dict(d)
	Outliner.moved(S, "prop:%d" % sel_prop)   # L36: its children turn / grow with it
	_prop_autokey(sel_prop)
	_props_show()
	_doc_line()
	_say("the %s is %s now" % [_prop_name(sel_prop), nxt])


## HIS COLOUR (Easy's "His colour" button): the body's skin cycles skin, white, grey, blue, red, dark. The body parts with a
## photo material keep it (Surface: material from a photo). One undo step; the colour is view state like the photo materials
func _body_colour_next() -> void:
	if body_skin == null:
