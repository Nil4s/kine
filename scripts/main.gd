## File > Recent: a scene from the list, opened as the list's pick would open it
func _open_recent(path: String) -> void:
	if not FileAccess.file_exists(path):
		_say("%s is not on disk any more (moved or deleted): open another scene; it leaves File > Recent when %d newer ones are opened" % [path.get_file(), RECENT_N])
		return
	_open_scene_file(path)


## THE JOURNAL (ROADMAP 2, CRASH-PROOF; scripts/journal.gd): the scene after every edit, so a crash loses no edit that
## was made. Written by _do, by the next undo step, and by the frame that ends a drag or an undo (_process)
func _journal_write() -> void:
	_jpending = false
	if not journal_on:
		return
	if journal.path != scene_path or journal.dir != journal_dir:
		journal.open(journal_dir, scene_path)
	var t0 := Time.get_ticks_usec()
	var st := _scene_dict(false)
	journal_capture_us += Time.get_ticks_usec() - t0
	journal.append(st)


## a save: the work is on disk now, so the journal of the scene (and of the file it became) is dropped
func _journal_saved() -> void:
	if not journal_on:
		return
	journal.trim()
	journal.open(journal_dir, scene_path)
	journal.trim()


## start: a session that did not quit cleanly leaves its journals behind. The newest journal newer than its scene's
## file is offered (journal_offer); every journal is moved aside to .old, so this session starts its own
func _journal_boot() -> void:
	journal.dir = journal_dir
	var was_clean := journal.session_clean()
	journal.set_session(false)
	if was_clean:
		return
	var best := {}
	for f in DirAccess.get_files_at(journal_dir):
		if not f.ends_with(".jsonl"):
			continue
		var fp := journal_dir.path_join(f)
		var r := Journal.restore(fp)
		if not r.is_empty():
			var saved := -1
			if r["path"] != "" and FileAccess.file_exists(r["path"]):
				saved = int(FileAccess.get_modified_time(r["path"]))
			if int(r["t"]) > saved and (best.is_empty() or int(r["t"]) > int(best["t"])):
				best = Journal.restore(fp, saved)
		DirAccess.rename_absolute(ProjectSettings.globalize_path(fp), ProjectSettings.globalize_path(fp) + ".old")
	if not best.is_empty():
		journal_offer = best
		_journal_offer_say.call_deferred()


func _journal_offer_say() -> void:
	if journal_offer.is_empty():
		return
	var local := int(journal_offer["t"]) + int(Time.get_time_zone_from_system().get("bias", 0)) * 60
	_say("Restore the work from %s (%d edits after the last save): File: restore unsaved work" % [
		Time.get_datetime_string_from_unix_time(local, true), int(journal_offer["n"])])


## File: restore unsaved work: the scene as the last journaled edit left it, still unsaved (Save scene keeps it).
## The journal goes on from it, whole, so a second crash is covered too; the moved-aside files are dropped
func _journal_restore() -> void:
	if journal_offer.is_empty():
		_say("no unsaved work to restore: no session was left without a clean quit. Open a scene to start")
		return
	var o := journal_offer
	journal_offer = {}
	_restore_work({"scene": o["state"], "path": o["path"]})
	if journal_on:
		for f in DirAccess.get_files_at(journal_dir):
			if f.ends_with(".old"):
				DirAccess.remove_absolute(ProjectSettings.globalize_path(journal_dir.path_join(f)))
		journal.open(journal_dir, scene_path)
		journal.force_full()
		_journal_write()
	_say("restored the work from the journal (%d edits): it is not saved yet, Save scene keeps it" % int(o["n"]))


## CRASH REPORT (P25): the commands of a session that did not quit cleanly are kept for the report; a clean last session
## leaves nothing. Runs before _journal_boot, which clears the session flag this reads
func _crash_boot() -> void:
	var cenv := OS.get_environment("POSER_CRASH")   # a test's own folder (never user://crash)
	crash_dir = cenv if cenv != "" else "user://crash"
	CrashReport.ensure(crash_dir)
	var jr := Journal.new()
	jr.dir = journal_dir
	if jr.session_clean():
		CrashReport.clear_recent(crash_dir)
	else:
		crash_prev = CrashReport.move_old(crash_dir)
		if not crash_prev.is_empty():
			_crash_offer_say.call_deferred()
	crash_recent.open(crash_dir.path_join(CrashReport.RECENT))


func _crash_offer_say() -> void:
	if journal_offer.is_empty():   # the journal's own offer (Restore the work from ...) says it when there is one
		_say("Kine did not close cleanly last time. File > Crash report (last 20 commands) saves what you did then")


## every palette command, with the page it ran on, goes to the recent list (the file the report reads after a crash)
func _crash_note(n: String) -> void:
	if crash_dir == "":
		return
	crash_cmds.append(CrashReport.line(Time.get_unix_time_from_system(), cur_page, n))
	if crash_cmds.size() > CrashReport.KEEP:
		crash_cmds = crash_cmds.slice(crash_cmds.size() - CrashReport.KEEP)
	crash_recent.add(crash_cmds[-1])


## File > Crash report: the last 20 commands (the session that did not quit, when there is one) and the page, in a text file
## L16 OPT-IN UPDATE CHECK (scripts/update_check.gd): off and no address until the user sets both. The notice is the status line, never a dialog.
func _update_check_now(manual: bool) -> void:
	var cfg: Dictionary = OnlineOpt.load_cfg()["update"]
	if not bool(cfg["enabled"]):
		if manual:
			_say("update check is off: turn it on with 'Setting: update check on/off', then set the feed address in user://online.cfg")
		return
	var url := str(cfg["feed_url"])
	var body = null
	if url.begins_with("http://") or url.begins_with("https://"):
		body = await _http_get_text(url)
	var reader := func(u: String):
		return body if body != null else UpdateCheck.file_reader(u)
	var r := UpdateCheck.check(cfg, str(ProjectSettings.get_setting("application/config/version", "0.0.0")), reader)
	if bool(r.get("notify", false)) or manual or r.get("state") == "no_feed":
		if str(r.get("text", "")) != "":
			_say(str(r["text"]))


## the only place that opens the network for the update check; reached only when the user set a web address
func _http_get_text(url: String):
	var h := HTTPRequest.new()
	h.timeout = 8.0
	add_child(h)
	if h.request(url) != OK:
		h.queue_free()
		return null
	var res: Array = await h.request_completed
	h.queue_free()
	if res[0] != HTTPRequest.RESULT_SUCCESS or res[1] != 200:
		return null
	return (res[3] as PackedByteArray).get_string_from_utf8()


func _update_toggle() -> void:
	var c := OnlineOpt.load_cfg()
	c["update"]["enabled"] = not bool(c["update"]["enabled"])
	OnlineOpt.save_cfg(OnlineOpt.PATH, c)
	_say("update check: " + ("on" if c["update"]["enabled"] else "off") + (" (no feed address set yet: edit user://online.cfg [update] feed_url)" if c["update"]["enabled"] and str(c["update"]["feed_url"]) == "" else ""))


## L16 OPT-IN CRASH UPLOAD (scripts/crash_upload.gd): shows the redacted payload first; sends only after Send is pressed, only when
## the user turned it on and an endpoint is set. Both are off/empty by default, so by default this only shows the preview.
func _crash_send_open() -> void:
	var lines: Array = crash_prev if not crash_prev.is_empty() else crash_cmds
	var raw := "Page: %s\n%s" % [cur_page, "\n".join(lines.slice(-CrashReport.KEEP))]
	var users := [OS.get_environment("USERNAME"), OS.get_environment("USER")]
	var payload := CrashUpload.build_payload(raw, {"version": str(ProjectSettings.get_setting("application/config/version", "")), "os": OS.get_name(), "users": users})
	var cfg: Dictionary = OnlineOpt.load_cfg()["crash"]
	var d := ConfirmationDialog.new()
	d.title = "Send crash report?"
	d.dialog_text = CrashUpload.preview(payload, cfg)
	d.ok_button_text = "Send" if bool(cfg["enabled"]) and str(cfg["endpoint"]) != "" else "Close"
	d.size = Vector2i(760, 520)
	add_child(d)
	d.confirmed.connect(func():
		var r := CrashUpload.send(cfg, payload, true, _crash_http_sink)
		_say("crash report sent" if r["sent"] else "crash report not sent: " + str(r["why"]))
		d.queue_free())
	d.canceled.connect(d.queue_free)
	d.popup_centered()


func _crash_http_sink(endpoint: String, body: String) -> bool:
	var h := HTTPRequest.new()
	h.timeout = 8.0
	add_child(h)
	var ok_ := h.request(endpoint, ["Content-Type: text/plain; charset=utf-8"], HTTPClient.METHOD_POST, body) == OK
	h.request_completed.connect(func(_a, _b, _c, _d): h.queue_free())
	return ok_


func _crash_report_now() -> void:
	if crash_dir == "":
		_say("the crash report is off in this test run")
		return
	var lines: Array = crash_prev if not crash_prev.is_empty() else crash_cmds
	var note := "The commands are from the session that did not close cleanly." if not crash_prev.is_empty() else "The commands are from this session."
	var path := CrashReport.write(crash_dir, lines, cur_page, note)
	if path == "":
		_say("the crash report could not be written: check the disk, then try again")
		return
	_say("crash report saved (%d commands, with the page): %s. Nothing is sent; send the file yourself if you want" % [mini(lines.size(), CrashReport.KEEP), path])


var ui_recover: ConfirmationDialog
var _recovering := false   # Recover opens the scene's file under the autosave: that open must not drop the autosave


## on start: an autosave that differs from its scene on disk is offered back (Recover / Discard)
var _recover_discard := false


## LATER keeps the offered work in a slot of its own (the autosave's own slot is overwritten by the next autosave, and
## dropped by a quit with nothing unsaved or by opening a scene): <autosave>_later.json, offered when the main slot
## has nothing; one later slot (a newer Later replaces it)
func _later_path() -> String:
	return ProjectSettings.globalize_path(autosave).get_basename() + "_later.json"


func _recover_closed() -> void:
	var from: String = ui_recover.get_meta("from", "")
	if _recover_discard:
		_recover_discard = false
		if from == _later_path():
			DirAccess.remove_absolute(from)
		else:
			_autosave_drop()
		_say("the unsaved work was discarded")
	else:
		if from != _later_path():
			DirAccess.rename_absolute(from, _later_path())
			_as_last = ""
		_say("the unsaved work is kept: it is offered again next time Kine starts")


func _offer_drop(fp: String) -> void:
	if fp == _later_path():
		DirAccess.remove_absolute(fp)
	else:
		_autosave_drop()


func _recover_offer() -> void:
	var fp := ProjectSettings.globalize_path(autosave)
	if not FileAccess.file_exists(fp):
		fp = _later_path()
		if not FileAccess.file_exists(fp):
			return
	var a: Variant = JSON.parse_string(FileAccess.get_file_as_string(fp))
	if not (a is Dictionary) or not (a.get("scene") is Dictionary) or not a["scene"].has("cards"):
		_offer_drop(fp)   # unreadable: nothing to give back
		return
	var path: String = a.get("path", "")
	if path != "" and FileAccess.file_exists(path):
		var disk: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
		if disk is Dictionary and JSON.stringify(disk.get("cards")) == JSON.stringify(a["scene"]["cards"]):
			_offer_drop(fp)   # the same as the file: nothing was lost
			return
	if ui_recover == null:
		ui_recover = ConfirmationDialog.new()
		ui_recover.name = "recover_dialog"
		ui_recover.title = "Unsaved work found"
		ui_recover.ok_button_text = "Recover it"
		ui_recover.cancel_button_text = "Discard"
		ui_recover.get_cancel_button().name = "b_discard"
		ui_recover.get_ok_button().name = "b_recover"
		add_child(ui_recover)
		ui_recover.confirmed.connect(_recover)
		# ONLY THE DISCARD BUTTON DISCARDS (round 35a, GATES QQ3): Esc and the window's (x) also cancel; closing an
		# intro must never throw work away, so they mean LATER: the autosave stays and the next start offers it again
		ui_recover.get_cancel_button().pressed.connect(func(): _recover_discard = true)
		ui_recover.canceled.connect(func(): _recover_closed.call_deferred())   # after the button's own pressed
	var nm: String = a["scene"].get("name", "")
	if nm == "" and path != "":
		nm = path.get_file().get_basename()
	ui_recover.dialog_text = "Kine closed with unsaved work:
'%s', %d cards, autosaved %s.
Recover it?" % [
		nm if nm != "" else "a new scene", a["scene"]["cards"].size(), String(a.get("at", "")).replace("T", " ")]
	ui_recover.set_meta("autosave", a)
	ui_recover.set_meta("from", fp)
	ui_recover.popup_centered()


## Recover: the autosaved scene comes back, still marked unsaved (its file on disk is what _clean holds)
func _recover() -> void:
	var a: Dictionary = ui_recover.get_meta("autosave")
	if ui_recover.get_meta("from", "") == _later_path():
		DirAccess.remove_absolute(_later_path())   # it is open again; the autosave holds it from here
	_restore_work(a)


## the unsaved work a dict holds ({"scene", "path"}) comes back, still unsaved (Recover, and File: restore unsaved work)
func _restore_work(a: Dictionary) -> void:
	var path: String = a.get("path", "")
	_clean = "[]"
	_actors_home()   # TC3
	if path != "" and FileAccess.file_exists(path):
		_recovering = true
		_load_scene(path)   # sets _clean to the disk version
		_recovering = false
	S = Scene.new()
	S.from_dict(a["scene"])
	# the autosave / journal is the whole state: its body and plates replace whatever the file on disk put on the fighter
	if not a["scene"].has(BodyFile.KEY):
		BaseBody.restore_gen(self, 0)   # the mannequin as shipped (the state held no applied body)
	BodyFile.from_scene(self, a["scene"])   # G07: an applied body back, from its file or inline
	ArmourFromBody.from_scene(self, a["scene"])   # B23: the armour plates back
	CharImportApp.from_scene(self, a["scene"])   # L9
	camx.from_scene(a["scene"])   # C01
	scene_path = path
	if ui_loop != null:
		ui_natural.set_pressed_no_signal(S.natural)
		ui_spline.set_pressed_no_signal(S.spline)
		ui_loop.set_pressed_no_signal(S.loop)
	if ui_scene_name != null:
		ui_scene_name.text = S.name
	_show_open_scene()
	ov.mark_dirty()
	wt.mark_dirty()
	_dummy_hits()
	sel_card = -1
	playhead = 0.0
	S.apply(B, 0.0)
	_rebuild_cards()
	_refresh()
	_say("recovered '%s' (%d cards): it is not saved yet, Save scene keeps it" % [S.name, S.cards.size()])


## ---------------------------------------------------------------- THE SET (round 37, GATES SS5 / SS6)
## The scene's props as nodes under ui_props_root (rebuilt whole: a set is a handful of boxes); the picked one tinted
var _gone_said := {}   # prop kinds whose missing model file was already said


var _pn := {}   # L58: the drawn prop nodes, kept between edits: key ("prop_i" / "grp_i") -> [signature, [nodes]]


## forget the kept prop nodes and free them: the next _props_show draws every prop from scratch
func props_nodes_reset() -> void:
	_pn.clear()
	if ui_props_root != null:
		for c in ui_props_root.get_children():
			ui_props_root.remove_child(c)
			c.queue_free()


## resettle: false = the props are already at rest (an undo step restores the places it saved), so nothing is settled again
func _props_show(resettle := true) -> void:
	if resettle:
		Props.settle(S.props, C36Grip.air_held(S))   # UU1: whatever changed, every prop rests on what is under it
	B.props = S.solid_props()   # TT2: the live body stands on the set too (never on what it carries)
	if ui_props_root == null:
		return
	var tint := StandardMaterial3D.new()
	tint.albedo_color = Color(Tok.c("accent"), 0.35)
	tint.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	tint.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	var carried_props := []
	for cr in S.carries():
		carried_props.append(int(cr["prop"]))
	var shared := PropInstances.plan(S.props, sel_prop, carried_props)   # M3: the still copies of one kind share one drawn mesh
	var in_shared := {}
	for g in shared:
		for i in g:
			in_shared[i] = true
	var hide_any: bool = not S.outl.get("hide", {}).is_empty()
	var hid := {}
	if hide_any:
		for i in S.props.size():
			hid[i] = Outliner.hidden(S, "prop:%d" % i)
	var live := {}   # keys drawn this time
	# L58: a prop keeps its node while its record (and the pick tint) is unchanged; a keyed or carried prop is always redrawn (it is posed)
	for i in S.props.size():
		if in_shared.has(i) or hid.get(i, false):
			continue   # L36: a hidden prop is not drawn (a shared copy is dropped below)
		var p: Dictionary = S.props[i]
		var key := "prop_%d" % i
		live[key] = true
		var vol := Props.animated(p) or Props.hinged(p) or carried_props.has(i)
		var sig := hash(p) + (1 if i == sel_prop else 0)
		var old = _pn.get(key)
		if old != null and not vol and int(old[0]) == sig and is_instance_valid(old[1][0]) and (old[1][0] as Node3D).get_parent() == ui_props_root 				and ((old[1][0] as Node3D).transform).is_equal_approx(PropInstances.root_xf(p)):
			continue
		_pn_drop(key)
		var n := Props.mesh(p)
		if Props.model_missing(p) and not _gone_said.has(p["kind"]):
			_gone_said[p["kind"]] = true
			_say_plain("the model file of the %s is missing: it is drawn as a box. Open the importer and add the model again, or delete the prop" % p["kind"])
		n.name = key
		if i == sel_prop:
			for mi in n.find_children("*", "MeshInstance3D", true, false):
				(mi as MeshInstance3D).material_overlay = tint
		ui_props_root.add_child(n)
		_pn[key] = [sig, [n]]
		_props_gen += 1
	for g0 in shared:   # M3: one MultiMeshInstance3D per mesh of the kind, one instance per copy (scripts/prop_instances.gd)
		var g: Array = g0.filter(func(i): return not hid.get(i, false))   # L36: hidden copies are left out
		if g.is_empty():
			continue
		var key := "grp_%d" % g[0]
		live[key] = true
		var sigs := []
		for i in g:
			sigs.append(S.props[i])
		var sig := hash(sigs)
		var old = _pn.get(key)
		if old != null and int(old[0]) == sig and not (old[1] as Array).is_empty() and is_instance_valid(old[1][0]) and (old[1][0] as Node).get_parent() == ui_props_root:
			continue
		_pn_drop(key)
		var parts_mm := PropInstances.build(S.props, g)
		for j in parts_mm.size():
			parts_mm[j].name = "shared_%d_%d" % [g[0], j]
			ui_props_root.add_child(parts_mm[j])
		_pn[key] = [sig, parts_mm]
		_props_gen += 1
	for key in _pn.keys():
		if not live.has(key):
			_pn_drop(key)
	var known := {}
	for key in _pn:
		for n in _pn[key][1]:
			known[n] = true
	for c in ui_props_root.get_children():   # nothing else belongs here
		if not known.has(c):
			ui_props_root.remove_child(c)
			c.queue_free()
	for k in ui_prop_btns:
		_grey(ui_prop_btns[k], "" if sel_prop >= 0 else "pick a prop first: click it in the view, or add one with Add prop")
	var kind := String(S.props[sel_prop]["kind"]) if sel_prop >= 0 and sel_prop < S.props.size() else ""
	if ui_use_btns.has("Sit here"):
		_grey(ui_use_btns["Sit here"], "" if kind in SIT_ON else "pick a chair, a stool or a bench first (Add prop puts one in the set)")
		for k in ["Sit down", "Stand up"]:
			_grey(ui_use_btns[k], "" if kind in SIT_ON else "pick a chair, a stool or a bench first (Add prop puts one in the set)")
		_grey(ui_use_btns["Step up"], "" if kind in STEP_ON else "pick a box, a crate, a step or the stairs first (Add prop puts one in the set)")
		_grey(ui_use_btns["Pick up"], "" if kind != "" and sel_card >= 0 else ("pick a card first: the body on it holds the prop" if kind != "" else "pick a prop first: click it in the view, or add one with Add prop"))
		_grey(ui_use_btns["Put down"], "" if not _held_at(sel_card).is_empty() else "pick a card where a prop is held (after its Pick up card): the hands let it go there")
	_props_pose()
	if shading.mode != "solid":
		shading.set_mode(self, shading.mode)   # K01: the new prop nodes are drawn in the view's shading mode
	if ui_browser != null:
		ui_browser.refresh()


func _pn_drop(key: String) -> void:
	_props_gen += 1
	var old = _pn.get(key)
	_pn.erase(key)
	if old == null:
		return
	for n in old[1]:
		if is_instance_valid(n):
			if (n as Node).get_parent() != null:
				(n as Node).get_parent().remove_child(n)
			n.queue_free()


## the prop under the mouse: [index, distance along the ray] ([-1, INF] none); a ray against each solid box
func _pick_prop(mp: Vector2) -> Array:
	var o := cam.project_ray_origin(mp)
	var d := cam.project_ray_normal(mp)
	var best := -1
	var bt := INF
	for i in S.props.size():
		if Outliner.hidden(S, "prop:%d" % i):
			continue   # L36: a hidden object is clicked through
		for sw in Props.solids(S.props[i]):
			var inv: Transform3D = (sw["xf"] as Transform3D).affine_inverse()
			var lo := inv * o
			var ld := inv.basis * d
			var h: Vector3 = sw["half"]
			var t0 := -INF
			var t1 := INF
			var hit := true
			for k in 3:
				if absf(ld[k]) < 1e-9:
					if absf(lo[k]) > h[k]:
						hit = false
						break
				else:
					var a := (-h[k] - lo[k]) / ld[k]
					var b := (h[k] - lo[k]) / ld[k]
					t0 = maxf(t0, minf(a, b))
					t1 = minf(t1, maxf(a, b))
			if hit and t1 >= maxf(t0, 0.0) and maxf(t0, 0.0) < bt:
				bt = maxf(t0, 0.0)
				best = i
	return [best, bt]


## ---- OUTLINER (L36, scripts/outliner.gd): each change is ONE undo step; a refusal is said and changes nothing
func _outl_locked_say(i: int) -> bool:
	if i >= 0 and Outliner.locked(S, "prop:%d" % i):
		_say_plain("the %s is locked: unlock it in the Outliner first" % _prop_name(i))
		return true
	return false


## `child` dropped on `parent` ("" = the top level), its world transform kept. Returns "" or the reason it was refused
func _outl_reparent(child: String, parent: String) -> String:
	var why := Outliner.can_reparent(S, child, parent)
	if why != "":
		_say(why)
		return why
	_step_hint = "Reparent"
	_push_undo()
	Outliner.reparent(S, child, parent)
	_outl_changed()
	_say_plain("%s is now %s; it stayed where it was in the view. Ctrl+Z takes it back" % [Outliner._name(S, child), ("under " + Outliner._name(S, parent)) if parent != "" else "at the top level"])
	return ""


func _outl_hide(id: String, on: bool) -> void:
	if not Outliner.has(S, id) or S.outl.get("hide", {}).has(id) == on:
		return
	_step_hint = "Hide" if on else "Show"
	_push_undo()
	Outliner.set_hidden(S, id, on)
	_outl_changed()


func _outl_lock(id: String, on: bool) -> void:
	if not Outliner.has(S, id) or Outliner.locked(S, id) == on:
		return
	_step_hint = "Lock" if on else "Unlock"
	_push_undo()
	Outliner.set_locked(S, id, on)
	_outl_changed()


func _outl_changed() -> void:
	_props_show()
	if ui_browser != null:
		ui_browser.refresh()


## a row picked in the Outliner: a prop is picked as in the view, anything else is the picked object
func _outl_select(id: String) -> void:
	var i := Outliner.prop_index(id)
	if i >= 0:
		_prop_select(i)
		return
	sel_prop = -1
	sel_obj = id
	sel_obj_part = sel
	_props_show()
	_say_plain("%s selected (from the Outliner)" % Outliner._name(S, id))


func _prop_name(i: int) -> String:
	if i >= 0 and i < S.props.size() and String(S.props[i]["kind"]).begins_with("part:"):
		return PartScene.name_of(String(S.props[i]["kind"]))   # F146: a built part shows by its own name
	return String(S.props[i]["kind"]).trim_prefix("piece:").replace("_", " ") if i >= 0 and i < S.props.size() else ""


## a press on a prop: picked, and a drag moves it over the floor (snapped onto what it stands over); one undo step
func _prop_press(i: int, mp: Vector2, t: float) -> void:
	if Outliner.locked(S, "prop:%d" % i):   # L36: a locked object is picked, never grabbed: no drag, no undo step
		sel_prop = i
		sel_obj = "prop:%d" % i
		_props_show()
		_say_plain("the %s is locked: unlock it in the Outliner (the lock on its row) to move it" % _prop_name(i))
		return
	_step_hint = "Move prop"
	_push_undo()
	sel_prop = i
	sel_obj = "prop:%d" % i
	playing = false
	_prop_live(i)
	var hp := cam.project_ray_origin(mp) + cam.project_ray_normal(mp) * t
	var o: Vector3 = (S.props[i]["xf"] as Transform3D).origin
	_prop_drag = {"i": i, "plane": hp.y, "off": Vector3(o.x - hp.x, 0.0, o.z - hp.z), "moved": false, "from": o,
		"turn": StickyKeys.held(KEY_SHIFT), "yaw0": Props.yaw_of(S.props[i]["xf"]), "a0": atan2(hp.x - o.x, hp.z - o.z)}
	dragging = "prop"
	_end_teach()
	_props_show()
	_say_plain(("the %s: drag to move it (it steps onto what it stands over); Turn left / right and Remove are in the bar at the top right" if easy.on else "the %s: drag to move it (it steps onto what it stands over); Turn left / right and Delete are in SET") % _prop_name(i))


func _prop_move(mp: Vector2) -> void:
	var o := cam.project_ray_origin(mp)
	var d := cam.project_ray_normal(mp)
	if absf(d.y) < 1e-4 or _prop_drag.is_empty():
		return
	var t := (float(_prop_drag["plane"]) - o.y) / d.y
	if t <= 0.0:
		return
	var i: int = _prop_drag["i"]
	if _prop_drag["turn"]:   # row 22: Shift+drag turns the prop about its middle, following the mouse round it
		_prop_turn_drag(o + d * t)
		return
	var hp := o + d * t + (_prop_drag["off"] as Vector3)
	var p: Dictionary = S.props[i]
	var xf: Transform3D = p["xf"]
	xf.origin = Vector3(hp.x, 0.0, hp.z)
	p["xf"] = xf
	var others := []
	for k in S.props.size():
		if k != i:
			others.append(S.props[k])
	xf.origin.y = Props.snap_y(p, others)
	p["xf"] = xf
	_prop_drag["moved"] = xf.origin.distance_to(_prop_drag["from"]) > 0.001   # a still mouse is a click, not a move
	var n := ui_props_root.get_node_or_null("prop_%d" % i)
	if n != null:
		(n as Node3D).transform = xf


func _prop_release() -> void:
	if _prop_drag.is_empty():
		return
	if not _prop_drag["moved"]:
		undo.pop_back()   # a click that only picked: no step
		_history_rows()
	else:
		_prop_autokey(_prop_drag["i"])   # row 22: a keyed prop moved = a key at the playhead
		Outliner.moved(S, "prop:%d" % int(_prop_drag["i"]))   # L36: what is under it in the Outliner goes with it
		_props_show()   # UU1: what stood on it settles
		var y: float = (S.props[_prop_drag["i"]]["xf"] as Transform3D).origin.y
		_say("moved the %s%s" % [_prop_name(_prop_drag["i"]), "" if y < 0.001 else ": it stands on what is under it, %.0f cm up" % (y * 100.0)])
		_doc_line()
	_prop_drag = {}


func _prop_menu_fill(ap: MenuButton) -> void:
	var pm := ap.get_popup()
	pm.clear()
	var cat := Props.catalogue()
	for k in cat.size():
