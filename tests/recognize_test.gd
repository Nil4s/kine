## godot --headless --path . -s tests/recognize_test.gd     (N016 MOVE RECOGNIZER, scripts/move_recognizer.gd)
## "Is this a hook?" named from the played body, with how far it is from the textbook form. Bars, stated before measuring:
##   1 TEXT-TO-BLOCKING (ROADMAP 22, TextBlocking.build): 11 phrases, each recognised as the class its words name, at least
##     9 of 11: "fast jab" jab, "uppercut" uppercut, "hook, step in" hook, "right hook" hook, "overhead axe strike, step in"
##     and "heavy hammer overhead, step back" overhead weapon strike, "bat swing left", "bat swing right" and "staff sweep
##     right" horizontal weapon swing, "dagger thrust lunge" and "slow staff thrust, step in" thrust. (Text-to-blocking's
##     kicks, generated by StrikeBlocking, are checked in text_blocking_test, not counted here.) The built clips are
##     kept in user:// keyed by a hash of text_blocking.gd + strike_blocking.gd + attack_timing.gd + scenes/*.json (see blocked()).
##   2 HAND-POSED (built here from joint angles, both feet planted by Body.plant): jab (lead left), cross (rear right, hips
##     turning), hook (lead left, from the arm opened out to the side, elbow level), uppercut (rear right, rising), elbow
##     (right, forearm folded, swept across at shoulder height), knee (right),
##     front kick (right), side kick (right), roundhouse (right, the hips turning over): each recognised as built, 9 of 9.
##   3 MIRRORED (Scene.mirror_card on every card, the Mirror-the-scene op): every hand-posed clip and the text-blocked
##     "hook, step in" give the same class with the side swapped, all of them.
##   4 BROKEN HOOK: the hand-posed hook with the upper arm 25 deg lower at contact is still "hook"; its reported elbow
##     elevation is within 5 deg of the elevation measured here on the contact card itself (shoulder -> elbow, asin), it is
##     reported as a form miss in words ("drops ... below shoulder height"), and the intact hook's elbow passes (level within
##     10 deg). The change intact -> broken as reported is within 5 deg of the change measured on the cards.
##   5 NOT A STRIKE: scenes/walk_bat.json (and scenes/_wip/walk.json when present) -> strike false, class "unknown".
##   6 SERVE: `recognize` on the opened hand-posed hook (whole clip, and card=3) gives the class the direct call gives; card 1
##     and fighter 3 are errors that say what to send.
extends SceneTree

var fails := 0
var t_start := Time.get_ticks_msec()
var B: Body
var stance := {"_l": [Vector3(0.12, 0.0152, 0.28), 0.0], "_r": [Vector3(-0.14, 0.0152, -0.18), 0.5]}


func ok(c: bool, what: String) -> void:
	print(("ok   " if c else "FAIL ") + what + "   [%.0f s]" % ((Time.get_ticks_msec() - t_start) / 1000.0))
	if not c:
		fails += 1


## a pose: an orthodox guard stance (left foot forward, both fists at the chin), the given angles on top, the listed feet
## planted back on their stance spots
func pose(angs: Dictionary, plant := ["_l", "_r"]) -> Dictionary:
	for j in B.ang:
		B.ang[j] = Vector3.ZERO
	B.offset = Vector3(0, -0.04, 0)
	var base := {"thigh_l": Vector3(20, 0, 0), "calf_l": Vector3(15, 0, 0), "thigh_r": Vector3(-15, 0, 0), "calf_r": Vector3(10, 0, 0),
		"upperarm_l": Vector3(35, -55, 0), "lowerarm_l": Vector3(135, 0, 0), "upperarm_r": Vector3(35, -55, 0), "lowerarm_r": Vector3(135, 0, 0)}
	for j in base:
		B.ang[j] = base[j]
	for j in angs:
		B.ang[j] = B.clamp_ang(j, angs[j])
	B.fk()
	for sd in plant:
		B.plant(sd, stance[sd][0], stance[sd][1], true)
	return B.to_dict()


## keys: [[name, angles, planted feet, move s, hold s]]
func clip(nm: String, keys: Array) -> Scene:
	var S := Scene.new()
	S.name = nm
	for k in keys:
		S.cards.append({"name": k[0], "pose": pose(k[1], k[2]), "move": k[3], "hold": k[4]})
	S.cards[0]["move"] = -1.0
	return S


func mirrored(S: Scene) -> Scene:
	var M := Body.new()
	M.load_files("res://data/skeleton.json", "res://data/body_limits.json")
	var R := S.clone()
	for i in R.cards.size():
		R.cards[i] = Scene.mirror_card(R.cards[i], M)
	return R


const BOTH := ["_l", "_r"]
const LEFT := ["_l"]
const RIGHT := ["_r"]


func hand_posed(drop := 0.0) -> Dictionary:
	var g := {}
	var out := {}
	out["jab"] = clip("jab", [["guard", g, BOTH, 0, 0.3], ["jab", {"upperarm_l": Vector3(85, -5, 0), "lowerarm_l": Vector3(5, 0, 0)}, BOTH, 0.12, 0.1],
		["guard", g, BOTH, 0.25, 0.3]])
	out["cross"] = clip("cross", [["guard", g, BOTH, 0, 0.3], ["cross", {"upperarm_r": Vector3(85, -5, 0), "lowerarm_r": Vector3(5, 0, 0),
		"pelvis": Vector3(0, 0, 30), "spine_03": Vector3(0, 0, 15)}, BOTH, 0.15, 0.1], ["guard", g, BOTH, 0.3, 0.3]])
	out["hook"] = clip("hook", [["guard", g, BOTH, 0, 0.3], ["load", {"upperarm_l": Vector3(20, -5, 0), "lowerarm_l": Vector3(90, 0, 0), "pelvis": Vector3(0, 0, 15)}, BOTH, 0.2, 0.05],
		["hook", {"upperarm_l": Vector3(75, -drop, 0), "lowerarm_l": Vector3(90, 0, 0), "pelvis": Vector3(0, 0, -30), "spine_03": Vector3(0, 0, -15)}, BOTH, 0.15, 0.1],
		["guard", g, BOTH, 0.3, 0.3]])
	out["uppercut"] = clip("uppercut", [["guard", g, BOTH, 0, 0.3], ["dip", {"upperarm_r": Vector3(0, -85, 0), "lowerarm_r": Vector3(90, 0, 0), "spine_03": Vector3(0, 0, -10)}, BOTH, 0.25, 0.05],
		["uppercut", {"upperarm_r": Vector3(80, -45, 0), "lowerarm_r": Vector3(95, 0, 0), "pelvis": Vector3(0, 0, 25), "spine_03": Vector3(0, 0, 10)}, BOTH, 0.15, 0.1],
		["guard", g, BOTH, 0.3, 0.3]])
	out["elbow"] = clip("elbow", [["guard", g, BOTH, 0, 0.3], ["load", {"upperarm_r": Vector3(5, 0, 0), "lowerarm_r": Vector3(145, 0, 0), "pelvis": Vector3(0, 0, -10)}, BOTH, 0.2, 0.05],
		["elbow", {"upperarm_r": Vector3(80, 0, 0), "lowerarm_r": Vector3(145, 0, 0),
		"pelvis": Vector3(0, 0, 35), "spine_03": Vector3(0, 0, 15)}, BOTH, 0.15, 0.1], ["guard", g, BOTH, 0.3, 0.3]])
	out["knee"] = clip("knee", [["guard", g, BOTH, 0, 0.3], ["knee", {"thigh_r": Vector3(105, 0, 0), "calf_r": Vector3(130, 0, 0)}, LEFT, 0.2, 0.1],
		["guard", g, BOTH, 0.3, 0.3]])
	out["front kick"] = clip("front kick", [["guard", g, BOTH, 0, 0.3], ["chamber", {"thigh_r": Vector3(90, 0, 0), "calf_r": Vector3(115, 0, 0)}, LEFT, 0.2, 0.0],
		["front kick", {"thigh_r": Vector3(85, 0, 0), "calf_r": Vector3(5, 0, 0)}, LEFT, 0.12, 0.1], ["chamber", {"thigh_r": Vector3(90, 0, 0), "calf_r": Vector3(115, 0, 0)}, LEFT, 0.15, 0.0],
		["guard", g, BOTH, 0.25, 0.3]])
	out["side kick"] = clip("side kick", [["guard", g, BOTH, 0, 0.3], ["chamber", {"pelvis": Vector3(0, 20, 80), "thigh_r": Vector3(70, 30, 0), "calf_r": Vector3(125, 0, 0)}, LEFT, 0.25, 0.0],
		["side kick", {"pelvis": Vector3(0, 40, 80), "thigh_r": Vector3(0, 45, 0), "calf_r": Vector3(5, 0, 0)}, LEFT, 0.12, 0.1],
		["chamber", {"pelvis": Vector3(0, 20, 80), "thigh_r": Vector3(70, 30, 0), "calf_r": Vector3(125, 0, 0)}, LEFT, 0.15, 0.0], ["guard", g, BOTH, 0.3, 0.3]])
	out["roundhouse"] = clip("roundhouse", [["guard", g, BOTH, 0, 0.3], ["chamber", {"pelvis": Vector3(0, 20, 20), "thigh_r": Vector3(40, 45, 0), "calf_r": Vector3(120, 0, 0)}, LEFT, 0.2, 0.0],
		["roundhouse", {"pelvis": Vector3(0, 35, 110), "thigh_r": Vector3(20, 45, 0), "calf_r": Vector3(5, 0, 0)}, LEFT, 0.15, 0.1],
		["guard", g, BOTH, 0.35, 0.3]])
	return out


## the elevation of the upper arm (deg; + = elbow above the shoulder) on a card, read off the card's pose directly
func card_elev(S: Scene, i: int, sd: String) -> float:
	var M := Body.new()
	M.load_files("res://data/skeleton.json", "res://data/body_limits.json")
	M.from_dict(S.cards[i]["pose"])
	M.fk()
	var d: Vector3 = M.P["lowerarm" + sd] - M.P["upperarm" + sd]
	return rad_to_deg(asin(d.y / d.length()))


## TextBlocking.build(phrase), kept in user://recognize_tb/<key>/ so a re-run reads the same clip back instead of building
## it again (a build is 5-60 s, and minutes on a loaded machine). The key hashes text_blocking.gd, attack_timing.gd and every
## scenes/*.json (what the build retrieves from), so any change to them builds afresh. The clip read back is the file the
## build saves (TextBlocking.save, the scene list's own format), its notes in "plan".
func blocked(ph: String) -> Dictionary:
	var hc := HashingContext.new()
	hc.start(HashingContext.HASH_SHA256)
	var src := ["res://scripts/text_blocking.gd", "res://scripts/strike_blocking.gd", "res://tools/attack_timing.gd"]
	var fl := Array(DirAccess.get_files_at("res://scenes"))
	fl.sort()
	for f in fl:
		if String(f).ends_with(".json"):
			src.append("res://scenes/" + f)
	for f in src:
		hc.update(FileAccess.get_file_as_bytes(f))
	var dir := "user://recognize_tb/" + hc.finish().hex_encode().left(16)
	var path := "%s/%s.json" % [dir, ph.validate_filename().replace(" ", "_")]
	if FileAccess.file_exists(path):
		var d: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(path))
		var S := Scene.new()
		S.from_dict(d)
		return {"ok": true, "scene": S, "notes": String(d.get("plan", "")).split(" | "), "cached": true}
	var t0 := Time.get_ticks_msec()
	var bb := TextBlocking.build(ph, B)
	print("     (built '%s' in %.0f s)" % [ph, (Time.get_ticks_msec() - t0) / 1000.0])
	if bb.get("ok", false):
		TextBlocking.save(bb["scene"], B, path, " | ".join(bb.get("notes", [])))
		var d2: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(path))
		var S2 := Scene.new()
		S2.from_dict(d2)
		bb["scene"] = S2   # recognised from the file form either way, so a cached run reads the very same clip
	return bb


func line(nm: String, r: Dictionary) -> String:
	return "%-34s -> %-24s %s" % [nm, r["class"] + ("" if not r.get("strike", false) else " (" + String(r["side"]) + ")"), r.get("text", "")]


func _init() -> void:
	B = Body.new()
	B.load_files("res://data/skeleton.json", "res://data/body_limits.json")
	B.fk()

	# ---- 2 + 3 HAND-POSED and MIRRORED
	var hp := hand_posed()
	var good := 0
	var mir_ok := 0
	var mir_n := 0
	for k in hp:
		var r := MoveRecognizer.of_scene(hp[k], B)
		print("     " + line("hand-posed " + k, r))
		print("        chain %s; nearest %s" % [r.get("chain", {}).get("order", []), (r.get("nearest", []) as Array).map(func(x): return "%s %.2f" % [x["class"], x["distance"]])])
		if r["class"] == k:
			good += 1
		var rm := MoveRecognizer.of_scene(mirrored(hp[k]), B)
		mir_n += 1
		var swapped: bool = r.get("strike", false) and rm.get("strike", false) and rm["side"] != r["side"]
		if rm["class"] == r["class"] and swapped:
			mir_ok += 1
		else:
			print("        MIRROR: %s" % line("mirrored " + k, rm))
	ok(good == hp.size(), "2 hand-posed clips recognised as built: %d of %d (bar all)" % [good, hp.size()])

	# ---- 4 BROKEN HOOK
	var hk: Scene = hp["hook"]
	var bk: Scene = hand_posed(25.0)["hook"]
	var ri := MoveRecognizer.of_scene(hk, B)
	var rb := MoveRecognizer.of_scene(bk, B)
	var ei := card_elev(hk, 2, "_l")
	var eb := card_elev(bk, 2, "_l")
	var gi := float(ri["features"]["elbow_elev"])
	var gb := float(rb["features"]["elbow_elev"])
	var fb: Array = (rb["form"] as Array).filter(func(x): return String(x["what"]).begins_with("elbow height"))
	var fi: Array = (ri["form"] as Array).filter(func(x): return String(x["what"]).begins_with("elbow height"))
	print("     broken hook: %s" % rb["text"])
	ok(rb["class"] == "hook" and absf(gb - eb) <= 5.0 and not fb.is_empty() and not fb[0]["ok"] and String(fb[0]["text"]).contains("below shoulder height"),
		"4 broken hook is still '%s'; elbow reported %.1f deg, on the contact card %.1f deg (bar within 5): '%s'" % [rb["class"], gb, eb, fb[0]["text"] if not fb.is_empty() else "no form entry"])
	ok(not fi.is_empty() and fi[0]["ok"] and absf(gi - ei) <= 5.0 and absf((gi - gb) - (ei - eb)) <= 5.0,
		"4 intact hook's elbow %.1f deg (card %.1f) passes; the drop reported %.1f deg, on the cards %.1f deg (bar within 5)" % [gi, ei, gi - gb, ei - eb])

	# ---- 5 NOT A STRIKE
	for f in ["res://scenes/walk_bat.json", "res://scenes/_wip/walk.json"]:
		if not FileAccess.file_exists(f):
			print("     (%s not here: skipped)" % f)
			continue
		var W := Scene.new()
		W.from_dict(JSON.parse_string(FileAccess.get_file_as_string(f)))
		var rw := MoveRecognizer.of_scene(W, B)
		ok(not rw["strike"] and rw["class"] == "unknown", "5 %s: %s" % [f.get_file(), rw["text"]])

	# ---- 1 TEXT-TO-BLOCKING (and the mirror of its hook)
	var phrases := [["fast jab", "jab"], ["uppercut", "uppercut"], ["hook, step in", "hook"], ["right hook", "hook"],
		["overhead axe strike, step in", "overhead weapon strike"], ["heavy hammer overhead, step back", "overhead weapon strike"],
		["bat swing left", "horizontal weapon swing"], ["bat swing right", "horizontal weapon swing"], ["staff sweep right", "horizontal weapon swing"],
		["dagger thrust lunge", "thrust"], ["slow staff thrust, step in", "thrust"]]
	var hits := 0
	for ph in phrases:
		var bb := blocked(ph[0])
		if not bb.get("ok", false):
			print("     text-to-blocking '%s' failed: %s" % [ph[0], bb.get("error", "")])
			continue
		var r := MoveRecognizer.of_scene(bb["scene"], B)
		var hit: bool = r["class"] == ph[1]
		hits += 1 if hit else 0
		print("     %s %s   [made from: %s]" % ["HIT " if hit else "MISS", line("'" + ph[0] + "'", r), " / ".join(bb.get("notes", []).slice(0, 2))])
		if ph[0] == "hook, step in":
			var rm := MoveRecognizer.of_scene(mirrored(bb["scene"]), B)
			mir_n += 1
			if rm["class"] == r["class"] and r.get("strike", false) and rm.get("strike", false) and rm["side"] != r["side"]:
				mir_ok += 1
			else:
				print("        MIRROR: %s" % line("mirrored 'hook, step in'", rm))
	print("     (text-to-blocking's kicks, StrikeBlocking's generated key poses, are recognised in text_blocking_test: not counted here)")
	ok(hits >= 9, "1 text-to-blocking clips recognised as their words: %d of %d (bar >= 9)" % [hits, phrases.size()])
	ok(mir_ok == mir_n, "3 mirrored clips: same class, side swapped: %d of %d (bar all)" % [mir_ok, mir_n])

	# ---- 6 SERVE
	var m: Node = (load("res://main.tscn") as PackedScene).instantiate()
	root.add_child(m)
	await process_frame
	var T := AgentTools.new(m)
	m.S = hk
	m.dummy_on = false
	var s1: Dictionary = await T.request(1, "recognize", {})
	var s2: Dictionary = await T.request(2, "recognize", {"card": 3})
	var s3: Dictionary = await T.request(3, "recognize", {"card": 1})
	var s4: Dictionary = await T.request(4, "recognize", {"fighter": 3})
	print("     serve card=3: %s" % s2.get("result", {}).get("text", s2.get("error")))
	ok(s1.get("result", {}).get("class", "") == ri["class"] and s2.get("result", {}).get("class", "") == "hook" and s3.has("error") and s4.has("error"),
		"6 serve recognize: whole clip '%s', card 3 '%s'; card 1 -> '%s'; fighter 3 -> '%s'" % [s1.get("result", {}).get("class", s1.get("error")),
			s2.get("result", {}).get("class", s2.get("error")), s3.get("error", {}).get("message", "no error"), s4.get("error", {}).get("message", "no error")])

	print("RECOGNIZE %s (%d fails)" % ["PASS" if fails == 0 else "FAIL", fails])
	m.queue_free()
	quit(1 if fails > 0 else 0)
