; Kine by Teschima Studios (was Poser) - the mannequin for planning moves (separate from the game on purpose)
config_version=5

[application]
config/name="Kine"
config/version="0.1.0"
config/description="Kine by Teschima Studios: pose cards, real human limits, motion you can check"
; the saved settings and autosave stay where they were under the old name
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Poser"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]
anti_aliasing/quality/msaa_3d=2
