; Kine by Teschima Studios (was Poser) - the mannequin for planning moves (separate from the game on purpose)
config_version=5

[application]
config/name="Kine"
config/version="0.4.0"
config/description="Kine by Teschima Studios: pose cards, real human limits, motion you can check"
config/icon="res://assets/brand/icon.svg"
; the saved settings and autosave stay where they were under the old name
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Poser"
run/main_scene="res://main.tscn"
; the loading screen is the intro's own dark (scripts/intro/intro.gd), so the start is one dark field into the intro
boot_splash/bg_color=Color(0.0862745, 0.0901961, 0.105882, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]
anti_aliasing/quality/msaa_3d=2
