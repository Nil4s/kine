{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "poser/scene.schema.json",
 "title": "Poser scene or pose file",
 "description": "A file with 'cards' is a SCENE (poses in order, played as a motion); one with 'joints' is a POSE. Angles are degrees from rest (bend, side, twist; Body clamps them to data/body_limits.json on load), positions metres, quaternions [x, y, z, w]. Derived fields (A, G, pos, end, at_limit, contacts, bad_frames, length_s, arrive_s, leave_s) are written for readers and ignored on load. tools/validate.gd checks a file against this; tests/schema_test.gd keeps the enums equal to the code's tables.",
 "if": {
  "type": "object",
  "required": [
   "cards"
  ]
 },
 "then": {
  "$ref": "#/$defs/scene"
 },
 "else": {
  "$ref": "#/$defs/pose"
 },
 "$defs": {
  "vec3": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "quat": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 4,
   "maxItems": 4
  },
  "joint": {
   "type": "object",
   "required": [
    "bend",
    "side",
    "twist"
   ],
   "properties": {
    "bend": {
     "type": "number"
    },
    "side": {
     "type": "number"
    },
    "twist": {
     "type": "number"
    },
    "A": {
     "$ref": "#/$defs/quat"
    },
    "G": {
     "$ref": "#/$defs/quat"
    },
    "pos": {
     "$ref": "#/$defs/vec3"
    },
    "end": {
     "$ref": "#/$defs/vec3"
    },
    "at_limit": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "weapon": {
   "type": "object",
   "description": "empty = no weapon",
   "properties": {
    "kind": {
     "enum": [
      "metal_bat",
      "staff",
      "long_hammer",
      "dagger",
      "long_axe"
     ]
    },
    "length": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "hand": {
     "enum": [
      "",
      "hand_l",
      "hand_r"
     ]
    },
    "knob": {
     "$ref": "#/$defs/vec3"
    },
    "tip": {
     "$ref": "#/$defs/vec3"
    },
    "rot": {
     "$ref": "#/$defs/quat"
    },
    "local_pos": {
     "$ref": "#/$defs/vec3"
    },
    "local_rot": {
     "$ref": "#/$defs/quat"
    },
    "two_hand_grip": {
     "type": "boolean"
    },
    "grip_m": {
     "type": "number"
    },
    "grip2": {
     "type": "object",
     "description": "Lock both hands: the second hand's grip in the weapon's frame (hand, u = metres up the shaft, lpos, lrot, fingers)",
     "properties": {
      "hand": {"enum": ["hand_l", "hand_r"]},
      "u": {"type": "number"},
      "lpos": {"$ref": "#/$defs/vec3"},
      "lrot": {"$ref": "#/$defs/quat"},
      "fingers": {"type": "object"}
     },
     "required": ["hand", "lpos", "lrot", "fingers"],
     "additionalProperties": false
    }
   },
   "dependentRequired": {
    "kind": [
     "rot",
     "knob"
    ]
   },
   "additionalProperties": false
  },
  "pose": {
   "type": "object",
   "required": [
    "joints"
   ],
   "properties": {
    "joints": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "pelvis",
       "spine_01",
       "spine_02",
       "spine_03",
       "neck_01",
       "head",
       "clavicle_l",
       "upperarm_l",
       "lowerarm_l",
       "hand_l",
       "clavicle_r",
       "upperarm_r",
       "lowerarm_r",
       "hand_r",
       "thigh_l",
       "calf_l",
       "foot_l",
       "ball_l",
       "thigh_r",
       "calf_r",
       "foot_r",
       "ball_r",
       "thumb_01_l",
       "thumb_02_l",
       "thumb_03_l",
       "index_01_l",
       "index_02_l",
       "index_03_l",
       "middle_01_l",
       "middle_02_l",
       "middle_03_l",
       "ring_01_l",
       "ring_02_l",
       "ring_03_l",
       "pinky_01_l",
       "pinky_02_l",
       "pinky_03_l",
       "thumb_01_r",
       "thumb_02_r",
       "thumb_03_r",
       "index_01_r",
       "index_02_r",
       "index_03_r",
       "middle_01_r",
       "middle_02_r",
       "middle_03_r",
       "ring_01_r",
       "ring_02_r",
       "ring_03_r",
       "pinky_01_r",
       "pinky_02_r",
       "pinky_03_r"
      ]
     },
     "additionalProperties": {
      "$ref": "#/$defs/joint"
     }
    },
    "offset": {
     "$ref": "#/$defs/vec3"
    },
    "weapon": {
     "$ref": "#/$defs/weapon"
    },
    "weapon2": {
     "$ref": "#/$defs/weapon",
     "description": "the off-hand weapon (round 33, dual wield): always held, in the hand the main weapon is not in"
    },
    "contacts": {
     "type": "array"
    },
    "note": {
     "type": "string"
    },
    "from": {
     "type": "string"
    },
    "settled": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "heel_up": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "card": {
   "type": "object",
   "required": [
    "name",
    "pose"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "pose": {
     "$ref": "#/$defs/pose"
    },
    "move": {
     "type": "number",
     "minimum": -1,
     "description": "seconds to arrive from the card before; -1 = auto"
    },
    "hold": {
     "type": "number",
     "minimum": 0
    },
    "arrive_s": {
     "type": "number"
    },
    "leave_s": {
     "type": "number"
    },
    "steps": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "_l",
       "_r"
      ]
     },
     "additionalProperties": {
      "$ref": "#/$defs/vec3"
     }
    },
    "lift": {
     "type": "number"
    },
    "flow": {
     "type": "boolean"
    },
    "walk": {
     "type": "boolean"
    },
    "ease": {
     "enum": [
      "smooth",
      "linear",
      "in",
      "out",
      "snap"
     ]
    },
    "plant": {
     "type": "array",
     "items": {
      "enum": [
       "_l",
       "_r"
      ]
     },
     "uniqueItems": true
    }
   },
   "additionalProperties": false
  },
  "scene": {
   "type": "object",
   "required": [
    "cards"
   ],
   "properties": {
    "scene": {
     "type": "string"
    },
    "cards": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/card"
     }
    },
    "natural": {
     "type": "boolean"
    },
    "spline": {
     "type": "boolean"
    },
    "audio": {
     "type": "object",
     "description": "the sound on the timeline; only when there is one. offset = seconds where it starts",
     "required": ["path"],
     "properties": {
      "path": {"type": "string"},
      "offset": {"type": "number"},
      "gain_db": {"type": "number"}
     },
     "additionalProperties": false
    },
    "markers": {
     "type": "array",
     "description": "named moments on the timeline (round 41); only when any",
     "items": {
      "type": "object",
      "required": ["t", "name", "kind"],
      "properties": {
       "t": {"type": "number"},
       "name": {"type": "string"},
       "kind": {"enum": ["hit", "step", "swoosh", "note"]}
      },
      "additionalProperties": false
     }
    },
    "actors": {
     "type": "array",
     "description": "further characters (two-character scenes, G1); the top level is actor 0. Written only when there is more than one actor",
     "items": {
      "type": "object",
      "required": ["name", "xf", "scene"],
      "properties": {
       "name": {"type": "string"},
       "xf": {
        "type": "object",
        "required": ["pos", "yaw"],
        "properties": {
         "pos": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
         "yaw": {"type": "number"}
        },
        "additionalProperties": false
       },
       "scene": {"$ref": "#/$defs/scene"}
      },
      "additionalProperties": false
     }
    },
    "moving_holds": {
     "type": "boolean"
    },
    "on_floor": {
     "type": "boolean"
    },
    "floor_body": {
     "type": "boolean"
    },
    "pin": {
     "type": "boolean"
    },
    "fps": {
     "type": "integer",
     "minimum": 1,
     "maximum": 240
    },
    "length_s": {
     "type": "number"
    },
    "bad_frames": {
     "type": "array"
    },
    "note": {
     "type": "string"
    },
    "plan": {
     "type": "string"
    },
    "body": {
     "type": "object",
     "description": "PROPORTIONS (round 51, scripts/proportions.gd): the body this scene is animated on; written only when not the mannequin as shipped. stature = metres, floor to the top of the head; scale = per segment, multiplies that segment's bones, capsules and mesh (uniformly; missing = 1); sex picks de Leva 1996's mass table; mass = kg; preset = the ANSUR II preset it came from. data/skeleton.json is never edited.",
     "properties": {
      "stature": {"type": "number", "minimum": 0.5, "maximum": 2.5},
      "scale": {
       "type": "object",
       "propertyNames": {"enum": ["upper_arm", "forearm", "hand", "thigh", "shank", "foot", "trunk", "head"]},
       "additionalProperties": {"type": "number", "minimum": 0.5, "maximum": 2.0}
      },
      "sex": {"enum": ["male", "female"]},
      "mass": {"type": "number"},
      "preset": {"enum": ["female_5", "female_50", "female_95", "male_5", "male_50", "male_95"]}
     },
     "additionalProperties": false
    },
    "ik": {
     "type": "object",
     "description": "IK / FK with pole targets (GAP_ANALYSIS row 13): per limb (named by its tip), keys over time; written only when there is one. Each key: t = seconds, target = where the wrist / ankle goes (world, m), pole = a point the elbow / knee bends toward (world, m), w = IK weight 0..1 (linear between keys), rot = the hand / foot world rotation (optional). scripts/limb_ik.gd",
     "propertyNames": {
      "enum": ["hand_l", "hand_r", "foot_l", "foot_r"]
     },
     "additionalProperties": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": ["t", "target", "pole", "w"],
       "properties": {
        "t": {"type": "number", "minimum": 0},
        "target": {"$ref": "#/$defs/vec3"},
        "pole": {"$ref": "#/$defs/vec3"},
        "w": {"type": "number", "minimum": 0, "maximum": 1},
        "rot": {"$ref": "#/$defs/quat"}
       },
       "additionalProperties": false
      }
     }
    },
    "constraints": {
     "type": "array",
     "description": "USER CONSTRAINTS (round 51, CN; scripts/constraints.gd): a stack played in order after IK; written only when there is one. type child_of: owner (a hand, a foot or the pelvis) follows target x offset (the owner in the target's frame, stored when made); track_to: the head aims at the target within the neck's limits; floor: a foot never below height (m). w = influence 0..1, wk = keyed influence [[t, w], ...] (linear between, times w), mute = off.",
     "items": {
      "type": "object",
      "required": ["type", "owner", "w"],
      "properties": {
       "type": {"enum": ["child_of", "track_to", "floor"]},
       "owner": {"enum": ["hand_l", "hand_r", "foot_l", "foot_r", "pelvis", "head"]},
       "target": {
        "type": "object",
        "required": ["kind"],
        "properties": {
         "kind": {"enum": ["part", "weapon", "point", "prop", "actor"]},
         "part": {"type": "string"},
         "at": {"$ref": "#/$defs/vec3"},
         "prop": {"type": "integer", "minimum": 0},
         "actor": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
       },
       "offset": {
        "type": "object",
        "required": ["pos", "rot"],
        "properties": {"pos": {"$ref": "#/$defs/vec3"}, "rot": {"$ref": "#/$defs/quat"}},
        "additionalProperties": false
       },
       "w": {"type": "number", "minimum": 0, "maximum": 1},
       "wk": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
       "mute": {"type": "boolean"},
       "height": {"type": "number"}
      },
      "additionalProperties": false
     }
    },
    "sets": {
     "type": "object",
     "description": "SELECTION SETS and KEYING SETS (GAP_ANALYSIS rows 9, 6): named groups of body parts; written only when there is one. select = name -> parts (a click selects exactly them); keying = name -> parts (with one active, K keys every body part in it at the playhead, one undo step); active = the active keying set's name. Mirror swaps each part to its twin and a name ending _l / _r to the other. scripts/part_sets.gd",
     "properties": {
      "select": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
      "keying": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
      "active": {"type": "string"}
     },
     "additionalProperties": false
    },
    "camera": {
     "type": "array",
     "description": "THE SHOT CAMERA (GAP_ANALYSIS row 21): one keyed camera; written only when there is one. Each key: t = seconds, pos = where the lens is (world, m), aim = the point it looks at (world, m), f = focal length in mm on a 36 mm wide sensor, 16:9 frame (fov_v = 2 atan(20.25 / 2 / f)). Between keys pos, aim and f follow the part keys' monotone curve. scripts/shot_camera.gd",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["t", "pos", "aim", "f"],
      "properties": {
       "t": {"type": "number", "minimum": 0},
       "pos": {"$ref": "#/$defs/vec3"},
       "aim": {"$ref": "#/$defs/vec3"},
       "f": {"type": "number", "minimum": 8, "maximum": 600}
      },
      "additionalProperties": false
     }
    },
    "part_keys": {
     "type": "object",
     "description": "PART KEYS (round 41, WW1): one joint's own keys over the card blend; written only when there is one. Each key: t = seconds into the scene, v = [bend, side, twist] degrees. scripts/part_keys.gd",
     "propertyNames": {
      "enum": [
       "pelvis",
       "spine_01",
       "spine_02",
       "spine_03",
       "neck_01",
       "head",
       "clavicle_l",
       "upperarm_l",
       "lowerarm_l",
       "hand_l",
       "clavicle_r",
       "upperarm_r",
       "lowerarm_r",
       "hand_r",
       "thigh_l",
       "calf_l",
       "foot_l",
       "ball_l",
       "thigh_r",
       "calf_r",
       "foot_r",
       "ball_r",
       "thumb_01_l",
       "thumb_02_l",
       "thumb_03_l",
       "index_01_l",
       "index_02_l",
       "index_03_l",
       "middle_01_l",
       "middle_02_l",
       "middle_03_l",
       "ring_01_l",
       "ring_02_l",
       "ring_03_l",
       "pinky_01_l",
       "pinky_02_l",
       "pinky_03_l",
       "thumb_01_r",
       "thumb_02_r",
       "thumb_03_r",
       "index_01_r",
       "index_02_r",
       "index_03_r",
       "middle_01_r",
       "middle_02_r",
       "middle_03_r",
       "ring_01_r",
       "ring_02_r",
       "ring_03_r",
       "pinky_01_r",
       "pinky_02_r",
       "pinky_03_r"
      ]
     },
     "additionalProperties": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "t",
        "v"
       ],
       "properties": {
        "t": {
         "type": "number",
         "minimum": 0
        },
        "v": {
         "$ref": "#/$defs/vec3"
        },
        "interp": {
         "enum": ["constant", "linear"],
         "description": "XX1: how the curve leaves this key toward the next; absent = bezier"
        },
        "handle": {
         "enum": ["auto", "vector", "aligned", "free"],
         "description": "XX1: this key's bezier handle type; absent = auto_clamped (round 41's curve)"
        },
        "hin": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[dt, d_bend, d_side, d_twist]: a bezier handle as an offset from its key (XX1)"},
        "hout": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[dt, d_bend, d_side, d_twist]: a bezier handle as an offset from its key (XX1)"},
        "inf": {
         "enum": ["linear", "cycle", "cycle_offset"],
         "description": "XX1: on a joint's FIRST key: what the curve does outside its keys; absent = hold"
        },
        "mods": {
         "type": "array",
         "description": "DD2: on a joint's FIRST key: a curve modifier stack applied in order on top of the keys (Blender's F-Curve modifiers); the keys are unchanged",
         "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
           "type": {"enum": ["noise", "stepped", "limits", "cycles"]},
           "ch": {"type": "integer", "minimum": -1, "maximum": 2, "description": "0 bend, 1 side, 2 twist, -1 all three (default)"},
           "mix": {"type": "number", "minimum": 0, "maximum": 1, "description": "Blender's Influence; default 1"},
           "strength": {"type": "number", "description": "noise: degrees peak to peak"},
           "scale": {"type": "number", "exclusiveMinimum": 0, "description": "noise: seconds per bump"},
           "phase": {"type": "number"},
           "seed": {"type": "integer"},
           "step": {"type": "number", "exclusiveMinimum": 0, "description": "stepped: seconds held"},
           "offset": {"type": "number", "description": "stepped: seconds; noise (GE4): the noise moved in time, seconds"},
           "depth": {"type": "integer", "minimum": 0, "description": "noise (GE4): extra octaves"},
           "before": {"enum": ["none", "repeat", "offset", "mirror"], "description": "cycles (GE4): before the first key"},
           "after": {"enum": ["none", "repeat", "offset", "mirror"], "description": "cycles (GE4): after the last key"},
           "before_n": {"type": "integer", "minimum": 0, "description": "cycles (GE4): copies before, 0 = for ever"},
           "after_n": {"type": "integer", "minimum": 0, "description": "cycles (GE4): copies after, 0 = for ever"},
           "min": {"type": "number", "description": "limits: degrees"},
           "max": {"type": "number", "description": "limits: degrees"}
          },
          "additionalProperties": false
         }
        }
       },
       "additionalProperties": false
      }
     }
    }
   },
   "additionalProperties": false
  }
 }
}
